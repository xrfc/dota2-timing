  },
  "sustain": {
   "zh": "治疗/吸血/高回复",
   "definition": "治疗、吸血或高额回复是该英雄技能的主要效果之一（附带少量回复不算）"
  },
  "mobility": {
   "zh": "高机动/逃生",
   "definition": "有可主动使用的闪烁、跳跃、冲刺、传送或隐身逃生手段"
  },
  "disables": {
   "zh": "控制多",
   "definition": "至少两个技能带硬控（眩晕、妖术、沉默、定身、恐惧、睡眠、吹风等）"
  },
  "dispellable_save": {
   "zh": "依赖可驱散保命效果",
   "definition": "关键保命/防御增益可被驱散（否决坠饰等）；驱散规则未逐条核对，置信度偏低"
  },
  "illusions_summons": {
   "zh": "幻象/召唤物",
   "definition": "依赖幻象（illusions）或召唤单位（summons）作战"
  },
  "mana_dependent": {
   "zh": "法力依赖",
   "definition": "核心机制持续消耗法力（如魔法盾、球状闪电），或依赖高频施法"
  },
  "magic_burst": {
   "zh": "魔法爆发",
   "definition": "有高额魔法/纯粹伤害技能，可在短时间内打出大量伤害"
  },
  "targeted_spells": {
   "zh": "依赖指向技能",
   "definition": "客观规则：基础技能中敌方单体指向主动技能≥2个，或大招为敌方单体指向（清莲宝珠可反射）",
   "rule_based": true
  }
