      "mechanisms": [
        {"mechanism":"haste","condition":"base","decision":"accept","quote":"For each second Chaos Knight keeps moving without stopping or attacking, Armageddon gains bonus movement speed.","reason_zh":"持续移动且不攻击时，每秒获得5点额外移速，最多20点。","uncertain":false},
        {"mechanism":"self_mobility","condition":"base","decision":"accept","quote":"Ahead, Armageddon can be activated to charge over terrain","reason_zh":"至少一个由主动施放 Phantasm 创造的幻象存活时，混沌骑士可以主动冲锋。","uncertain":false},
        {"mechanism":"terrain_walk","condition":"base","decision":"accept","quote":"charge over terrain","reason_zh":"混沌骑士可以在这次冲锋中越过地形。","uncertain":false},
        {"mechanism":"displace_other","condition":"base","decision":"accept","quote":"Activation of Ahead, Armageddon will gather all of Chaos Knight's illusions in %illusion_radius% radius regardless of how they were created.","reason_zh":"发动时会把1300范围内已有的己方幻象集结起来随英雄冲锋。","uncertain":false},
        {"mechanism":"aoe_damage","condition":"base","decision":"accept","quote":"Chaos Knight and the illusions will attack units they charge over.","reason_zh":"一次冲锋可通过沿途攻击对多个敌方单位造成伤害。","uncertain":false},
        {"mechanism":"pierces_debuff_immunity","condition":"base","decision":"accept","quote":"\"immunity\": 3","reason_zh":"该技能的 immunity 字段为3，符合无视减益免疫的判据。","uncertain":false},
        {"mechanism":"illusions","condition":"base","decision":"reject","quote":"illusions created with the active cast of Phantasm","reason_zh":"发动所需的幻象由 Phantasm 创造，本技能集结已有幻象。","uncertain":false},
        {"mechanism":"charges","condition":"base","decision":"reject","quote":"building up to a max speed before releasing","reason_zh":"蓄力积累的是冲锋速度，没有可逐次消耗的使用次数。","uncertain":false},
        {"mechanism":"stun","condition":"base","decision":"reject","quote":"Being stunned, hexed, feared, taunted or rooted during the windup cancels the charge.","reason_zh":"眩晕是施法者蓄力时受到后会取消冲锋的控制。","uncertain":false},
        {"mechanism":"hex","condition":"base","decision":"reject","quote":"Being stunned, hexed, feared, taunted or rooted during the windup cancels the charge.","reason_zh":"妖术列在能取消施法者蓄力的外来控制中。","uncertain":false},
        {"mechanism":"fear","condition":"base","decision":"reject","quote":"Being stunned, hexed, feared, taunted or rooted during the windup cancels the charge.","reason_zh":"恐惧会取消施法者的蓄力，冲锋本身没有迫使敌人逃跑的效果。","uncertain":false},
        {"mechanism":"taunt","condition":"base","decision":"reject","quote":"Chaos Knight and the illusions will attack units they charge over.","reason_zh":"冲锋沿途触发攻击，没有写强制单位锁定某个攻击目标，说明中的嘲讽是取消蓄力的外来控制。","uncertain":false},
        {"mechanism":"root","condition":"base","decision":"reject","quote":"Being stunned, hexed, feared, taunted or rooted during the windup cancels the charge.","reason_zh":"缠绕会取消施法者的蓄力，说明没有写冲锋能缠绕目标。","uncertain":false},
        {"mechanism":"attack_modifier","condition":"base","decision":"reject","quote":"will attack units they charge over","reason_zh":"技能触发沿途攻击，说明没有给这些攻击附加命中效果。","uncertain":false}
