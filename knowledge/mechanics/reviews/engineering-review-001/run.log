   131	def test_wrong_feedback_disputes_a_row_and_does_not_confirm_it():
   132	    rows = [_row("a"), _row("b", "user_spot_check"), _row("c", "user:U1")]
   133	    feedback = [{"review_id": key, "verdict": "wrong", "note": "n"} for key in "abc"]
   134	    assert apply_feedback(rows, feedback, []) == []
   135	    assert rows[0]["basis"] == BASIS_DISPUTED
   136	    assert rows[1]["basis"] == BASIS_DISPUTED
   137	    assert not confirmed(rows[0]["basis"])
   138	    assert rows[2]["basis"] == "user:U1"
   139	    assert rows[0]["decision"] == "accept"
   140	    assert rows[0]["user_feedback"][0]["note"] == "n"
