    41	def _verify_receipt(package):
    42	    manifest = json.loads((package / "manifest.json").read_text())
    43	    for name, expected in manifest["output_sha256"].items():
    44	        assert hashlib.sha256((package / name).read_bytes()).hexdigest() == expected
