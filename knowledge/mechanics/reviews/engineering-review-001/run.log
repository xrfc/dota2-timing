    47	def _traced_reads(monkeypatch, tmp_path, build):
    48	    seen = set()
    49	    real_open = builtins.open
    50	    real_io_open = __import__("io").open
    51	
    52	    def spy(file, *args, **kwargs):
    53	        try:
    54	            path = os.path.abspath(os.fspath(file))
    55	        except TypeError:
    56	            return real_open(file, *args, **kwargs)
    57	        if path.startswith(str(ROOT)) and os.path.isfile(path):
    58	            seen.add(os.path.relpath(path, ROOT))
    59	        return real_open(file, *args, **kwargs)
    60	
    61	    monkeypatch.setattr(builtins, "open", spy)
    62	    monkeypatch.setattr("io.open", spy)
    63	    build(tmp_path / "out")
    64	    monkeypatch.setattr(builtins, "open", real_open)
    65	    monkeypatch.setattr("io.open", real_io_open)
    66	    return {name for name in seen if not name.endswith(".py")}
    67	
