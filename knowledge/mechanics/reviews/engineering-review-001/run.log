    69	def test_package_matches_manifest_and_replays(tmp_path):
    70	    _verify_receipt(PACKAGE)
    71	    fresh, _ = builder.run(tmp_path / "v13")
    72	    assert json.dumps(fresh, sort_keys=True) == json.dumps(_doc(), sort_keys=True)
