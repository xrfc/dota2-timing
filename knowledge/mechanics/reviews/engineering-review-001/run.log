    24	            for mechanism in rule.get(key, []):
    25	                if mechanism not in terms:
    26	                    raise ValueError(f"{rule['id']}: unknown mechanism {mechanism}")
    27	    return doc["rules"]
    28	
    29	
    30	def _subjects(rows, mechanisms):
    31	    return {row["subject"] for row in rows if row["mechanism"] in mechanisms}
    32	
    33	
    34	def evaluate_rule(rule, doc, game_field_subjects=None):
    35	    """Return sorted source and target subjects for one rule."""
    36	    rows = [row for row in doc["rows"] if row["decision"] == "accept"]
    37	    notes = doc["skill_notes"]
    38	    source = _subjects(rows, set(rule.get("source_mechanisms", [])))
    39	    source |= set(rule.get("source_subjects", []))
    40	    source |= {n["subject"] for n in notes if n["kind"] in rule.get("source_note_kinds", [])}
    41	    target = _subjects(rows, set(rule.get("target_mechanisms", [])))
    42	    target |= set(rule.get("target_subjects", []))
    43	    for field, values in rule.get("target_enum", {}).items():
    44	        target |= {
    45	            fact["subject"]
    46	            for fact in doc["field_observations"]
    47	            if fact["evidence_kind"] == f"enum:{field}" and int(fact["value"]) in values
    48	        }
    49	    if rule.get("target_game_field"):
    50	        target &= (game_field_subjects or {}).get(rule["target_game_field"], set())
    51	    target -= set(rule.get("target_exclude", []))
    52	    target -= {
    53	        n["subject"] for n in notes if n["kind"] in rule.get("target_exclude_note_kinds", [])
    54	    }
    55	    return {"sources": sorted(source), "targets": sorted(target)}
     1	"""U26 knowledge framework, layer 1: decoding of official raw ability enums.
     2	
     3	The hero registry stores Valve's raw_mechanics values opaquely. The decoding table
     4	(knowledge/mechanics/enums-*.json) gives each value a meaning plus example abilities;
     5	this module checks the table against the registry so that wrong examples or new,
     6	unexplained values (e.g. after a patch) fail loudly instead of being guessed.
     7	"""
     8	
     9	
    10	def _abilities(registry_heroes):
    11	    return {a["name"]: a for h in registry_heroes for a in h["abilities"]}
    12	
    13	
    14	def load_enums(doc, registry_heroes):
    15	    """Validate the table; return {field: {int value: entry}}."""
    16	    if doc.get("schema") != "mechanics-enums/1":
    17	        raise ValueError("Unsupported mechanics enum schema")
    18	    abilities = _abilities(registry_heroes)
    19	    out = {}
    20	    for field, spec in doc["fields"].items():
    21	        values = {}
    22	        for raw, entry in spec["values"].items():
    23	            value = int(raw)
    24	            if not entry.get("examples"):
    25	                raise ValueError(f"{field}={value}: needs at least one example ability")
    26	            if not isinstance(entry.get("confirmed"), bool):
    27	                raise ValueError(f"{field}={value}: confirmed must be true or false")
    28	            for name in entry["examples"]:
    29	                ability = abilities.get(name)
    30	                if ability is None:
    31	                    raise ValueError(f"{field}={value}: unknown example ability {name}")
    32	                actual = int(ability["raw_mechanics"][field])
    33	                if actual != value:
    34	                    raise ValueError(f"{field}={value}: example {name} has {actual}")
    35	            values[value] = entry
    36	        seen = {int(a["raw_mechanics"][field]) for a in abilities.values()}
    37	        unexplained = sorted(seen - set(values))
    38	        if unexplained:
    39	            raise ValueError(f"{field}: registry values without meaning: {unexplained}")
    40	        out[field] = values
    41	    return out
    42	
    43	
    44	TEXT_EVIDENCE = {"official_text", "manual"}
    45	RAW_FIELDS = {"behavior", "target_type", "immunity", "mana_costs", "cooldowns", "cast_ranges"}
    46	
    47	
    48	def load_vocabulary(doc, enums):
    49	    """Validate the mechanism vocabulary (layer 1 terms); return {id: entry}.
    50	
    51	    Evidence kinds: official_text, manual, enum:<decoded field>, field:<raw field>,
    52	    item_attr:<item attribute key>.
    53	    """
    54	    if doc.get("schema") != "mechanics-vocabulary/1":
    55	        raise ValueError("Unsupported mechanics vocabulary schema")
    56	    categories = set(doc["categories"])
    57	    out = {}
    58	    for entry in doc["mechanisms"]:
    59	        mid = entry["id"]
    60	        if mid in out:
    61	            raise ValueError(f"Duplicate mechanism: {mid}")
    62	        if entry["category"] not in categories:
    63	            raise ValueError(f"{mid}: unknown category {entry['category']}")
    64	        if not entry.get("zh") or not entry.get("definition") or not entry.get("evidence"):
    65	            raise ValueError(f"{mid}: needs zh, definition and evidence")
    66	        for kind in entry["evidence"]:
    67	            prefix, _, name = kind.partition(":")
    68	            ok = (
    69	                kind in TEXT_EVIDENCE
    70	                or (prefix == "enum" and name in enums)
    71	                or (prefix == "field" and name in RAW_FIELDS)
    72	                or (prefix == "item_attr" and bool(name))
    73	            )
    74	            if not ok:
    75	                raise ValueError(f"{mid}: unknown evidence {kind}")
    76	        out[mid] = entry
    77	    return out
    78	
    79	
    80	def decode(enums, field, value):
    81	    """Meaning (zh) of one raw value; raises KeyError for undecoded fields/values."""
    82	    return enums[field][int(value)]["zh"]
    83	
    84	
    85	def unconfirmed(enums):
    86	    """(field, value) pairs the user has not confirmed yet, for review prompts."""
    87	    return [
    88	        (field, value)
    89	        for field, values in enums.items()
    90	        for value, entry in sorted(values.items())
