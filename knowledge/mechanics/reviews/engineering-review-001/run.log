   235	def render_item_markdown(profile):
   236	    """Readable item page; `?` marks facts that only AIs agreed on."""
   237	    lines = [f"# {profile['name_zh']}", "", "`?`表示只有AI一致，你还没确认。", "", "## 机制", ""]
   238	    for item in profile["mechanisms"]:
   239	        prefix = f"{item['condition']}：" if item["condition"] else ""
   240	        mark = "" if item["confirmed"] else " ?"
   241	        note = f" — {item['notes'][0]}" if item["notes"] else ""
   242	        lines.append(f"- {prefix}{item['zh']}{mark}{note}")
   243	    for attribute in profile["attributes"]:
   244	        lines.append(f"- 字段 {attribute['name']}：{attribute['value']}")
   245	    lines += ["", "## 能克制什么", ""]
   246	    for rule in profile["can_counter"]:
   247	        shown = "、".join(rule["heroes"][:12]) or "规则未列出目标"
   248	        more = f"等{len(rule['heroes'])}人" if len(rule["heroes"]) > 12 else ""
   249	        lines.append(f"- {rule['rule']} {rule['zh']}：{shown}{more}")
   250	    lines += ["", "## 会被什么克制", ""]
   251	    for rule in profile["countered_by"]:
   252	        items = "、".join(rule["items"][:8]) or "无装备来源"
   253	        lines.append(
   254	            f"- {rule['rule']} {rule['zh']}：装备{items}；技能来源{rule['hero_sources']}个"
   255	        )
   256	    return "\n".join(lines) + "\n"
