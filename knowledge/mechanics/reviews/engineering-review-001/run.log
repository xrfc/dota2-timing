   270	        for fact in doc["field_observations"]
   271	        if fact["evidence_kind"] == "enum:dispellable"
   272	    }
   273	    traits = {}
   274	    for trait_id, spec in mapping["traits"].items():
   275	        if spec.get("pending"):
   276	            traits[trait_id] = {"zh": spec["zh"], "pending": spec["pending"], "heroes": []}
