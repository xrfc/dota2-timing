   318	def compare_with_v1(traits, v1_doc, mapping):
   319	    """Heroes each v2 trait adds or drops against the hand-labelled v1 table."""
   320	    diff = {}
   321	    for trait_id, spec in mapping["traits"].items():
   322	        old_id = spec.get("v1")
   323	        if not old_id or spec.get("pending"):
   324	            continue
   325	        subtype = spec.get("v1_subtype")
   326	        old = {
   327	            label["hero"]
   328	            for label in v1_doc["labels"].get(old_id, [])
   329	            if subtype is None or label.get("subtype") == subtype
   330	        }
   331	        new = {hero["name_zh"] for hero in traits["traits"][trait_id]["heroes"]}
   332	        diff[trait_id] = {
   333	            "v1": old_id,
   334	            "kept": len(old & new),
   335	            "added": sorted(new - old),
   336	            "dropped": sorted(old - new),
   337	        }
   338	    return diff

