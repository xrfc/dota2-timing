   259	def build_traits(mapping, doc, registry_heroes):
   260	    """Hero traits v2: which abilities give each hero each trait, with confirmation state."""
   261	    owner = {ability["name"]: hero for hero in registry_heroes for ability in hero["abilities"]}
   262	    zh = {
   263	        ability["name"]: ability["name_zh"]
