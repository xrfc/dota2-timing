    96	def test_changing_an_input_during_the_build_stops_it(monkeypatch, tmp_path):
    97	    real = builder.digest_inputs
    98	    calls = {"count": 0}
    99	
   100	    def drifting(repo=builder.ROOT):
   101	        result = dict(real(repo))
   102	        calls["count"] += 1
   103	        if calls["count"] > 1:
   104	            result[builder.REGISTRY] = "changed"
   105	        return result
   106	
   107	    monkeypatch.setattr(builder, "digest_inputs", drifting)
   108	    with pytest.raises(ValueError, match="hero-registry"):
   109	        builder.run(tmp_path / "v13")
