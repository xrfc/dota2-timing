   226	        "name_zh": name_zh,
   227	        "status": status,
   228	        "mechanisms": sorted(mechanisms, key=lambda m: (m["condition"], m["id"])),
   229	        "attributes": attributes,
   230	        "can_counter": can_counter,
   231	        "countered_by": countered_by,
   232	    }
