   159	                        "hero_zh": abilities[0]["hero_zh"],
   160	                        "rule": rule["id"],
   161	                        "abilities": [a["subject"] for a in abilities],
   162	                        "confirmed": source["confirmed"] and any(a["confirmed"] for a in abilities),
