   292	                {"subject": row["subject"], "name_zh": zh[row["subject"]], "evidence": []},
   293	            )
   294	            ability["evidence"].append(_row_evidence(row))
   295	        listed = []
   296	        for hero_id in sorted(heroes):
   297	            entry = heroes[hero_id]
   298	            abilities = sorted(entry["abilities"].values(), key=lambda a: a["subject"])
   299	            has_base = any(not e["condition"] for a in abilities for e in a["evidence"])
   300	            listed.append(
   301	                {
   302	                    **entry,
   303	                    "abilities": abilities,
   304	                    "ability_count": len(abilities),
   305	                    "only_with_upgrade": not has_base,
   306	                    "confirmed": any(e["confirmed"] for a in abilities for e in a["evidence"]),
   307	                }
   308	            )
   309	        traits[trait_id] = {
