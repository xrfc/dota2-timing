ue_names": ["stun_duration", "damage", "dragon_cast_range", "projectile_speed", "aoe", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "dazzle_poison_touch", "name_zh": "戴泽·剧毒之触", "name_en": "Poison Touch", "description_zh": "施放一股锥形的毒素，可以打击多个敌方单位。造成持续伤害和减速。每当目标受到戴泽的攻击，负面效果的持续时间都会刷新，减速效果也会提升。", "description_en": "Releases a cone of poison that strikes multiple enemy units. Deals damage over time and slows the targets. Anytime the targets get attacked by Dazzle, the debuff duration is refreshed and slow is increased.", "notes_zh": ["伤害格挡类技能不能减少该技能伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_radius", "end_radius", "end_distance", "targets", "damage", "slow", "projectile_speed", "duration", "bonus_slow", "attack_range_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "leshrac_lightning_storm", "name_zh": "拉席克·闪电风暴", "name_en": "Lightning Storm", "description_zh": "召唤一片闪电风暴攻击目标敌方单位，并跳跃到附近的敌方单位。被攻击的敌人将会被降低移动速度。", "description_en": "Summons a lightning storm that blasts the target enemy unit, then strikes any nearby enemy units. Struck enemies have their move speed slowed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "jump_count", "radius", "jump_delay", "movespeed_slow", "slow_duration", "pulse_nova_lightning_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "furion_sprout", "name_zh": "自然先知·发芽", "name_en": "Sprout", "description_zh": "使一圈树木在一个单位的周围发芽，将其困在其中并造成伤害，提供%vision_range%范围内的视野。", "description_en": "Sprouts a ring of trees around a unit, damaging and trapping it in place and providing vision in a %vision_range% radius.", "notes_zh": ["发芽的施放目标可以是任何单位或者地面。", "发芽产生的树木跟英雄技能的相互作用与平常树木相同。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["vision_range", "duration", "sprout_damage", "sprout_damage_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "furion_wrath_of_nature", "name_zh": "自然先知·自然之怒", "name_en": "Wrath of Nature", "description_zh": "伤害性的能量在全地图跳跃，打击视野中的敌人，会先从距目标点最近的敌人开始打击。每击中一个敌人伤害都会增加，击中%max_targets%个目标后达到最高伤害。", "description_en": "Damaging energy bounces around the map, striking enemies that are in vision starting with those closest to the cast point. Each enemy hit beyond the first adds damage, up to the maximum after %max_targets% are hit.", "notes_zh": ["自然的愤怒只能伤害视野内的单位。", "可以通过点击小地图施放；初始目标将选择施放地点最近的有效单位。"], "granted_by": "", "upgrades": {"scepter": {"zh": "缠绕所有击中的敌人。持续时间根据弹跳次序从%scepter_min_entangle_duration%秒开始增加，弹跳数达到上限时为%scepter_max_entangle_duration%秒。", "en": "Entangles all enemies it hits. Duration scales from %scepter_min_entangle_duration%s up to %scepter_max_entangle_duration%s seconds at max bounce."}}, "is_passive": false, "value_names": ["max_targets", "damage", "damage_percent_add", "jump_delay", "scepter_min_entangle_duration", "scepter_max_entangle_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "life_stealer_open_wounds", "name_zh": "噬魂鬼·撕裂伤口", "name_en": "Open Wounds", "description_zh": "噬魂鬼撕裂一个敌方单位，减缓受害者的移动速度，并使所有友军在攻击该单位时根据造成的伤害回复一定比例的生命。受害者在持续时间内逐渐恢复移动速度。", "description_en": "Lifestealer rends an enemy unit, slowing the victim's movement speed and allowing all allies to regain health for a percentage of the damage they deal to that unit. The victim recovers movement speed over the duration.", "notes_zh": ["撕裂伤口的减速有8个独立的阶段：50%/50%/40%/30%/20%/10%/10%/10%，每过一秒就会进入下个阶段，减速效果不断降低。", "治疗数值会被噬魂鬼的生命回复增强效果提升。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "slow_steps", "heal_percent", "spread_radius", "slow_step_pct_of_max", "slow_tooltip", "attack_speed_on_target", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "life_stealer_infest", "name_zh": "噬魂鬼·感染", "name_en": "Infest", "description_zh": "噬魂鬼进入目标单位的身体，无法被察觉，而且自身在体内时每秒恢复最大生命值的一定百分比。接着可以从宿主体内现身，对周围所有敌方单位造成伤害。如果被感染单位是敌方非英雄单位或中立生物，噬魂鬼可以控制其进行移动和攻击，而且该生物会持续失去最大生命值的一部分。无法对敌方英雄生效。\n\n驱散类型：弱驱散", "description_en": "Lifestealer infests the body of a target unit, becoming undetectable, and healing for a portion of his max hitpoints every second while inside. He can then explode from the host body, dealing damage to nearby enemies. If the infested unit is an enemy creep or a neutral creep, he can take control of the unit's ability to move and attack, and the creep loses a portion of their max hitpoints over time. Does not work on enemy heroes.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["噬魂鬼在感染一个单位期间能够从周围死亡的单位身上获得经验。", "被感染控制的单位会获得感染的移动速度加成。", "不会触发法术反弹。", "感染可以对远古生物使用。"], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离并且冷却时间降低至%bonus_AbilityCooldown%秒。感染可以对敌方英雄施放，持续时间较短，并在他们体内发动攻击，同时提升噬魂鬼的恢复速率。", "en": "Increases cast range and reduces cooldown to %bonus_AbilityCooldown%s.  Infest may target enemy heroes for a short duration, attacking them from the inside while increasing Lifestealer's regeneration rate."}, "shard": {"zh": "吞噬感染的中立生物会使敌人沾满鲜血，根据宿主的剩余生命值造成持续伤害。", "en": "Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health."}}, "is_passive": false, "value_names": ["radius", "damage", "bonus_movement_speed", "bonus_health", "self_regen", "infest_duration_enemy", "attack_rate_enemy", "creep_max_hp_drain_pct_per_second", "can_target_ancients", "dot_damage_as_pct_of_damage_dealt", "dot_duration", "dot_tick_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "dark_seer_ion_shell", "name_zh": "黑暗贤者·离子外壳", "name_en": "Ion Shell", "description_zh": "将目标用一个尖刺之盾包裹起来，对周围的敌人造成伤害。", "description_en": "Surrounds the target unit with a bristling shield that damages enemy units in an area around it.", "notes_zh": ["每%tick_interval%秒造成一次若干伤害。", "离子外壳对其作用单位没有伤害。", "如果对已经套上离子外壳的单位再次施放，新的离子外壳会取代旧的。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage_per_second", "duration", "tick_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "clinkz_searing_arrows", "name_zh": "克林克兹·灼热之箭", "name_en": "Searing Arrows", "description_zh": "让克林克兹的箭矢带有火焰，造成更多伤害。骷髅弓手在攻击克林克兹的攻击目标时会发射灼热之箭，造成%skeleton_damage_pct%%%伤害。", "description_en": "Imbues Clinkz's arrows with fire for extra damage.Skeleton Archers will fire Searing Arrows at targets Clinkz attacks for %skeleton_damage_pct%%% damage.", "notes_zh": ["灼热之箭能对建筑造成伤害。", "伤害直接作为物理伤害加到克林克兹的攻击伤害中。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_bonus", "has_multishot", "skeleton_damage_pct", "AbilityCastRange", "AbilityManaCost"]}]
