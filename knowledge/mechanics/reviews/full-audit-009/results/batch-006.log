_passive": false, "value_names": ["snowball_damage", "snowball_speed", "snowball_damage_bonus", "stun_duration", "stun_duration_bonus", "snowball_windup_radius", "snowball_duration", "snowball_radius", "snowball_grow_rate", "snowball_windup", "snowball_grab_radius", "snowball_speed_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "tusk_walrus_kick", "name_zh": "巨牙海民·海象飞踢", "name_en": "Walrus Kick", "description_zh": "将最近的敌方单位向目标方向踢上一脚，对其造成眩晕，伤害和减速。另外对落地区域%search_radius%范围内所有英雄造成伤害。飞踢非英雄单位会使冷却时间减少%creep_cooldown_reduction_pct%%%。", "description_en": "Kicks the closest enemy unit in the drawn direction, stunning, damaging, and slowing them. Also deals damage to all heroes within %search_radius% radius of its landing area. Cooldown is reduced by %creep_cooldown_reduction_pct%%% if kicking a creep.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["air_time", "push_length", "move_slow", "slow_duration", "damage", "search_radius", "creep_cooldown_reduction_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_walrus_punch", "name_zh": "巨牙海民·海象神拳！", "name_en": "Walrus PUNCH!", "description_zh": "巨牙海民为他强力的海象神拳做好准备，下一次攻击将会造成额外伤害并暴击，同时将目标打到半空中。", "description_en": "Tusk connects with his mighty Walrus Punch, a critical strike with bonus damage so powerful it launches its victim into the air.", "notes_zh": ["海象神拳！拥有克敌机先效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "crit_multiplier", "air_time", "push_length", "proc_chance", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skywrath_mage_arcane_bolt", "name_zh": "天怒法师·奥法鹰隼", "name_en": "Arcane Bolt", "description_zh": "天怒法师施放出缓慢移动的奥术鹰群，对敌方单位造成基于天怒法师智力值的伤害。", "description_en": "Skywrath Mage launches a slow-moving bolt of arcane magic, dealing damage to an enemy unit based on Skywrath Mage's intelligence.", "notes_zh": ["鹰群移动得非常缓慢（500移速），提供325范围的视野。击中目标后，将给予目标区域的视野，持续3.34秒。", "奥法鹰隼无法被躲避。"], "granted_by": "", "upgrades": {"shard": {"zh": "天怒法师施放奥法鹰隼时，会产生%total_bolt_count%个鹰隼，其中一个飞往原目标，而另外的两个飞往原目标附近%extra_bolt_search_radius%范围内随机敌人。以英雄为首要目标。", "en": "When Skywrath Mage casts Arcane Bolt, %total_bolt_count% bolts are created, one aimed at the original target, and two others aimed at random enemies within %extra_bolt_search_radius% range of the original target. Heroes will take priority."}}, "is_passive": false, "value_names": ["pierce_spell_immunity", "bolt_speed", "bolt_vision", "bolt_damage", "int_multiplier", "vision_duration", "extra_bolt_search_radius", "total_bolt_count", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skywrath_mage_ancient_seal", "name_zh": "天怒法师·上古封印", "name_en": "Ancient Seal", "description_zh": "天怒法师利用上古符文将目标单位封印，目标单位将被沉默，受到魔法伤害时将承受额外伤害。", "description_en": "Skywrath Mage seals the targeted unit with an ancient rune, silencing it and causing it to take additional damage from spells.", "notes_zh": ["减少魔法抗性的效果对非英雄单位无效。"], "granted_by": "", "upgrades": {"scepter": {"zh": "天怒法师施放上古封印时，会随机对原目标附近%scepter_radius%范围内另一个敌人施放相同的技能。以英雄为首要目标。", "en": "Anytime Skywrath Mage casts Ancient Seal, a different random target within %scepter_radius% range of the original target will be affected by the same ability. Heroes will take priority."}}, "is_passive": false, "value_names": ["resist_debuff", "seal_duration", "scepter_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "abaddon_death_coil", "name_zh": "亚巴顿·迷雾缠绕", "name_en": "Mist Coil", "description_zh": "亚巴顿以自身的部分生命为代价，释放出一团致命迷雾，可以对敌方单位造成伤害，或者治疗友方单位。", "description_en": "Abaddon releases a coil of deathly mist that can damage an enemy unit or heal a friendly unit at the cost of some of Abaddon's health.", "notes_zh": ["亚巴顿不能使用此技能自杀。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["self_damage", "self_damage_enemy_target", "missile_speed", "damage_heal", "effect_radius", "perform_attack", "damage_percentage_on_perform_attack", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "legion_commander_duel", "name_zh": "军团指挥官·决斗", "name_en": "Duel", "description_zh": "军团指挥官强制与目标敌方英雄进行决斗，持续短暂的数秒。决斗开始后双方英雄不能使用任何物品，而目标敌方英雄不能使用技能。如果有英雄在决斗期间死亡，赢得决斗的英雄将永久获得攻击力加成。", "description_en": "Legion Commander and the target enemy hero are forced to attack each other for a short duration. Neither hero can use items, and the target enemy hero cannot use abilities. If either hero dies during the duration, the hero winning the Duel gains permanent bonus damage.", "notes_zh": ["如果双方距离超过2000，决斗也会结束。"], "granted_by": "", "upgrades": {"scepter": {"zh": "如果军团指挥官在决斗中获胜，会在她周围自动触发强攻。", "en": "When Legion Commander wins a duel, Press the Attack is automatically triggered around her."}}, "is_passive": false, "value_names": ["duration", "reward_damage", "trigger_pta_on_victory", "duel_refresh_on_victory", "team_duel", "team_duel_damage_pct", "team_duel_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_boulder_smash", "name_zh": "大地之灵·巨石冲击", "name_en": "Boulder Smash", "description_zh": "大地之灵将敌方单位或友方单位作为目标，将其击飞，目标将沿他面朝的方向飞行一段距离。如果大地之灵点地为目标，他将击飞%remnant_smash_radius_tooltip%范围内距离最近的单位，优先以残岩为目标。击飞的单位或残岩会对碰到的所有单位造成伤害。如果敌人是被残岩击中还将额外被减速。残岩被击飞的距离比其他单位更远。", "description_en": "Earth Spirit smashes the target enemy or ally, sending them in the direction he is facing. If Earth Spirit targets an area, he will smash the nearest unit in a %remnant_smash_radius_tooltip% radius, prioritizing Stone Remnants. The travelling unit or Remnant damages all enemy units it hits.  If an enemy is hit by a Stone Remnant, they are also slowed. Stone Remnants travel further than other units.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "rock_search_aoe", "rock_damage", "move_slow", "duration", "speed", "unit_distance", "rock_distance", "remnant_smash_radius_tooltip", "creep_multiplier", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_petrify", "name_zh": "大地之灵·残岩魔咒", "name_en": "Enchant Remnant", "description_zh": "大地之灵对一名英雄施法，使其暂时获得残岩的属性。经过短时间后残岩就会碎裂，释放出英雄，并对周围单位造成伤害。可以对残岩施放。对残岩施放时冷却时间为5秒。对友方英雄施放时施法距离更远。", "description_en": "Earth Spirit temporarily enchants a hero, granting them the properties of a Stone Remnant. After a short duration the remnant shatters, releasing the hero and damaging nearby enemies. Can be cast on Stone Remnants. Has a 5 second cooldown when used that way.Has a larger cast range when cast on an ally hero.", "notes_zh": ["如果大地之灵自身受到残岩魔咒的效果，也可以成为巨石冲击的目标。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage", "aoe", "ally_cast_range", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "terrorblade_sunder", "name_zh": "恐怖利刃·魂断", "name_en": "Sunder", "description_zh": "隔断恐怖利刃以及目标英雄的灵魂并将双方的当前血量百分比进行互换。交换后双方英雄的生命值必定在一定百分比以上。", "description_en": "Severs the life from both Terrorblade and a target hero, exchanging a percentage of both units' current health. Some health points must remain.", "notes_zh": ["减益免疫的敌人不会被影响生命值。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["hit_point_minimum_pct", "ignore_minimum_pct_for_enemies", "ignore_minimum_pct_for_enemies_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "oracle_fortunes_end", "name_zh": "神谕者·气运之末", "name_en": "Fortune's End", "description_zh": "持续施法 - 将神谕者的力量汇聚为一股蕴含荡涤之力的能量，对敌方目标释放这股能量可以对其造成伤害，使其被缠绕，并且驱散其附近区域的魔法效果。如果目标是友军，将只造成驱散效果。缠绕时间随着持续施法时间逐渐提升。\n\n驱散类型：弱驱散", "description_en": "CHANNELED - Gathers Oracle's power into a bolt of scouring energy that, when released, damages, roots, and dispels enemies of buffs in an area around the target. If target is an ally it will only dispel debuffs. The root duration increases with channeling time.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["可以作用无敌单位。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["channel_time", "damage", "bolt_speed", "minimum_purge_duration", "maximum_purge_duration", "radius", "purge_constantly", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "oracle_fates_edict", "name_zh": "神谕者·命运敕令", "name_en": "Fate's Edict", "description_zh": "神谕者让目标沉醉，将其缴械并提升其%magic_damage_resistance_pct_tooltip%%%魔法抗性。", "description_en": "Oracle enraptures a target, disarming them and granting them %magic_damage_resistance_pct_tooltip%%% magic damage resistance.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "magic_damage_resistance_pct_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "oracle_purifying_flames", "name_zh": "神谕者·涤罪之焰", "name_en": "Purifying Flames", "description_zh": "将目标身上一切不洁之物净化，对其造成大量魔法伤害，并使其在接下来的一段时间内逐渐恢复生命值。恢复的生命值总量将超过受到的伤害。可对友方和敌方单位施放。", "description_en": "Burns away impurities, dealing heavy magic damage to the target before causing them to regenerate health over time. The amount of health regenerated over its duration exceeds the amount of initial damage. Can be cast on enemies and allies.", "notes_zh": ["涤罪之焰的治疗效果可以相互叠加。", "涤罪之焰的伤害对友军不会致死。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "heal_per_second", "total_heal_tooltip", "duration", "tick_rate", "damage_modifier", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "winter_wyvern_splinter_blast", "name_zh": "寒冬飞龙·碎裂冲击", "name_en": "Splinter Blast", "description_zh": "向一个单位发射一团易碎的冰球。冰球一击中目标就会碎裂，而目标单位将不会受到任何效果，但是附近%split_radius%基础范围内敌人都将因碎片的冲击受到伤害，并且移动速度减缓%movespeed_slow_tooltip%%%。", "description_en": "Launches a ball of brittle ice toward a unit. The ice shatters on impact, leaving the primary target completely unaffected, while hurling damaging splinters into nearby enemies in a %split_radius% base radius. Enemies struck by these splinters are slowed by %movespeed_slow_tooltip%%%.", "notes_zh": ["主弹道的移动速度为%projectile_speed%。", "主弹道无法被躲避，而且不能以寒冬飞龙自身为目标。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["projectile_speed", "projectile_max_time", "split_radius", "bonus_movespeed", "movespeed_slow_tooltip", "slow_duration", "secondary_projectile_speed", "damage", "stun_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "winter_wyvern_winters_curse", "name_zh": "寒冬飞龙·寒冬诅咒", "name_en": "Winter's Curse", "description_zh": "寒冬飞龙驱散一个敌方目标并将其冻在原地，附近的其他敌人将受到癫狂诅咒，对冻住的队友进行攻击，而且攻击速度得到提升。冻住的目标和被诅咒攻击队友的敌人不会受到任何来自敌方的伤害，不过寒冬飞龙或她控制的单位造成的伤害除外。敌方英雄进入施放后的诅咒范围内会增加诅咒的持续时间。", "description_en": "Winter Wyvern dispells then freezes an enemy in place while striking those nearby with a maddening curse which causes them to attack their frozen ally with increased attack speed. The frozen ally and those cursed to attack their ally are immune to all damage from their enemies with the exception of damage from Winter Wyvern or her controlled units. Enemy heroes which enter the cursed area after the cast add to the duration of the curse.", "notes_zh": ["如果目标被其队友击杀，击杀者将仍是寒冰飞龙。", "无视主目标的减益免疫状态，但是对目标周围的减益免疫队友无效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage_reduction", "bonus_attack_speed", "duration", "max_duration", "bonus_duration_per_hero", "bonus_duration_per_creep", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}]
