tion", "speed_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "root", "condition": "base"}]}, {"subject": "abyssal_underlord_atrophy_aura", "name_zh": "孽主·衰退光环", "name_en": "Atrophy Aura", "description_zh": "周围所有敌方单位遭到了削弱，损失部分基础攻击力。如果敌方英雄在光环范围内死亡，孽主将获得临时的额外攻击力加成。", "description_en": "Nearby enemy units are weakened, losing a portion of their base damage. If an enemy dies while under this effect, Underlord gains temporary bonus damage.", "notes_zh": ["破坏会使攻击力降低光环失效，并且孽主无法获得新的额外攻击力。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "damage_reduction_pct", "bonus_damage_from_creep", "bonus_damage_from_hero", "bonus_damage_duration"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "attack_damage_reduction", "condition": "base"}, {"mechanism": "aura", "condition": "base"}]}, {"subject": "abyssal_underlord_raid_boss", "name_zh": "孽主·侵略大军", "name_en": "Invading Force", "description_zh": "友方英雄传送后会临时获得承受伤害降低和移动速度加成。友军通过恶魔之扉传送后会获得%dark_portal_multiplier%倍加成。", "description_en": "After an allied hero Teleports, they temporarily gain Damage Reduction and Movement Speed. Allies receive %dark_portal_multiplier%x bonuses if teleporting via Fiend's Gate.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_reduction", "bonus_ms", "dark_portal_multiplier", "buff_duration"], "judge": [{"mechanism": "damage_block", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "abyssal_underlord_dark_portal", "name_zh": "孽主·恶魔之扉", "name_en": "Fiend's Gate", "description_zh": "打开2个传送门，一个在孽主身旁，另一个在目标地点。英雄可以对一个传送门持续施法%warp_channel_duration%秒，传送至另一端。传送门之间的距离必须超过%minimum_distance%。", "description_en": "Opens 2 portals, one next to Underlord and one in the target location. Heroes can channel a portal for %warp