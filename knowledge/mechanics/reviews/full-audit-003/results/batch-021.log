nism":"root","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"将他们困于原地","reason_zh":"把目标困在原地符合定身定义。"}]},{"subject":"ember_spirit_sleight_of_fist","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"攻击目标区域内所有敌人","reason_zh":"一次施放会攻击目标区域内所有敌人并造成伤害。"},{"mechanism":"attack_modifier","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"攻击目标区域内所有敌人，随后返回所在位置。对英雄造成额外伤害。","reason_zh":"技能自身使这些攻击对英雄附带额外伤害，符合攻击特效定义。"},{"mechanism":"cleave","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"炘拥有的攻击特效（如致命一击、重击、分裂、连锁闪电等效果）在技能攻击期间都能生效。","reason_zh":"材料仅说明已有分裂能在技能攻击期间生效，没有赋予技能自身分裂。"},{"mechanism":"critical","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"炘拥有的攻击特效（如致命一击、重击、分裂、连锁闪电等效果）在技能攻击期间都能生效。","reason_zh":"材料仅说明已有致命一击能生效，没有赋予技能自身暴击。"},{"mechanism":"self_mobility","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"Ember Spirit dashes around with blazing speed, attacking all enemies in the targeted area of effect, then returning to his start location.","reason_zh":"技能使灰烬之灵冲向敌人并返回起点，主动改变自身位置。"}]},{"subject":"ember_spirit_flame_guard","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"烈火罩开启后会对灰烬之灵周围的敌人造成每秒伤害。","reason_zh":"一次开启可持续伤害周围多个敌人。"},{"mechanism":"damage_block","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"使受到的魔法伤害被吸收一定百分比。","reason_zh":"技能明确吸收一定百分比的魔法伤害。"}]},{"subject":"ember_spirit_immolation","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"时刻对周围所有敌人造成每秒伤害。","reason_zh":"同一持续效果能同时伤害周围多个敌人。"}]},{"subject":"ember_spirit_fire_remnant","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"灰烬之灵向所有残焰像冲去，将其摧毁并造成范围伤害","reason_zh":"技能说明明确包含激活残焰造成范围伤害的效果。"},{"mechanism":"charges","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"学习后马上拥有3个残焰（上限数量）。","reason_zh":"初始有限的残焰数量结合升级说明中的能量点数上限与恢复，支持基础残焰采用充能机制。"},{"mechanism":"charges","condition":"shard","decision":"accept","condition_correct":false,"correct_condition":"base","quote":"灰烬之灵附近范围内有敌方英雄阵亡时，恢复一点残焰能量点数。","reason_zh":"魔晶新增恢复已有充能的途径，残焰的充能机制本身属于基础效果。"},{"mechanism":"self_mobility","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"灰烬之灵向所有残焰像冲去","reason_zh":"材料明确说明灰烬之灵自身冲向残焰并改变位置。"}]},{"subject":"earth_spirit_boulder_smash","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"击飞的单位或残岩会对碰到的所有单位造成伤害。","reason_zh":"一次击飞可沿途伤害多个敌方单位。"},{"mechanism":"flying","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"将其击飞，目标将沿他面朝的方向飞行一段距离。","reason_zh":"这里描述目标被击飞的位移，没有赋予该对象可越过地形的飞行移动能力。"},{"mechanism":"slow","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"如果敌人是被残岩击中还将额外被减速。","reason_zh":"技能击飞的残岩命中敌人时明确施加减速。"}]},{"subject":"earth_spirit_rolling_boulder","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"对经过的敌人造成伤害和眩晕","reason_zh":"一次翻滚能伤害沿途经过的多个敌人。"},{"mechanism":"invulnerable_untargetable","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"大地之灵在滚动时无法作为目标，而且无敌。","reason_zh":"说明明确赋予滚动期间无敌和不可选取状态。"},{"mechanism":"stun","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"对经过的敌人造成伤害和眩晕","reason_zh":"翻滚明确对经过的敌人施加眩晕。"}]},{"subject":"earth_spirit_geomagnetic_grip","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"行进路径上被击中的敌人都会被沉默并受到伤害。","reason_zh":"一次拉扯能对路径上多个敌人造成伤害。"},{"mechanism":"silence","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"行进路径上被击中的敌人都会被沉默","reason_zh":"技能明确沉默路径上被击中的敌人。"}]},{"subject":"earth_spirit_stone_caller","judgments":[{"mechanism":"charges","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"召唤残岩需要消耗一点能量点数，能量点数会随时间恢复。","reason_zh":"每次施放消耗一点可恢复的能量点数，符合充能定义。"},{"mechanism":"invulnerable_untargetable","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"残岩没有视野，为无敌状态","reason_zh":"技能产生的残岩明确具备无敌状态。"}]},{"subject":"earth_spirit_petrify","judgments":[{"mechanism":"aoe_damage","condition":"scepter","decision":"accept","condition_correct":true,"correct_condition":"scepter","quote":"经过短时间后残岩就会碎裂，释放出英雄，并对周围单位造成伤害。","reason_zh":"技能由A杖提供，碎裂时能对周围多个敌方单位造成伤害。"}]},{"subject":"earth_spirit_magnetize","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"将附近小范围内的敌方单位磁化，使其短时间内受到伤害。","reason_zh":"一次施放会使附近范围内多个敌方单位持续受到伤害。"}]},{"subject":"terrorblade_reflection","judgments":[{"mechanism":"invulnerable_untargetable","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"无法以倒影的幻象为目标，并且幻象为无敌","reason_zh":"技能制造的倒影明确具备不可选取和无敌状态。"},{"mechanism":"slow","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"移动速度和攻击速度都会降低。","reason_zh":"技能明确降低目标移动速度和攻击速度。"},{"mechanism":"spell_reflect","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"目标在短时间内将被自身倒影攻击","reason_zh":"倒影攻击目标不属于把指向技能反弹给施法者。"}]},{"subject":"terrorblade_conjure_image","judgments":[{"mechanism":"illusions","condition":"base","decision":"accept","condition_correct":true,"correct_condition":"base","quote":"创造一个恐怖利刃的幻象","reason_zh":"技能明确制造自身幻象。"}]},{"subject":"terrorblade_demon_zeal","judgments":[{"mechanism":"healing","condition":"shard","decision":"accept","condition_correct":true,"correct_condition":"shard","quote":"为恐怖利刃和他附近的幻象提供生命恢复","reason_zh":"该技能由魔晶提供，并明确给予生命恢复。"}]},{"subject":"terrorblade_terror_wave","judgments":[{"mechanism":"forced_action","condition":"scepter","decision":"accept","condition_correct":true,"correct_condition":"scepter","quote":"击中敌方英雄将使其恐惧","reason_zh":"该技能由A杖提供，施加的恐惧属于强制行为。"}]},{"subject":"terrorblade_sunder","judgments":[{"mechanism":"debuff_immunity","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"减益免疫的敌人不会被影响生命值。","reason_zh":"这里仅说明技能与目标减益免疫的交互，没有赋予减益免疫。"}]},{"subject":"terrorblade_dark_unity","judgments":[{"mechanism":"aoe_damage","condition":"base","decision":"reject","condition_correct":true,"correct_condition":"base","quote":"恐怖之刃控制的附近幻象拥有额外攻击伤害。","reason_zh":"该技能只提高附近幻象的攻击伤害，不使一次施放或一次攻击伤害多个敌人。"}]}]}
