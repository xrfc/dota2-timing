ityCooldown"], "judge": [{"mechanism": "slow", "condition": "base"}]}, {"subject": "ogre_magi_unrefined_fireblast", "name_zh": "食人魔魔法师·未精通的火焰爆轰", "name_en": "Unrefined Fireblast", "description_zh": "操控一波火焰轰击一个敌方单位，造成%base_damage% + %str_multiplier%倍食人魔力量的伤害并使目标眩晕。魔法消耗为食人魔魔法师当前魔法的%scepter_mana%%%。", "description_en": "Blasts an enemy unit with a wave of fire, dealing %base_damage% + %str_multiplier%x Ogre's Strength in damage and stunning the target. Its mana cost is %scepter_mana%%% of Ogre Magi's current mana.", "notes_zh": ["触发多重施法时，两次火焰爆轰之间有%multicast_delay%秒的间隔。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["stun_duration", "multicast_delay", "scepter_mana", "base_damage", "str_multiplier", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "stun", "condition": "scepter"}]}, {"subject": "ogre_magi_smash", "name_zh": "食人魔魔法师·烈火护盾", "name_en": "Fire Shield", "description_zh": "创造一个围绕友军目标的护盾，吸收接下来%attacks%次来自敌方英雄攻击的一定百分比伤害。吸收伤害后向攻击者发射火球。可以对防御塔施放。", "description_en": "Creates a shield around the target ally, absorbing a percentage of the damage of next %attacks% attacks from enemy heroes. When damage is absorbed, a fireball is launched at the attacker. Can be cast on towers.", "notes_zh": ["触发多重施法时，%multicast_fireshield_aoe%范围内的友方单位将随机获得烈火护盾效果。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["damage", "attacks", "duration", "multicast_fireshield_aoe", "projectile_speed", "damage_absorb_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "damage_block", "condition": "shard"}]}, {"subject": "ogre_magi_dumb_luck", "name_zh": "食人魔魔法师·傻福", "name_en": "Dumb Luck", "description_zh": "食人魔魔法师的智力值上限为0。他通过力量来获得魔法和魔法恢复。", "description_en": "Ogre Magi's max Intelligence is 0. He receives mana and mana regeneration from Strength.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["mana_per_str", "mana_regen_per_str", "level_one_ability_points", "level_two_ability_points", "required_level_reduction"], "judge": [{"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "undying_decay", "name_zh": "不朽尸王·腐朽", "name_en": "Decay", "description_zh": "不朽尸王偷取区域内所有敌方英雄的力量，造成基础伤害并将敌人的力量据为己有。对非英雄单位造成%creep_damage_multiplier%倍伤害。", "description_en": "Undying steals strength from all enemy heroes in an area, dealing base damage as he claims the enemy's strength for himself. Deals %creep_damage_multiplier%x damage to creeps.", "notes_zh": ["窃据的力量可以叠加，但是敌方英雄的力量至少为1点。", "力量的窃取先于技能造成的伤害。", "可以作用隐形单位。"], "granted_by": "", "upgrades": {"scepter": {"zh": "提升力量窃取。", "en": "Increases strength steal."}}, "is_passive": false, "value_names": ["decay_damage", "str_steal", "decay_duration", "radius", "str_scale_up", "creep_damage_multiplier", "shard_buff_duration", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "spell_steal", "condition": "base"}, {"mechanism": "stat_steal", "condition": "base"}]}, {"subject": "undying_soul_rip", "name_zh": "不朽尸王·噬魂", "name_en": "Soul Rip", "description_zh": "不朽尸王从附近的所有单位身上扯出生命力，并使用它治疗队友或伤害敌人。可以使用噬魂治疗墓碑。", "description_en": "Undying rips health away from all nearby units and uses it to heal an ally, or damage an enemy. Soul Rip can also be used to heal Tombstone.", "notes_zh": ["可以治疗墓碑，但是不能治疗或伤害其他建筑。", "不会扯出隐身单位、无敌单位、战争迷雾内单位或减益免疫敌人的生命力。", "可以扯出减益免疫友军，包括僵尸的生命力。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_unit", "max_units", "radius", "tombstone_heal", "strength_share_percent", "strength_share_duration", "strength_share_model_scale", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "healing", "condition": "base"}]}, {"subject": "undying_tombstone", "name_zh": "不朽尸王·墓碑", "name_en": "Tombstone", "description_zh": "在目标位置召唤一座墓碑。墓碑会不断在其附近的每个敌方单位身边产生僵尸攻击他们。僵尸拥有死亡渴望技能，使他们的攻击带有减速效果，并且若目标的生命值低于一定百分比，僵尸的攻击和移动速度会提升。", "description_en": "Summons a tombstone at the target point.  Zombies will frequently spawn next to every enemy unit in the area around the Tombstone, and attack them.  Zombies have the Deathlust ability, which causes their attacks to slow the target, and if the target reaches below a certain amount of health, increases the attack and movement speed of the zombie.", "notes_zh": ["墓碑免疫技能，但是可以被噬魂治疗。", "僵尸和墓碑均免疫技能。", "如果初始目标死亡或丢失视野，僵尸将会死亡。"], "granted_by": "", "upgrades": {"shard": {"zh": "墓碑可以对友方英雄施放，让他们躲进墓碑。进入墓碑的英雄%tombstone_bunker_cd%秒内无法离开，离开后同样的时间内无法再次进入。如果英雄在内时墓碑被摧毁，该英雄会被眩晕%tombstone_stun_penalty%秒。", "en": "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."}}, "is_passive": false, "value_names": ["tombstone_health", "hits_to_destroy_tooltip", "duration", "radius", "health_threshold_pct_tooltip", "zombie_interval", "zombie_damage_tooltip", "zombie_bonus_damage", "zombie_health", "bunker_units", "tombstone_grab_radius", "tombstone_bunker_cd", "tombstone_stun_penalty", "AbilityCastRange", "AbilityCastPoint"], "judge": [{"mechanism": "debuff_immunity", "condition": "base"}, {"mechanism": "healing", "condition": "base"}, {"mechanism": "slow", "condition": "base"}, {"mechanism": "stun", "condition": "shard"}]}, {"subject": "undying_ceaseless_dirge", "name_zh": "不朽尸王·挽歌犹唱", "name_en": "Ceaseless Dirge", "description_zh": "不朽尸王阵亡时会立刻在泉水复活。比赛开始时处于冷却状态。无法被刷新。", "description_en": "When Undying dies he will instantly respawn in the fountain. Begins the game on cooldown. Cannot be refreshed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["respawn_delay", "AbilityCooldown"], "judge": [{"mechanism": "respawn", "condition": "base"}]}, {"subject": "undying_flesh_golem", "name_zh": "不朽尸王·血肉傀儡", "name_en": "Flesh Golem", "description_zh": "不朽尸王变身为一具令人毛骨悚然的血肉傀儡。在这个状态下，他获得一定百分比的力量加成，移动速度加成，并且攻击附带减速和伤害加深效果，还会产生墓碑的僵尸。", "description_en": "Undying transforms into a horrifying flesh golem.  While in this state, he gains a percentage increase to strength, bonus movement speed, and causes attacks to slow, apply damage amplification, and spawn Tombstone zombies.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["slow", "damage_amp", "slow_duration", "str_percentage", "duration", "movement_bonus", "spawn_zombie_on_attack", "zombie_duration", "zombie_spawn_padding", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "incoming_damage_amp", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "rubick_telekinesis", "name_zh": "拉比克·隔空取物", "name_en": "Telekinesis", "description_zh": "拉比克利用他的隔空取物能力，将敌人短暂抬到空中，然后猛投向地面。被投下的单位会砸晕落地点附近的敌人。", "description_en": "Rubick uses his telekinetic powers to lift the enemy into the air briefly and then hurls them back at the ground. The unit lands on the ground with such force that it stuns nearby enemies.", "notes_zh": ["目标滞空时，拉比克可以使用次级技能将目标扔往目标方向。", "单位落地后，自身不会受到范围眩晕效果。"], "granted_by": "", "upgrades": {"shard": {"zh": "可以对自身或友军施放隔空取物。投掷距离增加至%max_land_distance%，投掷延迟降低至%shard_teammate_throw_delay%秒。", "en": "Allows you to target yourself or allies with Telekinesis. Throw distance is increased to %max_land_distance% and throw delay is reduced to %shard_teammate_throw_delay% seconds."}}, "is_passive": false, "value_names": ["lift_duration", "stun_duration", "radius", "max_land_distance", "fall_duration", "shard_max_land_distance_bonus_pct", "shard_cooldown_reduction_pct", "shard_teammate_throw_delay", "landing_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "displace_other", "condition": "shard"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "rubick_fade_bolt", "name_zh": "拉比克·弱化能流", "name_en": "Fade Bolt", "description_zh": "拉比克制造一道强大的奥术能量流，在多个敌方单位之间流动，造成伤害并降低他们的攻击力和技能伤害。每次跳跃造成的伤害递减。", "description_en": "Rubick creates a powerful stream of arcane energy that travels between enemy units, dealing damage and reducing their attack and spell damage. Each jump deals less damage.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "jump_damage_reduction_pct", "damage_reduction", "duration", "radius", "jump_delay", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "attack_damage_reduction", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}, {"mechanism": "spell_amp", "condition": "base"}]}, {"subject": "rubick_arcane_supremacy", "name_zh": "拉比克·奥术至尊", "name_en": "Arcane Supremacy", "description_zh": "拉比克对奥术的熟稔使他拥有更远的施法距离，和额外技能增强。", "description_en": "Rubick's mastery of the arcane allows him to have a larger cast range and bonus spell amplification.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["cast_range", "spell_amp"], "judge": [{"mechanism": "spell_amp", "condition": "base"}]}, {"subject": "rubick_spell_steal", "name_zh": "拉比克·技能窃取", "name_en": "Spell Steal", "description_zh": "拉比克钻研一个敌方英雄的魔法精华之痕，学习这个英雄最后释放的技能的秘密。拉比克将可以使用这个技能，维持几分钟或直到他死亡。", "description_en": "Rubick studies the trace magical essence of one enemy hero, learning the secrets of the last spell the hero cast. Rubick can use this spell as his own for several minutes or until he dies.", "notes_zh": ["无法窃取物品类技能。", "拉比克若拥有阿哈利姆魔晶，则窃取的技能会是魔晶升级版本。", "不会触发法术反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "可窃取的技能提升至2个。提升施法距离，并且窃取的技能会升级成神杖版本。", "en": "Increases the number of spells that can be stolen to 2. Increases cast range, and upgrades stolen spells to their Scepter version."}, "shard": {"zh": "窃取的技能升级为相应的魔晶版本。", "en": "Upgrades stolen spells to their Shard version."}}, "is_passive": false, "value_names": ["cast_range_scepter", "projectile_speed", "stolen_mana_reduction", "stolen_spell_cooldown_percent", "spell_amp_percent", "duration", "curiosity_steal_factor", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "spell_reflect", "condition": "base"}, {"mechanism": "spell_steal", "condition": "base"}, {"mechanism": "spell_steal", "condition": "shard"}]}, {"subject": "rubick_curiosity", "name_zh": "拉比克·奇心", "name_en": "Curiosity", "description_zh": "拉比克现在每级获得%curiosity_per_level%层奇心的叠加效果，每层奇心提供%curiosity_attack_damage%点基础攻击力，%curiosity_modifier_amp%%%增益/减益持续时间，和%curiosity_aoe_bonus%作用范围加成。如果拉比克看到%charge_radius%范围内有敌方英雄施放技能，他就会获得%curiosity_per_spell_cast%层奇心，持续%curiosity_duration%秒。如果当前提供临时奇心的敌人在受到来自拉比克的伤害后%grace_period%秒内阵亡，他就会永久获得%curiosity_per_kill%层奇心。", "description_en": "Rubick gains %curiosity_per_level% stack of Curiosity per level that grants him %curiosity_attack_damage% base damage, %curiosity_modifier_amp%%% Buff/Debuff Duration, and %curiosity_aoe_bonus% AOE Bonus. If Rubick sees an enemy Hero cast an ability within %charge_radius% distance of him, he gains %curiosity_per_spell_cast% Curiosity for %curiosity_duration% seconds.  If an enemy Hero dies while Rubick has Curiosity from them and he damaged them in the last %grace_period% seconds, he gains %curiosity_per_kill% Curiosity permanently.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["curiosity_per_spell_cast", "curiosity_duration", "curiosity_per_level", "curiosity_attack_damage", "curiosity_modifier_amp", "curiosity_aoe_bonus", "curiosity_per_kill", "grace_period", "curiosity_factor", "charge_radius", "curiosity_permanent_gain", "current_debuff_amp", "current_aoe_bonus"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}]}, {"subject": "disruptor_thunder_strike", "name_zh": "干扰者·风雷之击", "name_en": "Thunder Strike", "description_zh": "用闪电反复打击目标单位。每次打击会伤害附近小范围内的敌方单位，并施加%slow_duration%秒的%slow_amount%%%攻击速度和移动速度降低效果。提供目标的视野。", "description_en": "Repeatedly strikes the targeted unit with lightning.  Each strike damages nearby enemy units in a small radius and slows enemy movement and attack speed by %slow_amount%%% for %slow_duration% seconds.  Provides vision of its target.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "strikes", "strike_interval", "strike_damage", "strike_damage_bonus", "slow_duration", "slow_amount", "shard_ground_delay", "hits_units_inside_kinetic", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "disruptor_glimpse", "name_zh": "干扰者·恶念瞥视", "name_en": "Glimpse", "description_zh": "将目标英雄传送回他%backtrack_time%秒前所在位置。瞬间消灭幻象单位。根据瞥视距离的一定百分比造成伤害，不能超过最大伤害。", "description_en": "Teleports the target hero back to where it was %backtrack_time% seconds ago.  Instantly kills illusions. Deals damage equal to a percentage of the distance glimpsed, that cannot go over a damage maximum.", "notes_zh": ["飞行时间由目标的飞行距离决定。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["backtrack_time", "cast_range", "min_damage", "max_damage", "damage_to_distance_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "execute", "condition": "base"}, {"mechanism": "flying", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}]}, {"subject": "disruptor_electromagnetic_repulsion", "name_zh": "干扰者·电磁排斥", "name_en": "Electromagnetic Repulsion", "description_zh": "每当干扰者受到%effect_radius%范围内来自任意来源的%damage_threshold%点伤害，附近所有敌人都会受到%damage_per_int%倍干扰者智力值的伤害，并且被推开最多%effect_radius%距离。", "description_en": "Whenever Disruptor takes more than %damage_threshold% damage from any source within %effect_radius% radius, all nearby enemies within take damage equal to %damage_per_int%x of Disruptor's Intelligence, and are pushed back up to a %effect_radius% distance away.", "notes_zh": ["%damage_reset_interval%秒后伤害计数会重置。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_threshold", "effect_radius", "knockback_duration", "damage_reset_interval", "damage_per_int", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "displace_other", "condition": "base"}]}, {"subject": "disruptor_static_storm", "name_zh": "干扰者·静态风暴", "name_en": "Static Storm", "description_zh": "创造一场静态风暴，在持续时间内伤害并沉默区域内的所有敌方单位。伤害刚开始时很低，但会在持续时间内逐渐增加。", "description_en": "Creates a damaging static storm that also silences all enemy units in the area for the duration.  The damage starts off weak, but increases in power over the duration.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "锁闭物品。", "en": "Mutes items."}}, "is_passive": false, "value_names": ["radius", "pulses", "damage_max", "duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "mute", "condition": "scepter"}, {"mechanism": "silence", "condition": "base"}]}]}
