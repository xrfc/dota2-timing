, "max_distance", "bonus_speed", "illusion_spawn_radius", "illusion_spawn_travel_distance", "evasion", "AbilityCooldown"], "judge": [{"mechanism": "charges", "condition": "base"}, {"mechanism": "evasion", "condition": "base"}, {"mechanism": "illusions", "condition": "scepter"}]}, {"subject": "phantom_lancer_juxtapose", "name_zh": "幻影长矛手·并列", "name_en": "Juxtapose", "description_zh": "幻影长矛手的攻击有一定几率使自己的存在破碎，产生自身的幻象。幻象也有几率进一步破碎，再产生幻象。幻影长矛手产生的幻象持续%illusion_duration%秒，幻象产生的幻象则持续%illusion_from_illusion_duration%秒。", "description_en": "Phantom Lancer has a chance to fracture his presence on an attack, creating an illusion of himself. Illusions also have a chance to fracture further. Illusions created from Phantom Lancer last for %illusion_duration% seconds, while illusions created from other illusions last %illusion_from_illusion_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "并列增加主动技能。使幻影长矛手进入隐身，最多持续%invis_duration%秒，同时产生一个复制幻象来迷惑敌人。隐身期间自身移动速度提升%invis_movespeed%%%。", "en": "Adds an active ability to Juxtapose. Renders Phantom Lancer invisible for up to %invis_duration% seconds while generating a duplicate image to confuse enemies. His movement speed is increased by %invis_movespeed%%% during this invisibility."}}, "is_passive": true, "value_names": ["max_illusions", "proc_chance_pct", "illusion_proc_chance_pct", "illusion_duration", "illusion_from_illusion_duration", "illusion_damage_out_pct", "tooltip_illusion_damage", "illusion_damage_in_pct", "tooltip_total_illusion_damage_in_pct", "shard_bonus_illusions", "invis_duration", "invis_movespeed", "uncontrollable_illusions", "new_target_radius", "AbilityManaCost"], "judge": [{"mechanism": "illusions", "condition": "base"}, {"mechanism": "illusions", "condition": "shard"}, {"mechanism": "invisibility", "condition": "shard"}]}, {"subject": "puck_illusory_orb", "name_zh": "帕克·幻象法球", "name_en": "Illusory Orb", "description_zh": "以矢量为目标。帕克向路线方向发出一个魔法球，对经过路径上的敌人造成伤害。法球每%damage_interval%秒会在作用范围内额外造成%damage_over_time_pct%%%击中伤害，但超过最大施法距离后法球会被摧毁。\n\n在幻象法球飞行过程中，帕克可以使用灵动之翼来传送到法球所在的位置。可以设为多样施法（右键点击技能栏图标），让法球的路线为向前的直线。", "description_en": "Vector Targeted. Puck launches a magic orb that travels along the path, damaging enemy units along the way. The orb deals an additional %damage_over_time_pct%%% of its impact damage every %damage_interval%s in its area of effect, but if it exceeds the max cast range it will be destroyed.\n\n At any point, Puck may teleport to the orb's location using Ethereal Jaunt. Can be put on alt-cast to launch the Orb straight ahead.", "notes_zh": ["幻象法球在飞行途中提供顺畅视野。", "将自己传送到幻象法球可以躲避攻击和技能弹道。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "max_distance", "orb_speed", "orb_vision", "vision_duration", "damage", "warning_sound_time", "curve_orb", "curve_orb_duration_multiplier", "curve_orb_max_acceleration", "curve_orb_pullback_bonus_launch_speed", "curve_strength", "vector_reticle_distance", "damage_over_time_pct", "damage_interval"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "attack_modifier", "condition": "base"}, {"mechanism": "flying", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}]}, {"subject": "puck_waning_rift", "name_zh": "帕克·新月之痕", "name_en": "Waning Rift", "description_zh": "帕克传送至目标地点洒出它神秘的仙女粉尘，对周围的敌人造成伤害和沉默。", "description_en": "Puck teleports to the target location and releases a burst of faerie dust that deals damage and silences enemy units nearby.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "silence_duration", "damage", "max_distance", "push_pull_enabled", "knock_distance", "knock_duration", "pull_distance", "pull_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}, {"mechanism": "silence", "condition": "base"}]}, {"subject": "puck_phase_shift", "name_zh": "帕克·相位转移", "name_en": "Phase Shift", "description_zh": "持续施法 - 帕克暂时将自己转移到另一个位面，从而免疫伤害。", "description_en": "CHANNELED - Puck briefly shifts into another dimension where it is immune from harm.", "notes_zh": ["帕克在相位转移状态下依然具有碰撞体积。", "进行任何动作都会中止相位转移。", "帕克在相位转移状态下无敌。"], "granted_by": "", "upgrades": {"shard": {"zh": "帕克的攻击造成额外魔法伤害。帕克每次施放相位转移时对攻击距离内所有敌人发动一次攻击。", "en": "Puck's attacks deal bonus magic damage. Puck attacks all enemies within its attack range every time it phase shifts."}}, "is_passive": false, "value_names": ["duration", "shard_attack_range_bonus", "shard_bonus_damage", "AbilityChannelTime", "AbilityCastPoint", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "invulnerable_untargetable", "condition": "base"}, {"mechanism": "magic_resist_reduction", "condition": "shard"}, {"mechanism": "phased", "condition": "base"}, {"mechanism": "phased", "condition": "shard"}]}, {"subject": "puck_puckish", "name_zh": "帕克·顽皮克敌", "name_en": "Puckish", "description_zh": "每当帕克躲避攻击时，它就会分别回复最大生命值和最大魔法值的%mana_and_health_restore_pct%%%。躲避指向性技能的弹道将回复%dodged_spell_multiplier%倍数值。防御塔的攻击不会对此生效。", "description_en": "Whenever Puck disjoints an attack, it restores %mana_and_health_restore_pct%%% of its max health and mana. Dodging a targeted spell projectile restores %dodged_spell_multiplier%x that amount. Does not apply to attacks by Towers.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["mana_and_health_restore_pct", "dodged_spell_multiplier"], "judge": [{"mechanism": "healing", "condition": "base"}, {"mechanism": "mana_gain", "condition": "base"}, {"mechanism": "projectile_dodge", "condition": "base"}]}, {"subject": "puck_dream_coil", "name_zh": "帕克·梦境缠绕", "name_en": "Dream Coil", "description_zh": "创造一个变化无常的的魔法梦境来困住敌方英雄，对他们造成伤害和束缚。如果被困住的敌方英雄试图挣脱缠绕走出梦境，将因为梦境破碎而受到眩晕和额外伤害。", "description_en": "Creates a coil of volatile magic that latches onto enemy Heroes, damaging and leashing them.  If the enemy hero stretches the coil by moving too far away, it snaps, stunning and dealing additional damage.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "梦境缠绕作用下的所有敌人都会被帕克攻击，攻击频率基于帕克攻击频率的%attack_rate_pct%%%。即使目标挣脱梦境，被眩晕时攻击也会继续。", "en": "All enemies affected by Dream Coil are attacked at a rate equal to %attack_rate_pct%%% of Puck's attack rate. The attacks continue while the target is stunned if they break the Dream Coil."}}, "is_passive": false, "value_names": ["coil_duration", "coil_break_radius", "stun_duration", "coil_initial_damage", "coil_stun_duration", "coil_break_damage", "coil_radius", "coil_rapid_fire_rate", "coil_rapid_fire_z_offset", "attack_rate_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "incoming_damage_amp", "condition": "base"}, {"mechanism": "mobility_lock", "condition": "base"}, {"mechanism": "root", "condition": "base"}, {"mechanism": "root", "condition": "scepter"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "pudge_meat_hook", "name_zh": "帕吉·肉钩", "name_en": "Meat Hook", "description_zh": "向一个单位或方向射出血腥的肉钩。勾住第一个遭遇的单位，并将它拖到帕吉身边，如果是非远古单位会被秒杀，其他敌方单位则是受到伤害。", "description_en": "Launches a bloody hook toward a unit or location. The hook will snag the first unit it encounters, dragging the unit back to Pudge, killing it if it's a non-ancient creep and dealing damage if it is an enemy otherwise.", "notes_zh": ["钩中敌人后将打断持续施法类技能。", "肉钩能击中隐身单位。", "肉钩可以穿过树木、地形、建筑、远古生物和肉山。", "肉钩可以拖拽友方单位，不过他们不会受到伤害。", "肉钩可以将神符拖拽至帕吉身旁，并返还肉钩的魔法消耗。"], "granted_by": "", "upgrades": {"shard": {"zh": "肉钩击中敌人时会根据牵引距离造成额外伤害。肉钩击中友军时，肉钩的冷却时间会减少%cooldown_reduction_pct_allied_hook%%%。", "en": "When Meat Hook hits an enemy, it deals bonus damage based on the distance pulled.When Meat Hook hits an ally, Meat Hook's cooldown is reduced by %cooldown_reduction_pct_allied_hook%%%."}}, "is_passive": false, "value_names": ["damage", "hook_speed", "hook_width", "vision_radius", "vision_duration", "distance_to_damage", "min_distance_damage", "cooldown_reduction_pct_allied_hook", "self_stun_duration_percent", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "channel_interrupt", "condition": "base"}, {"mechanism": "displace_other", "condition": "shard"}, {"mechanism": "tree_walk", "condition": "base"}]}, {"subject": "pudge_rot", "name_zh": "帕吉·腐烂", "name_en": "Rot", "description_zh": "能够造成持续伤害并减缓敌人移动速度的毒性云雾——同时对敌军和自身造成伤害。", "description_en": "A toxic cloud that deals intense damage and slows movement--harming not only enemy units but Pudge himself.", "notes_zh": ["使用腐烂不会打断持续施法。", "腐烂能伤害隐身单位。", "即使帕吉在开启腐烂后被沉默，腐烂也不会关闭。", "腐烂的对己伤害不致死。"], "granted_by": "", "upgrades": {"scepter": {"zh": "腐烂的作用范围提升%bonus_rot_radius%，伤害提升%bonus_rot_damage%点，并且可以降低敌人的%scepter_rot_regen_reduction_pct%%%生命回复。", "en": "Increases Rot radius by %bonus_rot_radius%, damage by %bonus_rot_damage%, and causes it to reduce enemy Health Restoration by %scepter_rot_regen_reduction_pct%%%."}}, "is_passive": false, "value_names": ["rot_radius", "rot_tick", "rot_slow", "rot_damage", "scepter_rot_regen_reduction_pct"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "channel_interrupt", "condition": "base"}, {"mechanism": "heal_reduction", "condition": "scepter"}, {"mechanism": "invisibility", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "pudge_flesh_heap", "name_zh": "帕吉·肉盾", "name_en": "Meat Shield", "description_zh": "帕吉用一层血肉包裹自己，可以格挡所有来源的所有类型伤害。", "description_en": "Pudge covers himself with a layer of flesh that blocks damage of any type taken from any source.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_block", "duration", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "damage_block", "condition": "base"}]}, {"subject": "pudge_dismember", "name_zh": "帕吉·肢解", "name_en": "Dismember", "description_zh": "持续施法 - 帕吉撕咬一个敌方单位，使其失去行动能力并受到持续伤害。伤害量为基础伤害加上帕吉力量值的一定百分比，帕吉将回复与伤害量相等的生命。帕吉会将该单位以每秒%pull_units_per_second%的速度向自身牵引，最多牵引%pull_distance_limit%距离。", "description_en": "CHANNELED - Pudge chows down on an enemy unit, disabling it and dealing damage over time. Damage is increased by Pudge's Strength and heals him for the total amount. Pudge pulls the unit at a rate of %pull_units_per_second% units, up to a minimum of %pull_distance_limit% range.", "notes_zh": ["即使肢解的目标在受到作用的过程中隐身，还是不会脱离肢解的作用。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["dismember_damage", "strength_damage", "ticks", "pull_units_per_second", "pull_distance_limit", "animation_rate", "shard_regen_pct", "order_lock_duration", "shard_cast_range", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "displace_other", "condition": "base"}, {"mechanism": "healing", "condition": "base"}, {"mechanism": "invisibility", "condition": "base"}]}, {"subject": "razor_plasma_field", "name_zh": "雷泽·等离子场", "name_en": "Plasma Field", "description_zh": "释放一波威力随扩张程度提升的等离子能量场，收缩时也会对经过的敌人造成伤害和减速。距离雷泽越远，伤害和减速越高。等离子场对每个单位造成两次伤害。", "description_en": "Releases a wave of energetic plasma that grows in power as it expands, but also zaps on contraction, slowing and dealing damage to enemy units caught in its path. Damage and slow increases with distance from Razor. The Plasma Field hits each unit twice, once each direction.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_min", "damage_max", "radius", "total_ability_time", "slow_min", "slow_max", "slow_duration", "second_ring_delay", "second_ring_reduction", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "razor_storm_surge", "name_zh": "雷泽·风暴涌动", "name_en": "Storm Surge", "description_zh": "被攻击时拥有几率、每次受到指向性技能时都会释放一道叉状闪电，击中目标和附近其他敌人，优先打击与目标类型相同的单位，造成伤害并减缓移动速度。", "description_en": "There's a chance when attacked, and always when targeted with a spell, to release a forked lightning that strikes the target and other nearby enemies, prioritizing the unit type of the attacker, dealing damage and slowing movement speed.", "notes_zh": ["这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {"shard": {"zh": "风暴之眼开启时，打击几率为%eye_of_the_storm_chance_multiplier%倍，打击冷却时间减少%strike_cd_reduction_during_storm%秒，而且闪电会打击风暴之眼范围内所有敌人。单次伤害不会对同个敌人施加两次。", "en": "While Eye of the Storm is active, strike chance is %eye_of_the_storm_chance_multiplier%x as high, strike cooldown is reduced by %strike_cd_reduction_during_storm%s, and Lightning strikes all enemies within Eye of the Storm's radius. Does not apply to the same enemy twice from a single instance."}}, "is_passive": true, "value_names": ["strike_pct_chance", "strike_target_count", "strike_damage", "strike_move_slow_pct", "strike_slow_duration", "strike_search_radius", "strike_internal_cd", "strike_cd_reduction_during_storm", "hit_targets_inside_eye_of_the_storm", "eye_of_the_storm_chance_multiplier"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "damage_return", "condition": "base"}, {"mechanism": "slow", "condition": "base"}, {"mechanism": "spell_reflect", "condition": "base"}]}, {"subject": "razor_eye_of_the_storm", "name_zh": "雷泽·风暴之眼", "name_en": "Eye of the Storm", "description_zh": "强大的闪电风暴，打击生命值最低的敌方单位，造成伤害并削弱护甲。", "description_en": "A powerful lightning storm strikes out at the enemy unit with the lowest health, dealing damage and reducing armor.", "notes_zh": ["每次打击都会以范围内血量最低的敌方单位为目标。", "风暴之眼优先打击受到静电连接作用的英雄。", "连续施放的风暴之眼可以叠加。"], "granted_by": "", "upgrades": {"scepter": {"zh": "风暴之眼可以同时打击两个目标，并且能对建筑造成伤害。打击建筑时，只会以防御塔、兵营和遗迹作为目标。", "en": "Causes Eye of the Storm to strike two different units instead of one and can damage structures. When striking buildings, it will only target towers, barracks, and the Ancient."}}, "is_passive": false, "value_names": ["radius", "duration", "strike_interval", "armor_reduction", "damage", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "armor_reduction", "condition": "base"}]}, {"subject": "sandking_burrowstrike", "name_zh": "沙王·掘地穿刺", "name_en": "Burrowstrike", "description_zh": "沙王钻入地面挖掘隧道前进，穿出地面时伤害并眩晕上方的敌方单位。对击中的英雄施加腐尸毒。可以设为多样施法（右键点击技能栏图标），直接朝指定方向立刻施放，不需要走向目标地点。", "description_en": "Sand King burrows into the ground and tunnels forward, damaging and stunning enemy units above him as he resurfaces. Adds Caustic Finale poison to heroes hit Can be put on alt-cast to immediately cast in the desired direction, without walking towards the targeted location.", "notes_zh": ["不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["burrow_width", "burrow_duration", "burrow_speed", "burrow_anim_time", "AbilityDamage", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "spell_block", "condition": "base"}, {"mechanism": "spell_reflect", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "sandking_sand_storm", "name_zh": "沙王·沙尘暴", "name_en": "Sand Storm", "description_zh": "沙王制造一起可怕的沙尘暴，对敌方单位造成伤害，同时沙王身处其中时获得隐身效果。沙王离开该区域后效果结束。", "description_en": "Sand King creates a fearsome sandstorm that damages enemy units and grants Sand King Invisibility while he is in it. The effect ends when Sand King leaves the area.", "notes_zh": ["沙尘暴可以用来躲避攻击和技能弹道。", "沙王在沙尘暴中攻击或使用技能会暂时显形。%fade_delay%秒后将再次隐形。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_tick_rate", "sand_storm_radius", "sand_storm_damage", "fade_delay", "blind_pct", "sand_storm_slow", "AbilityDuration", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "invisibility", "condition": "base"}, {"mechanism": "projectile_dodge", "condition": "base"}, {"mechanism": "reveal", "condition": "base"}]}, {"subject": "sandking_scorpion_strike", "name_zh": "沙王·尾刺", "name_en": "Stinger", "description_zh": "沙王袭击一片区域，对范围内所有敌人发动一次攻击，对每个敌人造成额外伤害。最中心%inner_radius%范围内敌人将受到%inner_radius_bonus_damage_pct%%%额外伤害。对所有击中的敌人施加腐尸毒和减速效果。", "description_en": "Sand King strikes an area, performing an attack on all enemies in the area of effect, dealing extra damage to each. Enemies within an innermost radius of %inner_radius% take %inner_radius_bonus_damage_pct%%% extra damage. Applies Caustic Finale and a slow to all enemies hit.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "inner_radius", "inner_radius_bonus_damage_pct", "attack_damage", "debuff_duration", "strike_slow", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "sandking_epicenter", "name_zh": "沙王·地震", "name_en": "Epicenter", "description_zh": "经过%abilitycastpoint%秒施法前摇后，沙王向地中发送扰动，引起大地剧烈震动。所有范围内的敌人会受到伤害并被减速。每次后续震波都会提高伤害传播半径。", "description_en": "After a cast point of %abilitycastpoint% seconds, Sand King sends a disturbance into the earth, causing it to shudder violently. All enemies caught within range will take damage and become slowed. Each subsequent pulse increases the radius of damage dealt.", "notes_zh": ["地震波将以沙王为中心，而不是他施放技能的地点。"], "granted_by": "", "upgrades": {"scepter": {"zh": "地震的脉冲开始时每%spine_tick_rate%秒会在随机地点产生%scepter_explosions_per_pulse%片尾刺的攻击区域，每片区域为地震当前范围的%scepter_explosion_radius_pct%%%，对击中的敌人造成%spine_damage_pct%%%尾刺伤害。魔晶的地震波会产生%shard_explosions_per_pulse%次攻击。", "en": "When the pulses start, %scepter_explosions_per_pulse% Stinger attack areas are created every %spine_tick_rate%s at random locations, each measuring %scepter_explosion_radius_pct%%% of the Epicenter's current radius, that apply %spine_damage_pct%%% of Stinger damage to enemies hit. Shard pulses cause %shard_explosions_per_pulse% attack(s)."}, "shard": {"zh": "每%shard_interval%秒会在沙王身上产生一个较小的地震波。", "en": "Every %shard_interval%s causes a small single Epicenter Pulse around Sand King."}}, "is_passive": false, "value_names": ["epicenter_pulses", "epicenter_damage", "epicenter_radius_base", "epicenter_radius_increment", "epicenter_slow", "epicenter_slow_as", "proc_passively", "shard_radius", "shard_interval", "linger_duration", "scepter_explosion_radius_pct", "scepter_explosion_min_dist", "scepter_explosions_per_pulse", "spine_tick_rate", "spine_damage_pct"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "storm_spirit_static_remnant", "name_zh": "风暴之灵·残影", "name_en": "Static Remnant", "description_zh": "风暴之灵制造一个充满爆炸性能量的自身残影，会向目标地点走去，持续%abilityduration%秒。如果有人接近就会引爆造成伤害，残影持续%abilityduration%秒。", "description_en": "Creates an explosively charged image of Storm Spirit that walks to the target position and lasts for %abilityduration% seconds. Will detonate and deal damage if an enemy unit comes near it.", "notes_zh": ["残影在技能施放%static_remnant_delay%秒后才能实体化。", "残影在持续时间内拥有顺畅视野。", "残影爆炸将伤害%static_remnant_damage_radius%码作用范围内的单位，但是触发范围是%static_remnant_radius%码。", "可以对自身施放，这样会原地施放。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["static_remnant_radius", "static_remnant_damage_radius", "static_remnant_delay", "static_remnant_damage", "is_point_targeted", "static_remnant_travel_speed", "static_remnant_vision_radius_day", "static_remnant_vision_radius_night", "AbilityCastRange", "AbilityDuration", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}]}, {"subject": "storm_spirit_electric_vortex", "name_zh": "风暴之灵·电子涡流", "name_en": "Electric Vortex", "description_zh": "将一个敌人拖到风暴之灵所在位置的涡流。", "description_en": "A vortex that pulls an enemy unit to Storm Spirit's location.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "电子涡流变成范围型技能，可以作用于风暴之灵周围所有敌人。", "en": "Electric Vortex affects all enemies within a radius around Storm Spirit."}}, "is_passive": false, "value_names": ["electric_vortex_pull_distance", "electric_vortex_pull_tether_range", "electric_vortex_self_slow", "electric_vortex_self_slow_duration", "radius_scepter", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "displace_other", "condition": "base"}]}, {"subject": "storm_spirit_overload", "name_zh": "风暴之灵·超负荷", "name_en": "Overload", "description_zh": "施法时会产生电荷，在风暴之灵下次攻击时被释放，对附近敌人造成伤害并减速。", "description_en": "Casting a spell creates an electrical charge, which is released in a burst on Storm's next attack, dealing damage and slowing nearby enemies.", "notes_zh": ["使用物品不会触发超负荷。", "超负荷效果不会叠加。"], "granted_by": "", "upgrades": {"shard": {"zh": "施放后风暴之灵和附近友方英雄获得%shard_activation_charges%次超负荷效果。提供额外攻击速度。持续最多%shard_activation_duration%秒，或效果用尽。", "en": "Can be activated to grant Storm Spirit and nearby allied heroes %shard_activation_charges% Overload charges. Provides bonus Attack Speed. Lasts up to %shard_activation_duration% seconds or until the charges are depleted."}}, "is_passive": true, "value_names": ["overload_aoe", "overload_move_slow", "overload_attack_slow", "overload_damage", "shard_activation_radius", "shard_activation_charges", "shard_activation_duration", "shard_manacost", "shard_cooldown", "shard_attack_speed_bonus", "overload_bounces", "overload_damage_pct", "AbilityDuration"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "charges", "condition": "shard"}, {"mechanism": "slow", "condition": "base"}]}]}
