cription_en": "Throws a flare towards an enemy, dealing damage, teleporting them away, rooting them and reducing their Cast and Attack Range for %debuff_duration% seconds.The target is teleported further the closer they are to Tinker.", "notes_zh": ["最大传送距离为%warp_distance_pct_tooltip%%%折跃耀光施法距离，在最大施法距离时降至0。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["damage", "max_distance", "warp_distance_factor", "warp_distance_pct_tooltip", "range_reduction", "debuff_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "root", "condition": "shard"}, {"mechanism": "self_mobility", "condition": "shard"}]}]}
