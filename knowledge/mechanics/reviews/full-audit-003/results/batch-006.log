age", "condition": "base"}, {"mechanism": "cleave", "condition": "shard"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "enigma_demonic_conversion", "name_zh": "谜团·恶魔召唤", "name_en": "Demonic Summoning", "description_zh": "以生命为代价召唤三个谜团自身的碎片。虚灵的生命值会有所增加，数值为谜团当前生命值的%current_health_pct%%%。这些虚灵都由谜团控制，在反复经过几次成功的攻击后，虚灵会再次分裂，并完全回复生命值。", "description_en": "Summons three fragments of Enigma himself at the cost of health.  The eidolons health is increased by %current_health_pct%%% of Enigma's current health. These eidolons are all under Enigma's control, and repeated successful attacks cause them to multiply.  When this happens, the eidolons have their health restored.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["spawn_count", "split_attack_count", "eidelon_max_health", "life_extension", "eidelon_base_damage", "eidolon_damage_spread", "eidolon_bonus_damage", "eidolon_bonus_attack_speed", "eidelon_base_movespeed", "creep_max_level", "eidolon_magic_resist", "eidolon_attack_range", "allied_damage_pct", "self_modelscale", "spawn_offset"], "judge": [{"mechanism": "cleave", "condition": "base"}]}, {"subject": "enigma_midnight_pulse", "name_zh": "谜团·午夜凋零", "name_en": "Midnight Pulse", "description_zh": "使一块区域浸入暗共振中，对敌方单位造成%base_damage% + 基于敌人当前生命值的伤害。", "description_en": "Steeps an area in dark resonance, dealing %base_damage% + a percentage of the enemies current HP as damage.", "notes_zh": ["此技能将摧毁范围内的树木。", "多个午夜凋零的效果不会叠加。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "base_damage", "damage_percent", "duration", "tick_rate", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "tree_destroy", "condition": "base"}]}, {"subject": "enigma_black_hole", "name_zh": "谜团·黑洞", "name_en": "Black Hole", "description_zh": "持续施法 - 召唤一个强引力漩涡吸住敌方单位。被黑洞影响的单位不能移动、攻击或施法。", "description_en": "CHANNELED - Summons a vortex that sucks in nearby enemy units.  Enemies affected by Black Hole cannot move, attack, or cast spells.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "黑洞额外造成等同于单位%scepter_pct_damage%%%最大生命值的每秒伤害，并且产生一个%scepter_radius%范围，没有打断效果的牵引效果。牵引速度为%scepter_drag_speed%。", "en": "Black Hole deals additional damage equivalent to %scepter_pct_damage%%% of the unit's Max Health per second and does a non-interrupting pull towards it in a %scepter_radius% AoE. Pulls at a rate of %scepter_drag_speed%."}}, "is_passive": false, "value_names": ["damage", "radius", "pull_speed", "tick_rate", "duration", "vision_radius", "pull_rotate_speed", "animation_rate", "scepter_pct_damage", "scepter_radius", "scepter_drag_speed", "scepter_pull_rotate_speed", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint"], "judge": [{"mechanism": "channel_interrupt", "condition": "scepter"}, {"mechanism": "displace_other", "condition": "scepter"}, {"mechanism": "summons", "condition": "base"}]}, {"subject": "tinker_laser", "name_zh": "修补匠·激光", "name_en": "Laser", "description_zh": "发射强烈的能量光束，对目标造成伤害和致盲。被致盲的单位，所有物理攻击都会落空。", "description_en": "Fires an intense energy beam, damaging and blinding the target. Blinded targets miss all physical attacks.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "修补匠的激光升级成缩小射线，使主目标的模型大小、当前生命值和最大生命值减少%scepter_reduction_pct%%%（可以叠加）。", "en": "Upgrades Tinker's Laser into a Shrink Ray, reducing the main target's size, current health, and maximum health by %scepter_reduction_pct%%% (stacking). Does not pierce debuff immunity."}}, "is_passive": false, "value_names": ["miss_rate", "duration", "laser_damage", "radius_explosion", "splash_pct", "scepter_bonus_cast_range", "scepter_reduction_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "blind", "condition": "base"}]}, {"subject": "tinker_march_of_the_machines", "name_zh": "修补匠·机械行军", "name_en": "March of the Machine