 "vector_render_radius", "walk_speed", "turn_rate", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "invulnerable_untargetable", "condition": "base"}, {"mechanism": "sleep", "condition": "base"}]}, {"subject": "bane_fiends_grip", "name_zh": "祸乱之源·魔爪", "name_en": "Fiend's Grip", "description_zh": "持续施法 - 抓住一个敌方单位，使其失去行动能力并持续受到大量伤害，同时每%fiend_grip_tick_interval%秒按目标最大魔法值一定比例吸取魔法。", "description_en": "CHANNELED - Grips an enemy unit, disabling it and causing heavy damage over time, while stealing mana every %fiend_grip_tick_interval% seconds based on the unit's maximum mana.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "魔爪的冷却时间减少%bonus_AbilityCooldown%秒。魔爪将产生两个不可控制的幻象，幻象也将对目标持续施放魔爪。幻象承受%scepter_incoming_illusion_damage%%%伤害，并且被打断后立刻消失。伤害不会叠加。", "en": "Reduces Fiend's Grip cooldown by %bonus_AbilityCooldown%s. Fiend's Grip now creates two uncontrollable illusions that are also channeling Fiend's Grip on the target. Illusions take %scepter_incoming_illusion_damage%%% incoming damage and immediately die if they are interrupted. Damage does not stack."}}, "is_passive": false, "value_names": ["fiend_grip_tick_interval", "fiend_grip_mana_drain", "fiend_grip_damage", "illusion_count", "scepter_incoming_illusion_damage", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "channel_interrupt", "condition": "scepter"}, {"mechanism": "illusions", "condition": "scepter"}, {"mechanism": "mana_burn", "condition": "base"}, {"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "bane_ichor_of_nyctasha", "name_zh": "祸乱之源·妮塔莎脓血", "name_en": "Ichor of Nyctasha", "description_zh": "每次祸乱之源击杀敌方英雄，或者他们在祸乱之源的负面效果下阵亡，他们都会在游戏的剩余时间内获得一层恐惧的效果，使敌人对祸乱之源施加的负面状态的状态抗性减少。", "description_en": "Every time Bane kills an enemy hero or they die under the effect of Bane's debuff, they receive a Terror for the rest of the game that decreases their status resistance to Bane's subsequent debuffs.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_tick_rate", "max_terrors", "status_resistance"], "judge": [{"mechanism": "status_resistance", "condition": "base"}]}, {"subject": "bloodseeker_bloodrage", "name_zh": "血魔·血怒", "name_en": "Bloodrage", "description_zh": "使血魔陷入渴望鲜血的狂怒中，以每秒流失一定百分比生命的代价获得攻击速度和技能增强加成。", "description_en": "Drives Bloodseeker into a bloodthirsty rage which causes him to attack faster and deal more spell damage at the cost of a percentage of his health per second.", "notes_zh": ["对血魔造成的伤害不致死。"], "granted_by": "", "upgrades": {"shard": {"zh": "血怒下血魔的攻击现在造成%max_health_dmg_pct%%%目标最大生命值的纯粹伤害。", "en": "Bloodseeker's Bloodrage attacks now deal %max_health_dmg_pct%%% of the target's max health as Pure damage."}}, "is_passive": false, "value_names": ["duration", "attack_speed", "spell_amp", "damage_pct", "max_health_dmg_pct", "can_silence", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "spell_amp", "condition": "base"}]}, {"subject": "bloodseeker_blood_bath", "name_zh": "血魔·血祭", "name_en": "Blood Rite", "description_zh": "血魔用圣血为一片区域洗礼。%delay_plus_castpoint_tooltip%秒后祭祀完成，区域范围内所有敌人都会受到伤害，并被沉默。", "description_en": "Bloodseeker baptizes an area in sacred blood. After %delay_plus_castpoint_tooltip% seconds the ritual completes, causing any enemies caught in the area to take damage and become silenced.", "notes_zh": ["总时间为%delay%秒的施法时间加上%castpoint_tooltip%秒的生效延迟。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "silence_duration", "damage", "delay", "delay_plus_castpoint_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "silence", "condition": "base"}]}, {"subject": "bloodseeker_thirst", "name_zh": "血魔·焦渴", "name_en": "Thirst", "description_zh": "血魔能够感知到敌人的伤口中涌出的鲜血，敌方英雄的生命值低于%min_bonus_pct%%%，他的移动速度就会提升，而且生命值越低，提升效果越大。如果生命值低于%invis_threshold_pct%%%，他还将获得该英雄的视野和真实视域。焦渴的效果可以叠加。血魔可以突破最大速度限制。", "description_en": "Bloodseeker is invigorated by the wounds of his enemies, gaining bonus movement speed when an enemy hero's health falls below %min_bonus_pct%%%, with the bonuses increasing as their health falls further. If an enemy hero's health falls below %invis_threshold_pct%%%, he will also gain vision and True Sight of that hero. Bonuses stack per hero. Unlocks max movement speed for Bloodseeker.", "notes_zh": ["幻象不能触发该技能。", "移动速度加成在敌人生命值低于%max_bonus_pct%%%时达到上限。", "目标死亡后效果延续%linger_duration%秒。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["min_bonus_pct", "bonus_movement_speed", "active_movement_speed", "active_duration", "inactive_penalty_pct", "sanguivore_multiplier", "max_bonus_pct", "visibility_threshold_pct", "invis_threshold_pct", "linger_duration", "AbilityCastPoint", "AbilityManaCost"], "judge": [{"mechanism": "grant_vision", "condition": "base"}, {"mechanism": "invisibility", "condition": "base"}, {"mechanism": "true_sight", "condition": "base"}]}, {"subject": "bloodseeker_sanguivore", "name_zh": "血魔·食血动物", "name_en": "Sanguivore", "description_zh": "血魔每杀死一个单位都会回复部分生命，回复量为基础%base_heal%点加上该单位最大生命值的一定百分比。友军击杀了附近的敌方英雄时会回复半额数值。", "description_en": "Bloodseeker restores some life when he kills a unit, equal to %base_heal% health plus a percentage of the units max health.Restores for half values if an ally kills a nearby enemy hero.", "notes_zh": ["非英雄单位的吸血效果减少%creep_lifesteal_reduction_pct%%%。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["base_heal", "heal_hp_pct", "creep_lifesteal_reduction_pct", "half_bonus_aoe", "barrier_decay_pct", "max_shield_pct", "pure_damage_lifesteal_pct", "AbilityCastPoint"], "judge": [{"mechanism": "healing", "condition": "base"}]}, {"subject": "bloodseeker_rupture", "name_zh": "血魔·割裂", "name_en": "Rupture", "description_zh": "让一个敌方单位皮开肉绽，根据其当前生命值造成初始伤害。单位移动后会根据移动的距离受到伤害。", "description_en": "Causes an enemy unit's skin to rupture, dealing initial damage based on its current health. If the unit moves, it takes damage based on the distance moved.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "提升初始伤害，并且提供%AbilityCharges%点割裂能量点数。", "en": "Increases initial damage and grants %AbilityCharges% Rupture Charges."}}, "is_passive": false, "value_names": ["duration", "movement_damage_pct", "hp_pct", "damage_cap_amount", "knockback", "knockback_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "charges", "condition": "scepter"}]}, {"subject": "crystal_maiden_crystal_nova", "name_zh": "水晶室女·冰霜新星", "name_en": "Crystal Nova", "description_zh": "召唤具有破坏性的冰爆，降低目标区域内的敌人的移动速度。", "description_en": "A burst of damaging frost slows enemy movement in the targeted area.", "notes_zh": ["冰霜新星在持续时间内提供目标区域的视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "movespeed_slow", "attackspeed_slow", "duration", "vision_duration", "nova_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "crystal_maiden_frostbite", "name_zh": "水晶室女·冰封禁制", "name_en": "Frostbite", "description_zh": "操控冰霜包围一个敌方单位，禁止移动和攻击，并持续造成伤害。对非远古的普通单位施放将造成%creep_multiplier%倍伤害。", "description_en": "Encases an enemy unit in ice, prohibiting movement and attack, while dealing damage over time. Deals %creep_multiplier%x damage to non-ancient creeps.", "notes_zh": ["冰封禁制为捆缚效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "duration", "creep_multiplier", "tick_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "root", "condition": "base"}]}, {"subject": "crystal_maiden_brilliance_aura", "name_zh": "水晶室女·奥术光环", "name_en": "Arcane Aura", "description_zh": "地图上所有友方单位获得额外魔法恢复。水晶室女附近%proximity_bonus_radius%范围内友军获得更高的魔法恢复。水晶室女被动获得魔法恢复增强。", "description_en": "Gives mana regeneration to all friendly units on the map. Allies within a %proximity_bonus_radius% radius of Crystal Maiden receive more mana regeneration.Crystal Maiden passively gains mana regen amplification.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["base_mana_regen", "proximity_mana_regen_tooltip", "mana_regen_amp", "proximity_bonus_factor", "proximity_bonus_radius"], "judge": [{"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "crystal_maiden_crystal_clone", "name_zh": "水晶室女·冰晶克隆", "name_en": "Crystal Clone", "description_zh": "向一个方向滑行，在原地制造一个自身的冰晶克隆，并且躲避多种飞行过程中的攻击和技能弹道。如果克隆受到了足量伤害，或者超过一定时间都会碎裂，对附近%frostbite_radius%范围内敌人施加冰封禁制。克隆体也可以被水晶室女自身的技能摧毁。", "description_en": "Slides in a direction, creating a crystal clone of herself in her place and disjointing incoming projectiles. If the clone takes enough damage or times out, it shatters, Frostbiting enemies in a %frostbite_radius% AoE around its place. The Clone can also be destroyed by Crystal Maiden's own spells.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["hop_distance", "hop_duration", "clone_duration", "frostbite_radius", "anim_delay", "clone_health", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "flying", "condition": "shard"}, {"mechanism": "projectile_dodge", "condition": "shard"}]}, {"subject": "crystal_maiden_glacial_guard", "name_zh": "水晶室女·冰川护体", "name_en": "Glacial Guard", "description_zh": "水晶室女消耗在她技能上的一部分魔法会转化为物理护盾。", "description_en": "A portion of the mana Crystal Maiden spends on her abilities is converted into a physical barrier.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["mana_multiplier", "barrier_duration"], "judge": [{"mechanism": "damage_block", "condition": "base"}]}, {"subject": "crystal_maiden_freezing_field", "name_zh": "水晶室女·极寒领域", "name_en": "Freezing Field", "description_zh": "持续施法 - 以水晶室女为中心召唤%num_explosions%次随机冰爆轰炸敌人，将其减速并造成大量伤害。持续%abilitychanneltime%秒。", "description_en": "CHANNELED - Surrounds Crystal Maiden with %num_explosions% random icy explosions that slow enemies and deal massive damage. Lasts %abilitychanneltime% seconds.", "notes_zh": ["减速效果对作用范围内所有敌人有效，即使他们没有受到冰爆的伤害（效果持续%slow_duration%秒）。", "每%explosion_interval_tooltip%秒产生一次爆炸。"], "granted_by": "", "upgrades": {"scepter": {"zh": "使自身在极寒领域期间可以移动、施法和攻击。仍然可以被敌人打断。在此期间移动速度降低%shard_self_movement_speed_slow_pct%%%。冰爆总数提升%shard_bonus_explosion%%%。对极寒领域内停留超过%frostbite_delay%秒的所有单位都会施加冰封禁制。", "en": "Allows you to move, cast and attack during Freezing Field. Can still be interrupted by enemies. You move %shard_self_movement_speed_slow_pct%%% slower during this. Increases total number of explosions by %shard_bonus_explosion%%%. Applies Frostbite to any unit that has been standing in the Freezing Field for over %frostbite_delay%s."}}, "is_passive": false, "value_names": ["radius", "explosion_radius", "explosion_interval_tooltip", "num_explosions", "movespeed_slow", "attack_slow", "slow_duration", "explosion_min_dist", "explosion_max_dist", "damage", "frostbite_delay", "shard_bonus_explosion", "shard_self_movement_speed_slow_pct", "can_move", "AbilityChannelTime"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "channel_interrupt", "condition": "scepter"}, {"mechanism": "slow", "condition": "base"}]}]}
