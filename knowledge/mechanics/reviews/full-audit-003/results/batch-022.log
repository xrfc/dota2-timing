, "heal_amp", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "heal_reduction", "condition": "shard"}, {"mechanism": "healing", "condition": "shard"}]}, {"subject": "oracle_false_promise", "name_zh": "神谕者·虚妄之诺", "name_en": "False Promise", "description_zh": "暂时篡改队友的命运，技能期间受到的任何治疗和伤害效果将在虚妄之诺结束后结算，其中治疗效果结算时效果更强。施放时将移除目标身上大部分的负面状态效果。\n\n驱散类型：强驱散", "description_en": "Temporarily alters an ally's destiny, delaying any healing or damage taken until False Promise ends. Any healing that is delayed by False Promise is amplified. Removes most negative status effects and disables on initial cast.\n\nDISPEL TYPE: Strong Dispel", "notes_zh": ["伤害和治疗效果虽然被延缓结算，但是结算时依然会考虑护甲和魔法抗性的减免。", "经过延缓的伤害和治疗效果在目标失去本技能效果后立刻结算。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "radius", "bonus_armor", "heal_amp_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "applies_strong_dispel", "condition": "base"}, {"mechanism": "damage_block", "condition": "base"}, {"mechanism": "healing", "condition": "base"}, {"mechanism": "magic_resist_reduction", "condition": "base"}]}, {"subject": "oracle_prognosticate", "name_zh": "神谕者·预言", "name_en": "Prognosticate", "description_zh": "神谕者将预测并对友军宣布，下个强化神符出现的地点（上路或下路），以及肉山的准确复活时间。", "description_en": "Oracle will predict and announce to allies, where the next power rune will spawn (top or bottom) as well as Roshan's exact respawn time.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": [], "judge": [{"mechanism": "respawn", "condition": "base"}]}, {"subject": "techies_sticky_bomb", "name_zh": "工程师·粘性炸弹", "name_en": "Sticky Bomb", "description_zh": "向目标区域抛出一个粘性炸弹。如果炸弹落在一个敌方英雄身旁，炸弹会粘上去，减缓其移动速度。数秒后炸弹会爆炸，对爆炸区域内造成伤害，并再次施加减速，持续%secondary_slow_duration%秒。", "description_en": "Lobs a Sticky Bomb towards the target area. If it lands next to an enemy hero, the bomb will stick to it, slowing its movement speed. After a few seconds the bomb will explode, dealing damage in an area around the detonation and applying a secondary slow for %secondary_slow_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "countdown", "radius", "damage", "slow", "secondary_slow", "secondary_slow_duration", "explosion_radius", "speed", "acceleration", "pre_chase_time", "max_chase_time", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "techies_reactive_tazer", "name_zh": "工程师·活性电击", "name_en": "Reactive Tazer", "description_zh": "工程师对友军目标放出电荷，使他们短时间内获得移动速度加成。攻击目标的敌人会受到伤害被暂时缴械，并且受到弱驱散效果。效果结束时，或者用子技能提前引爆后电荷将会爆炸，使范围内所有敌人缴械并受到伤害。", "description_en": "Techies trigger an electric charge on the target ally, giving them bonus movement speed for a short period of time. Enemies attacking the target take damage and are temporarily disarmed and get a Basic Dispel.At the end of the effect or if detonated early with the sub-ability, the charge explodes, disarming all enemies within the radius and dealing damage.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "disarm_duration", "bonus_ms", "explosion_radius", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "applies_basic_dispel", "condition": "base"}, {"mechanism": "charges", "condition": "base"}, {"mechanism": "disarm", "condition": "base"}]}, {"subject": "techies_suicide", "name_zh": "工程师·爆破起飞！", "name_en": "Blast Off!", "description_zh": "工程师冲到敌人中间，在相遇时引爆炸药，造成大量范围伤害，并眩晕敌人。引爆时会对工程师造成当前生命值一定百分比的非致死伤害。", "description_en": "Techies hurtle themselves into the enemy's midst, detonating charges upon impact which deal massive area of effect damage and stun enemies. Upon landing, the assault deals Techies non-lethal damage equal to a percentage of their current health.", "notes_zh": ["工程师在此次爆炸中受到的自身伤害为纯粹伤害，而且不会致死。", "此技能将摧毁树木。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage", "stun_duration", "hp_cost", "duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "charges", "condition": "base"}, {"mechanism": "stun", "condition": "base"}, {"mechanism": "tree_destroy", "condition": "base"}]}, {"subject": "techies_mutually_assured_destruction", "name_zh": "工程师·同归于尽", "name_en": "M.A.D.", "description_zh": "工程师获得相当于最大魔法值一定百分比的魔法恢复。工程师阵亡时，他们会留下一个木桶，在%explosion_delay%秒后爆炸，对范围内敌人造成伤害。伤害数值是根据工程师的最大魔法值。", "description_en": "Techies gain a percentage of their mana pool as bonus mana regeneration.When Techies die, they leave behind a barrel that explodes after %explosion_delay%s, damaging enemies in an area around it. Damage is based on Techies' max mana.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "同归于尽变为主动技能。提升最大魔法值的伤害系数。工程师放置同归于尽木桶后，可以使用子技能手动引爆。同一时间主动技能只能放下一个同归于尽木桶。", "en": "M.A.D. becomes an active ability. Increases max mana as damage amount. Techies plant an M.A.D. which can be detonated manually with a sub-ability. Only one M.A.D. from the active ability can be placed at a time."}}, "is_passive": true, "value_names": ["bonus_mana_as_mana_regen", "radius", "base_damage", "max_mana_pct_as_damage", "current_mana_regen", "current_damage", "explosion_delay", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "techies_minefield_sign", "name_zh": "工程师·雷区标识", "name_en": "Minefield Sign", "description_zh": "在指定地点放置警示牌，使作用范围内的感应地雷为无敌状态，并且造成的伤害增加%bonus_mine_damage_pct%%%。同一时间只能存在一个标识。持续%lifetime%秒。敌方英雄进入标识的%trigger_radius%范围内时标识附近整个%aura_radius%范围变成一片雷区，持续%minefield_duration%秒。敌方单位在区域内移动都会受到伤害。雷区持续时间结束后标识会被摧毁。", "description_en": "Plant a warning sign, causing Proximity Mines within its radius to be invulnerable and deal %bonus_mine_damage_pct%%% more damage. Only one sign can exist at a time. Lasts %lifetime% seconds.When an enemy Hero walks within %trigger_radius% units of a minefield sign, the %aura_radius% units area around the sign will become a minefield for %minefield_duration% seconds, dealing damage to enemy Heroes any time they move within its area. Minefield Sign is destroyed after this effect ends.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["aura_radius", "lifetime", "minefield_duration", "trigger_radius", "scepter_move_damage", "scepter_move_amt", "bonus_mine_damage_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "invulnerable_untargetable", "condition": "scepter"}]}, {"subject": "techies_land_mines", "name_zh": "工程师·感应地雷", "name_en": "Proximity Mines", "description_zh": "埋布隐形的地雷，不会被真实视域检测到，但是有敌方单位在地雷的%radius%生效范围内会显形。敌人在生效范围内停留超过%proximity_threshold%秒会使地雷爆炸，并且魔法抗性会被暂时降低。爆炸对%min_distance%范围内目标造成全额伤害，对边缘造成的伤害减少至%outer_damage%%%。对建筑物造成%building_damage_pct%%%伤害。", "description_en": "Plant an invisible mine that cannot be detected by True Sight, but is visible if an enemy is within the active %radius% AoE of the mine. Mines detonate if an enemy is standing within the active AoE for %proximity_threshold% seconds dealing damage and temporarily reducing the enemy's Magic Resistance. The explosion deals full damage if the target is within %min_distance% radius and decreases down to %outer_damage%%% on the edge. Deals %building_damage_pct%%% damage to buildings.", "notes_zh": ["感应地雷的%placement_radius%范围内不能再放置地雷。", "感应地雷不会阻止中立生物产生。", "地雷持续时间没有上限，除非爆炸或被摧毁。", "隐形单位也能触发地雷。", "敌方英雄将地雷摧毁可以获得30金钱。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "proximity_threshold", "damage", "building_damage_pct", "activation_delay", "cast_range_scepter_bonus", "outer_damage", "min_distance", "placement_radius", "mres_reduction", "burn_duration", "AbilityCastRange", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "economy", "condition": "base"}, {"mechanism": "reveal", "condition": "base"}]}, {"subject": "winter_wyvern_arctic_burn", "name_zh": "寒冬飞龙·严寒烧灼", "name_en": "Arctic Burn", "description_zh": "寒冬飞龙乘着一股极地寒风扶摇而上，移动将无视地形，每次攻击都将呼出逼人的寒气。高飞时，她的攻击距离更远，攻击弹道速度也更快，被攻击的敌人在寒意作用下，移动速度会被减缓，同时每秒损失%percent_damage%%%当前生命值。", "description_en": "Winter Wyvern soars upon an arctic wind, granting her unobstructed movement and allowing her to exhale a blistering chill into each attack. While soaring, her attacks travel further and faster, and slow enemies with a magical freeze that strips them of %percent_damage%%% of their current health each second.", "notes_zh": ["本技能无法作用于肉山。", "寒冬飞龙的攻击前摇降低至%attack_point%秒。", "严寒烧灼的持续伤害和减速可以被驱散。"], "granted_by": "", "upgrades": {"scepter": {"zh": "严寒烧灼变成开关型技能，开启后每秒消耗一定量魔法。提升寒冬飞龙的移动速度。", "en": "Causes Arctic Burn to be a toggle ability, draining mana every second when active. Increases Winter Wyvern's movement speed."}}, "is_passive": false, "value_names": ["duration", "attack_range_bonus", "percent_damage", "tick_rate", "damage_duration", "move_slow", "projectile_speed_bonus", "tree_destruction_radius", "attack_point", "max_attacks", "mana_cost_scepter", "movement_scepter", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "mana_burn", "condition": "scepter"}, {"mechanism": "mana_gain", "condition": "scepter"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "winter_wyvern_splinter_blast", "name_zh": "寒冬飞龙·碎裂冲击", "name_en": "Splinter Blast", "description_zh": "向一个单位发射一团易碎的冰球。冰球一击中目标就会碎裂，而目标单位将不会受到任何效果，但是附近%split_radius%基础范围内敌人都将因碎片的冲击受到伤害，并且移动速度减缓%movespeed_slow_tooltip%%%。", "description_en": "Launches a ball of brittle ice toward a unit. The ice shatters on impact, leaving the primary target completely unaffected, while hurling damaging splinters into nearby enemies in a %split_radius% base radius. Enemies struck by these splinters are slowed by %movespeed_slow_tooltip%%%.", "notes_zh": ["主弹道的移动速度为%projectile_speed%。", "主弹道无法被躲避，而且不能以寒冬飞龙自身为目标。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["projectile_speed", "projectile_max_time", "split_radius", "bonus_movespeed", "movespeed_slow_tooltip", "slow_duration", "secondary_projectile_speed", "damage", "stun_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "winter_wyvern_cold_embrace", "name_zh": "寒冬飞龙·极寒之拥", "name_en": "Cold Embrace", "description_zh": "将队友封入一个冰茧中，使其被冻在原地并恢复生命值，恢复数值为基础数值加上最大生命值的一定比例。冰茧将阻隔一切物理伤害。", "description_en": "Encases an ally in an icy cocoon, freezing them solid while healing a base amount as well as a percentage of their maximum health each second. The cocoon blocks all physical damage.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "冷却时间减少%shard_cooldown_reduction%秒。友方单位从冰茧解冻后获得额外攻击力。", "en": "Reduces cooldown by %shard_cooldown_reduction% seconds. Allied units gain bonus attack damage when emerging from the icy cocoon."}}, "is_passive": false, "value_names": ["duration", "heal_additive", "heal_percentage", "shard_cooldown_reduction", "tick_interval", "can_target_buildings", "damage_buff_pct", "damage_buff_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "healing", "condition": "base"}]}, {"subject": "winter_wyvern_winters_curse", "name_zh": "寒冬飞龙·寒冬诅咒", "name_en": "Winter's Curse", "description_zh": "寒冬飞龙驱散一个敌方目标并将其冻在原地，附近的其他敌人将受到癫狂诅咒，对冻住的队友进行攻击，而且攻击速度得到提升。冻住的目标和被诅咒攻击队友的敌人不会受到任何来自敌方的伤害，不过寒冬飞龙或她控制的单位造成的伤害除外。敌方英雄进入施放后的诅咒范围内会增加诅咒的持续时间。", "description_en": "Winter Wyvern dispells then freezes an enemy in place while striking those nearby with a maddening curse which causes them to attack their frozen ally with increased attack speed. The frozen ally and those cursed to attack their ally are immune to all damage from their enemies with the exception of damage from Winter Wyvern or her controlled units. Enemy heroes which enter the cursed area after the cast add to the duration of the curse.", "notes_zh": ["如果目标被其队友击杀，击杀者将仍是寒冰飞龙。", "无视主目标的减益免疫状态，但是对目标周围的减益免疫队友无效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage_reduction", "bonus_attack_speed", "duration", "max_duration", "bonus_duration_per_hero", "bonus_duration_per_creep", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "debuff_immunity", "condition": "base"}]}, {"subject": "arc_warden_flux", "name_zh": "天穹守望者·乱流", "name_en": "Flux", "description_zh": "将不稳定的涡流能量灌注到落单敌人体内，造成持续伤害并减缓其移动速度。如目标周围有其他敌方单位 ，则不会造成伤害。", "description_en": "Infuses a lone enemy unit with swirling, volatile energy, dealing damage over time and slowing the target. The damage is not applied if another enemy unit is near the target.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "目标落单时乱流具有沉默效果，造成更高伤害，而且持续时间更长。", "en": "Flux silences when the target is alone, deals more damage, and lasts longer."}}, "is_passive": false, "value_names": ["duration", "search_radius", "think_interval", "damage_per_second", "move_speed_slow_pct", "applies_silence", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "silence", "condition": "scepter"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "arc_warden_magnetic_field", "name_zh": "天穹守望者·磁场", "name_en": "Magnetic Field", "description_zh": "天穹守望者制造一个充满磁能的圆形扭曲力场。磁场提供攻击速度加成，并且其中的友方单位可以闪避来自磁场外的攻击。磁场可以牵引神符，并且自动激活其中的神符。", "description_en": "Arc Warden generates a circular distortion field of magnetic energy. The Magnetic Field grants bonus attack speed and protects allied units within it by evading attacks coming from outside the field. The Magnetic Field pulls runes, and runes inside Magnetic Field automatically activate.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "attack_speed_bonus", "evasion_chance", "rune_pull_strength", "rune_pull_max_speed_as_multiplier_of_pull_strength", "rune_pull_falloff_multiplier", "rune_pull_radius", "rune_activate_radius_buffer", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "evasion", "condition": "base"}]}, {"subject": "arc_warden_spark_wraith", "name_zh": "天穹守望者·闪光幽魂", "name_en": "Spark Wraith", "description_zh": "召唤一个缓慢实体化的闪光怨灵萦绕在目标区域，直到有敌人进入范围。一旦有敌方单位进入范围，怨灵将贴近敌人自我熔化，造成魔法伤害并使目标减速。", "description_en": "Summons a Spark Wraith that slowly materializes and patrols a targeted area until an enemy comes within its range. Once a target has been found the wraith fuses with them, dealing magical damage and slowing the unit.", "notes_zh": ["闪光幽魂无法被躲避。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "move_speed_slow_pct", "base_activation_delay", "spark_damage_base", "wraith_speed_base", "ministun_duration", "think_interval", "wraith_vision_radius", "wraith_vision_duration", "maximum_targets", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "arc_warden_tempest_double", "name_zh": "天穹守望者·风暴双雄", "name_en": "Tempest Double", "description_zh": "天穹守望者将破碎的自我汇聚到一起，创造出自身的完美电子复制体。复制体可以使用天穹守望者的当前所有物品和基础技能，但是大部分消耗品以及死亡时会掉落的物品除外。复制体的物品和技能冷却时间会独立计算。复制体会逐渐失去自我意识，移动速度变慢，攻击准确度下降。", "description_en": "Briefly refocusing its fractured elements into a single form, the Arc Warden is able to create a perfect electrical duplication of itself. The duplicate can use all of Arc Warden's current items and spells, except most consumables and items that drop on death. The duplicate has separate item and ability cooldowns.The Tempest Double loses its sense of self and fractures over time, becoming slower and less accurate.", "notes_zh": ["复制体无法使用风暴双雄或刷新球。"], "granted_by": "", "upgrades": {"shard": {"zh": "风暴双雄产生时带有奥术、隐身和极速神符的效果，持续%rune_duration%秒。不会触发神符灌注。", "en": "The Tempest Double is infused with the bonuses of Arcane, Invisibility, and Haste Runes for %rune_duration%s when created.Does not trigger Runic Infusion."}}, "is_passive": false, "value_names": ["bounty", "bounty_gold", "bounty_xp", "duration", "max_blind_chance", "max_slow", "has_debuff", "rune_duration", "invis_rune", "arcane_rune", "haste_rune", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"], "judge": [{"mechanism": "blind", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}]}
