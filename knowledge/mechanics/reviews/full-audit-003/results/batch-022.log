          "condition_correct": true,
          "correct_condition": "base",
          "quote": "Each spirit can be launched independently at a targeted area of effect. Affected enemy units take damage over time",
          "reason_zh": "单只精灵发射后即可对目标区域内多个敌人造成伤害。"
        },
        {
          "mechanism": "flying",
          "condition": "base",
