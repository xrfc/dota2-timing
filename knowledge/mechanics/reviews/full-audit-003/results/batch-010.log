ect": "dazzle_poison_touch", "name_zh": "戴泽·剧毒之触", "name_en": "Poison Touch", "description_zh": "施放一股锥形的毒素，可以打击多个敌方单位。造成持续伤害和减速。每当目标受到戴泽的攻击，负面效果的持续时间都会刷新，减速效果也会提升。", "description_en": "Releases a cone of poison that strikes multiple enemy units. Deals damage over time and slows the targets. Anytime the targets get attacked by Dazzle, the debuff duration is refreshed and slow is increased.", "notes_zh": ["伤害格挡类技能不能减少该技能伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_radius", "end_radius", "end_distance", "targets", "damage", "slow", "projectile_speed", "duration", "bonus_slow", "attack_range_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "damage_block", "condition": "base"}, {"mechanism": "slow", "condition": "base"}, {"mechanism": "spell_amp", "condition": "base"}, {"mechanism": "spell_block", "condition": "base"}]}, {"subject": "dazzle_shallow_grave", "name_zh": "戴泽·薄葬", "name_en": "Shallow Grave", "description_zh": "友军身受薄葬的福佑，在其保护下不论受到多大的伤害都不会阵亡。对该友军的治疗效果在持续时间内也会根据其生命值得到增强。", "description_en": "An ally blessed with Shallow Grave, no matter how close to death, cannot die while under its protection. Healing on that ally is also amplified for the duration based on the hero's HP.", "notes_zh": ["在薄葬作用下生命值至少为1点，但是斧王的淘汰之刃还是可以斩杀目标英雄。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "fx_halo_height", "heal_amplify", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "death_prevention", "condition": "base"}, {"mechanism": "execute", "condition": "base"}, {"mechanism": "healing", "condition": "base"}]}, {"subject": "dazzle_shadow_wave", "name_zh": "戴泽·暗影波", "name_en": "Shadow Wave", "description_zh": "放出一道能量弧，可以瞬间跳跃至目标附近的队友，治疗的同时还将对附近的敌方单位造成伤害。施放暗影波时戴泽必定会享受到治疗效果。", "description_en": "Sends out a bolt of power that arcs between allies, healing them while damaging any enemy units standing nearby.  Dazzle is always healed by Shadow Wave.", "notes_zh": ["优先治疗友方英雄", "如果敌军附近有多个我方单位，那么他将受到多重暗影波的伤害。"], "granted_by": "", "upgrades": {"scepter": {"zh": "暗影波现在也可对敌人施放，在友军和敌人之间都可以弹跳。弹跳至敌人时，他们会受到伤害，并且治疗附近友军，数值为%scepter_heal_pct%%%平常治疗和伤害量。戴泽还会对暗影波弹跳到的每个敌人发动一次攻击。", "en": "Shadow Wave can now target and bounce between enemies in addition to allies. When bouncing to an enemy, they will take damage and heal nearby allies equal to %scepter_heal_pct%%% of the normal healing and damage values. Dazzle will also perform an attack against any enemy that Shadow Wave bounces to."}}, "is_passive": false, "value_names": ["bounce_radius", "damage_radius", "max_targets", "tooltip_max_targets_inc_dazzle", "damage", "scepter_heal_pct", "scepter_cd_increase", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "healing", "condition": "base"}, {"mechanism": "healing", "condition": "scepter"}]}, {"subject": "dazzle_innate_weave", "name_zh": "戴泽·编织", "name_en": "Weave", "description_zh": "戴泽的技能会对范围内友军和敌人同时施加编织，提升友军的护甲并减少敌人的护甲。本效果可以多次叠加。", "description_en": "Dazzle's abilities apply Weave to both allies and enemies they affect, increasing allied armor and reducing enemy armor. Multiple instances of this effect stack.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "对友军施加编织时，每层编织效果治疗%ally_heal%点。", "en": "Applying Weave to an ally heals them for %ally_heal% per stack of Weave."}}, "is_passive": true, "value_names": ["armor_change", "duration", "affects_allies", "affects_enemies", "heal_amplification_pct", "ally_multiplier", "enemy_multiplier", "ally_heal"], "judge": [{"mechanism": "armor_reduction", "condition": "base"}, {"mechanism": "healing", "condition": "shard"}]}, {"subject": "dazzle_nothl_projection", "name_zh": "戴泽·虚无投影", "name_en": "Nothl Projection", "description_zh": "戴泽的灵魂离开身体，穿过虚无之境变成无敌的幽灵，可以施放技能、攻击和使用物品，他的身体还留在这个世界，和灵魂之间存在着可见的连接。在灵魂形态下，戴泽的基础技能都已强化：剧毒之触带有妖术效果；薄葬结束时会治疗；暗影波的冷却时间变短。效果可以提前结束，效果结束时戴泽的灵魂会返回身体。", "description_en": "Dazzle departs his body, traveling through the Nothl Realm as an invulnerable spirit that can cast spells, attack, and use items, leaving his body behind in the world with a visible tether. While active, Dazzle's basic abilities are empowered: Poison Touch hexes enemies, Shallow Grave heals upon expiration, and Shadow Wave has a shorter cooldown. The effect can be ended early, and Dazzle returns to the body at the end.", "notes_zh": ["戴泽的灵魂离开身体超过%leash_start%距离后会被拉向身体。戴泽的灵魂移动得越远，拉力就越大。", "戴泽的灵魂不能攻击建筑。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["min_duration", "max_duration", "initial_travel_speed", "soul_return_time", "soul_return_min_speed", "leash_start", "base_leash_pull", "leash_increase", "poison_touch_hex", "shallow_grave_heal", "shadow_wave_cdr", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "displace_other", "condition": "base"}, {"mechanism": "invulnerable_untargetable", "condition": "base"}, {"mechanism": "mobility_lock", "condition": "base"}]}, {"subject": "rattletrap_battery_assault", "name_zh": "发条技师·弹幕冲击", "name_en": "Battery Assault", "description_zh": "向附近敌方单位随机射出高能弹片，造成小额魔法伤害和短暂眩晕。", "description_en": "Discharges high-powered shrapnel at random nearby enemy units, dealing minor magical damage and ministun.", "notes_zh": ["发条技师被控制后仍然有效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "overclocking_radius", "duration", "interval", "damage", "creep_damage_multiplier", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "rattletrap_power_cogs", "name_zh": "发条技师·能量齿轮", "name_en": "Power Cogs", "description_zh": "在发条技师周围形成一圈通电的齿轮，困住附近的单位。在外侧的敌人碰到齿轮会被电流震退，损失一定的生命和魔法。并且%mana_burn_as_damage_pct%%%损失魔法也会加入到伤害。一个齿轮发动过一次震击后就会报废。敌人攻击齿轮数次后可将其摧毁，而发条技师需要攻击一次会将齿轮推出%projectile_distance%距离。发条技师可以自由穿行齿轮，穿行时会使齿轮失效。", "description_en": "Forms a ring of energized cogs around Clockwerk, trapping any units that are near. Enemies outside the trap that touch a cog are knocked back, losing health and mana. Once a cog has delivered a shock, it will power down. Damage is increased by %mana_burn_as_damage_pct%%% of the mana burned. Cogs can be destroyed by enemy attacks, but Clockwerk can push them up to %projectile_distance% distance away with one hit. Clockwerk can move through the cogs freely, disabling them as he passes over.", "notes_zh": ["齿轮可以震退隐身单位。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage", "mana_burn", "mana_burn_as_damage_pct", "attacks_to_destroy", "push_length", "push_duration", "cogs_radius", "trigger_distance", "inside_cogs_distance_reduction", "extra_pull_buffer", "projectile_distance", "projectile_speed", "debuff_immune_inside_cogs", "push_duration_overclock"], "judge": [{"mechanism": "mana_burn", "condition": "base"}]}, {"subject": "rattletrap_rocket_flare", "name_zh": "发条技师·照明火箭", "name_en": "Rocket Flare", "description_zh": "向全地图范围内的指定区域发射照明弹。击中时对区域内敌人造成伤害和短暂减速。照明火箭提供%duration%秒击中区域的视野。", "description_en": "Fires a global range flare that explodes over a given area. Upon impact, enemies in the area take damage and are briefly slowed. Rocket flare provides vision over the impact area for %duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "speed", "damage", "slow_pct", "slow_duration", "projectile_vision_radius", "projectile_vision_duration", "projectile_vision_tick_rate", "true_sight", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "rattletrap_overclocking", "name_zh": "发条技师·超速运转", "name_en": "Overclocking", "description_zh": "使发条技师的所有技能变得强力：弹幕冲击：作用范围提升，并且可以作用于范围内所有敌人。能量齿轮：成型范围提升，并且发条技师靠近能量齿轮时护甲提升。照明火箭：伤害、视野和减速时间提升，并且发射时向目标两侧各额外发射一枚。发射钩爪：眩晕范围和时间均有提升。喷气背包：移动得更快。持续时间结束后发条技师的移动和攻击速度降到最低。", "description_en": "Supercharges Clockwerks abilities:Battery Assault: Increased radius and affects all enemies in its range.Power Cogs: Radius increased, and Clockwerk's armor while near Power Cogs is increased.Rocket Flares: Increased damage, vision and slow duration, and fire additional rockets to either side of the target.Hookshot: Stun radius and duration increased.Jetpack: Moves faster.Clockwerk's movement and attack speed becomes slowed to a crawl after the duration runs out.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["buff_duration", "debuff_duration", "bonus_armor_pct", "battery_assault_radius", "cogs_radius", "hookshot_radius_bonus_pct", "hookshot_duration_bonus_pct", "rocket_flare_interval", "rocket_flare_offset_pct", "rocket_flare_rockets", "rocket_flare_duration_pct", "rocket_flare_damage_pct", "jetpack_bonus_speed", "jetpack_turn_rate", "AbilityManaCost"], "judge": [{"mechanism": "stun", "condition": "scepter"}]}, {"subject": "rattletrap_jetpack", "name_zh": "发条技师·喷气背包", "name_en": "Jetpack", "description_zh": "发条技师开动喷气背包，获得飞行移动状态，飞行视野和移动速度加成。发条技师的转身速率大幅降低，并且无法攻击。在加成状态的持续时间内可以开启和关闭喷气背包。", "description_en": "Clockwerk activates a jetpack, gaining flying movement, flying vision, and bonus movement speed. Clockwerk has a severely-limited turn rate during this time and cannot attack. Jetpack can be toggled on and off for the duration of the buff.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["bonus_speed", "turn_rate", "height", "duration", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "flying", "condition": "shard"}, {"mechanism": "grant_vision", "condition": "shard"}]}, {"subject": "rattletrap_hookshot", "name_zh": "发条技师·发射钩爪", "name_en": "Hookshot", "description_zh": "向目标位置高速射出钩爪，如果命中一个单位，发条技师会将自己牵引到目标身边，对目标附近%stun_radius%范围内所有敌人造成眩晕和伤害。对牵引时冲撞到的单位也造成伤害和眩晕。", "description_en": "Fires a grappling device rapidly at the target location.  If the hook hits a unit, Clockwerk launches himself into the target, stunning and dealing damage to everyone in a %stun_radius% radius around the hit target. Any enemies Clockwerk collides with along the way are damaged and stunned.", "notes_zh": ["发射钩爪可以抓住友方单位并将发条技师牵引过去，但是不会造成伤害和眩晕。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["latch_radius", "stun_radius", "radius_ally", "duration", "speed", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "leshrac_split_earth", "name_zh": "拉席克·撕裂大地", "name_en": "Split Earth", "description_zh": "撕裂敌人脚下的大地。造成伤害和短暂的眩晕。", "description_en": "Splits the earth under enemies. Deals damage and stuns for a short duration.", "notes_zh": ["撕裂大地将摧毁作用范围内的树木。", "技能经过%delay%秒延迟后生效。"], "granted_by": "", "upgrades": {"shard": {"zh": "撕裂大地在相同地点再重复%shard_max_count%次，重复间隔为%shard_secondary_delay%秒。每次作用范围增加%shard_radius_increase%。撕裂大地的重复地点对双方队伍可见。", "en": "Causes Split Earth to repeat in the same location %shard_max_count% additional times, with a %shard_secondary_delay% second delay between each one. Each time the radius increases by %shard_radius_increase%. Split Earth echo location is visible to both teams."}}, "is_passive": false, "value_names": ["delay", "radius", "duration", "shard_radius_increase", "shard_max_count", "shard_secondary_delay", "AbilityDamage", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "stun", "condition": "base"}, {"mechanism": "tree_destroy", "condition": "base"}]}, {"subject": "leshrac_diabolic_edict", "name_zh": "拉席克·恶魔敕令", "name_en": "Diabolic Edict", "description_zh": "使拉席克周围的区域充满魔法性爆炸，对敌方单位和建筑造成纯粹伤害。范围内的敌人越少，他们受到的伤害就越高。", "description_en": "Saturates the area around Leshrac with magical explosions that deal pure damage to enemy units and buildings.  The fewer units available to attack, the more damage those units will take.", "notes_zh": ["即使拉席克死亡，爆炸还是会在原地继续。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["num_explosions", "radius", "affects_buildings", "damage", "targets", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}]}, {"subject": "leshrac_lightning_storm", "name_zh": "拉席克·闪电风暴", "name_en": "Lightning Storm", "description_zh": "召唤一片闪电风暴攻击目标敌方单位，并跳跃到附近的敌方单位。被攻击的敌人将会被降低移动速度。", "description_en": "Summons a lightning storm that blasts the target enemy unit, then strikes any nearby enemy units. Struck enemies have their move speed slowed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "jump_count", "radius", "jump_delay", "movespeed_slow", "slow_duration", "pulse_nova_lightning_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}, {"mechanism": "slow", "condition": "base"}, {"mechanism": "summons", "condition": "base"}]}, {"subject": "leshrac_greater_lightning_storm", "name_zh": "拉席克·虚无主义", "name_en": "Nihilism", "description_zh": "使拉席克和范围内所有敌人变为虚无状态，他们无法攻击，并且承受的魔法伤害增加，移动速度被减缓。拉席克的移动速度得到提升，而不是减缓。拉席克受到的魔法伤害不会增加。", "description_en": "Causes Leshrac and all nearby enemies to turn ethereal, preventing them from attacking, slowing them, and making them take more magic damage. Increases Leshrac's speed rather than reducing it. Does not cause Leshrac to take amplified damage.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["duration", "magic_amp", "slow", "radius", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "ethereal", "condition": "scepter"}, {"mechanism": "incoming_damage_amp", "condition": "scepter"}, {"mechanism": "magic_resist_reduction", "condition": "scepter"}, {"mechanism": "slow", "condition": "scepter"}]}, {"subject": "leshrac_pulse_nova", "name_zh": "拉席克·脉冲新星", "name_en": "Pulse Nova", "description_zh": "拉席克在他周围创造破坏性的能量波，每秒对附近敌方单位造成伤害。每次脉冲都会消耗拉席克的魔法。", "description_en": "Creates waves of damaging energy around Leshrac, one per second, to damage nearby enemy units. Drains Leshrac's mana with each pulse.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["mana_cost_per_second", "radius", "damage", "damage_resistance", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "mana_burn", "condition": "base"}, {"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "furion_sprout", "name_zh": "自然先知·发芽", "name_en": "Sprout", "description_zh": "使一圈树木在一个单位的周围发芽，将其困在其中并造成伤害，提供%vision_range%范围内的视野。", "description_en": "Sprouts a ring of trees around a unit, damaging and trapping it in place and providing vision in a %vision_range% radius.", "notes_zh": ["发芽的施放目标可以是任何单位或者地面。", "发芽产生的树木跟英雄技能的相互作用与平常树木相同。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["vision_range", "duration", "sprout_damage", "sprout_damage_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "grant_vision", "condition": "base"}]}, {"subject": "furion_teleportation", "name_zh": "自然先知·传送", "name_en": "Teleportation", "description_zh": "传送到地图上任何位置。到达地点后获得一个护盾。", "description_en": "Teleports to any point on the map. Gains a barrier after arriving to its destination.", "notes_zh": ["魔耗和冷却时间都是在技能施放结束后结算。自然先知在施放技能时被打断将不会耗费魔法或使技能进入冷却。", "施法开始后，目标地点将产生视觉特效，对队友和敌人均可见。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["barrier", "buff_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "channel_interrupt", "condition": "base"}, {"mechanism": "damage_block", "condition": "base"}, {"mechanism": "self_mobility", "condition": "base"}]}, {"subject": "furion_curse_of_the_forest", "name_zh": "自然先知·青森诅咒", "name_en": "Curse of the Oldgrowth", "description_zh": "对%range%范围内所有敌方英雄施加诅咒，使他们在迷雾中显形，根据%radius%范围内树木的数量对他们造成减速和持续伤害。在此情况下树人也被视为树木。", "description_en": "Applies a curse on all enemy heroes within %range% range, displaying them in fog, slowing them, and dealing damage over time based on the number of trees within %radius% radius. Treants count as trees for this purpose.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage_per_tree", "slow_per_tree", "radius", "range", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}, {"mechanism": "reveal", "condition": "shard"}, {"mechanism": "slow", "condition": "shard"}]}, {"subject": "furion_spirit_of_the_forest", "name_zh": "自然先知·丛林之魂", "name_en": "Spirit of the Forest", "description_zh": "附近的每棵树都会让自然先知获得%damage_per_tree_pct%%%攻击力加成。每个树人也会让自然先知获得若干倍数的加成，不论相距多远。树人也拥有这个技能。", "description_en": "Nature's Prophet gains %damage_per_tree_pct%%% bonus damage for each nearby tree. Treants also provide this bonus with multiplied values regardless of proximity. Treants also possess this ability.", "notes_zh": ["树人会从周围的树木和其他树人获得加成效果。", "树精卫士不提供任何加成。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_per_tree_pct", "radius_base", "multiplier"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}]}, {"subject": "furion_wrath_of_nature", "name_zh": "自然先知·自然之怒", "name_en": "Wrath of Nature", "description_zh": "伤害性的能量在全地图跳跃，打击视野中的敌人，会先从距目标点最近的敌人开始打击。每击中一个敌人伤害都会增加，击中%max_targets%个目标后达到最高伤害。", "description_en": "Damaging energy bounces around the map, striking enemies that are in vision starting with those closest to the cast point. Each enemy hit beyond the first adds damage, up to the maximum after %max_targets% are hit.", "notes_zh": ["自然的愤怒只能伤害视野内的单位。", "可以通过点击小地图施放；初始目标将选择施放地点最近的有效单位。"], "granted_by": "", "upgrades": {"scepter": {"zh": "缠绕所有击中的敌人。持续时间根据弹跳次序从%scepter_min_entangle_duration%秒开始增加，弹跳数达到上限时为%scepter_max_entangle_duration%秒。", "en": "Entangles all enemies it hits. Duration scales from %scepter_min_entangle_duration%s up to %scepter_max_entangle_duration%s seconds at max bounce."}}, "is_passive": false, "value_names": ["max_targets", "damage", "damage_percent_add", "jump_delay", "scepter_min_entangle_duration", "scepter_max_entangle_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "root", "condition": "scepter"}, {"mechanism": "self_mobility", "condition": "base"}]}, {"subject": "life_stealer_rage", "name_zh": "噬魂鬼·狂暴", "name_en": "Rage", "description_zh": "进入狂暴状态，变成减益免疫，提升魔法抗性和移动速度。\n\n驱散类型：弱驱散", "description_en": "Launch into a maddened rage, becoming Debuff Immune, increasing magic resistance and gaining movement speed.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "magic_resist", "debuff_immunity", "movespeed_bonus", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "applies_basic_dispel", "condition": "base"}, {"mechanism": "debuff_immunity", "condition": "base"}]}, {"subject": "life_stealer_open_wounds", "name_zh": "噬魂鬼·撕裂伤口", "name_en": "Open Wounds", "description_zh": "噬魂鬼撕裂一个敌方单位，减缓受害者的移动速度，并使所有友军在攻击该单位时根据造成的伤害回复一定比例的生命。受害者在持续时间内逐渐恢复移动速度。", "description_en": "Lifestealer rends an enemy unit, slowing the victim's movement speed and allowing all allies to regain health for a percentage of the damage they deal to that unit. The victim recovers movement speed over the duration.", "notes_zh": ["撕裂伤口的减速有8个独立的阶段：50%/50%/40%/30%/20%/10%/10%/10%，每过一秒就会进入下个阶段，减速效果不断降低。", "治疗数值会被噬魂鬼的生命回复增强效果提升。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "slow_steps", "heal_percent", "spread_radius", "slow_step_pct_of_max", "slow_tooltip", "attack_speed_on_target", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "healing", "condition": "base"}, {"mechanism": "lifesteal", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "life_stealer_feast", "name_zh": "噬魂鬼·盛宴", "name_en": "Feast", "description_zh": "噬魂鬼每次攻击时还会根据目标最大生命值的一定百分比造成伤害，同时获得治疗。每次击杀单位他都会获得永久生命上限。", "description_en": "Lifestealer's attacks deal damage and provide heal for a percentage of his target's max health. He gains permanent max HP whenever he kills a unit.", "notes_zh": ["对友军和敌人有效。对肉山无效。", "回复量与造成伤害相互独立。", "破坏会使技能无法获得新的叠加效果。", "破坏不会使现有叠加效果提供的加成失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["hp_leech_percent", "hp_damage_percent", "creep_deny_percent", "bonus_hp_per_hero", "bonus_hp_per_creep", "bonus_hp_total"], "judge": [{"mechanism": "healing", "condition": "base"}, {"mechanism": "lifesteal", "condition": "base"}]}]}
