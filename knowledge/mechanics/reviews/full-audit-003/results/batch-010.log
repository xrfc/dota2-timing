{
  "objects": [
    {
      "subject": "dragon_knight_elder_dragon_form",
      "judgments": [
        {
          "mechanism": "aoe_damage",
          "condition": "base",
          "decision": "accept",
          "condition_correct": true,
          "correct_condition": "base",
          "quote": "2级赤龙：攻击获得溅射伤害。",
          "reason_zh": "攻击具有溅射伤害，支持一次攻击伤害多个敌人。"
        },
