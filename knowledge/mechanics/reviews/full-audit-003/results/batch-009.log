: {"shard": {"zh": "攻击力加成提升。被控制时可以施放折光。", "en": "Increases bonus damage. Refraction can be cast while disabled."}}, "is_passive": false, "value_names": ["instances", "shield_per_instance", "bonus_damage", "bonus_damage_per_instance_burn", "duration", "cast_while_disabled", "dispels", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "damage_block", "condition": "base"}, {"mechanism": "hp_removal", "condition": "base"}]}, {"subject": "templar_assassin_meld", "name_zh": "圣堂刺客·隐匿", "name_en": "Meld", "description_zh": "圣堂刺客将自己隐藏起来，只要静止不动将一直处于隐身状态。只要在隐匿状态下攻击敌人打破隐身，拉娜娅的攻击将对敌人造成额外伤害，并降低其护甲，持续%debuff_duration%秒。额外伤害和隐匿的负面效果会施加给灵能之刃飞溅距离内所有敌人。", "description_en": "Templar Assassin conceals herself, becoming invisible as long as she remains still. If Meld's invisibility is broken by attacking an enemy, Lanaya's attack will deal bonus damage to the enemy and reduce their armor for %debuff_duration% seconds. Bonus damage and debuffs from Meld are applied to all enemies in the Psi Blades split range.", "notes_zh": ["除了停留在原地或持续施放灵能投射，其他任何动作都会打破隐匿效果。", "隐匿的护甲降低作用对防御塔无效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "bonus_armor", "bash_duration", "attack_range_bonus", "debuff_duration", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "armor_reduction", "condition": "base"}, {"mechanism": "invisibility", "condition": "base"}]}, {"subject": "templar_assassin_psi_blades", "name_zh": "圣堂刺客·灵能之刃", "name_en": "Psi Blades", "description_zh": "圣堂刺客锋利的灵能之刃可以穿透敌人，对其正后方的敌方单位造成伤害，并且攻击距离得到提升。每对一个单位造成伤害后，飞溅伤害都会减少一定百分比。", "description_en": "Templar Assassin's psi blades slice through the attacked unit, splitting and damaging enemy units directly behind it, while gaining bonus attack range. For each unit it damages, the split damage is reduced by a percentage.", "notes_zh": ["飞溅伤害可以伤害隐身单位。", "重击等攻击特效只对主目标有效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_attack_range", "attack_spill_range", "attack_spill_width", "attack_spill_pct", "meld_strike_spills"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "attack_modifier", "condition": "base"}, {"mechanism": "bash", "condition": "base"}, {"mechanism": "invisibility", "condition": "base"}]}, {"subject": "templar_assassin_trap_teleport", "name_zh": "圣堂刺客·灵能投射", "name_en": "Psionic Projection", "description_zh": "持续施法 - 圣堂刺客经过%abilitychanneltime%秒持续施法后可以传送至任意灵能陷阱，到达时引爆灵能陷阱，陷阱总是最大效果，并且立刻造成%extra_damage%点额外伤害。灵能投射在持续施法时不会脱离隐匿效果。", "description_en": "CHANNELED - Allows Templar Assassin to teleport to any Psionic Trap after channeling for %abilitychanneltime% seconds, detonating it upon arrival as if it was fully charged and instantly dealing %extra_damage% bonus damage. Channeling Psionic Projection does not break Meld.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["extra_damage", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "self_mobility", "condition": "scepter"}]}, {"subject": "templar_assassin_psionic_trap", "name_zh": "圣堂刺客·灵能陷阱", "name_en": "Psionic Trap", "description_zh": "圣堂刺客放下一个隐形的神秘陷阱监视敌人的动向。引爆后将减缓%trap_radius%范围内敌人的移动速度，陷阱放置时间越久，引爆后减速效果越强，最低为%movement_speed_min%%%，放置%trap_max_charge_duration%秒后引爆将达到最大减速效果，为%movement_speed_max%%%，并且还能造成额外伤害。", "description_en": "Templar Assassin places mystical traps that invisibly monitor enemy movement. When sprung at her command, they exert a slowing influence of %movement_speed_min%%% in a %trap_radius% radius. Trap movement slow charges up to %movement_speed_max%%% after %trap_max_charge_duration% seconds. Deals damage after %trap_max_charge_duration%s.", "notes_zh": ["陷阱没有时间限制。", "他们拥有隐形效果，渐隐时间为%trap_fade_time%秒，还拥有技能免疫状态。他们可以承受2次远程英雄的攻击，1次近战英雄的攻击，或4次非英雄单位的攻击。", "陷阱的视野是250/250，不能阻止中立生物刷新。"], "granted_by": "", "upgrades": {"scepter": {"zh": "现在陷阱引爆后还会沉默受到作用的敌人。", "en": "When activated, traps now silence affected enemies."}}, "is_passive": false, "value_names": ["trap_radius", "trap_duration", "max_traps", "trap_fade_time", "movement_speed_min", "movement_speed_max", "trap_bonus_damage", "extra_damage", "damage_tick_rate", "trap_max_charge_duration", "min_silence_duration", "max_silence_duration", "bonus_vision", "AbilityCastRange", "AbilityCastPoint"], "judge": [{"mechanism": "charges", "condition": "base"}, {"mechanism": "debuff_immunity", "condition": "base"}, {"mechanism": "silence", "condition": "scepter"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "templar_assassin_inner_peace", "name_zh": "圣堂刺客·心怀安宁", "name_en": "Inner Peace", "description_zh": "原地不动且未受到伤害超过%time_until_meditation%秒后，圣堂刺客开始冥想，获得生命恢复和魔法恢复加成，冥想%time_until_max_bonus%秒后达到最大加成。", "description_en": "When remaining stationary and not taking damage for %time_until_meditation%s, Templar Assassin begins meditating, gaining health and mana regeneration, reaching the maximum bonus after %time_until_max_bonus%s of meditating.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["max_hp_regen", "max_mana_regen", "time_until_meditation", "time_until_max_bonus"], "judge": [{"mechanism": "healing", "condition": "base"}, {"mechanism": "mana_gain", "condition": "base"}]}, {"subject": "viper_poison_attack", "name_zh": "冥界亚龙·毒性攻击", "name_en": "Poison Attack", "description_zh": "蝮蛇的毒液得到强化，使他的普通攻击附带效果，可以降低目标的移动速度和魔法抗性，并持续造成伤害。效果可以叠加，最多叠加%max_stacks%次。", "description_en": "Intensifies Viper's venom, adding an effect to his normal attack that applies a stacking movement speed slow and magic resistance deduction while dealing damage over time. Stacks up to %max_stacks% times.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升最大叠加次数，毒性攻击可以降低护甲，并且可以作用于建筑，造成的伤害有所降低。", "en": "Increases max stacks, and causes Poison Attack to lower armor per stack and to affect buildings for reduced damage."}}, "is_passive": false, "value_names": ["duration", "damage", "movement_speed", "magic_resistance", "max_stacks", "bonus_range", "shard_armor_reduction", "shard_building_dmg_pct", "AbilityCastRange", "AbilityManaCost"], "judge": [{"mechanism": "armor_reduction", "condition": "shard"}, {"mechanism": "attack_modifier", "condition": "base"}, {"mechanism": "magic_resist_reduction", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "viper_nethertoxin", "name_zh": "冥界亚龙·幽冥剧毒", "name_en": "Nethertoxin", "description_zh": "蝮蛇向目标区域释放幽冥剧毒。范围内的单位持续受到伤害，在区域内停留的时间越长，受到的伤害也越高。同时他们的攻击速度会被降低。", "description_en": "Viper releases a Nethertoxin at the targeted area. Units in that area take an increasing damage over time based on how long they remain in it. Units in it have their attack speed slowed.", "notes_zh": ["多个幽冥剧毒不会叠加。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["min_damage", "max_damage", "max_duration", "radius", "attack_slow", "duration", "projectile_speed", "radius_increase", "expand_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "slow", "condition": "base"}]}, {"subject": "viper_corrosive_skin", "name_zh": "冥界亚龙·腐蚀皮肤", "name_en": "Corrosive Skin", "description_zh": "蝮蛇分泌出感染性的毒素，%max_range%范围内任何伤害它的敌人都将受到伤害，同时攻击速度也被降低。这种酸性分泌物还能提高蝮蛇的魔法抗性。", "description_en": "Viper exudes an infectious toxin that damages and slows the attack speed of any enemy that damages it in a %max_range% radius. The acid exudate also increases Viper's resistance to magic.", "notes_zh": ["与其他提升魔法抗性的物品和技能叠加。", "破坏会使腐蚀皮肤不再施加效果。极恶俯冲还是会施加腐蚀皮肤。", "这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "腐蚀皮肤会对距离冥界亚龙%effect_multiplier_distance%范围内的敌人施加%effect_multiplier%倍攻击速度降低效果。当冥界亚龙处于幽冥剧毒中，腐蚀皮肤的魔法抗性和每秒伤害会逐渐提升，在%nethertoxin_bonus_pct_max_duration_tooltip%秒后，达到最高的%nethertoxin_bonus_pct%%%提升。", "en": "Corrosive Skin applies %effect_multiplier%x the attack speed slow to enemies that are within %effect_multiplier_distance% distance of Viper.  Viper's Corrosive Skin Magic Resistance and Damage per Second are gradually increased while he is in Nethertoxin, up to %nethertoxin_bonus_pct%%% increased effect after %nethertoxin_bonus_pct_max_duration_tooltip%s."}}, "is_passive": true, "value_names": ["duration", "bonus_attack_speed", "bonus_magic_resistance", "damage", "max_range", "effect_multiplier_distance", "effect_multiplier", "nethertoxin_bonus_pct", "nethertoxin_bonus_pct_max_duration_tooltip"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aoe_damage", "condition": "scepter"}, {"mechanism": "damage_return", "condition": "base"}, {"mechanism": "slow", "condition": "base"}, {"mechanism": "slow", "condition": "scepter"}, {"mechanism": "spell_reflect", "condition": "base"}]}, {"subject": "viper_viper_strike", "name_zh": "冥界亚龙·蝮蛇突袭", "name_en": "Viper Strike", "description_zh": "蝮蛇降低敌方目标单位的移动和攻击速度，同时破坏其被动技能并造成持续毒素伤害。移动和攻击速度会在毒素的持续时间内逐渐恢复。", "description_en": "Viper slows the targeted enemy unit's movement and attack speed while also disabling their passives and dealing poison damage over time. The slowing effect reduces over the duration of the poison.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage", "bonus_movement_speed", "bonus_attack_speed", "projectile_speed", "max_charges", "charge_restore_time", "does_break", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "slow", "condition": "base"}]}, {"subject": "luna_lucent_beam", "name_zh": "露娜·月光", "name_en": "Lucent Beam", "description_zh": "召唤一道月能的光束打击敌人，造成伤害并短暂眩晕目标。", "description_en": "Calls a beam of lunar energy down upon an enemy, damaging and briefly stunning them.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["beam_damage", "glaives_fired", "glaives_attack_radius", "stun_duration", "damage_buff_duration", "damage_buff_per_beam", "lucent_beam_bounce_range", "damage_buff_from_eclipse_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "luna_lunar_orbit", "name_zh": "露娜·环月", "name_en": "Lunar Orbit", "description_zh": "产生%rotating_glaives%个月刃在露娜身旁%rotating_glaives_movement_radius%范围内旋转。任何碰到月刃的敌方单位都会受到露娜攻击伤害的一定百分比。", "description_en": "Creates %rotating_glaives% glaives that rotate %rotating_glaives_movement_radius% radius around Luna. Any enemy unit that collides with a glaive will take a percentage of Luna's Attack Damage.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升伤害降低效果。开启时，露娜获得%bonus_movement_speed%%%移动速度加成。", "en": "Increases damage reduction. While active, Luna gains %bonus_movement_speed%%% bonus movement speed."}}, "is_passive": false, "value_names": ["rotating_glaives_duration", "rotating_glaives", "rotating_glaives_movement_radius", "rotating_glaives_movement_radius_expand_speed_scale", "rotating_glaives_hit_radius", "rotating_glaives_collision_damage", "rotating_glaives_speed", "rotating_glaive_collision_speed_damage_tooltip", "rotating_glaives_damage_reduction", "bonus_movement_speed", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}]}, {"subject": "luna_moon_glaive", "name_zh": "露娜·月刃", "name_en": "Moon Glaives", "description_zh": "强化露娜的月刃，使攻击可以在敌方单位之间弹跳。每次弹跳造成的伤害都会减少。", "description_en": "Empowers Luna's glaives, causing her attacks to bounce between enemy units. Deals less damage with each bounce.", "notes_zh": ["月刃不会触发致命一击以外的任何攻击特效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["range", "bounces", "damage_reduction_percent"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "attack_modifier", "condition": "base"}]}, {"subject": "luna_lunar_blessing", "name_zh": "露娜·月之祝福", "name_en": "Lunar Blessing", "description_zh": "提升露娜和附近%radius%范围内友方英雄的攻击力，露娜获得双倍的攻击力加成。夜晚期间月之祝福为全地图生效，并且露娜受到福佑后夜间视野提升。", "description_en": "Grants attack damage to Luna and nearby allied heroes within %radius% range, with Luna receiving double the attack damage bonuses. At night, Lunar Blessing is global, and Luna is blessed with bonus night vision.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "bonus_damage", "self_bonus_damage", "bonus_night_vision"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "aura", "condition": "base"}]}, {"subject": "luna_eclipse", "name_zh": "露娜·月蚀", "name_en": "Eclipse", "description_zh": "召唤一次月蚀，以她当前技能等级的月光随机打击附近敌人。月光只有伤害效果，不会造成眩晕，而且单一目标只能受到有限次数的打击。月蚀会暂时将白天变为黑夜。", "description_en": "Showers random nearby enemies with strikes from Luna's current level of Lucent Beam. These beams do not stun their targets, and there is a maximum number of times that a single target can be struck. Also turns day into night for a short time.", "notes_zh": ["如果露娜没有升级月光，月蚀将无法造成伤害，但是变为黑夜效果有效。", "露娜阵亡后月光马上中止。", "不能伤害隐身单位。", "每道月光之间都有%beam_interval%秒的间隔。神杖升级后间隔为%beam_interval_scepter%秒。"], "granted_by": "", "upgrades": {"scepter": {"zh": "露娜可以对友方单位或自身施放月蚀，使月蚀的效果跟随目标，或者对一片区域施放。增加月光数量，减少月蚀持续时间，并且移除单体打击次数上限，月光的产生间隔缩短一半。", "en": "Allows Luna to cast Eclipse on an allied unit or herself and have its effects follow them, or cast it on an area. Increases total beams, reduces duration, removes the limit on beams per unit, and makes the beams appear twice as fast."}}, "is_passive": false, "value_names": ["beams", "beam_interval", "beam_interval_scepter", "radius", "hit_count", "night_duration", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "dragon_knight_breathe_fire", "name_zh": "龙骑士·火焰气息", "name_en": "Breathe Fire", "description_zh": "向龙骑士的前方喷射出一团火焰，烧灼碰到的敌人，并使其攻击力降低。", "description_en": "Unleashes a breath of fire in front of Dragon Knight that burns enemies and reduces the damage their attacks deal.", "notes_zh": ["不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_radius", "end_radius", "range", "speed", "damage", "reduction", "duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "damage_block", "condition": "base"}, {"mechanism": "mobility_lock", "condition": "base"}, {"mechanism": "spell_block", "condition": "base"}, {"mechanism": "spell_reflect", "condition": "base"}]}, {"subject": "dragon_knight_dragon_tail", "name_zh": "龙骑士·神龙摆尾", "name_en": "Dragon Tail", "description_zh": "龙骑士用盾对身边的一个敌方单位进行打击，对它和它身边的目标造成眩晕和伤害。", "description_en": "Dragon Knight smites an enemy unit with his shield, stunning and damaging it and units close to it.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["stun_duration", "damage", "dragon_cast_range", "projectile_speed", "aoe", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "stun", "condition": "base"}]}, {"subject": "dragon_knight_wyrms_wrath", "name_zh": "龙骑士·飞龙之怒", "name_en": "Wyrm's Wrath", "description_zh": "神龙的生命之血提升了龙骑士的技能和物品，使其拥有作用范围加成，并且攻击会对敌方单位造成额外魔法伤害。", "description_en": "The life blood of the Dragon improves Dragon Knight's abilities and items to have increased AoE and causes his attacks to deal additional magic damage to enemy units.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["magic_damage", "bonus_aoe"], "judge": [{"mechanism": "aoe_damage", "condition": "base"}, {"mechanism": "magic_resist_reduction", "condition": "base"}]}, {"subject": "dragon_knight_fireball", "name_zh": "龙骑士·龙炎火球", "name_en": "Fireball", "description_zh": "点燃一片区域，对其中的敌人持续造成伤害，伤害效果还会粘滞。近战形态下施放距离较近。", "description_en": "Ignites an area, dealing damage over time that lingers on enemies in it. Has reduced cast range when melee.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage", "duration", "burn_interval", "linger_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"], "judge": [{"mechanism": "aoe_damage", "condition": "shard"}]}, {"subject": "dragon_knight_dragon_blood", "name_zh": "龙骑士·龙族血统", "name_en": "Dragon Blood", "description_zh": "神龙的生命之血提升了龙骑士的生命恢复和护甲。在古龙形态下生命恢复和护甲均提升%regen_and_armor_multiplier_during_dragon_form%%%。", "description_en": "The life blood of the Dragon improves Dragon Knight's health regeneration and armor.  Regen and armor are increased by %regen_and_armor_multiplier_during_dragon_form%%% during Elder Dragon Form.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["health_regen", "armor", "regen_and_armor_multiplier_during_dragon_form"], "judge": [{"mechanism": "healing", "condition": "base"}]}]}
