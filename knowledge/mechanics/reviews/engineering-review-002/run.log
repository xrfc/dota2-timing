"""Build reviewed facts v13 and evaluate rules v5 on them (U90, U92).

Writes to a new directory only. Every file the build reads is declared and hashed before and
after the build, so an input that changes mid-build stops it.

    PYTHONPATH=src python scripts/build_mechanics_facts_v13.py \
        --output knowledge/mechanics/extractions/v13
"""

import argparse
import hashlib
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import build_mechanics_facts_v4 as v4script  # noqa: E402
import build_mechanics_facts_v6 as v6script  # noqa: E402
import build_mechanics_facts_v7 as v7script  # noqa: E402
import build_mechanics_facts_v8 as v8script  # noqa: E402
import build_mechanics_facts_v12 as v12script  # noqa: E402

from dota_items.data.mechanics import load_enums, load_vocabulary  # noqa: E402
from dota_items.data.mechanics_facts_v13 import build_reviewed  # noqa: E402
from dota_items.data.mechanics_graph_v2 import annotate_evaluation  # noqa: E402
from dota_items.data.mechanics_interactions import evaluate_rule, load_rules  # noqa: E402

ROOT = v4script.ROOT
VOCABULARY = f"{v4script.MECH}/vocabulary-v13.json"
RULES = f"{v4script.MECH}/rules-v7.json"
CORRECTIONS = v12script.CORRECTIONS
CORRECTIONS_2 = v12script.CORRECTIONS_2
ADOPTIONS = v12script.ADOPTIONS
RULINGS = v12script.RULINGS
ITEM_NAMES = v12script.ITEM_NAMES
REGISTRY = "knowledge/hero-capabilities/hero-registry.json"
ENUMS = f"{v4script.MECH}/enums-v1.json"
V13_INPUTS = f"{v4script.REVIEWS}/v13-inputs-001.json"
SLOW_RULINGS = f"{v4script.REVIEWS}/slow-rulings-001.jsonl"
TERRAIN_RULINGS = f"{v4script.REVIEWS}/terrain-rulings-001.jsonl"
FEEDBACK = (
    f"{v4script.REVIEWS}/u5-verdicts-2026-11-03.jsonl",
    f"{v4script.REVIEWS}/u5-spot-check-002/verdicts-2026-11-05.jsonl",
)
CONDITION_ROUNDS = tuple(
    (number, f"{v4script.REVIEWS}/codex-round-00{number}/codex-review.jsonl")
    for number in range(2, 9)
)
GAME_FILES = (
    "knowledge/game-files/snapshots/2026-11-02/sources/scripts/npc/npc_abilities.txt",
    "knowledge/game-files/snapshots/2026-11-03-items/sources/scripts/npc/items.txt",
)
HERO_SCRIPTS = "knowledge/game-files/snapshots/2026-11-02/sources/scripts/npc/heroes"
IMPLEMENTATION = (
    *v12script.IMPLEMENTATION,
    "src/dota_items/data/mechanics_facts_v13.py",
    "src/dota_items/data/mechanics_graph_v2.py",
    "src/dota_items/data/mechanics.py",
    "src/dota_items/data/mechanics_interactions.py",
    "scripts/build_mechanics_facts_v13.py",
)


def digest_implementation(repo=ROOT):
    return {name: hashlib.sha256((repo / name).read_bytes()).hexdigest() for name in IMPLEMENTATION}


IMPLEMENTATION_AT_IMPORT = digest_implementation()


def declared_inputs(repo=ROOT):
    """Every file a build reads, including the per-hero scripts a helper walks."""
    heroes = sorted(
        path.relative_to(repo).as_posix() for path in (repo / HERO_SCRIPTS).glob("*.txt")
    )
    return tuple(
        dict.fromkeys(
            (
                *(n for n in v12script.INPUTS if n not in (v12script.VOCABULARY, v12script.RULES)),
                VOCABULARY,
                RULES,
                SLOW_RULINGS,
                TERRAIN_RULINGS,
                REGISTRY,
                ENUMS,
                V13_INPUTS,
                *FEEDBACK,
                *(path for _, path in CONDITION_ROUNDS),
                *GAME_FILES,
                *heroes,
            )
        )
    )


def digest_inputs(repo=ROOT):
    return {
        name: hashlib.sha256((repo / name).read_bytes()).hexdigest()
        for name in declared_inputs(repo)
    }


def _changed(before, after):
    """Names that differ, including files that appeared or were deleted."""
    return sorted(
        name for name in before.keys() | after.keys() if before.get(name) != after.get(name)
    )


def load_json(repo, name):
    return json.loads((repo / name).read_text(encoding="utf-8"))


def run(output, repo=ROOT):
    output = Path(output)
    if output.exists():
        raise ValueError("Output already exists; choose a new directory")
    before = digest_inputs(repo)
    sources = v6script.load_sources(repo)
    sources["skill_notes"] = load_json(repo, v7script.NOTES)["notes"]
    sources["audit"].extend(v4script.read_jsonl(repo, v8script.ROUND8))
    sources["t5_corrections"] = v4script.read_jsonl(repo, CORRECTIONS)
    sources["t5_corrections_2"] = v4script.read_jsonl(repo, CORRECTIONS_2)
    sources["audit_adoptions"] = v4script.read_jsonl(repo, ADOPTIONS)
    sources["recheck_rulings"] = v4script.read_jsonl(repo, RULINGS)
    extra = load_json(repo, V13_INPUTS)
    sources["v13_rulings"] = [
        *extra["rulings"],
        *v4script.read_jsonl(repo, SLOW_RULINGS),
        *v4script.read_jsonl(repo, TERRAIN_RULINGS),
    ]
    sources["v13_notes"] = extra["notes"]
    sources["feedback_corrections"] = extra["corrections"]
    sources["user_feedback"] = [
        {**row, "file": name} for name in FEEDBACK for row in v4script.read_jsonl(repo, name)
    ]
    sources["condition_reviews"] = [
        {**row, "round": number, "reviewer": "codex"}
        for number, name in CONDITION_ROUNDS
        for row in v4script.read_jsonl(repo, name)
    ]
    registry = load_json(repo, "knowledge/hero-capabilities/hero-registry.json")
    sources["zh_names"] = {
        ability["name"]: f"{hero['name_zh']}·{ability['name_zh']}"
        for hero in registry["heroes"]
        for ability in hero["abilities"]
    }
    for row in load_json(repo, ITEM_NAMES)["result"]["data"]["itemabilities"]:
        if row["name_loc"]:
            sources["zh_names"][row["name"].removeprefix("item_")] = row["name_loc"]
    doc = build_reviewed(sources)
    enums = load_enums(load_json(repo, f"{v4script.MECH}/enums-v1.json"), registry["heroes"])
    terms = load_vocabulary(load_json(repo, VOCABULARY), enums)
    rules = load_rules(load_json(repo, RULES), terms)
    fields = {"ROOT_DISABLES": v7script.root_disabled_subjects(repo)}
    evaluation = annotate_evaluation(
        {
            "schema": "mechanics-rules-evaluation/1",
            "rules": [
                {"id": rule["id"], "zh": rule["zh"], **evaluate_rule(rule, doc, fields)}
                for rule in rules
            ],
        },
        rules,
    )
    changed = _changed(before, digest_inputs(repo))
    changed += _changed(IMPLEMENTATION_AT_IMPORT, digest_implementation(repo))
    if changed:
        raise ValueError(f"Inputs changed during the build: {changed}")
    output.mkdir(parents=True)
    for name, value in (
        ("facts-v13.json", doc),
        ("delta-vs-v3.json", v4script.delta_of(doc)),
        ("rules-evaluation.json", evaluation),
    ):
        (output / name).write_text(
            json.dumps(value, ensure_ascii=False, indent=1) + "\n", encoding="utf-8"
        )

    def digest(path):
        return hashlib.sha256(path.read_bytes()).hexdigest()

    manifest = {
        "schema": "mechanics-extraction-receipt/1",
        "extractor_version": doc["extractor_version"],
        "patch_verified": False,
        "input_sha256": before,
        "implementation_sha256": {name: digest(repo / name) for name in IMPLEMENTATION},
        "output_sha256": {path.name: digest(path) for path in sorted(output.iterdir())},
    }
    (output / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n", encoding="utf-8")
    return doc, evaluation


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path, help="New directory")
    args = parser.parse_args()
    print(json.dumps(run(args.output)[0]["counts"], ensure_ascii=False))


if __name__ == "__main__":
    main()
"""Build the derived layer from facts v13 with edge status and condition notes (U92).

Writes a new directory; derived-v1 and derived-v2 stay reproducible. Heroes gain the extra
abilities the registry lacks, such as the Spirit Bear's skills (U90).

    PYTHONPATH=src python scripts/build_mechanics_derived_v3.py \\
        --output knowledge/mechanics/profiles/derived-v3
"""

import argparse
import hashlib
import json
from pathlib import Path

from dota_items.data.mechanics_graph import (
    build_graph,
    build_item_profile,
    build_traits,
    compare_with_v1,
    node_index,
    render_item_markdown,
)
from dota_items.data.mechanics_graph_v2 import annotate_graph, display_doc, display_evaluation
from dota_items.data.mechanics_profiles import build_hero_profile, render_markdown

ROOT = Path(__file__).resolve().parents[1]
FACTS = "knowledge/mechanics/extractions/v13/facts-v13.json"
EVALUATION = "knowledge/mechanics/extractions/v13/rules-evaluation.json"
RULES = "knowledge/mechanics/rules-v7.json"
VOCABULARY = "knowledge/mechanics/vocabulary-v13.json"
REGISTRY = "knowledge/hero-capabilities/hero-registry.json"
EXTRA_ABILITIES = "knowledge/mechanics/extra-abilities-v1.json"
STATUS = "knowledge/mechanics/retired-items-v1.json"
ITEM_NAMES = "knowledge/items/sources/itemlist-schinese.json"
TRAITS_V1 = "knowledge/hero-traits/hero-traits-v1.json"
MAPPING = "knowledge/hero-traits/trait-mapping-v3.json"
INPUTS = (
    FACTS,
    EVALUATION,
    RULES,
    VOCABULARY,
    REGISTRY,
    EXTRA_ABILITIES,
    STATUS,
    ITEM_NAMES,
    TRAITS_V1,
    MAPPING,
)
IMPLEMENTATION = (
    "src/dota_items/data/mechanics_graph.py",
    "src/dota_items/data/mechanics_graph_v2.py",
    "src/dota_items/data/mechanics_profiles.py",
    "scripts/build_mechanics_derived_v3.py",
)


def _digest_all(repo, names):
    return {name: hashlib.sha256((repo / name).read_bytes()).hexdigest() for name in names}


IMPLEMENTATION_AT_IMPORT = _digest_all(ROOT, IMPLEMENTATION)


def _dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def _digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def with_extra_abilities(heroes, extra):
    """Registry heroes plus abilities listed under them, without changing the registry."""
    added = {entry["hero_id"]: entry["abilities"] for entry in extra["heroes"]}
    return [
        {**hero, "abilities": [*hero["abilities"], *added.get(hero["hero_id"], [])]}
        for hero in heroes
    ]


def run(output, repo=ROOT):
    output = Path(output)
    if output.exists():
        raise ValueError("Output already exists; choose a new directory")
    before = {name: _digest(repo / name) for name in INPUTS}
    load = lambda name: json.loads((repo / name).read_text(encoding="utf-8"))  # noqa: E731
    doc, evaluation = load(FACTS), load(EVALUATION)
    rules = load(RULES)["rules"]
    terms = {term["id"]: term for term in load(VOCABULARY)["mechanisms"]}
    heroes = with_extra_abilities(load(REGISTRY)["heroes"], load(EXTRA_ABILITIES))
    status = load(STATUS)["status"]
    names = {
        row["name"].removeprefix("item_"): row["name_loc"]
        for row in load(ITEM_NAMES)["result"]["data"]["itemabilities"]
        if row["name_loc"]
    }
    active_names = {
        subject: name
        for subject, name in names.items()
        if status.get(subject) in ("purchasable", "other_source")
    }
    graph = annotate_graph(
        build_graph(rules, evaluation, doc, node_index(heroes, names, status)), rules, doc
    )
    shown_doc, shown_evaluation = display_doc(doc), display_evaluation(evaluation)
    shown_graph = {
        **graph,
        "rules": [
            {**rule, "zh": f"【待定】{rule['zh']}"} if rule["status"] == "pending" else rule
            for rule in graph["rules"]
        ],
    }

    hero_dir, item_dir = output / "heroes", output / "items"
    hero_dir.mkdir(parents=True)
    item_dir.mkdir()
    hero_profiles = []
    for hero in sorted(heroes, key=lambda h: h["hero_id"]):
        profile = build_hero_profile(hero, shown_doc, shown_evaluation, terms, active_names)
        hero_profiles.append(profile)
        (hero_dir / f"hero-{hero['hero_id']}.md").write_text(
            render_markdown(profile), encoding="utf-8"
        )
    item_subjects = sorted(
        {row["subject"] for row in doc["rows"] if row["decision"] == "accept"} & set(active_names)
    )
    item_profiles = []
    for subject in item_subjects:
        profile = build_item_profile(
            subject, active_names[subject], status[subject], shown_doc, shown_graph, terms
        )
        item_profiles.append(profile)
        (item_dir / f"{subject}.md").write_text(render_item_markdown(profile), encoding="utf-8")
    mapping = load(MAPPING)
    traits = build_traits(mapping, doc, heroes)
    traits["compared_with_v1"] = compare_with_v1(traits, load(TRAITS_V1), mapping)

    _dump(
        output / "hero-profiles.json",
        {"schema": "mechanics-hero-profiles/1", "facts": FACTS, "profiles": hero_profiles},
    )
    _dump(
        output / "item-profiles.json",
        {"schema": "mechanics-item-profiles/1", "facts": FACTS, "profiles": item_profiles},
    )
    _dump(output / "counter-graph.json", graph)
    _dump(output / "hero-traits-v2.json", traits)
    changed = sorted(name for name in INPUTS if _digest(repo / name) != before[name])
    current = _digest_all(repo, IMPLEMENTATION)
    changed += sorted(
        name for name in IMPLEMENTATION if current[name] != IMPLEMENTATION_AT_IMPORT[name]
    )
    if changed:
        raise ValueError(f"Inputs changed during the build: {changed}")
    files = sorted(path for path in output.rglob("*") if path.is_file())
    _dump(
        output / "manifest.json",
        {
            "schema": "mechanics-derived-receipt/2",
            "patch_verified": False,
            "semantics": graph["semantics"],
            "input_sha256": before,
            "implementation_sha256": {name: _digest(repo / name) for name in IMPLEMENTATION},
            "output_sha256": {str(p.relative_to(output)): _digest(p) for p in files},
        },
    )
    return {"heroes": hero_profiles, "items": item_profiles, "graph": graph, "traits": traits}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path, help="New directory")
    args = parser.parse_args()
    result = run(args.output)
    print(len(result["heroes"]), "heroes", len(result["items"]), "items")


if __name__ == "__main__":
    main()
"""MK-T5 v13: conditions survive, feedback means what it said, edges say what they are."""

import ast
import builtins
import hashlib
import json
import os
import sys
from pathlib import Path

import pytest

from dota_items.data.mechanics_facts_v13 import (
    BASIS_DISPUTED,
    apply_feedback,
    attach_condition_notes,
)
from dota_items.data.mechanics_graph_v2 import (
    STATUS_PENDING,
    annotate_evaluation,
    annotate_graph,
    display_doc,
    display_evaluation,
    hero_relations,
    usable_edges,
)
from dota_items.data.mechanics_profiles import confirmed

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = ROOT / "knowledge/mechanics/extractions/v13"
DERIVED = ROOT / "knowledge/mechanics/profiles/derived-v3"
sys.path.insert(0, str(ROOT / "scripts"))

import build_mechanics_derived_v3 as derived  # noqa: E402
import build_mechanics_facts_v13 as builder  # noqa: E402


def _doc():
    return json.loads((PACKAGE / "facts-v13.json").read_text(encoding="utf-8"))


def _graph():
    return json.loads((DERIVED / "counter-graph.json").read_text(encoding="utf-8"))


def _rows(doc, subject, mechanism):
    return [r for r in doc["rows"] if r["subject"] == subject and r["mechanism"] == mechanism]


def _verify_receipt(package):
    manifest = json.loads((package / "manifest.json").read_text())
    for name, expected in manifest["output_sha256"].items():
        assert hashlib.sha256((package / name).read_bytes()).hexdigest() == expected


def _traced_reads(monkeypatch, tmp_path, build):
    seen = set()
    real_open = builtins.open
    real_io_open = __import__("io").open

    def spy(file, *args, **kwargs):
        try:
            path = os.path.abspath(os.fspath(file))
        except TypeError:
            return real_open(file, *args, **kwargs)
        if path.startswith(str(ROOT)) and os.path.isfile(path):
            seen.add(os.path.relpath(path, ROOT))
        return real_open(file, *args, **kwargs)

    monkeypatch.setattr(builtins, "open", spy)
    monkeypatch.setattr("io.open", spy)
    build(tmp_path / "out")
    monkeypatch.setattr(builtins, "open", real_open)
    monkeypatch.setattr("io.open", real_io_open)
    return {name for name in seen if not name.endswith(".py")}


def test_package_matches_manifest_and_replays(tmp_path):
    _verify_receipt(PACKAGE)
    fresh, _ = builder.run(tmp_path / "v13")
    assert json.dumps(fresh, sort_keys=True) == json.dumps(_doc(), sort_keys=True)


def test_derived_replays_every_output_file(tmp_path):
    _verify_receipt(DERIVED)
    derived.run(tmp_path / "derived")
    fresh = json.loads((tmp_path / "derived/manifest.json").read_text())["output_sha256"]
    stored = json.loads((DERIVED / "manifest.json").read_text())["output_sha256"]
    assert fresh == stored


def _repo_imports(path, seen):
    """Repository files a Python file imports, followed all the way down."""
    if path in seen or not path.exists():
        return seen
    seen.add(path)
    for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
        names = []
        if isinstance(node, ast.Import):
            names = [alias.name for alias in node.names]
        elif isinstance(node, ast.ImportFrom) and node.module:
            names = [node.module, *(f"{node.module}.{alias.name}" for alias in node.names)]
        for name in names:
            if name.startswith("dota_items."):
                _repo_imports(ROOT / "src" / (name.replace(".", "/") + ".py"), seen)
            elif name.startswith("build_mechanics"):
                _repo_imports(ROOT / "scripts" / f"{name}.py", seen)
    return seen


@pytest.mark.parametrize("module", [builder, derived])
def test_every_imported_repo_file_is_recorded(module):
    used = _repo_imports(Path(module.__file__), set())
    recorded = {ROOT / name for name in module.IMPLEMENTATION}
    assert used <= recorded, sorted(str(path) for path in used - recorded)


def test_deleted_input_counts_as_changed():
    assert builder._changed({"a": "1", "b": "2"}, {"a": "1"}) == ["b"]
    assert builder._changed({"a": "1"}, {"a": "1", "c": "3"}) == ["c"]
    assert builder._changed({"a": "1"}, {"a": "1"}) == []


def test_changing_implementation_during_the_build_stops_it(monkeypatch, tmp_path):
    name = builder.IMPLEMENTATION[0]
    monkeypatch.setitem(builder.IMPLEMENTATION_AT_IMPORT, name, "older")
    with pytest.raises(ValueError, match="Inputs changed"):
        builder.run(tmp_path / "v13")


def test_every_file_the_facts_build_reads_is_declared(monkeypatch, tmp_path):
    read = _traced_reads(monkeypatch, tmp_path, builder.run)
    assert read
    assert read <= set(builder.declared_inputs())
    manifest = json.loads((PACKAGE / "manifest.json").read_text())
    assert set(builder.declared_inputs()) == set(manifest["input_sha256"])


def test_every_file_the_derived_build_reads_is_declared(monkeypatch, tmp_path):
    read = _traced_reads(monkeypatch, tmp_path, derived.run)
    assert read
    assert read <= set(derived.INPUTS)


def test_changing_an_input_during_the_build_stops_it(monkeypatch, tmp_path):
    real = builder.digest_inputs
    calls = {"count": 0}

    def drifting(repo=builder.ROOT):
        result = dict(real(repo))
        calls["count"] += 1
        if calls["count"] > 1:
            result[builder.REGISTRY] = "changed"
        return result

    monkeypatch.setattr(builder, "digest_inputs", drifting)
    with pytest.raises(ValueError, match="hero-registry"):
        builder.run(tmp_path / "v13")


def test_condition_notes_survive_and_absence_is_not_unconditional():
    doc = _doc()
    rows = _rows(doc, "night_stalker_void", "stun")
    assert any("夜" in note["text"] for row in rows for note in row["condition_notes"])
    assert all(row["condition_review"] in {"ai_note", "none"} for row in doc["rows"])
    assert any(row["condition_review"] == "none" for row in doc["rows"])
    assert "不能用于自动推理" in doc["condition_policy"]


def test_condition_note_reaches_the_hero_page():
    page = (DERIVED / "heroes/hero-60.md").read_text(encoding="utf-8")
    line = next(text for text in page.splitlines() if text.startswith("- 眩晕"))
    assert "夜" in line


def _row(review_id, basis="two_ai", decision="accept"):
    return {"review_id": review_id, "basis": basis, "decision": decision, "notes_zh": []}


def test_wrong_feedback_disputes_a_row_and_does_not_confirm_it():
    rows = [_row("a"), _row("b", "user_spot_check"), _row("c", "user:U1"), _row("d", "field:x")]
    feedback = [{"review_id": key, "verdict": "wrong", "note": "n"} for key in "abcd"]
    assert apply_feedback(rows, feedback, []) == []
    assert [row["basis"] for row in rows] == [BASIS_DISPUTED] * 4
    assert not confirmed(rows[0]["basis"])
