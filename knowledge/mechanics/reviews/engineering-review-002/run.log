"""MK-T5 reviewed facts, version 12: v11 plus U85-U89 and the split of control terms."""

from dota_items.data import mechanics_facts_v11 as v11

SCHEMA = "mechanics-facts/12"
VERSION = "mechanics-reviewed/12"
VOCABULARY = "knowledge/mechanics/vocabulary-v11.json"
RETIRED_TERMS = {"forced_action", "mobility_lock"}


def condition_label(condition):
    """Name a row condition the way reviews and rulings write it."""
    if condition.get("context") == "item":
        return "item"
    if condition.get("requires_scepter"):
        return "scepter"
    if condition.get("requires_shard"):
        return "shard"
    return "base"


def _matches(rows, entry):
    return [
        row
        for row in rows
        if row["subject"] == entry["subject"]
        and row["mechanism"] == entry["mechanism"]
        and entry.get("condition") in (None, condition_label(row["condition"]))
    ]


def _add(rows, entry, zh_names, status):
    if not entry.get("condition"):
        raise ValueError(f"New row needs a condition: {entry}")
    origin = "user_ruling" if entry["basis"].startswith("user:") else "control_audit"
    row = v11._new_row({**entry, "origin": origin, "kind": "row"}, zh_names, status)
    if origin == "control_audit":
        row["codex"] = "accept"
    rows.append(row)


def _set(rows, entry, zh_names, status):
    found = _matches(rows, entry)
    if not found:
        _add(rows, entry, zh_names, status)
    elif not entry["basis"].startswith("user:"):
        raise ValueError(f"Only a user ruling may change a row: {entry}")
    for row in found:
        row["decision"] = entry["decision"]
        row["basis"] = entry["basis"]
        row["notes_zh"] = [entry["note_zh"], *row["notes_zh"]]


def _move(rows, entry):
    moved = [row for row in _matches(rows, entry) if row["decision"] == "accept"]
    if not moved:
        raise ValueError(f"Nothing to move: {entry}")
    for row in moved:
        row["mechanism"] = entry["new"]
        row["renamed_from"] = entry["mechanism"]


def apply_rulings(doc, operations, zh_names, status):
    """Apply operations in order, then set aside rows left under retired terms."""
    rows = [{**row, "notes_zh": list(row["notes_zh"])} for row in doc["rows"]]
    for entry in operations:
        if entry["op"] == "set":
            _set(rows, entry, zh_names, status)
        elif entry["op"] == "move":
            _move(rows, entry)
        else:
            raise ValueError(f"Unknown operation: {entry}")
    retired = [row for row in rows if row["mechanism"] in RETIRED_TERMS]
    unmapped = [row for row in retired if row["decision"] == "accept" and not _replaced(row, rows)]
    if unmapped:
        raise ValueError(f"Accepted row has no new term: {unmapped}")
    kept = [row for row in rows if row["mechanism"] not in RETIRED_TERMS]
    kept.sort(key=lambda row: (row["mechanism"], row["subject"], row["review_id"]))
    decisions, basis = {}, {}
    for row in kept:
        decisions[row["decision"]] = decisions.get(row["decision"], 0) + 1
        name = row["basis"].split(":")[0]
        basis[name] = basis.get(name, 0) + 1
    counts = {
        **doc["counts"],
        "rows": len(kept),
        "decisions": decisions,
        "basis": basis,
        "retired_term_rows": len(retired),
    }
    return {**doc, "rows": kept, "retired_term_rows": retired, "counts": counts}


def _replaced(row, rows):
    """A blink lock row is covered when the subject now has root or bind."""
    return row["mechanism"] == "mobility_lock" and any(
        other["subject"] == row["subject"]
        and other["mechanism"] in {"root", "bind"}
        and other["decision"] == "accept"
        for other in rows
    )


def build_reviewed(sources):
    """v11 result with the rulings and the control split applied."""
    doc = apply_rulings(
        v11.build_reviewed(sources),
        sources["recheck_rulings"],
        sources["zh_names"],
        sources["item_status"],
    )
    return {**doc, "schema": SCHEMA, "extractor_version": VERSION, "vocabulary": VOCABULARY}
"""MK-T5 derived layer additions: say what a rule edge is, and what it is not.

A rule yields a source set and a target set, so an edge is a candidate for review. It does not
prove the pair works under every condition. Edges from pending rules are labelled and left out
of `usable_edges` by default, so a consumer cannot take them for settled relations by accident.
"""

STATUS_CANDIDATE = "candidate"
STATUS_PENDING = "pending"
SEMANTICS = "候选：规则只算来源集合和目标集合，没有逐对核对条件和例外，不等于每一对都成立"
NOT_EVALUATED = ("pairs", "target_exempt_mechanisms", "parameters")


def rule_status(rule):
    return STATUS_PENDING if rule.get("pending") else STATUS_CANDIDATE


def annotate_evaluation(evaluation, rules):
    """Add relation, status and unevaluated fields to each evaluated rule."""
    by_id = {rule["id"]: rule for rule in rules}
    annotated = []
    for entry in evaluation["rules"]:
        rule = by_id[entry["id"]]
        annotated.append(
            {
                **entry,
                "relation": rule["relation"],
                "status": rule_status(rule),
                "pending": rule.get("pending"),
                "not_evaluated": [name for name in NOT_EVALUATED if name in rule],
            }
        )
    return {
        **evaluation,
        "schema": "mechanics-rules-evaluation/2",
        "semantics": SEMANTICS,
        "rules": annotated,
    }


def _condition_notes(doc):
    """Condition notes per accepted row, in the order the graph lists that row's evidence."""
    notes = {}
    for row in doc["rows"]:
        if row["decision"] == "accept":
            notes.setdefault((row["subject"], row["mechanism"]), []).append(
                [note["text"] for note in row["condition_notes"]]
            )
    return notes


def _with_condition_notes(entry, notes):
    """Give each evidence item the notes of its own row, not of every row on that mechanism."""
    used = {}
    evidence = []
    for item in entry["evidence"]:
        rows = notes.get((entry["subject"], item["via"]), [])
        index = used.get(item["via"], 0)
        used[item["via"]] = index + 1
        evidence.append({**item, "condition_notes": rows[index] if index < len(rows) else []})
    return {**entry, "evidence": evidence}


def annotate_graph(graph, rules, doc):
    """Carry relation and status onto edges, and condition notes onto evidence."""
    by_id = {rule["id"]: rule for rule in rules}
    notes = _condition_notes(doc)
    out_rules = []
    for rule in graph["rules"]:
        source = by_id[rule["id"]]
        sides = {
            side: [_with_condition_notes(entry, notes) for entry in rule[side]]
            for side in ("sources", "targets")
        }
        out_rules.append(
            {
                **rule,
                **sides,
                "status": rule_status(source),
                "not_evaluated": [name for name in NOT_EVALUATED if name in source],
            }
        )
    edges = [
        {
            **edge,
            "relation": by_id[edge["rule"]]["relation"],
            "status": rule_status(by_id[edge["rule"]]),
            "pending": by_id[edge["rule"]].get("pending"),
        }
        for edge in graph["item_to_hero"]
    ]
    return {
        **graph,
        "schema": "mechanics-counter-graph/2",
        "semantics": SEMANTICS,
        "rules": out_rules,
        "item_to_hero": edges,
    }


def usable_edges(graph, *, confirmed_only=False, include_pending=False):
    """Edges a consumer may read; pending ones need an explicit request."""
    if graph.get("schema") != "mechanics-counter-graph/2":
        raise ValueError("Needs a counter graph that records edge status")
    return [
        edge
        for edge in graph["item_to_hero"]
        if (include_pending or edge["status"] != STATUS_PENDING)
        and (edge["confirmed"] or not confirmed_only)
    ]


def hero_relations(graph, source_hero, target_hero, *, include_pending=False):
    """Rules where one hero's abilities act on another's, with relation and status."""
    if graph.get("schema") != "mechanics-counter-graph/2":
        raise ValueError("Needs a counter graph that records edge status")
    found = []
    for rule in graph["rules"]:
        if rule["status"] == STATUS_PENDING and not include_pending:
            continue
        sources = [s for s in rule["sources"] if s.get("hero_id") == source_hero]
        targets = [t for t in rule["targets"] if t.get("hero_id") == target_hero]
        if sources and targets:
            found.append(
                {
                    "rule": rule["id"],
                    "zh": rule["zh"],
                    "relation": rule["relation"],
                    "status": rule["status"],
                    "sources": [s["subject"] for s in sources],
                    "targets": [t["subject"] for t in targets],
                    "confirmed": any(s["confirmed"] for s in sources)
                    and any(t["confirmed"] for t in targets),
                }
            )
    return found


def _readable(note):
    """The part of a condition note worth showing; template text alone says nothing."""
    text = note["text"].removeprefix("基础技能；A杖要求=False，魔晶要求=False。")
    if note["round"] == 2 or len(text) > 70:
        return ""
    for word in (
        "夜",
        "白天",
        "血量",
        "生命值低",
        "层",
        "概率",
        "几率",
        "形态",
        "近战",
        "远程",
        "击杀",
        "死亡",
        "如果",
        "持续施法期间",
    ):
        if word in text:
            return text
    return ""


def display_doc(doc):
    """Copy of the facts for profile pages, with a readable condition note first."""
    rows = []
    for row in doc["rows"]:
        shown = [text for text in map(_readable, row["condition_notes"]) if text]
        notes = [f"AI说明条件：{shown[-1]}", *row["notes_zh"]] if shown else row["notes_zh"]
        rows.append({**row, "notes_zh": notes})
    return {**doc, "rows": rows}


def display_evaluation(evaluation):
    """Copy of the evaluation with pending rules labelled in their names."""
    rules = [
        {**rule, "zh": f"【待定】{rule['zh']}"} if rule["status"] == STATUS_PENDING else rule
        for rule in evaluation["rules"]
    ]
    return {**evaluation, "rules": rules}
"""MK-T4 mechanism rules: validate them and work out which subjects they connect.

Rules state relations between mechanisms, never what to buy. Inputs are the reviewed
facts; a rule with `pending` still needs a user definition and yields no targets.
"""

RELATIONS = {"removes", "blocks", "disables", "counters", "reduces", "amplifies", "context"}


def load_rules(doc, terms):
    """Validate the rule file; return its rules."""
    if doc.get("schema") != "mechanics-rules/1":
        raise ValueError("Unsupported mechanics rules schema")
    seen = set()
    for rule in doc["rules"]:
        if rule["id"] in seen:
            raise ValueError(f"Duplicate rule: {rule['id']}")
        seen.add(rule["id"])
        if rule["relation"] not in RELATIONS:
            raise ValueError(f"{rule['id']}: unknown relation {rule['relation']}")
        if not rule.get("decision"):
            raise ValueError(f"{rule['id']}: needs a decision reference")
        for key in ("source_mechanisms", "target_mechanisms", "target_exempt_mechanisms"):
            for mechanism in rule.get(key, []):
                if mechanism not in terms:
                    raise ValueError(f"{rule['id']}: unknown mechanism {mechanism}")
    return doc["rules"]


def _subjects(rows, mechanisms):
    return {row["subject"] for row in rows if row["mechanism"] in mechanisms}


def evaluate_rule(rule, doc, game_field_subjects=None):
    """Return sorted source and target subjects for one rule."""
    rows = [row for row in doc["rows"] if row["decision"] == "accept"]
    notes = doc["skill_notes"]
    source = _subjects(rows, set(rule.get("source_mechanisms", [])))
    source |= set(rule.get("source_subjects", []))
    source |= {n["subject"] for n in notes if n["kind"] in rule.get("source_note_kinds", [])}
    target = _subjects(rows, set(rule.get("target_mechanisms", [])))
    target |= set(rule.get("target_subjects", []))
    for field, values in rule.get("target_enum", {}).items():
        target |= {
            fact["subject"]
            for fact in doc["field_observations"]
            if fact["evidence_kind"] == f"enum:{field}" and int(fact["value"]) in values
        }
    if rule.get("target_game_field"):
        target &= (game_field_subjects or {}).get(rule["target_game_field"], set())
    target -= set(rule.get("target_exclude", []))
    target -= {
        n["subject"] for n in notes if n["kind"] in rule.get("target_exclude_note_kinds", [])
    }
    return {"sources": sorted(source), "targets": sorted(target)}

