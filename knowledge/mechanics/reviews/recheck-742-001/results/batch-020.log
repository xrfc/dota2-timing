eject"}]}, {"subject": "spirit_breaker_bulldoze", "name_zh": "裂魂人·威吓", "category": "2_纯数值", "text_741f": {"desc_loc": "Spirit Breaker gains movement speed and status resistance to ram through enemies. Can be used while charging."}, "text_742": {"desc_loc": "Spirit Breaker gains movement speed and status resistance to ram through enemies. Can be used while charging."}, "changed_fields": [{"field": "duration", "old": {"base": [8], "scepter": null, "shard": null}, "new": {"base": [7], "scepter": null, "shard": null}}], "rows": [{"review_id": "220b06e3add7a79e78d0", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "c6fa9034e24a619873bc", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "reject"}, {"review_id": "928b16ea938d83ac02d2", "mechanism": "status_resistance", "mechanism_zh": "状态抗性", "definition": "缩短自身受到的控制与减益的持续时间（如散夜对剑+16%）", "condition": "base", "decision": "accept"}]}, {"subject": "spirit_breaker_charge_of_darkness", "name_zh": "裂魂人·暗影冲刺", "category": "2_纯数值", "text_741f": {"desc_loc": "Spirit Breaker fixes his sight on an enemy unit and starts charging through all objects, starting at %min_movespeed_bonus_pct%%% of the bonus speed and reaching his max speed after %windup_time%s. All enemy units passed through and the targeted unit will be hit by a Greater Bash. If the targeted unit dies, Spirit Breaker will change his target to the nearest enemy unit to that location.", "notes_loc": ["Spirit Breaker passes through trees, cliffs, and units.", "The charge indicator is visible only to allies.", "Spirit Breaker gains shared vision of the target."], "shard_loc": "Increases Charge of Darkness Bonus Speed by %bonus_movement_speed%.", "facets_loc": ["Charge of Darkness bonus movement speed lingers after charge ends."]}, "text_742": {"desc_loc": "Spirit Breaker fixes his sight on an enemy unit and starts charging through all objects, starting at %min_movespeed_bonus_pct%%% of the bonus speed and reaching his max speed after %windup_time%s. All enemy units passed through and the targeted unit will be hit by a Greater Bash. If the targeted unit dies, Spirit Breaker will change his target to the nearest enemy unit to that location.", "notes_loc": ["Spirit Breaker passes through trees, cliffs, and units.", "The charge indicator is visible only to allies.", "Spirit Breaker gains shared vision of the target."], "shard_loc": "Increases Charge of Darkness Bonus Speed by %bonus_movement_speed%.", "facets_loc": ["Charge of Darkness bonus movement speed lingers after charge ends."]}, "changed_fields": [{"field": "bash_radius", "old": {"base": [300], "scepter": null, "shard": null}, "new": {"base": [275], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:spirit_breaker_charge_of_darkness:aoe_damage:base", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "f84c099e556df0aee8dc", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "base", "decision": "accept"}, {"review_id": "649384b168e117c18736", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "6f69668e79f2304f998a", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "e0d6acb10bbfe51b045a", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "audit:spirit_breaker_charge_of_darkness:phased:base", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "base", "decision": "accept"}, {"review_id": "0ea999f9519205bbbf82", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "f65b62e8e2f835eb3313", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "audit:spirit_breaker_charge_of_darkness:terrain_walk:base", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "base", "decision": "accept"}, {"review_id": "79d8ec22e8493d9024ee", "mechanism": "tree_walk", "mechanism_zh": "穿树", "definition": "移动时能穿过树木，但不能越过悬崖或地形", "condition": "base", "decision": "reject"}, {"review_id": "281194b7594f6745f9f3", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "spirit_breaker_greater_bash", "name_zh": "裂魂人·巨力重击", "category": "2_纯数值", "text_741f": {"desc_loc": "Gives a chance to stun and knockback an enemy unit on an attack. Deals a percentage of movement speed as damage.", "notes_loc": ["Does not stack with Skull Basher.", "Break disables the passive percent Chance to Bash. Does not disable Greater Bash application from Charge of Darkness or Nether Strike."], "scepter_loc": "Increases knockback. If a knocked-back enemy collides with another enemy, the second enemy is bashed (creeps only receive %cascading_bashes_creep_penalty%%% damage), and the original target takes %cascading_bashes_damage_multiplier%%% of Greater Bash's damage again.", "facets_loc": ["Greater Bash chance is increased if you've bashed more than one hero within the last %bonus_chance_duration%s. Each additional hero past the first increases Greater Bash chance by %bonus_chance_pct%%%."]}, "text_742": {"desc_loc": "Gives a chance to stun and knockback an enemy unit on an attack. Deals a percentage of movement speed as damage.", "notes_loc": ["Does not stack with Skull Basher.", "Break disables the passive percent Chance to Bash. Does not disable Greater Bash application from Charge of Darkness or Nether Strike."], "scepter_loc": "Increases knockback. If a knocked-back enemy collides with another enemy, the second enemy is bashed (creeps only receive %cascading_bashes_creep_penalty%%% damage), and the original target takes %cascading_bashes_damage_multiplier%%% of Greater Bash's damage again.", "facets_loc": ["Greater Bash chance is increased if you've bashed more than one hero within the last %bonus_chance_duration%s. Each additional hero past the first increases Greater Bash chance by %bonus_chance_pct%%%."]}, "changed_fields": [{"field": "damage", "old": {"base": [25, 30, 35, 40], "scepter": null, "shard": null}, "new": {"base": [24, 28, 32, 36], "scepter": null, "shard": null}}], "rows": [{"review_id": "78516525145627e3d135", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "de015b6e277f2cb048c1", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "60a99ae539a64ab120c9", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "dfbe6bc76b82823c356e", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "base", "decision": "accept"}, {"review_id": "2fb99ff4f444ca8f6c35", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "75e661773bf64e5c4a35", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "4a72bbbb2385347aa0fe", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "6bd5f2a55789ae9a5b0d", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "reject"}, {"review_id": "c3c67c6208c62e71d4ae", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "spirit_breaker_planar_pocket", "name_zh": "裂魂人·位面空洞", "category": "2_纯数值", "text_741f": {"desc_loc": "Barathrum gains magic resistance and distorts reality around the selected hero, making any unit-targeted spells cast by enemy heroes get redirected towards Spirit Breaker. Can be cast on both allied and enemy heroes, but only spells cast by enemies of Spirit Breaker will be redirected.", "notes_loc": ["Planar Pocket's effect stops if Barathrum moves %break_distance% units away from the target."]}, "text_742": {"desc_loc": "Barathrum gains magic resistance and distorts reality around the selected hero, making any unit-targeted spells cast by enemy heroes get redirected towards Spirit Breaker. Can be cast on both allied and enemy heroes, but only spells cast by enemies of Spirit Breaker will be redirected.", "notes_loc": ["Planar Pocket's effect stops if Barathrum moves %break_distance% units away from the target."]}, "changed_fields": [{"field": "magic_resistance", "old": {"base": [40], "scepter": null, "shard": null}, "new": {"base": [50], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:spirit_breaker_planar_pocket:spell_block:shard", "mechanism": "spell_block", "mechanism_zh": "格挡指向技能", "definition": "使指向自身或队友的技能失效", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "704bf8f05db03f967670", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "storm_spirit_galvanized", "name_zh": "风暴之灵·通电", "category": "2_纯数值", "text_741f": {"desc_loc": "Storm Spirit gains a charge of %mp_per_kill% mana regeneration per kill, and a charge every %level_divisor% levels. Loses %charges_per_death% charges per death. Additionally every time he gains a charge he also gains %perma_mp_per_kill% Mana Regen permanently.", "notes_loc": ["Break disables the gaining of new stacks from kills."]}, "text_742": {"desc_loc": "Storm Spirit gains a charge of %mp_per_kill% mana regeneration per kill, and a charge every %level_divisor% levels. Loses %charges_per_death% charges per death. Additionally every time he gains a charge he also gains %perma_mp_per_kill% Mana Regen permanently.", "notes_loc": ["Break disables the gaining of new stacks from kills."]}, "changed_fields": [{"field": "mp_per_kill", "old": {"base": [0.2], "scepter": null, "shard": null}, "new": {"base": [0.25], "scepter": null, "shard": null}}], "rows": [{"review_id": "d6944247f78dd70bf44f", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "5e3d417d4c0856f6ef9d", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "df91fcf3bcd3ba2cb998", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}]}, {"subject": "storm_spirit_overload", "name_zh": "风暴之灵·超负荷", "category": "2_纯数值", "text_741f": {"desc_loc": "Casting a spell creates an electrical charge, which is released in a burst on Storm's next attack, dealing damage and slowing nearby enemies.", "notes_loc": ["Using items doesn't trigger Overload.", "Overload charges do not stack."], "shard_loc": "Can be activated to grant Storm Spirit and nearby allied heroes %shard_activation_charges% Overload charges. Provides bonus Attack Speed. Lasts up to %shard_activation_duration% seconds or until the charges are depleted."}, "text_742": {"desc_loc": "Casting a spell creates an electrical charge, which is released in a burst on Storm's next attack, dealing damage and slowing nearby enemies.", "notes_loc": ["Using items doesn't trigger Overload.", "Overload charges do not stack."], "shard_loc": "Can be activated to grant Storm Spirit and nearby allied heroes %shard_activation_charges% Overload charges. Provides bonus Attack Speed. Lasts up to %shard_activation_duration% seconds or until the charges are depleted."}, "changed_fields": [], "rows": [{"review_id": "bca8ed44da80e728e0ee", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:storm_spirit_overload:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "cb0a6d9d0183f2f1674c", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "1304d228fd116ec2cb5b", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "4dcce04ae8a8e32262cf", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "2f36682cf1ffd792a1fa", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "sven_storm_bolt", "name_zh": "斯温·风暴之拳", "category": "3_说明文字", "text_741f": {"desc_loc": "Sven unleashes his magical gauntlet that deals damage and stuns enemy units in a small area around the target.", "scepter_loc": "Increases cast range and applies a basic dispel on the target. Affects invulnerable units. If alt-cast, it deals an additional %scepter_bonus_damage% damage and Sven travels with the Storm Hammer."}, "text_742": {"desc_loc": "Sven unleashes his magical gauntlet that deals damage and stuns enemy units in a small area around the target.", "scepter_loc": "Increases cast range to %AbilityCastRange% and applies a basic dispel on the target. Affects invulnerable units. If alt-cast, it deals an additional %scepter_bonus_damage% damage and Sven travels with the Storm Hammer."}, "changed_fields": [{"field": "AbilityCastRange", "old": {"base": [600], "scepter": [25], "shard": null}, "new": {"base": [600], "scepter": [30], "shard": null}}, {"field": "bolt_speed", "old": {"base": [1000], "scepter": [25], "shard": null}, "new": {"base": [1000], "scepter": [30], "shard": null}}], "rows": [{"review_id": "06ac483ed200d6b74c3a", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "2e90d6568e9b7abbcb0a", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "8c083629c3db5bd44b95", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "scepter_upgrade", "decision": "reject"}, {"review_id": "audit:sven_storm_bolt:self_mobility:scepter", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "9e54cbf9bcb99ff678d4", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "audit:sven_storm_bolt:terrain_walk:scepter", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "4e4efbc17e9a42799000", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "sven_warcry", "name_zh": "斯温·战吼", "category": "2_纯数值", "text_741f": {"desc_loc": "Sven's Warcry heartens his allied heroes for battle, increasing their armor and movement speed. Lasts %duration% seconds.", "shard_loc": "Increases radius and bonus movement speed. Warcry is now undispellable and provides a %base_barrier_amount% physical damage barrier."}, "text_742": {"desc_loc": "Sven's Warcry heartens his allied heroes for battle, increasing their armor and movement speed. Lasts %duration% seconds.", "shard_loc": "Increases radius and bonus movement speed. Warcry is now undispellable and provides a %base_barrier_amount% physical damage barrier."}, "changed_fields": [{"field": "mana_costs", "old": [30, 35, 40, 45], "new": [45]}, {"field": "AbilityManaCost", "old": {"base": [30, 35, 40, 45], "scepter": null, "shard": null}, "new": {"base": [45], "scepter": null, "shard": null}}, {"field": "base_barrier_amount", "old": {"base": [0], "scepter": null, "shard": [300]}, "new": {"base": [0], "scepter": null, "shard": [350]}}], "rows": [{"review_id": "d19e821220939d65e59a", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "287d0bfe2c98176493f0", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "4551c19450ea7cefae81", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}]}, {"subject": "techies_land_mines", "name_zh": "工程师·感应地雷", "category": "2_纯数值", "text_741f": {"desc_loc": "Plant an invisible mine that cannot be detected by True Sight, but is visible if an enemy is within the active %radius% AoE of the mine. Mines detonate if an enemy is standing within the active AoE for %proximity_threshold% seconds dealing damage and temporarily reducing the enemy's Magic Resistance. The explosion deals full damage if the target is within %min_distance% radius and decreases down to %outer_damage%%% on the edge. Deals %building_damage_pct%%% damage to buildings.", "notes_loc": ["Cannot be placed within %placement_radius% AoE of another Proximity Mine.", "Proximity Mines do not block neutral creep camps from spawning.", "Mines last until they explode or are destroyed.", "Mines are triggered by invisible units.", "Grants 30 gold if destroyed by an enemy hero."]}, "text_742": {"desc_loc": "Plant an invisible mine that cannot be detected by True Sight, but is visible if an enemy is within the active %radius% AoE of the mine. Mines detonate if an enemy is standing within the active AoE for %proximity_threshold% seconds dealing damage and temporarily reducing the enemy's Magic Resistance. The explosion deals full damage if the target is within %min_distance% radius and decreases down to %outer_damage%%% on the edge. Deals %building_damage_pct%%% damage to buildings.", "notes_loc": ["Cannot be placed within %placement_radius% AoE of another Proximity Mine.", "Proximity Mines do not block neutral creep camps from spawning.", "Mines last until they explode or are destroyed.", "Mines are triggered by invisible units.", "Grants 30 gold if destroyed by an enemy hero."]}, "changed_fields": [{"field": "cooldowns", "old": [0], "new": [0.25]}, {"field": "mana_costs", "old": [110, 140, 170], "new": [125, 175, 225]}, {"field": "AbilityChargeRestoreTime", "old": {"base": [15], "scepter": null, "shard": null}, "new": {"base": [14, 13, 12], "scepter": null, "shard": null}}, {"field": "AbilityCooldown", "old": null, "new": {"base": [0.25], "scepter": null, "shard": null}}, {"field": "AbilityManaCost", "old": {"base": [110, 140, 170], "scepter": null, "shard": null}, "new": {"base": [125, 175, 225], "scepter": null, "shard": null}}, {"field": "mres_reduction", "old": {"base": [15, 20, 25], "scepter": null, "shard": null}, "new": {"base": [12, 16, 20], "scepter": null, "shard": null}}, {"field": "tooltip_health_pips", "old": null, "new": {"base": [1], "scepter": null, "shard": null}}], "rows": [{"review_id": "a5e7656ab5a917f115c8", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "fa99e427702a4c46dd6b", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "accept"}, {"review_id": "3ea1265204540be69b41", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "reject"}, {"review_id": "e9b15acc67a40fb95cf4", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "92ada6901f6cc5a6ab72", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "base", "decision": "accept"}, {"review_id": "740d2e5e9da25a90337b", "mechanism": "reveal", "mechanism_zh": "显形", "definition": "使隐身单位显形，不等于持续真视", "condition": "base", "decision": "reject"}]}, {"subject": "techies_mutually_assured_destruction", "name_zh": "工程师·同归于尽", "category": "3_说明文字", "text_741f": {"desc_loc": "Techies gain a percentage of their mana pool as bonus mana regeneration. When Techies die, they leave behind a barrel that explodes after %explosion_delay%s, damaging enemies in an area around it. Damage is based on Techies' max mana.", "shard_loc": "M.A.D. becomes an active ability. Increases max mana as damage amount. Techies plant an M.A.D. which can be detonated manually with a sub-ability. Only one M.A.D. from the active ability can be placed at a time."}, "text_742": {"desc_loc": "Techies gain a percentage of their mana pool as bonus mana regeneration. When Techies die, they leave behind a barrel that explodes after %explosion_delay%s, damaging enemies in an area around it. Damage is based on Techies' max mana.", "notes_loc": ["Break disables the bonus mana regeneration."], "shard_loc": "M.A.D. becomes an active ability. Increases max mana as damage amount. Techies plant a M.A.D. which can be detonated manually with a sub-ability. Only one M.A.D. from the active ability can be placed at a time."}, "changed_fields": [{"field": "max_mana_pct_as_damage", "old": {"base": [30], "scepter": null, "shard": [10]}, "new": {"base": [30], "scepter": null, "shard": [15]}}, {"field": "tooltip_health_pips", "old": null, "new": {"base": [0], "scepter": null, "shard": [3]}}], "rows": [{"review_id": "557ede12f295eab63b68", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "978d8b9683010b6cff8e", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "a423e7ed6315548d992b", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}]}, {"subject": "techies_reactive_tazer", "name_zh": "工程师·活性电击", "category": "2_纯数值", "text_741f": {"desc_loc": "Techies trigger an electric charge on the target ally, giving them bonus movement speed for a short period of time. Enemies attacking the target take damage and are temporarily disarmed and get a Basic Dispel. At the end of the effect or if detonated early with the sub-ability, the charge explodes, disarming all enemies within the radius and dealing damage."}, "text_742": {"desc_loc": "Techies trigger an electric charge on the target ally, giving them bonus movement speed for a short period of time. Enemies attacking the target take damage and are temporarily disarmed and get a Basic Dispel. At the end of the effect or if detonated early with the sub-ability, the charge explodes, disarming all enemies within the radius and dealing damage."}, "changed_fields": [], "rows": [{"review_id": "0a0c7c83751c9be8e81e", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "1b288746f8887ac9abee", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "ba28fdb96d5dad492dd0", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "audit:techies_reactive_tazer:damage_return:base", "mechanism": "damage_return", "mechanism_zh": "反伤", "definition": "受到攻击或伤害时触发的反击伤害：按比例返还所受伤害、固定值反击，或受伤触发的范围伤害（如半人马·反伤、斧王·反击螺旋、钢毛后背）；攻击者不一定被打到也算，记条件", "condition": "base", "decision": "accept"}, {"review_id": "a3fd87611e1428721a98", "mechanism": "disarm", "mechanism_zh": "缴械", "definition": "目标无法普通攻击", "condition": "base", "decision": "accept"}, {"review_id": "26996d10e942b81b1f8d", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}]}, {"subject": "techies_sticky_bomb", "name_zh": "工程师·粘性炸弹", "category": "2_纯数值", "text_741f": {"desc_loc": "Lobs a Sticky Bomb towards the target area. If it lands next to an enemy hero, the bomb will stick to it, slowing its movement speed. After a few seconds the bomb will explode, dealing damage in an area around the detonation and applying a secondary slow for %secondary_slow_duration% seconds."}, "text_742": {"desc_loc": "Lobs a Sticky Bomb towards the target area. If it lands next to an enemy hero, the bomb will stick to it, slowing its movement speed. After a few seconds the bomb will explode, dealing damage in an area around the detonation and applying a secondary slow for %secondary_slow_duration% seconds."}, "changed_fields": [{"field": "countdown", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [1.5], "scepter": null, "shard": null}}, {"field": "explosion_stun_duration", "old": null, "new": {"base": [], "scepter": null, "shard": null}}, {"field": "stun_on_explosion", "old": null, "new": {"base": [], "scepter": null, "shard": null}}], "rows": [{"review_id": "82109c0e227f6cf4f064", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "cf84000385639fc599d9", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "templar_assassin_psionic_trap", "name_zh": "圣堂刺客·灵能陷阱", "category": "3_说明文字", "text_741f": {"desc_loc": "Templar Assassin places mystical traps that invisibly monitor enemy movement. When sprung at her command, they exert a slowing influence of %movement_speed_min%%% in a %trap_radius% radius. Trap movement slow charges up to %movement_speed_max%%% after %trap_max_charge_duration% seconds. Deals damage after %trap_max_charge_duration%s.", "notes_loc": ["Traps last indefinitely.", "They have invisibility that fades in over %trap_fade_time% seconds and spell immunity. They take 2 hits to kill by ranged heroes, 1 by melee heroes, and 4 by creeps.", "Traps have 250/250 vision range and don't prevent neutral camps from spawning."], "scepter_loc": "When activated, traps now silence affected enemies."}, "text_742": {"desc_loc": "Templar Assassin places mystical traps that invisibly monitor enemy movement. When sprung at her command, they exert a slowing influence of %movement_speed_min%%% in a %trap_radius% radius. Trap movement slow charges up to %movement_speed_max%%% after %trap_max_charge_duration% seconds. Deals damage after %trap_max_charge_duration%s.", "notes_loc": ["Traps last indefinitely.", "They have invisibility that fades in over %trap_fade_time% seconds and spell immunity. Creeps and illusions deal 25% damage to them.", "Traps have 250/250 vision range and don't prevent neutral camps from spawning.", "Traps have fragile pips: melee heroes and Roshan remove 2 pips per attack."], "scepter_loc": "When activated, traps now silence affected enemies."}, "changed_fields": [{"field": "cast_ranges", "old": [1800], "new": [1600, 1800, 2000]}, {"field": "AbilityCastRange", "old": {"base": [1800], "scepter": null, "shard": null}, "new": {"base": [1600, 1800, 2000], "scepter": null, "shard": null}}, {"field": "trap_health", "old": null, "new": {"base": [2], "scepter": null, "shard": null}}], "rows": [{"review_id": "990732b2712bfe40eafe", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "41165de79d9050e20f8c", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "a1407ab1ee626e155030", "mechanism": "debuff_immunity", "mechanism_zh": "减益免疫/技能免疫", "definition": "处于减益免疫（技能免疫）时，只有能无视减益免疫的效果才对其生效（如碎颅锤的重击可以眩晕开了黑皇杖的单位）", "condition": "base", "decision": "accept"}, {"review_id": "6c7e8e38672e2ebe8307", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "89d29295a011fa35c18a", "mechanism": "silence", "mechanism_zh": "沉默", "definition": "目标无法施放技能（仍可攻击、使用物品）", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "b1b308e00a2da3b05d3e", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "terrorblade_demon_zeal", "name_zh": "恐怖利刃·狂魔", "category": "2_纯数值", "text_741