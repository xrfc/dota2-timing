d": "bonus_movement_speed_ranged", "old": null, "new": {"base": [45], "scepter": null, "shard": null}}], "rows": [{"review_id": "7c6901fa2d3e4e9970b0", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}, {"review_id": "f4b91c9fc6490ca8d833", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "item", "decision": "accept"}]}, {"subject": "phoenix_sun_ray", "name_zh": "凤凰·烈日炙烤", "category": "2_纯数值", "text_741f": {"desc_loc": "Phoenix expels a beam of light at the cost of its own health. The beam damages enemies and heals allies for a base amount plus a percentage of their max health. The percentage increases as the beam continues to fire.", "notes_loc": ["Sun Ray has a width of %radius% units, and a length of %abilitycastrange% units.", "Sun Ray is canceled if Phoenix gets stunned, silenced, cycloned, hexed or slept.", "Phoenix can use items and abilities without canceling Sun Ray."], "shard_loc": "Allows Sun Ray to be cast during Supernova."}, "text_742": {"desc_loc": "Phoenix expels a beam of light at the cost of its own health. The beam damages enemies and heals allies for a base amount plus a percentage of their max health. The percentage increases as the beam continues to fire.", "notes_loc": ["Sun Ray has a width of %radius% units, and a length of %abilitycastrange% units.", "Sun Ray is canceled if Phoenix gets stunned, silenced, cycloned, hexed or slept.", "Phoenix can use items and abilities without canceling Sun Ray."], "shard_loc": "Allows Sun Ray to be cast during Supernova."}, "changed_fields": [{"field": "mana_costs", "old": [100, 110, 120, 130], "new": [90, 105, 120, 135]}, {"field": "AbilityManaCost", "old": {"base": [100, 110, 120, 130], "scepter": null, "shard": null}, "new": {"base": [90, 105, 120, 135], "scepter": null, "shard": null}}, {"field": "base_damage", "old": {"base": [15, 20, 25, 30], "scepter": null, "shard": null}, "new": {"base": [20, 25, 30, 35], "scepter": null, "shard": null}}], "rows": [{"review_id": "6e361d7bbbde4b97ffbc", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "ed42c8c2537976e46a87", "mechanism": "channel_interrupt", "mechanism_zh": "打断持续施法", "definition": "说明明确写打断持续施法；眩晕、沉默等已有控制不重复记", "condition": "base", "decision": "reject"}, {"review_id": "534860cf3f3f7cf4e803", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "aff2bf1baa66b0e200c5", "mechanism": "silence", "mechanism_zh": "沉默", "definition": "目标无法施放技能（仍可攻击、使用物品）", "condition": "base", "decision": "reject"}, {"review_id": "b8ecaf866e2f2a509aac", "mechanism": "sleep", "mechanism_zh": "睡眠", "definition": "无法行动，受伤害后醒来", "condition": "base", "decision": "reject"}, {"review_id": "af8618c1c17739dbfa6a", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "reject"}]}, {"subject": "phoenix_supernova", "name_zh": "凤凰·超新星", "category": "3_说明文字", "text_741f": {"desc_loc": "The Phoenix willingly ends its current life for the chance to be reborn. Transforms into a burning sun that scorches enemies in a huge area. The sun can be destroyed by attacks from enemy Heroes. After %abilityduration% seconds the sun explodes, stunning all nearby enemies while restoring Phoenix to full health and mana with refreshed abilities. DISPEL TYPE: Strong Dispel", "scepter_loc": "Increases number of attacks to destroy Supernova and allows Phoenix to cast Supernova on an allied hero, bringing both into the sun to be reborn together."}, "text_742": {"desc_loc": "The Phoenix willingly ends its current life for the chance to be reborn. Transforms into a burning sun that scorches enemies in a huge area. The sun has pip health. Creeps and illusions deal 25% damage to the sun. After %abilityduration% seconds the sun explodes, stunning all nearby enemies while restoring Phoenix to full health and mana with refreshed abilities. DISPEL TYPE: Strong Dispel", "scepter_loc": "Increases Supernova's pip health and allows Phoenix to cast Supernova on an allied hero, bringing both into the sun to be reborn together."}, "changed_fields": [{"field": "stun_duration", "old": {"base": [1.6, 2, 2.4], "scepter": null, "shard": null}, "new": {"base": [1.8, 2.1, 2.4], "scepter": null, "shard": null}}], "rows": [{"review_id": "5142545a2ec4a634ef28", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "b3792bc9cfa0a763b57c", "mechanism": "applies_strong_dispel", "mechanism_zh": "施加强驱散", "definition": "移除目标身上可被强驱散的效果（含多数眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "audit:phoenix_supernova:aura:base", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "base", "decision": "accept"}, {"review_id": "audit:phoenix_supernova:cooldown_reset:base", "mechanism": "cooldown_reset", "mechanism_zh": "刷新冷却", "definition": "立刻重置冷却", "condition": "base", "decision": "accept"}, {"review_id": "audit:phoenix_supernova:healing:base", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "354a424bb6ea1ad31e5e", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}, {"review_id": "9b506f6f2bfe56ca4851", "mechanism": "respawn", "mechanism_zh": "重生", "definition": "死亡后复活，或影响复活", "condition": "base", "decision": "accept"}, {"review_id": "b08e4fe99ceb96405382", "mechanism": "respawn", "mechanism_zh": "重生", "definition": "死亡后复活，或影响复活", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "867d805275e77e2ac98b", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "phylactery", "name_zh": "灵匣", "category": "3_说明文字", "text_741f": {"desc_loc": "Passive: Empower Spell The next Unit Target spell you cast on an enemy deals a separate %bonus_spell_damage% bonus damage to the target and slows them by %slow%%% for %slow_duration%s."}, "text_742": {"desc_loc": "Passive: Empower Spell The next Unit Target spell you cast on an enemy deals a separate %bonus_spell_damage% bonus damage to the target and slows them by %slow%%% for %slow_duration%s."}, "changed_fields": [{"field": "cooldowns", "old": [9], "new": [8]}, {"field": "AbilityCooldown", "old": {"base": [9], "scepter": null, "shard": null}, "new": {"base": [8], "scepter": null, "shard": null}}, {"field": "bonus_spell_damage", "old": {"base": [150], "scepter": null, "shard": null}, "new": {"base": [130], "scepter": null, "shard": null}}, {"field": "slow", "old": {"base": [30], "scepter": null, "shard": null}, "new": {"base": [40], "scepter": null, "shard": null}}, {"field": "slow_duration", "old": {"base": [3], "scepter": null, "shard": null}, "new": {"base": [2], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:phylactery:healing:item", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "item", "decision": "accept"}, {"review_id": "3b95924d43619c222bbd", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}, {"review_id": "8f6d1bdf00637fa34095", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "item", "decision": "accept"}, {"review_id": "b619500fa49440ddd5f9", "mechanism": "spell_amp", "mechanism_zh": "法术放大", "definition": "提高技能造成的伤害", "condition": "item", "decision": "reject"}]}, {"subject": "pipe", "name_zh": "洞察烟斗", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Active: Barrier Gives a magic damage barrier that absorbs %barrier_block% damage to all nearby allies. Lasts %barrier_duration% seconds. Radius: %barrier_radius% Passive: Insight Aura Gives allied units %magic_resistance_aura%%% magic resistance. Radius: %aura_radius%", "notes_loc": ["Barrier does not affect units that have been affected by Barrier within Pipe of Insight's cooldown.", "Stacks multiplicatively with other sources of magic resistance."]}, "text_742": {"desc_loc": "Active: Barrier Gives a magic damage barrier that absorbs %barrier_block% damage to all nearby allies. Lasts %barrier_duration% seconds. Radius: %barrier_radius% Passive: Insight Aura Gives allied units %magic_resistance_aura%%% magic resistance. Radius: %aura_radius%", "notes_loc": ["Barrier does not affect units that have been affected by Barrier within Pipe of Insight's cooldown.", "Stacks multiplicatively with other sources of magic resistance."]}, "changed_fields": [{"field": "dispellable", "old": 0, "new": 2}, {"field": "cooldowns", "old": [60], "new": [50]}, {"field": "AbilityCooldown", "old": {"base": [60], "scepter": null, "shard": null}, "new": {"base": [50], "scepter": null, "shard": null}}], "rows": [{"review_id": "91966fcae9096ad74d38", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "reject"}, {"review_id": "dce4d634ee69bdcecfc6", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "item", "decision": "accept"}, {"review_id": "54a8041616495ab6f4ad", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "item", "decision": "accept"}, {"review_id": "audit:pipe:healing:item", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "item", "decision": "accept"}]}, {"subject": "power_treads", "name_zh": "动力鞋", "category": "5_增删或退出", "text_741f": {}, "text_742": {"desc_loc": "Active: Switch Attribute Switches between +%bonus_stat% Strength, +%bonus_stat% Agility, or +%bonus_stat% Intelligence. Movement speed bonuses from multiple pairs of boots do not stack.", "notes_loc": ["Power Treads can be built using a Belt of Strength, Band of Elvenskin, or a Robe of the Magi."]}, "changed_fields": [{"field": "behavior", "old": null, "new": "2052"}, {"field": "target_team", "old": null, "new": 0}, {"field": "target_type", "old": null, "new": 0}, {"field": "flags", "old": null, "new": 0}, {"field": "damage", "old": null, "new": 0}, {"field": "immunity", "old": null, "new": 0}, {"field": "dispellable", "old": null, "new": 0}, {"field": "ability_has_scepter", "old": null, "new": false}, {"field": "ability_has_shard", "old": null, "new": false}, {"field": "cast_ranges", "old": null, "new": [0]}, {"field": "cast_points", "old": null, "new": [0]}, {"field": "channel_times", "old": null, "new": [0]}, {"field": "cooldowns", "old": null, "new": [0]}, {"field": "durations", "old": null, "new": [0]}, {"field": "damages", "old": null, "new": [0, 0, 0, 0]}, {"field": "mana_costs", "old": null, "new": [0]}, {"field": "health_costs", "old": null, "new": []}, {"field": "item_cost", "old": null, "new": 1400}, {"field": "bonus_attack_speed", "old": null, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "bonus_movement_speed_melee", "old": null, "new": {"base": [55], "scepter": null, "shard": null}}, {"field": "bonus_movement_speed_ranged", "old": null, "new": {"base": [45], "scepter": null, "shard": null}}, {"field": "bonus_stat", "old": null, "new": {"base": [10], "scepter": null, "shard": null}}], "rows": [{"review_id": "d115cae8ca094dabe6e6", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}]}, {"subject": "primal_beast_rock_throw", "name_zh": "獸·砸", "category": "3_说明文字", "text_741f": {"desc_loc": "Primal Beast throws a rock at the target location that stuns and damages enemies. The rock cannot be thrown within a minimum range of Primal Beast. After landing, the rock splits into 3 additional fragments that land behind the initial target location. Rock Throw increases stacks of Uproar for each hero hit."}, "text_742": {"desc_loc": "Primal Beast throws a rock at the target location that stuns enemies and deals %base_damage% + %damage_str_pct%%% STR damage. The rock cannot be thrown within a minimum range of Primal Beast. After landing, the rock splits into 3 additional fragments that land behind the initial target location. Rock Throw increases stacks of Uproar for each hero hit."}, "changed_fields": [{"field": "base_damage", "old": {"base": [325], "scepter": null, "shard": null}, "new": {"base": [300], "scepter": null, "shard": null}}, {"field": "damage_str_pct", "old": null, "new": {"base": [100], "scepter": null, "shard": null}}], "rows": [{"review_id": "d1890545484d1e7d30a7", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "02b70f5cff1185627ef1", "mechanism": "cleave", "mechanism_zh": "分裂溅射", "definition": "攻击伤害波及周围单位", "condition": "base", "decision": "reject"}, {"review_id": "ae17309ba6ec697f1d17", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "puck_dream_coil", "name_zh": "帕克·梦境缠绕", "category": "2_纯数值", "text_741f": {"desc_loc": "Creates a coil of volatile magic that latches onto enemy Heroes, damaging and leashing them. If the enemy hero stretches the coil by moving too far away, it snaps, stunning and dealing additional damage.", "scepter_loc": "All enemies affected by Dream Coil are attacked at a rate equal to %attack_rate_pct%%% of Puck's attack rate. The attacks continue while the target is stunned if they break the Dream Coil."}, "text_742": {"desc_loc": "Creates a coil of volatile magic that latches onto enemy Heroes, damaging and leashing them. If the enemy hero stretches the coil by moving too far away, it snaps, stunning and dealing additional damage.", "scepter_loc": "All enemies affected by Dream Coil are attacked at a rate equal to %attack_rate_pct%%% of Puck's attack rate. The attacks continue while the target is stunned if they break the Dream Coil."}, "changed_fields": [{"field": "cooldowns", "old": [75], "new": [80, 75, 70]}, {"field": "AbilityCooldown", "old": {"base": [75], "scepter": null, "shard": null}, "new": {"base": [80, 75, 70], "scepter": null, "shard": null}}], "rows": [{"review_id": "45da1b3ede10dfd77af7", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "audit:puck_dream_coil:aoe_damage:base", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "b1a444f9d631d664ceca", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "reject"}, {"review_id": "d5b9f097eb8be3376f2f", "mechanism": "leash", "mechanism_zh": "束缚", "definition": "目标还能走，但被限制在一定范围内或被拴住走不远，闪烁和传送类不能用", "condition": "base", "decision": "accept"}, {"review_id": "72f4e4bf28b69c04782c", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "base", "decision": "reject"}, {"review_id": "813c1e098956bc6d5f09", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "scepter_upgrade", "decision": "reject"}, {"review_id": "aab4edb47c445475a948", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "puck_waning_rift", "name_zh": "帕克·新月之痕", "category": "2_纯数值", "text_741f": {"desc_loc": "Puck teleports to the target location and releases a burst of faerie dust that deals damage and silences enemy units nearby.", "facets_loc": ["Waning Rift pushes enemies away. If the ability is in alt-cast state, it will pull them instead."]}, "text_742": {"desc_loc": "Puck teleports to the target location and releases a burst of faerie dust that deals damage and silences enemy units nearby.", "facets_loc": ["Waning Rift pushes enemies away. If the ability is in alt-cast state, it will pull them instead."]}, "changed_fields": [{"field": "cooldowns", "old": [16, 15, 14, 13], "new": [15, 14, 13, 12]}, {"field": "AbilityCooldown", "old": {"base": [16, 15, 14, 13], "scepter": null, "shard": null}, "new": {"base": [15, 14, 13, 12], "scepter": null, "shard": null}}], "rows": [{"review_id": "37c1e06237a5e972c876", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "5bc4827e577541980230", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "1a1c56a18d5c8bfeec39", "mechanism": "silence", "mechanism_zh": "沉默", "definition": "目标无法施放技能（仍可攻击、使用物品）", "condition": "base", "decision": "accept"}]}, {"subject": "pudge_dismember", "name_zh": "帕吉·肢解", "category": "2_纯数值", "text_741f": {"desc_loc": "CHANNELED - Pudge chows down on an enemy unit, disabling it and dealing damage over time. Damage is increased by Pudge's Strength and heals him for the total amount. Pudge pulls the unit at a rate of %pull_units_per_second% units, up to a minimum of %pull_distance_limit% range.", "notes_loc": ["If a unit becomes invisible while Dismembered, it will still be under the effects of Dismember."], "facets_loc": ["Dismember increases Strength when dealing damage to heroes."]}, "text_742": {"desc_loc": "CHANNELED - Pudge chows down on an enemy unit, disabling it and dealing damage over time. Damage is increased by Pudge's Strength and heals him for the total amount. Pudge pulls the unit at a rate of %pull_units_per_second% units, up to a minimum of %pull_distance_limit% range.", "notes_loc": ["If a unit becomes invisible while Dismembered, it will still be under the effects of Dismember."], "facets_loc": ["Dismember increases Strength when dealing damage to heroes."]}, "changed_fields": [{"field": "strength_damage", "old": {"base": [0.3, 0.6, 0.9], "scepter": null, "shard": null}, "new": {"base": [0.3, 0.5, 0.7], "scepter": null, "shard": null}}], "rows": [{"review_id": "c59bd5e4a8e83e68666e", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "0c806faeb301cd13063f", "mechanism": "channeled", "mechanism_zh": "持续施法", "definition": "施法者自身需要持续引导，被打断即停止", "condition": "base", "decision": "accept"}, {"review_id": "c1c0a6a1acb19862a69b", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "9a32114bd655cb3921ea", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "55f03d5e069745765658", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "audit:pudge_dismember:lifesteal:base", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}, {"review_id": "audit:pudge_dismember:stun:base", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "5a3a511df769042a7d74", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "pudge_meat_hook", "name_zh": "帕吉·肉钩", "category": "3_说明文字", "text_741f": {"desc_loc": "Launches a bloody hook toward a unit or location. The hook will snag the first unit it encounters, dragging the unit back to Pudge, killing it if it's a non-ancient creep and dealing damage if it is an enemy otherwise.", "notes_loc": ["Interrupts channeling spells of the primary target if it's an enemy.", "Meat Hook hits invisible units.", "Meat Hook can go through trees, cliffs, buildings, ancient units and Roshan.", "Meat Hook can drag friendly units, but they won't be damaged.", "Meat Hook can hit and drag runes to Pudge, refunding the Hook's mana cost."], "shard_loc": "When Meat Hook hits an enemy, it deals bonus damage based on the distance pulled. When Meat Hook hits an ally, Meat Hook's cooldown is reduced by %cooldown_reduction_pct_allied_hook%%%.", "facets_loc": ["Meat Hook deals bonus damage based on the distance pulled, but base damage is reduced."]}, "text_742": {"desc_loc": "Launches a bloody hook toward a unit or location. The hook will snag the first unit it encounters, dragging the unit back to Pudge, killing it if it's a non-ancient creep and dealing damage if it is an enemy otherwise.", "notes_loc": ["Interrupts channeling spells of the primary target if it's an enemy.", "Meat Hook hits invisible units.", "Meat Hook can go through trees, cliffs, buildings, ancient units and Roshan.", "Meat Hook can drag friendly units, but they won't be damaged.", "Meat Hook can hit and drag runes to Pudge, refunding the Hook's mana cost."], "shard_loc": "Increases range. When Meat Hook hits an enemy, it deals bonus damage based on the distance pulled.", "facets_loc": ["Meat Hook deals bonus damage based on the distance pulled, but base damage is reduced."]}, "changed_fields": [{"field": "AbilityCastRange", "old": {"base": [1300], "scepter": null, "shard": null}, "new": {"base": [1300], "scepter": null, "shard": [100]}}, {"field": "cooldown_reduction_pct_allied_hook", "old": {"base": [0], "scepter": null, "shard": [50]}, "new": {"base": [0], "scepter": null, "shard": [0]}}], "rows": [{"review_id": "7a480add2125b604a894", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "c81e58a5173bb24041df", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "5ee3b680453f2297c6bc", "mechanism": "channel_interrupt", "mechanism_zh": "打断持续施法", "definition": "说明明确写打断持续施法；眩晕、沉默等已有控制不重复记", "condition": "base", "decision": "accept"}, {"review_id": "5f5e03d8a276a1f2b8ef", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "audit:pudge_meat_hook:displace_other:base", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "1aa1e012f2e1a57edb39", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "7f2882ccd2906d8baaca", "mechanism": "tree_walk", "mechanism_zh": "穿树", "definition": "移动时能穿过树木，但不能越过悬崖或地形", "condition": "base", "decision": "reject"}]}, {"subject": "pugna_decrepify", "name_zh": "帕格纳·衰老", "category": "3_说明文字", "text_741f": {"desc_loc": "A powerful banishing spell that slows a unit and renders it unable to attack or be attacked. Healing on affected allies is increased, while afflicted enemies take extra magic damage instead.", "notes_loc": ["Only magical and pure damage can affect a unit under the effects of Decrepify.", "Doesn't slow allied units.", "Can be used on your Nether Ward."]}, "text_742": {"desc_loc": "A powerful banishing spell that slows a unit and renders it unable to attack or be attacked. Healing received and dealt by affected allies is increased, while afflicted enemies take extra magic damage instead.", "notes_loc": ["Only magical and pure damage can affect a unit under the effects of Decrepify.", "Doesn't slow allied units.", "Can be used on your Nether Ward."]}, "changed_fields": [{"field": "mana_costs", "old": [80], "new": [50, 60, 70, 80]}, {"field": "AbilityManaCost", "old": {"base": [80], "scepter": null, "shard": null}, "new": {"base": [50, 60, 70, 80], "scepter": null, "shard": null}}, {"field": "bonus_spell_damage_pct", "old": {"base": [-20, -30, -40, -50], "scepter": null, "shard": null}, "new": {"base": [-16, -24, -32, -40], "scepter": null, "shard": null}}], "rows": [{"review_id": "020385b9b09915b67b7f", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "8081de344bac18007e77", "mechanism": "cyclone_banish", "mechanism_zh": "吹风/放逐", "definition": "使目标短暂离开战场，期间无敌或不可被选取", "condition": "base", "decision": "reject"}, {"review_id": "371b31e9c3292a3f3126", "mechanism": "ethereal", "mechanism_zh": "虚无", "definition": "单位进入虚无状态：无法攻击，也不会受到物理攻击；魔法和纯粹伤害仍可作用", "condition": "base", "decision": "accept"}, {"review_id": "6bdc3362ebedd3032325", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "reject"}, {"review_id": "5e4c6ec515da87c7dfce", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "reject"}, {"review_id": "0485a0f4255743a9d5df", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "base", "decision": "accept"}, {"review_id": "cbbc4cb973cb1cee2bc9", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "9651e7885caaf7fd1553", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "pugna_life_drain", "name_zh": "帕格纳·生命汲取", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "CHANNELED - When cast on an enemy, Pugna drains health from the target enemy unit to heal himself and granting vision over the target. When cast on an ally, Pugna will drain his own health into his ally.", "scepter_loc": "Reduces cooldown by %abilitycooldown%s. When targeting an enemy hero, Pugna reduces their outgoing spell damage by %spell_amp_drain_rate%%% per second up to a maximum of %spell_amp_drain_max%%% and increases his own, up to a maximum of %max_spell_amp_drain_pct%%%. When draining through a Nether Ward using Shard, the rate of increase/decrease is %spell_amp_drain_rate_ward%%% instead. Debuff lasts %spell_amp_drain_duration% seconds.", "shard_loc": "Life Drain can target your Nether Ward, causing life drain to refract to all enemy heroes within %abilitycastrange% units of the ward for %shard_damage_pct_from_ward%%% of its normal value. The effect is interrupted if the ward is destroyed."}, "text_742": {"desc_loc": "CHANNELED - When cast on an enemy, Pugna drains health from the target enemy unit, healing himself for the damage dealt and granting vision over the target. When cast on an ally, Pugna heals his ally and takes magical damage equal to the amount healed. This damage cannot kill Pugna.", "shard_loc": "Life Drain can target your Nether Ward, causing life drain to refract to all enemy heroes within %abilitycastrange% units of the ward for %shard_damage_pct_from_ward%%% of its normal value. The effect is interrupted if the ward is destroyed."}, "changed_fields": [{"field": "ability_has_scepter", "old": true, "new": false}, {"field": "channel_times", "ol