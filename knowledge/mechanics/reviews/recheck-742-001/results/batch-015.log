iew_id": "5342c583d7689ff5798f", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "c4c9a19f3fd010964b01", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "phantom_assassin_stifling_dagger", "name_zh": "幻影刺客·窒碍短匕", "category": "2_纯数值", "text_741f": {"desc_loc": "Throws a dagger slowing the enemy unit's movement speed, dealing %base_damage%+%attack_factor_tooltip%%% of Phantom Assassin's attack damage as physical damage and applying attack effects from items and abilities.", "notes_loc": ["If an attack effect is chance-based, the chance of its application will be the same as its chance to occur.", "Spell-immune enemies are not affected by Stifling Dagger's slow.", "Stifling Dagger grants vision around its location while it travels and upon impact."]}, "text_742": {"desc_loc": "Throws a dagger slowing the enemy unit's movement speed, dealing %base_damage%+%attack_factor_tooltip%%% of Phantom Assassin's attack damage as physical damage and applying attack effects from items and abilities.", "notes_loc": ["If an attack effect is chance-based, the chance of its application will be the same as its chance to occur.", "Spell-immune enemies are not affected by Stifling Dagger's slow.", "Stifling Dagger grants vision around its location while it travels and upon impact."]}, "changed_fields": [], "rows": [{"review_id": "f2f4770312252748eaf4", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "906e413b39050ff6384a", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "060b0ebfce87092d6fbf", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "e6b6b1a9658bc34c0ef8", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "phantom_lancer_doppelwalk", "name_zh": "幻影长矛手·神行百变", "category": "2_纯数值", "text_741f": {"desc_loc": "Phantom Lancer briefly vanishes from the battlefield. After %delay% second, Phantom Lancer and any of his nearby illusions reappear at a random position within the targeted location, along with two additional doppelgangers. Extends duration of all illusions. The two added doppelgangers have different properties: one takes normal damage and deals none, while the other takes %illusion_2_damage_in_pct%%% bonus damage and deals %illusion_2_damage_out_pct%%% less damage. DISPEL TYPE: Basic Dispel", "notes_loc": ["This ability can be used to dodge projectiles, and dispel debuffs.", "Trees near a reappearing unit will be destroyed.", "Phantom Lancer and his allies can see which illusion is the 100% damage illusion."], "facets_loc": ["Spawns an additional illusion per %hp_missing_per_extra_illusion_pct%%% of health that Phantom Lancer is missing."]}, "text_742": {"desc_loc": "Phantom Lancer briefly vanishes from the battlefield. After %delay% second, Phantom Lancer and any of his nearby illusions reappear at a random position within the targeted location, along with two additional doppelgangers. Extends duration of all illusions. The two added doppelgangers have different properties: one takes normal damage and deals none, while the other takes %illusion_2_damage_in_pct%%% bonus damage and deals %illusion_2_damage_out_pct%%% less damage. DISPEL TYPE: Basic Dispel", "notes_loc": ["This ability can be used to dodge projectiles, and dispel debuffs.", "Trees near a reappearing unit will be destroyed.", "Phantom Lancer and his allies can see which illusion is the 100% damage illusion."], "facets_loc": ["Spawns an additional illusion per %hp_missing_per_extra_illusion_pct%%% of health that Phantom Lancer is missing."]}, "changed_fields": [], "rows": [{"review_id": "816318b325e562c4c8f6", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "8c509a9b8626cf757710", "mechanism": "illusions", "mechanism_zh": "幻象", "definition": "制造自身或他人的幻象", "condition": "base", "decision": "accept"}, {"review_id": "1b424ccd8968ef3fa47f", "mechanism": "projectile_dodge", "mechanism_zh": "躲避弹道", "definition": "主动使已飞来的弹道落空；“无法被躲避”的说明不算", "condition": "base", "decision": "accept"}, {"review_id": "audit:phantom_lancer_doppelwalk:self_mobility:base", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "audit:phantom_lancer_doppelwalk:tree_destroy:base", "mechanism": "tree_destroy", "mechanism_zh": "砍树", "definition": "能摧毁树木", "condition": "base", "decision": "accept"}]}, {"subject": "phantom_lancer_juxtapose", "name_zh": "幻影长矛手·并列", "category": "2_纯数值", "text_741f": {"desc_loc": "Phantom Lancer has a chance to fracture his presence on an attack, creating an illusion of himself. Illusions also have a chance to fracture further. Illusions created from Phantom Lancer last for %illusion_duration% seconds, while illusions created from other illusions last %illusion_from_illusion_duration% seconds.", "shard_loc": "Adds an active ability to Juxtapose. Renders Phantom Lancer invisible for up to %invis_duration% seconds while generating a duplicate image to confuse enemies. His movement speed is increased by %invis_movespeed%%% during this invisibility.", "facets_loc": ["Juxtapose Illusions spawn on random nearby units and deal more damage but can't be controlled."]}, "text_742": {"desc_loc": "Phantom Lancer has a chance to fracture his presence on an attack, creating an illusion of himself. Illusions also have a chance to fracture further. Illusions created from Phantom Lancer last for %illusion_duration% seconds, while illusions created from other illusions last %illusion_from_illusion_duration% seconds.", "shard_loc": "Adds an active ability to Juxtapose. Renders Phantom Lancer invisible for up to %invis_duration% seconds while generating a duplicate image to confuse enemies. His movement speed is increased by %invis_movespeed%%% during this invisibility.", "facets_loc": ["Juxtapose Illusions spawn on random nearby units and deal more damage but can't be controlled."]}, "changed_fields": [{"field": "AbilityCooldown", "old": {"base": [0], "scepter": null, "shard": [18]}, "new": {"base": [0], "scepter": null, "shard": [20]}}, {"field": "illusion_duration", "old": {"base": [8], "scepter": null, "shard": null}, "new": {"base": [7], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:phantom_lancer_juxtapose:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "5dfa392d062faa693c92", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "3861d90474c3f5a90526", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "006b642f01d90ce6f782", "mechanism": "illusions", "mechanism_zh": "幻象", "definition": "制造自身或他人的幻象", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "19b6d5160bc86c8ae9be", "mechanism": "illusions", "mechanism_zh": "幻象", "definition": "制造自身或他人的幻象", "condition": "base", "decision": "accept"}, {"review_id": "fda03be72d07857cf4f0", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自