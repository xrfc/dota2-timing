": null}, "new": {"base": [70], "scepter": null, "shard": null}}, {"field": "duration", "old": {"base": [6], "scepter": null, "shard": null}, "new": {"base": [4.5], "scepter": null, "shard": null}}, {"field": "movement_slow", "old": {"base": [50], "scepter": null, "shard": null}, "new": {"base": [35], "scepter": null, "shard": null}}], "rows": [{"review_id": "195129478b3f1ac81342", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "accept"}, {"review_id": "audit:overwhelming_blink:attack_slow:item", "mechanism": "attack_slow", "mechanism_zh": "减攻速", "definition": "降低敌方单位的攻击速度", "condition": "item", "decision": "accept"}, {"review_id": "d1bf0f20de1627f4c116", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "item", "decision": "accept"}, {"review_id": "ea89d954d653478161e0", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "item", "decision": "accept"}, {"review_id": "ea0fca55691277e6605c", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "item", "decision": "accept"}]}, {"subject": "pangolier_swashbuckle", "name_zh": "石鳞剑士·虚张声势", "category": "3_说明文字", "text_741f": {"desc_loc": "Pangolier dashes along the target line, then slashes and briefly slows all enemies in the drawn direction with several quick swipes. Lucky Shot has a chance to activate from this damage.", "notes_loc": ["Casting Swashbuckle during Rolling Thunder ends Rolling Thunder."]}, "text_742": {"desc_loc": "Pangolier dashes along the target line, then slashes and briefly slows all enemies in the drawn direction with several quick swipes. Attacks have decreased Item Potency. Lucky Shot has a chance to activate from this damage.", "notes_loc": ["Casting Swashbuckle during Rolling Thunder ends Rolling Thunder."]}, "changed_fields": [{"field": "damage", "old": {"base": [35, 65, 95, 125], "