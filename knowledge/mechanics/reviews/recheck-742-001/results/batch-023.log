cept"}]}, {"subject": "weaver_threads_of_fate", "name_zh": "编织者·命运之线", "category": "3_说明文字", "text_741f": {"desc_loc": "Whenever Weaver deals damage to an enemy hero with an attack or ability, if he remains within %thread_setup_distance% range of them for %thread_setup_time%s, he establishes a Thread of Fate that briefly slows the enemy and ties Weaver and the enemy together. Each established thread of fate grants bonus damage to Weaver."}, "text_742": {"desc_loc": "Whenever Weaver deals damage to an enemy hero with an attack or ability, if he remains within %thread_setup_distance% range of them for %thread_setup_time%s, he establishes a Thread of Fate that briefly slows the enemy and ties Weaver and the enemy together. While the thread holds, the enemy is slowed again every %established_thread_duration%s. Each established thread of fate grants bonus damage to Weaver."}, "changed_fields": [{"field": "thread_setup_time", "old": {"base": [1.5], "scepter": null, "shard": null}, "new": {"base": [1.25], "scepter": null, "shard": null}}], "rows": [{"review_id": "eba83aa3165a36123b26", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "e6c698617e5da6b0e3f9", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "382aee02d8fe96376ff0", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "weaver_time_lapse", "name_zh": "编织者·时光倒流", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Weaver warps backward to whatever position it was in five seconds earlier--regaining the HP and mana from that time. No effect on cooldown, gold or experience. DISPEL TYPE: Strong Dispel", "notes_loc": ["Removes most negative buffs from Weaver.", "Time Lapse disjoints projectiles."], "scepter_loc": "