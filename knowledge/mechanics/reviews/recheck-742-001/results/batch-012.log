sm_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "226b4ac7dcdd51fcffeb", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "003553bae9be6f4d48d0", "mechanism": "mana_burn", "mechanism_zh": "烧蓝/法力削减", "definition": "减少目标的法力值", "condition": "base", "decision": "accept"}, {"review_id": "e09f616d2e6ba68133cf", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}, {"review_id": "b507c721221c5c8bce17", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "c52e69fad921b57630fc", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "lion_to_hell_and_back", "name_zh": "莱恩·下地狱再上来", "category": "2_纯数值", "text_741f": {"desc_loc": "Lion gains %debuff_amp%%% debuff duration after killing or assisting in a Hero kill while that Hero is dead. Lion gains %spell_amp%%% spell amplification for %duration%s after respawning or resurrecting or until he gets a kill or assist."}, "text_742": {"desc_loc": "Lion gains %debuff_amp%%% debuff duration after killing or assisting in a Hero kill while that Hero is dead. Lion gains %spell_amp%%% spell amplification for %duration%s after respawning or resurrecting or until he gets a kill or assist."}, "changed_fields": [{"field": "spell_amp", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [15], "scepter": null, "shard": null}}], "rows": [{"review_id": "e69ca90cbb340a84fe4f", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "71bde1bc2270af04a332", "mechanism": "respawn", "mechanism_zh": "重生", "definition": "死亡后复活，或影响复活", "condition": "base", "decision": "reject"}, {"review_id": "a5933756a651555e2172", "mechanism": "spell_amp", "mechanism_zh": "法术放大", "definition": "提高技能造成的伤害", "condition": "base", "decision": "accept"}]}, {"subject": "lone_druid_spirit_bear", "name_zh": "独行德鲁伊·熊灵伙伴", "category": "3_说明文字", "text_741f": {"desc_loc": "Summons a powerful Spirit Bear companion that can equip items. If the bear moves %bear_attack_leash_range% distance away from the Lone Druid, it cannot attack. Lone Druid suffers %backlash_damage%%% of his max health as backlash damage if the Spirit Bear dies. Spirit Bear has Demolish, Return, Entangling Claws, Savage Roar, and Spirit Link abilities.", "notes_loc": ["Most spells interact with the Spirit Bear in the same way as they do with heroes.", "Spirit Bear has 0 base attributes, 0 base armor, and %base_magic_resistance%%% base magic resistance. Attributes from buffs or items fully affect the bear as they would for Universal heroes.", "Spirit Bear cannot gain experience. The Spirit Bear levels up when Lone Druid levels up.", "Spirit Bear has its own Aghanim's Scepter and Shard upgrades.", "Spirit Bear receives a copy of Lone Druid's Neutral Item that has an independent cooldown."], "facets_loc": ["Increases the distance from Lone Druid at which the Spirit Bear can attack."]}, "text_742": {"desc_loc": "Summons a powerful Spirit Bear companion that can equip items. If the bear moves too far away from the Lone Druid, it cannot attack. Lone Druid suffers %backlash_damage%%% of his max health as backlash damage if the Spirit Bear dies. Spirit Bear has Demolish, Return, Entangling Claws, Savage Roar, and Spirit Link abilities.", "notes_loc": ["Most spells interact with the Spirit Bear in the same way as they do with heroes.", "Spirit Bear has 0 base attributes, 0 base armor, and %base_magic_resistance%%% base magic resistance. Attributes from buffs or items fully affect the bear as they would for Universal heroes.", "Spirit Bear cannot gain experience. The Spirit Bear levels up when Lone Druid levels up.", "Spirit Bear has its own Aghanim's Scepter and Shard upgrades.", "Spirit Bear receives a copy of Lone Druid's Neutral Item that has an independent cooldown."], "facets_loc": ["Increases the distance from Lone Druid at which the Spirit Bear can attack."]}, "changed_fields": [{"field": "bear_attack_leash_range_tooltip", "old": null, "new": {"base": [0], "scepter": null, "shard": null}}], "rows": [{"review_id": "d63dc94e008e9ab7a6b7", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "reject"}, {"review_id": "328f5e84809c536b3965", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "base", "decision": "reject"}, {"review_id": "05927dbef062d90d3614", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "accept"}]}, {"subject": "lone_druid_spirit_link", "name_zh": "独行德鲁伊·灵魂链接", "category": "2_纯数值", "text_741f": {"desc_loc": "Links Lone Druid and the Spirit Bear, increasing their movement speed as well as sharing a percentage of their lifesteal with each other.", "notes_loc": ["Break disables the shared lifesteal."], "scepter_loc": "Lone Druid severs his link to his Spirit Bear, and connects to the target allied hero, sharing the Spirit Link bonuses with them for %duration%s. Armor sharing and attack speed are increased by %active_bonus%%%. Damage done by the ally heals Lone Druid, as well as the other way around. The Spirit Bear is feared for the duration of the transformation, unless he has his own Aghanim's Scepter.", "facets_loc": ["Shared Armor increased. Damage dealt by either the Spirit Bear or Lone Druid will heal the other.", "Only damage dealt by Spirit Bear heals Lone Druid."]}, "text_742": {"desc_loc": "Links Lone Druid and the Spirit Bear, increasing their movement speed as well as sharing a percentage of their lifesteal with each other.", "notes_loc": ["Break disables the shared lifesteal."], "scepter_loc": "Lone Druid severs his link to his Spirit Bear, and connects to the target allied hero, sharing the Spirit Link bonuses with them for %duration%s. Armor sharing and attack speed are increased by %active_bonus%%%. Damage done by the ally heals Lone Druid, as well as the other way around. The Spirit Bear is feared for the duration of the transformation, unless he has his own Aghanim's Scepter.", "facets_loc": ["Shared Armor increased. Damage dealt by either the Spirit Bear or Lone Druid will heal the other.", "Only damage dealt by Spirit Bear heals Lone Druid."]}, "changed_fields": [{"field": "bonus_movement_speed_druid", "old": {"base": [10, 20, 30, 40], "scepter": null, "shard": null}, "new": {"base": [15, 30, 45, 60], "scepter": null, "shard": null}}], "rows": [{"review_id": "ef78e74c04ed02de3882", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "be8bdccf10fea0d5cdaa", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "5c1f9fb6b68349a5b491", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}]}, {"subject": "luna_lucent_beam", "name_zh": "露娜·月光", "category": "2_纯数值", "text_741f": {"desc_loc": "Calls a beam of lunar energy down upon an enemy, damaging and briefly stunning them.", "shard_loc": "Grants Luna an attack damage bonus buff every time an enemy hero is hit by Lucent Beam. Lucent Beams created by Eclipse grant %damage_buff_from_eclipse_pct%%% of the damage amount."}, "text_742": {"desc_loc": "Calls a beam of lunar energy down upon an enemy, damaging and briefly stunning them.", "shard_loc": "Grants Luna an attack damage bonus buff every time an enemy hero is hit by Lucent Beam. Lucent Beams created by Eclipse grant %damage_buff_from_eclipse_pct%%% of the damage amount."}, "changed_fields": [{"field": "lucent_beam_additional_targets", "old": null, "new": {"base": [], "scepter": null, "shard": null}}], "rows": [{"review_id": "4670320d9206e698c01f", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "7a9ef5696e58570f9476", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "7e8235d873944929715b", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "luna_moon_glaive", "name_zh": "露娜·月刃", "category": "3_说明文字", "text_741f": {"desc_loc": "Empowers Luna's glaives, causing her attacks to bounce between enemy units. Deals less damage with each bounce.", "notes_loc": ["Moon Glaives do not proc any attack modifier except Critical Strikes."]}, "text_742": {"desc_loc": "Empowers Luna's glaives, causing her attacks to bounce between enemy units. Damage and Item Potency decrease with each bounce.", "notes_loc": ["Additional bounces do not benefit from lifesteal or critical strike."]}, "changed_fields": [{"field": "effectiveness_reduction_percent", "old": null, "new": {"base": [40], "scepter": null, "shard": null}}], "rows": [{"review_id": "10b2860c06fc8333cba9", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "262f9b6d30020b76d453", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "reject"}, {"review_id": "cafbda9c266ab316eaa8", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}]}, {"subject": "lycan_feral_impulse", "name_zh": "狼人·野性驱使", "category": "3_说明文字", "text_741f": {"desc_loc": "Increases the HP regeneration and damage of Lycan and all units under his control.", "facets_loc": ["Max level decreased to %max_level%."]}, "text_742": {"desc_loc": "Increases the HP regeneration and damage for Lycan and all units under his control.", "notes_loc": ["Does not increase damage from items."]}, "changed_fields": [], "rows": [{"review_id": "65d203178937d00126d4", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "3896eb6a185ea5d94dc2", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}]}, {"subject": "lycan_summon_wolves", "name_zh": "狼人·召狼", "category": "2_纯数值", "text_741f": {"desc_loc": "Summons %wolf_count% wolves to aid Lycan in battle. At level 3, wolves gain Permanent Invisibility, and at level 4 wolves gain Cripple that gives 20% chance to cripple the target, causing 8 damage per second and lose 60 attack speed for 4 seconds.", "notes_loc": ["Using this spell will replace currently active summoned Wolves."], "shard_loc": "Increases the number of wolves summoned. Grants all summoned wolves the ability Hightail, an active ability that gives them phased movement, evasion, movespeed, and attack speed.", "facets_loc": ["Summoned Wolves are invulnerable and uncontrollable spirits that do not attack, but provide health and damage bonuses to Lycan.", "Max Level increased to %max_level%. Level 5 wolves gain Hamstring, which empowers their attacks to root enemies and cause them to take more physical damage on attacks. Level 6 wolves have Hightail, an active ability that gives wolves phased movement, evasion, movespeed, and attack speed."]}, "text_742": {"desc_loc": "Summons %wolf_count% wolves to aid Lycan in battle. At level 3, wolves gain Permanent Invisibility, and at level 4 wolves gain Cripple that gives 20% chance to cripple the target, causing 8 damage per second and lose 60 attack speed for 4 seconds.", "notes_loc": ["Using this spell will replace currently active summoned Wolves."], "shard_loc": "Increases the number of wolves summoned. Grants all summoned wolves the ability Hightail, an active ability that gives them phased movement, evasion, movespeed, and attack speed.", "facets_loc": ["Summoned Wolves are invulnerable and uncontrollable spirits that do not attack, but provide health and damage bonuses to Lycan.", "Max Level increased to %max_level%. Level 5 wolves gain Hamstring, which empowers their attacks to root enemies and cause them to take more physical damage on attacks. Level 6 wolves have Hightail, an active ability that gives wolves phased movement, evasion, movespeed, and attack speed."]}, "changed_fields": [{"field": "wolf_damage", "old": {"base": [22, 28, 34, 40, 46, 52], "scepter": null, "shard": null}, "new": {"base": [22, 32, 42, 52, 62, 72], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:lycan_summon_wolves:slow:base", "mechanism": "attack_slow", "mechanism_zh": "减攻速", "definition": "降低敌方单位的攻击速度", "condition": "base", "decision": "accept"}, {"review_id": "81e7362f05f06af5fbc8", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "base", "decision": "reject"}, {"review_id": "9274b5b6f0756916db62", "mechanism": "evasion", "mechanism_zh": "闪避", "definition": "自身有概率使敌方攻击落空", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "87e541fc3dd166f881a9", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "5f58acf585f6f55a16a9", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "accept"}, {"review_id": "72d30194c36af6c151fb", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "b11950c40e8204fd5992", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "accept"}]}, {"subject": "lycan_wolf_bite", "name_zh": "狼人·饿狼撕咬", "category": "3_说明文字", "text_741f": {"desc_loc": "Lycan bites an allied hero or creep-hero, granting them Shapeshift properties. Lycan and the bitten target gain %lifesteal_percent%%% Lifesteal and share the healing effect of Lifesteal with each other as long as they are within %lifesteal_range% range of each other.", "notes_loc": ["Wolf Bite cooldown matches the cooldown of the current level of Shapeshift."]}, "text_742": {"desc_loc": "Lycan bites an allied hero or creep-hero, granting them Shapeshift properties. While shapeshifted this way, the target counts as a unit under Lycan's control for Pack Hunter.", "notes_loc": ["Wolf Bite cooldown matches the cooldown of the current level of Shapeshift."]}, "changed_fields": [{"field": "lifesteal_percent", "old": {"base": [40], "scepter": null, "shard": null}, "new": null}, {"field": "lifesteal_range", "old": {"base": [1200], "scepter": null, "shard": null}, "new": null}], "rows": [{"review_id": "522b75b460a924a0a717", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "f5b35ac237a40b44974b", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}]}, {"subject": "maelstrom", "name_zh": "漩涡", "category": "3_说明文字", "text_741f": {"desc_loc": "Passive: Chain Lightning Grants a %chain_chance%%% chance on attack to release a bolt of electricity that leaps between %chain_strikes% targets within a %chain_radius% radius, dealing %chain_damage% magical damage to each. Lightning proc pierces evasion."}, "text_742": {"desc_loc": "Passive: Chain Lightning Grants a %chain_chance%%% chance on attack to release a bolt of electricity that leaps between %chain_strikes% targets within a %chain_radius% radius, dealing %chain_damage% magical damage to each. Lightning proc pierces evasion.", "notes_loc": ["Chain Lightning does not trigger off of attacks from illusions."]}, "changed_fields": [], "rows": [{"review_id": "516d9641c012e865b787", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "accept"}, {"review_id": "audit:maelstrom:attack_modifier:item", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}, {"review_id": "audit:maelstrom:pierce_evasion:item", "mechanism": "pierce_evasion", "mechanism_zh": "克敌机先", "definition": "攻击无视闪避（必中）", "condition": "item", "decision": "accept"}]}, {"subject": "mage_slayer", "name_zh": "法师克星", "category": "2_纯数值", "text_741f": {"desc_loc": "Passive: Mage Slayer Places a debuff when you attack enemies, dealing %dps% physical damage per second and causing them to do %spell_amp_debuff%%% less spell damage for %duration% seconds."}, "text_742": {"desc_loc": "Passive: Mage Slayer Places a debuff when you attack enemies, dealing %dps% physical damage per second and causing them to do %spell_amp_debuff%%% less spell damage for %duration% seconds."}, "changed_fields": [], "rows": [{"review_id": "0587fff248c312e52535", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "reject"}, {"review_id": "audit:mage_slayer:attack_modifier:item", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}, {"review_id": "audit:mage_slayer:healing:item", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "item", "decision": "accept"}, {"review_id": "4e59191ba5764f291d48", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}, {"review_id": "50cc2f9fc1b45fddc3ab", "mechanism": "spell_amp", "mechanism_zh": "法术放大", "definition": "提高技能造成的伤害", "condition": "item", "decision": "reject"}]}, {"subject": "magnataur_shockwave", "name_zh": "马格纳斯·震荡波", "category": "2_纯数值", "text_741f": {"desc_loc": "Magnus sends out a wave of force, damaging enemy units in a line, pulling them towards him, and slowing them for a brief period.", "facets_loc": ["Increases the max level of Shockwave. Level %max_level% Shockwave causes it to return towards Magnus's current location after reaching max length. The return Shockwave travels %return_shockwave_bonus_distance% distance further and hits enemies a second time for %return_damage_pct_tooltip%%% of the damage."]}, "text_742": {"desc_loc": "Magnus sends out a wave of force, damaging enemy units in a line, pulling them towards him, and slowing them for a brief period.", "facets_loc": ["Increases the max level of Shockwave. Level %max_level% Shockwave causes it to return towards Magnus's current location after reaching max length. The return Shockwave travels %return_shockwave_bonus_distance% distance further and hits enemies a second time for %return_damage_pct_tooltip%%% of the damage."]}, "changed_fields": [{"field": "shock_damage", "old": {"base": [75, 150, 225, 300], "scepter": null, "shard": null}, "new": {"base": [90, 160, 230, 300], "scepter": null, "shard": null}}], "rows": [{"review_id": "7d8f72c2aaa8b87a5e1c", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "d47713d67cfed86d04c0", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "a09cf05288920c91fc1f", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "c6c7905d0721107e63be", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "reject"}]}, {"subject": "manta", "name_zh": "幻影斧", "category": "3_说明文字", "text_741f": {"desc_loc": "Active: Mirror Image Creates %images_count% images of your hero that last %illusion_duration% seconds. Melee images deal %tooltip_damage_outgoing_melee%%% damage, while Ranged images deal %tooltip_damage_outgoing_ranged%%%. Illusions take %tooltip_damage_incoming_total_pct%%% damage. Dispel Type: Basic Dispel", "notes_loc": ["Has a %invuln_duration% second cast time during which you are invulnerable.", "Many effects are removed upon using Manta.", "Yasha based movement speed bonuses from multiple items do not stack."]}, "text_742": {"desc_loc": "Active: Mirror Image Creates %images_count% images of your hero that last %illusion_duration% seconds. Melee images deal %tooltip_damage_outgoing_melee%%% damage, while Ranged images deal %tooltip_damage_outgoing_ranged%%%. Illusions take %tooltip_damage_incoming_total_pct%%% damage and have %illusion_effectiveness%%% Item Potency. Dispel Type: Basic Dispel", "notes_loc": ["Has a %invuln_duration% second cast time during which you are invulnerable.", "Many effects are removed upon using Manta.", "Yasha based movement speed bonuses from multiple items do not stack."]}, "changed_fields": [{"field": "item_cost", "old": 4650, "new": 4550}, {"field": "bonus_movement_speed", "old": {"base": [10], "scepter": null, "shard": null}, "new": {"base": [6], "scepter": null, "shard": null}}, {"field": "illusion_effectiveness", "old": null, "new": {"base": [35], "scepter": null, "shard": null}}], "rows": [{"review_id": "17cfe619cfab1a60b4a3", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "item", "decision": "accept"}, {"review_id": "1a4e89e1035a3954e748", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}, {"review_id": "t5:manta:illusions", "mechanism": "illusions", "mechanism_zh": "幻象", "definition": "制造自身或他人的幻象", "condition": "item", "decision": "accept"}, {"review_id": "fb92aa9261305f161b15", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "item", "decision": "accept"}]}, {"subject": "marci_bodyguard", "name_zh": "玛西·护卫术", "category": "2_纯数值", "text_741f": {"desc_loc": "Passively grants Marci lifesteal and bonus attack damage. When cast on an ally, she provides them with %max_partner_penalty%%% of her passive lifesteal and attack damage bonus. Additionally Marci creates a shared all damage barrier for herself and her partner. As Marci attacks heroes, %shared_barrier_replenish_amount%%% of the damage dealt restores the barrier.", "notes_loc": ["Marci cannot cast Bodyguard on herself.", "Lifesteal effectiveness gets a %creep_lifesteal_reduction_pct%%% penalty against creeps.", "The shared barrier is reduced by damage on either Marci or her partner."], "facets_loc": ["While bodyguarded, Marci and her partner share %shared_healing_percent%%% of health healed by this ability with each other."]}, "text_742": {"desc_loc": "Passively grants Marci lifesteal and bonus attack damage. When cast on an ally, she provides them with %max_partner_penalty%%% of her passive lifesteal and attack damage bonus. Additionally Marci creates a shared all damage barrier for herself and her partner. As Marci attacks heroes, %shared_barrier_replenish_amount%%% of the damage dealt restores the barrier.", "notes_loc": ["Marci cannot cast Bodyguard on herself.", "Lifesteal effectiveness gets a %creep_lifesteal_reduction_pct%%% penalty against creeps.", "The shared barrier is reduced by damage on either Marci or her partner."], "facets_loc": ["While bodyguarded, Marci and her partner share %shared_healing_percent%%% of health healed by this ability with each other."]}, "changed_fields": [{"field": "cooldowns", "old": [20], "new": [21, 20, 19, 18]}, {"field": "AbilityCooldown", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [21, 20, 19, 18], "scepter": null, "shard": null}}, {"field": "shared_barrier", "old": {"base": [90, 160, 230, 300], "scepter": null, "shard": null}, "new": {"base": [120, 180, 240, 300], "scepter": null, "shard": null}}], "rows": [{"review_id": "e1925c21fa9dbe8aa332", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "accept"}, {"review_id": "2212c32e1a24e753f164", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}]}, {"subject": "marci_special_delivery", "name_zh": "玛西·特快专递", "category": "3_说明文字", "text_741f": {"desc_loc": "Marci whistles to instantly summon her courier to her. If the courier started in the fountain, it will take items from Marci's stash. After teleporting it will transfer these items to Marci and head back to the fountain. Passively grants all allied couriers %bonus_levels% bonus levels and %bonus_hp_tooltip% bonus health.", "notes_loc": ["Special Delivery whistle has a cast point of %abilitycastpoint% second.", "If the courier didn't transfer any items or still has items after casting, it will remain next to Marci."]}, "text_742": {"desc_loc": "Marci whistles to instantly summon her courier to her. If the courier started in the fountain, it will take items from Marci's stash. After teleporting it will transfer these items to Marci and head back to the fountain. Passively grants all allied couriers %bonus_levels% bonus levels and %bonus_hp_tooltip% extra pip.", "notes_loc": ["Special Delivery whistle has a cast point of %abilitycastpoint% second.", "If the courier didn't transfer any items or still has items after casting, it will remain next to Marci."]}, "changed_fields": [{"field": "cooldowns", "old": [215], "new": [200]}, {"field": "AbilityCooldown", "old": {"base": [215], "scepter": null, "shard": null}, "new": {"base": [200], "scepter": null, "shard": null}}, {"field": "bonus_hp", "old": {"base": [3], "scepter": null, "shard": null}, "new": {"base": [4], "scepter": null, "shard": null}}], "rows": [{"review_id": "75bc3ddc1af6270ac2e1", "mechanism": "cyclone_banish", "mechanism_zh": "吹风/放逐", "definition": "使目标短暂离开战场，期间无敌或不可被选取", "condition": "base", "decision": "reject"}, {"review_id": "a0ecc3e81bafb3b9256e", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "reject"}]}, {"subject": "mars_arena_of_blood", "name_zh": "玛尔斯·热血竞技场", "category": "3_说明文字", "text_741f": {"desc_loc": "After a short formation time, Mars summons an arena lined with the undead warriors of the Ash Legion, who block enemy attacks and movement. Enemy heroes near the inside edge of the arena will be attacked by spears, dealing damage and knocking them back.", "scepter_loc": "Lowers cooldown by %bonus_AbilityCooldown%s and increases duration. If an enemy is killed in the Arena, Mars and all of his allies inside the Arena restore %arena_kill_buff_heal_pct%% of their max health and mana and get a %arena_kill_buff_damage_pct%% attack damage buff for %arena_kill_buff_duration%s. This effect stacks.", "facets_loc": ["If Mars is in the Arena when an enemy dies inside of it, he restores %arena_kill_buff_heal_pct%%% of his max health and mana and gets a %arena_kill_buff_damage_pct%%% attack damage buff for %arena_kill_buff_duration%s. Allies inside the Arena receive %allied_reduction_pct%%% of the bonuses.", "Arena of Blood obscures vision and enemies within the arena do not share vision with their allies."]}, "text_742": {"desc_loc": "After a short formation time, Mars summons an arena lined with the undead warriors of the Ash Legion, who block enemy attacks and movement. Enemy heroes near the inside edge of the arena will be attacked by spears, dealing damage and knocking them back.", "scepter_loc": "Lowers cooldown by %bonus_AbilityCooldown%s and increases duration. If an enemy is killed in the Arena, Mars and all of his allies inside the Arena restore %arena_kill_buff_heal_pct%%% of their max health and mana and get a %arena_kill_buff_damage_pct%%% attack damage buff for %arena_kill_buff_duration%s. This effect stacks.", "facets_loc": ["If Mars is in the Arena when an enemy dies inside of it, he restores %arena_kill_buff_heal_pct%%% of his max health and mana and gets a %arena_kill_buff_damage_pct%%% attack damage buff for %arena_kill_buff_duration%s. Allies inside the Arena receive %allied_reduction_pct%%% of the bonuses.", "Arena of Blood obscures vision and enemies within the arena do not share vision with their allies."]}, "changed_fields": [{"field": "cooldowns", "old": [100, 95, 90], "new": [105, 95, 85]}, {"field": "AbilityCooldown", "old": {"base": [100, 95, 90], "scepter": [10], "shard": null}, "new": {"base": [105, 95, 85], "scepter": [10], "shard": null}}, {"field": "arena_kill_buff_damage_pct", "old": {"base": [0], "scepter": [35], "shard": null}, "new": {"base": [0], "scepter": [45], "shard": null}}], "rows": [{"review_id": "d8ffe