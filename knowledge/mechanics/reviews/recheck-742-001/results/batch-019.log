ism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "cdd4d4dd088276752ac9", "mechanism": "reveal", "mechanism_zh": "显形", "definition": "使隐身单位显形，不等于持续真视", "condition": "base", "decision": "reject"}, {"review_id": "8e00fcf5de33c634c06a", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "skywrath_mage_mystic_flare", "name_zh": "天怒法师·神秘之耀", "category": "2_纯数值", "text_741f": {"desc_loc": "Skywrath Mage uses his ultimate magical ability to conjure a precise and violent mystical field that lays waste to his adversaries. Deals massive damage distributed evenly among any Heroes in the area over %duration% seconds.", "notes_loc": ["Mystic Flare only affects Heroes. Mystic Flare does not damage creep heroes.", "Mystic Flare will damage enemy creeps if no enemy heroes are present.", "Mystic Flare will immediately destroy illusions."], "scepter_loc": "When Skywrath Mage casts Mystic Flare, another Mystic Flare will be created on the position of a different random target enemy within %scepter_radius% range of the original target. Heroes will take priority."}, "text_742": {"desc_loc": "Skywrath Mage uses his ultimate magical ability to conjure a precise and violent mystical field that lays waste to his adversaries. Deals massive damage distributed evenly among any Heroes in the area over %duration% seconds.", "notes_loc": ["Mystic Flare only affects Heroes. Mystic Flare does not damage creep heroes.", "Mystic Flare will damage enemy creeps if no enemy heroes are present.", "Mystic Flare will immediately destroy illusions."], "scepter_loc": "When Skywrath Mage casts Mystic Flare, another Mystic Flare will be created on the position of a different random target enemy within %scepter_radius% range of the original target. Heroes will take priority."}, "changed_fields": [{"field": "damage", "old": {"base": [800, 1200, 1600], "scepter": null, "shard": null}, "new": {"base": [800, 1125, 1450], "scepter": null, "shard": null}}], "rows": [{"review_id": "77e555a8e817461b05e5", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:skywrath_mage_mystic_flare:ground_zone:base", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "base", "decision": "accept"}]}, {"subject": "skywrath_mage_shield_of_the_scion", "name_zh": "天怒法师·天裔之盾", "category": "3_说明文字", "text_741f": {"desc_loc": "Every time Skywrath Mage deals magical damage to an enemy hero with his abilities, he gains a small magic damage barrier. Each buff stacks independently."}, "text_742": {"desc_loc": "Every time Skywrath Mage deals magical damage to an enemy hero with his abilities, he gains bonus intelligence and a small magic damage barrier. Each buff stacks independently."}, "changed_fields": [{"field": "barrier_duration", "old": {"base": [12], "scepter": null, "shard": null}, "new": {"base": [10], "scepter": null, "shard": null}}, {"field": "bonus_intelligence", "old": null, "new": {"base": [1], "scepter": null, "shard": null}}], "rows": [{"review_id": "3af860a2bf46a400618a", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "16cc693e6676fafb99c4", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "accept"}]}, {"subject": "slardar_bash", "name_zh": "斯拉达·深海重击", "category": "2_纯数值", "text_741f": {"desc_loc": "After %attack_count% attacks, your next attack will bash the target.", "notes_loc": ["Does not stack with Skull Basher."]}, "text_742": {"desc_loc": "After %attack_count% attacks, your next attack will bash the target.", "notes_loc": ["Does not stack with Skull Basher."]}, "changed_fields": [], "rows": [{"review_id": "adc363e86b409f76339f", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "base", "decision": "accept"}, {"review_id": "665991b7df5dabd52000", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "audit:slardar_bash:stun:base", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "slardar_slithereen_crush", "name_zh": "斯拉达·鱼人碎击", "category": "2_纯数值", "text_741f": {"desc_loc": "Slams the ground, leaving a puddle of water, and stunning and damaging nearby enemy units. After the stun, the affected units are slowed.", "scepter_loc": "Increases Slithereen Crush puddle radius and duration.", "shard_loc": "Slithereen Crush now applies Corrosive Haze for a short time to units affected."}, "text_742": {"desc_loc": "Slams the ground, leaving a puddle of water, and stunning and damaging nearby enemy units. After the stun, the affected units are slowed.", "scepter_loc": "Increases Slithereen Crush puddle radius and duration.", "shard_loc": "Slithereen Crush now applies Corrosive Haze for a short time to units affected."}, "changed_fields": [], "rows": [{"review_id": "9c0b6437d69ad8cc5dde", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "b2c40997a7827d555922", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "e11b107c7149582c59ab", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "slark_shadow_dance", "name_zh": "斯拉克·暗影之舞", "category": "2_纯数值", "text_741f": {"desc_loc": "When not visible to the enemy team, Slark passively gains bonus movement speed and health regeneration. If Slark is damaged by a neutral unit, the passive movement and health regeneration bonuses are lost for %neutral_disable% seconds. When activated, Slark hides himself in a cloud of shadows, becoming immune to detection. Attacking, casting spells, and using items will not reveal Slark, but enemies can see the cloud itself."}, "text_742": {"desc_loc": "When not visible to the enemy team, Slark passively gains bonus movement speed and health regeneration. If Slark is damaged by a neutral unit, the passive movement and health regeneration bonuses are lost for %neutral_disable% seconds. When activated, Slark hides himself in a cloud of shadows, becoming immune to detection. Attacking, casting spells, and using items will not reveal Slark, but enemies can see the cloud itself."}, "changed_fields": [], "rows": [{"review_id": "735c4a835d3b4b966d16", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "9be4a5a3df96daf08bd8", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "audit:slark_shadow_dance:invisibility:base", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "accept"}, {"review_id": "f6cf8025aead67d87bdd", "mechanism": "reveal", "mechanism_zh": "显形", "definition": "使隐身单位显形，不等于持续真视", "condition": "base", "decision": "reject"}]}, {"subject": "smoke_of_deceit", "name_zh": "诡计之雾", "category": "2_纯数值", "text_741f": {"desc_loc": "Use: Disguise Turns the caster and all allied player-controlled targets in a %application_radius% radius invisible, and grants %bonus_movement_speed%%% bonus movement speed for %duration% seconds. While the caster is still disguised, any allies that come within %secondary_application_radius% range of them will also get the buff applied to them. Each smoke can only be applied once to allies. Attacking or moving within %visibility_radius% range of an enemy hero or tower, will break the invisibility. Disguise grants invisibility that is immune to True Sight. Smoke of Deceit is usable from the backpack and has no cooldown when swapped into the main inventory."}, "text_742": {"desc_loc": "Use: Disguise Turns the caster and all allied player-controlled targets in a %application_radius% radius invisible, and grants %bonus_movement_speed%%% bonus movement speed for %duration% seconds. While the caster is still disguised, any allies that come within %secondary_application_radius% range of them will also get the buff applied to them. Each smoke can only be applied once to allies. Attacking or moving within %visibility_radius% range of an enemy hero or tower, will break the invisibility. Disguise grants invisibility that is immune to True Sight. Smoke of Deceit is usable from the backpack and has no cooldown when swapped into the main inventory."}, "changed_fields": [{"field": "bonus_movement_speed", "old": {"base": [15], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "duration", "old": {"base": [45], "scepter": null, "shard": null}, "new": {"base": [50], "scepter": null, "shard": null}}], "rows": [{"review_id": "2c0ffeb3a4bbd6e1c017", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "item", "decision": "reject"}, {"review_id": "433db0e0de6a675f18ee", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}, {"review_id": "adbfdd2c755c69bf84d1", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "item", "decision": "accept"}]}, {"subject": "snapfire_boomstick", "name_zh": "电炎绝手·猎枪", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Snapfire deals more damage to nearby enemies."}, "text_742": {"desc_loc": "Snapfire deals more damage to nearby enemies."}, "changed_fields": [{"field": "behavior", "old": "66", "new": "562949953421379"}], "rows": [{"review_id": "c2d8f4e79c8ed22fb9e3", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "cb8daaafa348f6991371", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}]}, {"subject": "snapfire_lil_shredder", "name_zh": "电炎绝手·霹雳铁手", "category": "2_纯数值", "text_741f": {"desc_loc": "Snapfire heats up her mounted turret to rapidly fire %buffed_attacks% attacks dealing fixed damage plus a percentage of her attack damage. Each attack reduces the enemy's armor. Provides bonus attack range for the duration.", "notes_loc": ["Sets base attack time to %base_attack_time%s for the duration.", "Attack modifiers have a chance to proc on Lil' Shredder attacks."]}, "text_742": {"desc_loc": "Snapfire heats up her mounted turret to rapidly fire %buffed_attacks% attacks dealing fixed damage plus a percentage of her attack damage. Each attack reduces the enemy's armor. Provides bonus attack range for the duration.", "notes_loc": ["Sets base attack time to %base_attack_time%s for the duration.", "Attack modifiers have a chance to proc on Lil' Shredder attacks."]}, "changed_fields": [{"field": "cooldowns", "old": [24, 20, 16, 12], "new": [21, 18, 15, 12]}, {"field": "AbilityCooldown", "old": {"base": [24, 20, 16, 12], "scepter": null, "shard": null}, "new": {"base": [21, 18, 15, 12], "scepter": null, "shard": null}}], "rows": [{"review_id": "2466462601432691a305", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "d2e7a2505b322b072f33", "mechanism": "armor_reduction", "mechanism_zh": "减护甲", "definition": "降低目标护甲", "condition": "base", "decision": "accept"}, {"review_id": "071b44d49a7d1b22263b", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}]}, {"subject": "snapfire_mortimer_kisses", "name_zh": "电炎绝手·蜥蜴绝吻", "category": "2_纯数值", "text_741f": {"desc_loc": "Snapfire's friend launches a barrage of firespit globs over %duration_tooltip% seconds. Globs cause impact damage and create pools of firespit, which slow and apply damage over time. Snapfire has a reduced turn rate for the duration and a minimum launch range of %min_range%. Each glob can be targeted with a right click.", "notes_loc": ["Can be cancelled by pressing Stop, Hold Position, or using another ability.", "Has a minimum travel time of %min_lob_travel_time% and maximum travel time of %max_lob_travel_time%."]}, "text_742": {"desc_loc": "Snapfire's friend launches a barrage of firespit globs over %duration_tooltip% seconds. Globs cause impact damage and create pools of firespit, which slow and apply damage over time. Snapfire has a reduced turn rate for the duration and a minimum launch range of %min_range%. Each glob can be targeted with a right click.", "notes_loc": ["Can be cancelled by pressing Stop, Hold Position, or using another ability.", "Has a minimum travel time of %min_lob_travel_time% and maximum travel time of %max_lob_travel_time%."]}, "changed_fields": [{"field": "damage_per_impact", "old": {"base": [170, 250, 330], "scepter": null, "shard": null}, "new": {"base": [180, 250, 320], "scepter": null, "shard": null}}], "rows": [{"review_id": "e957727cd0806e9dce5d", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:snapfire_mortimer_kisses:ground_zone:base", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "base", "decision": "accept"}, {"review_id": "7790c0810e588427d9b9", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "snapfire_scatterblast", "name_zh": "电炎绝手·电光石火", "category": "2_纯数值", "text_741f": {"desc_loc": "Snapfire unloads with a wide blast that damages and slows enemies in a cone. Damage is increased by %point_blank_dmg_bonus_pct%%% and Movement Slow, Attack Slow and Slow Duration are increased by %point_blank_debuff_duration_pct%%% for enemies caught at point-blank range.", "facets_loc": ["Scatterblast is narrower and longer. Bonus damage and slow when enemies are not in point blank range."]}, "text_742": {"desc_loc": "Snapfire unloads with a wide blast that damages and slows enemies in a cone. Damage is increased by %point_blank_dmg_bonus_pct%%% and Movement Slow, Attack Slow and Slow Duration are increased by %point_blank_debuff_duration_pct%%% for enemies caught at point-blank range.", "facets_loc": ["Scatterblast is narrower and longer. Bonus damage and slow when enemies are not in point blank range."]}, "changed_fields": [{"field": "knockback_duration", "old": null, "new": {"base": [], "scepter": null, "shard": null}}], "rows": [{"review_id": "7238edbd635ac22dc13f", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:snapfire_scatterblast:attack_slow:base", "mechanism": "attack_slow", "mechanism_zh": "减攻速", "definition": "降低敌方单位的攻击速度", "condition": "base", "decision": "accept"}, {"review_id": "8f591af15e5a440a59ca", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "sniper_assassinate", "name_zh": "狙击手·暗杀", "category": "3_说明文字", "text_741f":