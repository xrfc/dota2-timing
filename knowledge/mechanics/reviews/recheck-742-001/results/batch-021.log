:tiny_tree_grab:tree_destroy:base", "mechanism": "tree_destroy", "mechanism_zh": "砍树", "definition": "能摧毁树木", "condition": "base", "decision": "accept"}, {"review_id": "0e76b524b220e0cbf3bd", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "reject"}]}, {"subject": "tranquil_boots", "name_zh": "静谧之鞋", "category": "3_说明文字", "text_741f": {"desc_loc": "Passive: Break Whenever you attack a hero or are attacked by any unit, the bonus %bonus_health_regen% HP regen is lost and the movement speed bonus is reduced to %broken_movement_speed% for %break_time% seconds. Movement speed bonuses from multiple pairs of boots do not stack."}, "text_742": {"desc_loc": "Passive: Respite Whenever you attack a hero or are attacked by any unit, the health regen bonus is reduced to %broken_health_regen% and the movement speed bonus is reduced to %broken_movement_speed% for %break_time% seconds. Movement speed bonuses from multiple pairs of boots do not stack."}, "changed_fields": [{"field": "broken_health_regen", "old": null, "new": {"base": [2], "scepter": null, "shard": null}}], "rows": [{"review_id": "5af770c0b44398281493", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}, {"review_id": "606499e427e4b284ac33", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "item", "decision": "accept"}]}, {"subject": "treant_eyes_in_the_forest", "name_zh": "树精卫士·丛林之眼", "category": "2_纯数值", "text_741f": {"desc_loc": "Treant Protector enchants a tree, which grants him unobstructed vision in that location. The eyes last for %duration% seconds and are invisible, but are destroyed if their host tree is destroyed or if they are attacked directly.", "notes_loc": ["Being entangled by Overgrowth through enchanted trees from Eyes in the Forest does damage.", "If the enemy has True Sight, they will be able to see which trees are enchanted."]}, "text_742": {"desc_loc": "Treant Protector enchants a tree, which grants him unobstructed vision in that location. The eyes last for %duration% seconds and are invisible, but are destroyed if their host tree is destroyed or if they are attacked directly.", "notes_loc": ["Being entangled by Overgrowth through enchanted trees from Eyes in the Forest does damage.", "If the enemy has True Sight, they will be able to see which trees are enchanted."]}, "changed_fields": [], "rows": [{"review_id": "e8ba8f6a5341be8bcc90", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "accept"}, {"review_id": "66c98233374070c1a75f", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "audit:treant_eyes_in_the_forest:high_ground_vision:shard", "mechanism": "high_ground_vision", "mechanism_zh": "高空视野", "definition": "获得不被阻挡的视野，如暗夜魔王的大招", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "ac533a4e9088176e89ef", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "reject"}, {"review_id": "dd8942c40dce837e75c9", "mechanism": "tree_destroy", "mechanism_zh": "砍树", "definition": "能摧毁树木", "condition": "base", "decision": "reject"}, {"review_id": "c8d6b6571b599e603dc3", "mechanism": "true_sight", "mechanism_zh": "真视", "definition": "可看见隐身单位", "condition": "base", "decision": "reject"}, {"review_id": "fa957c2e0ea72b92fcb6", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "reject"}]}, {"subject": "treant_leech_seed", "name_zh": "树精卫士·寄生种子", "category": "2_纯数值", "text_741f": {"desc_loc": "Treant's attack plants a life-sapping seed in an enemy unit. That unit takes additional magic damage, is rooted and disarmed for a short duration, and emits %healing_pulse_count% healing pulses to up to %max_heal_units% nearby allies of Treant Protector based on the damage dealt by the attack.", "facets_loc": ["Leech Seed can be ground targeted, planting a tree that heals allies and damages all enemies in the effect radius for the duration of the ability. Damage to creeps is reduced by %creep_damage_reduction_pct%%%. If the tree is cut down, it immediately re-grows again."]}, "text_742": {"desc_loc": "Treant's attack plants a life-sapping seed in an enemy unit. That unit takes additional magic damage, is rooted and disarmed for a short duration, and emits %healing_pulse_count% healing pulses to up to %max_heal_units% nearby allies of Treant Protector based on the damage dealt by the attack.", "facets_loc": ["Leech Seed can be ground targeted, planting a tree that heals allies and damages all enemies in the effect radius for the duration of the ability. Damage to creeps is reduced by %creep_damage_reduction_pct%%%. If the tree is cut down, it immediately re-grows again."]}, "changed_fields": [{"field": "mana_costs", "old": [35], "new": [20]}, {"field": "AbilityManaCost", "old": {"base": [35], "scepter": null, "shard": null}, "new": {"base": [20], "scepter": null, "shard": null}}], "rows": [{"review_id": "2f3a6481b32bee988149", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "58b60079be3658705c3a", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "ffd23c162a219a58368c", "mechanism": "bind", "mechanism_zh": "捆缚", "definition": "目标不能移动，也不能攻击，闪烁和传送类也不能用，但仍能施法", "condition": "base", "decision": "accept"}, {"review_id": "172dd6048e6cdb633a72", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "f82c6afeab2c921cf3e8", "mechanism": "disarm", "mechanism_zh": "缴械", "definition": "目标无法普通攻击", "condition": "base", "decision": "accept"}, {"review_id": "8b97ffb99c9db33c1209", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "9dc871d49bc3eb985744", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "reject"}, {"review_id": "628e3a79cee3249bbca0", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "base", "decision": "reject"}, {"review_id": "83d39cd24cf02b1ac76e", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "treant_natures_grasp", "name_zh": "树精卫士·自然卷握", "category": "3_说明文字", "text_741f": {"desc_loc": "Creates vines towards the target location. Vines slow down and deal damage to enemies that walk through. Does %creep_penalty%%% less damage to creeps."}, "text_742": {"desc_loc": "Creates vines towards the target location. Vines slow down and deal damage to enemies that walk through."}, "changed_fields": [{"field": "creep_penalty", "old": {"base": [35], "scepter": null, "shard": null}, "new": null}], "rows": [{"review_id": "b4901aaa947763c7e7f2", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:treant_natures_grasp:ground_zone:base", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "base", "decision": "accept"}, {"review_id": "b56373940b0b6cdc9d27", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "troll_warlord_battle_trance", "name_zh": "巨魔战将·战斗专注", "category": "3_说明文字", "text_741f": {"desc_loc": "Troll unleashes a powerful battle trance, that forces you to continuously attack the closest enemy unit within %range% range, prioritizing heroes. Damage does not kill you during this mode. Grants you bonus lifesteal, attack speed, slow resistance and movement speed. Applies a Basic Dispel. DISPEL TYPE: Basic Dispel", "notes_loc": ["Troll can still use his items and abilities while affected by Battle Trance, but not other commands.", "Troll can still be killed with Axe's Culling Blade.", "Troll is granted vision over the target."], "facets_loc": ["During Battle Trance, Troll Warlord has increased max Fervor stacks and no attack speed limit. Battle Trance grants allied heroes %attack_speed_share_percent%%% of the attack speed bonus."]}, "text_742": {"desc_loc": "Troll unleashes a powerful battle trance, that forces you to continuously attack the closest enemy unit within %range% range, prioritizing heroes. Unslowable while attacking. Damage does not kill you during this mode. Grants you bonus lifesteal, attack speed, status resistance, and movement speed. Applies a Basic Dispel. DISPEL TYPE: Basic Dispel", "notes_loc": ["Troll can still use his items and abilities while affected by Battle Trance, but not other commands.", "Troll can still be killed with Axe's Culling Blade.", "Troll is granted vision over the target."], "facets_loc": ["During Battle Trance, Troll Warlord has increased max Fervor stacks and no attack speed limit. Battle Trance grants allied heroes %attack_speed_share_percent%%% of the attack speed bonus."]}, "changed_fields": [{"field": "slow_resistance", "old": {"base": [35], "scepter": null, "shard": null}, "new": null}, {"field": "status_resistance", "old": null, "new": {"base": [15, 20, 25], "scepter": null, "shard": null}}], "rows": [{"review_id": "9030410c6da5414d485d", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "audit:troll_warlord_battle_trance:death_prevention:base", "mechanism": "death_prevention", "mechanism_zh": "免死", "definition": "在一段时间内不会被打死（如薄葬、回光返照）", "condition": "base", "decision": "accept"}, {"review_id": "17ae2e8e0664321b8aef", "mechanism": "execute", "mechanism_zh": "斩杀", "definition": "目标低于生命阈值时直接杀死", "condition": "base", "decision": "reject"}, {"review_id": "062386e9d9312364613b", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "67c4f04a8aafa1268b03", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "c369a97a09d616e0584d", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}, {"review_id": "62613f1350de1228dd41", "mechanism": "slow_resistance", "mechanism_zh": "减速抗性", "definition": "降低自身受到的减速效果（如散夜对剑+30%）", "condition": "base", "decision": "accept"}, {"review_id": "audit:troll_warlord_battle_trance:forced_action:base", "mechanism": "taunt", "mechanism_zh": "嘲讽", "definition": "单位被迫攻击某个目标：强迫敌人攻击施法者、决斗、被迫攻击队友、周围单位被迫攻击指定目标、强迫自身攻击都算", "condition": "base", "decision": "accept"}]}, {"subject": "tusk_drinking_buddies", "name_zh": "巨牙海民·酒友", "category": "2_纯数值", "text_741f": {"desc_loc": "Tusk reaches out to tag an allied unit, pulling them closer. Once tagged, both Tusk and his tagged ally gain movement speed and armor.", "notes_loc": ["Doesn't pull Tusk or targeted ally if they are within %min_distance% range of each other.", "Cannot be used during Snowball."]}, "text_742": {"desc_loc": "Tusk reaches out to tag an allied unit, pulling them closer. Once tagged, both Tusk and his tagged ally gain movement speed and armor.", "notes_loc": ["Doesn't pull Tusk or targeted ally if they are within %min_distance% range of each other.", "Cannot be used during Snowball."]}, "changed_fields": [{"field": "buff_duration", "old": {"base": [6], "scepter": null, "shard": null}, "new": {"base": [7], "scepter": null, "shard": null}}, {"field": "movespeed_bonus", "old": {"base": [25], "scepter": null, "shard": null}, "new": {"base": [30], "scepter": null, "shard": null}}], "rows": [{"review_id": "ded9522bee6f9eaafa3e", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "09f4588c6729db21e8bd", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "audit:tusk_drinking_buddies:self_mobility:shard", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "audit:tusk_drinking_buddies:terrain_walk:shard", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "shard_upgrade", "decision": "accept"}]}, {"subject": "undying_ceaseless_dirge", "name_zh": "不朽尸王·挽歌犹唱", "category": "3_说明文字", "text_741f": {"desc_loc": "When Undying dies he will instantly respawn in the fountain. Begins the game on cooldown. Cannot be refreshed."}, "text_742": {"desc_loc": "When Undying dies he will instantly respawn in the fountain. Begins the game on cooldown. Cannot be refreshed and is not affected by cooldown reduction."}, "changed_fields": [], "rows": [{"review_id": "b9194c489349772ab74e", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "09c4ebf7ef84233cccc4", "mechanism": "respawn", "mechanism_zh": "重生", "definition": "死亡后复活，或影响复活", "condition": "base", "decision": "accept"}]}, {"subject": "undying_flesh_golem", "name_zh": "不朽尸王·血肉傀儡", "category": "2_纯数值", "text_741f": {"desc_loc": "Undying transforms into a horrifying flesh golem. While in this state, he gains a percentage increase to strength, bonus movement speed, and causes attacks to slow, apply damage amplification, and spawn Tombstone zombies.", "facets_loc": ["While transformed into a Flesh Golem, attacks spawn a zombie."]}, "text_742": {"desc_loc": "Undying transforms into a horrifying flesh golem. While in this state, he gains a percentage increase to strength, bonus movement speed, and causes attacks to slow, apply damage amplification, and spawn Tombstone zombies.", "facets_loc": ["While transformed into a Flesh Golem, attacks spawn a zombie."]}, "changed_fields": [{"field": "damage_amp", "old": {"base": [25, 30, 35], "scepter": null, "shard": null}, "new": {"base": [20, 25, 30], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:undying_flesh_golem:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "eb11ceb893590b10a325", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "a4cf535ce2d1901de191", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "accept"}, {"review_id": "7e3174a9258041fc1557", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "undying_soul_rip", "name_zh": "不朽尸王·噬魂", "category": "2_纯数值", "text_741f": {"desc_loc": "Undying rips health away from all nearby units and uses it to heal an ally, or damage an enemy. Soul Rip can also be used to heal Tombstone.", "notes_loc": ["Can heal Tombstone, but can't heal or damage other buildings.", "Does not rip from invisible units, invulnerable units, units in the fog of war, or spell immune enemies.", "Does rip from spell immune allies, including zombies."], "facets_loc": ["Casting Soul Rip on allies increases their Strength by a percentage of Undying's Strength."]}, "text_742": {"desc_loc": "Undying rips health away from all nearby units and uses it to heal an ally, or damage an enemy. Soul Rip can also be used to heal Tombstone.", "notes_loc": ["Can heal Tombstone, but can't heal or damage other buildings.", "Does not rip from invisible units, invulnerable units, units in the fog of war, or spell immune enemies.", "Does rip from spell immune allies, including zombies."], "facets_loc": ["Casting Soul Rip on allies increases their Strength by a percentage of Undying's Strength."]}, "changed_fields": [{"field": "strength_share_duration", "old": {"base": [0], "scepter": null, "shard": null}, "new": null}, {"field": "strength_share_model_scale", "old": {"base": [0], "scepter": null, "shard": null}, "new": null}, {"field": "strength_share_percent", "old": {"base": [0], "scepter": null, "shard": null}, "new": null}, {"field": "tombstone_heal", "old": {"base": [4, 8, 12, 16], "scepter": null, "shard": null}, "new": {"base": [1, 2, 3, 4], "scepter": null, "shard": null}}], "rows": [{"review_id": "649c2580025cd6ee081b", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "a2135dec4c019380bab5", "mechanism": "debuff_immunity", "mechanism_zh": "减益免疫/技能免疫", "definition": "处于减益免疫（技能免疫）时，只有能无视减益免疫的效果才对其生效（如碎颅锤的重击可以眩晕开了黑皇杖的单位）", "condition": "base", "decision": "reject"}, {"review_id": "a398d8c969e4c08402c6", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "d5e57f0f93f66dedf40f", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "undying_tombstone", "name_zh": "不朽尸王·墓碑", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Summons a tombstone at the target point. Zombies will frequently spawn next to every enemy unit in the area around the Tombstone, and attack them. Zombies have the Deathlust ability, which causes their attacks to slow the target, and if the target reaches below a certain amount of health, increases the attack and movement speed of the zombie.", "notes_loc": ["Tombstone is Spell Immune, but can be healed by Soul Rip.", "Zombies and Tombstone are Spell Immune.", "If their initial target dies or goes out of vision, the Zombie will die."], "shard_loc": "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."}, "text_742": {"desc_loc": "Summons a tombstone at the target point. Zombies will frequently spawn next to every enemy unit in the area around the Tombstone, and attack them. Zombies have the Deathlust ability, which causes their attacks to slow the target, and if the target reaches below a certain amount of health, increases the attack and movement speed of the zombie.", "notes_loc": ["Tombstone is Spell Immune, but can be healed by Soul Rip.", "Zombies and Tombstone are Spell Immune.", "If their initial target dies or goes out of vision, the Zombie will die."], "shard_loc": "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."}, "changed_fields": [{"field": "ability_has_shard", "old": true, "new": false}, {"field": "tombstone_health", "old": {"base": [20, 24, 28, 32], "scepter": null, "shard": null}, "new": {"base": [5, 6, 7, 8], "scepter": null, "shard": null}}, {"field": "zombie_health", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [1], "scepter": null, "shard": null}}], "rows": [{"review_id": "4d11a1e0737317667dc6", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "audit:undying_tombstone:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "973837647c6283b42739", "mechanism": "debuff_immunity", "mechanism_zh": "减益免疫/技能免疫", "definition": "处于减益免疫（技能免疫）时，只有能无视减益免疫的效果才对其生效（如碎颅锤的重击可以眩晕开了黑皇杖的单位）", "condition": "base", "decision": "accept"}, {"review_id": "d20d74cf93a471b2d0e5", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "95de13655b39ceaff5dd", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "reject"}, {"review_id": "44c08947f7032fa76e4a", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "067d2e71afe53a3ef84e", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "c34d840b58ad1a51df66", "mechanism": "summons", "mechanis