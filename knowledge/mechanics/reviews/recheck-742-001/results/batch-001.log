d": "2c98c2cb05a4a2a4bb26", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "scepter_upgrade", "decision": "reject"}]}, {"subject": "abaddon_death_coil", "name_zh": "亚巴顿·迷雾缠绕", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Abaddon releases a coil of deathly mist that can damage an enemy unit or heal a friendly unit at the cost of some of Abaddon's health.", "notes_loc": ["Abaddon can not kill himself with this skill."], "facets_loc": ["Mist Coil also deals %damage_percentage_on_perform_attack%%% attack damage and applies effects from items and abilities. Self Damage increased when targeting enemies."]}, "text_742": {"desc_loc": "Abaddon releases a coil of deathly mist at the cost of Abaddon's health. Friendly units are healed and have their movement speed increased. Enemy units are damaged and slowed. Health cost is %self_damage_pct%%% of the Damage/Heal amount.", "notes_loc": ["Abaddon can not kill himself with this skill.", "Mist Coil's health cost will damage Aphotic Shield and other barriers before using Abaddon's health."], "scepter_loc": "Mist Coil affects all units in a %effect_radius% radius around the target. When Mist Coil hits enemies, Abaddon deals %damage_percentage_on_perform_attack%%% of his attack damage and applies on-hit effects with %potency%%% Item Potency."}, "changed_fields": [{"field": "ability_has_scepter", "old": false, "new": true}, {"field": "damage_percentage_on_perform_attack", "old": {"base": [], "scepter": null, "shard": null}, "new": {"base": [0], "scepter": [100], "shard": null}}, {"field": "duration", "old": null, "new": {"base": [0.7, 0.8, 0.9, 1], "scepter": null, "shard": null}}, {"field": "effect_radius", "old": {"base": [], "scepter": null, "shard": null}, "new": {"base": [0], "scepter": [400], "shard": null}}, {"field": "movement_speed_pct", "old": null, "new": {"base": [60], "scepter": null, "shard": null}}, {"field": "perform_attack", "old": {"base": [], "scepter": null, "shard": null}, "new": {"base": [0], "scepter": [1], "shard": null}}, {"field": "potency", "old": null, "new": {"base": [0], "scepter": [80], "shard": null}}, {"field": "self_damage", "old": {"base": [40], "scepter": null, "shard": null}, "new": null}, {"field": "self_damage_enemy_target", "old": {"base": [40], "scepter": null, "shard": null}, "new": null}, {"field": "self_damage_pct", "old": null, "new": {"base": [40], "scepter": null, "shard": null}}], "rows": [{"review_id": "f5f47bc0d9db93f9412b", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "e01f7cdb62122e1046a5", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "52a5b55a7ce6f1fd8e95", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "abaddon_frostmourne", "name_zh": "亚巴顿·魔霭诅咒", "category": "3_说明文字", "text_741f": {"desc_loc": "Abaddon strikes an enemy, affecting them by a chilling curse, slowing them, causing them to take damage over time, and all attacks against them gain an attack speed boost. Damage over time component to buildings is reduced by %tower_dps_pct%%%."}, "text_742": {"desc_loc": "Abaddon strikes an enemy, affecting them by a chilling curse, slowing them, causing them to take damage over time, and all attacks against them gain an attack speed boost. Abaddon gains %curse_self_attack_speed_multiplier_tooltip_only%x the attack speed boost. Damage over time component to buildings is reduced by %tower_dps_penalty_pct%%%."}, "changed_fields": [{"field": "curse_attack_speed", "old": {"base": [10, 20, 30, 40], "scepter": null, "shard": null}, "new": {"base": [15, 20, 25, 30], "scepter": null, "shard": null}}, {"field": "curse_dps", "old": {"base": [15, 25, 35, 45], "scepter": null, "shard": null}, "new": {"base": [12, 20, 28, 36], "scepter": null, "shard": null}}, {"field": "curse_duration", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [3], "scepter": null, "shard": null}}, {"field": "curse_self_attack_speed", "old": null, "new": {"base": [22.5, 30, 37.5, 45], "scepter": null, "shard": null}}, {"field": "curse_self_attack_speed_multiplier_tooltip_only", "old": null, "new": {"base": [1.5], "scepter": null, "shard": null}}, {"field": "hit_count", "old": {"base": [1], "scepter": null, "shard": null}, "new": null}, {"field": "slow_duration", "old": {"base": [2], "scepter": null, "shard": null}, "new": null}, {"field": "tower_dps_pct", "old": {"base": [100], "scepter": null, "shard": null}, "new": null}, {"field": "tower_dps_penalty_pct", "old": null, "new": {"base": [100], "scepter": null, "shard": null}}], "rows": [{"review_id": "5388d26e118abfa3417e", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "audit:abaddon_frostmourne:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "30e55fe750e981045a87", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "59b84b5db11958e4fd3b", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "abaddon_withering_mist", "name_zh": "亚巴顿·凋零迷雾", "category": "3_说明文字", "text_741f": {"desc_loc": "Damaging enemies applies the Withering Mist debuff for %duration%s. Affected enemies have their Health Restoration reduced by %heal_reduction_pct%%% if they are below %hp_threshold_pct%%% HP."}, "text_742": {"desc_loc": "Damaging enemies reduces their Health Restoration for %duration%s. The lower the enemy's HP, the stronger the Health restoration reduction effect. Minimum effect of %min_heal_reduction_pct%%% at full health. Maximum effect at zero health. Does not apply from item damage."}, "changed_fields": [{"field": "heal_reduction_pct", "old": {"base": [29.5], "scepter": null, "shard": null}, "new": null}, {"field": "hp_threshold_pct", "old": {"base": [40], "scepter": null, "shard": null}, "new": null}, {"field": "max_heal_reduction_pct", "old": null, "new": {"base": [40], "scepter": null, "shard": null}}, {"field": "min_heal_reduction_pct", "old": null, "new": {"base": [10], "scepter": null, "shard": null}}], "rows": [{"review_id": "8580b6af0a2d9111ad8e", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "c2dd818ab9c8a64c54f8", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "023b1cfedc31aaaf3dcb", "mechanism": "heal_reduction", "mechanism_zh": "治疗削减", "definition": "降低或禁止目标的任何形式生命恢复，含属性回复；提升生命上限的效果不受影响", "condition": "base", "decision": "accept"}]}, {"subject": "abyssal_blade", "name_zh": "深渊之刃", "category": "3_说明文字", "text_741f": {"desc_loc": "Active: Overwhelm Stuns a target enemy unit for %stun_duration% seconds. Pierces Debuff Immunity. Passive: Bash Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage. Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_loc": ["The stun is melee range.", "Does not stack with other bashes, and does not grant bash to Clones and Tempest Doubles.", "Multiple sources of damage block do not stack.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode."]}, "text_742": {"desc_loc": "Active: Overwhelm Stuns a target enemy unit for %stun_duration% seconds. Pierces Debuff Immunity. Passive: Bash Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage. Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_loc": ["The stun is melee range.", "Does not stack with other bashes, and does not grant bash to Clones, Illusions, or Tempest Doubles.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode.", "Attack Range bonuses from Dragon Lance and its upgrades do not stack."]}, "changed_fields": [{"field": "cast_ranges", "old": [150], "new": [175]}, {"field": "item_cost", "old": 6250, "new": 6150}, {"field": "AbilityCastRange", "old": {"base": [150], "scepter": null, "shard": null}, "new": {"base": [175], "scepter": null, "shard": null}}, {"field": "base_attack_range_melee", "old": null, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "bonus_agility", "old": null, "new": {"base": [15], "scepter": null, "shard": null}}, {"field": "hp_regen_amp", "old": {"base": [16], "scepter": null, "shard": null}, "new": null}, {"field": "slow_resistance", "old": {"base": [30], "scepter": null, "shard": null}, "new": null}], "rows": [{"review_id": "6bff14de65c720924c05", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "reject"}, {"review_id": "cd98da73ae5e3687e164", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "item", "decision": "accept"}, {"review_id": "325afb07ca5141e24d40", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "item", "decision": "reject"}, {"review_id": "e8f160c820a1e8d97873", "mechanism": "pierces_debuff_immunity", "mechanism_zh": "无视减益免疫", "definition": "效果对处于减益免疫的敌方仍生效（技能看immunity=3，装备看官方说明）", "condition": "item", "decision": "accept"}, {"review_id": "audit:abyssal_blade:slow_resistance:item", "mechanism": "slow_resistance", "mechanism_zh": "减速抗性", "definition": "降低自身受到的减速效果（如散夜对剑+30%）", "condition": "item", "decision": "accept"}, {"review_id": "04fa0ef69a96f89755a7", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "item", "decision": "accept"}, {"review_id": "af53553ef03fbfbbe6f5", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "item", "decision": "accept"}, {"review_id": "c359f7cc91fdc0ad13f8", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "item", "decision": "accept"}]}, {"subject": "abyssal_underlord_dark_portal", "name_zh": "孽主·恶魔之扉", "category": "3_说明文字", "text_741f": {"desc_loc": "Opens 2 portals, one next to Underlord and one in the target location. Heroes can channel a portal for %warp_channel_duration% seconds to teleport to the other side. Portals have to be at least %minimum_distance% away from each other.", "notes_loc": ["Double-click to teleport to your team's base, in front of your fountain"], "scepter_loc": "Summons a Pit of Malice around each of the portals. Reduces cooldown.", "facets_loc": ["Underlord summons uncontrollable demonic Warriors and Archers after travelling through the Fiend's Gate that attack nearby enemies. These units deal %underling_building_damage_reduction_tooltip%%% damage to buildings."]}, "text_742": {"desc_loc": "Opens 2 portals, one next to Underlord and one in the target location. Heroes can channel a portal for %warp_channel_duration% seconds to teleport to the other side. Portals have to be at least %minimum_distance% away from each other.", "notes_loc": ["Double-click to teleport to your team's base, in front of your fountain"], "scepter_loc": "Summons a Pit of Malice around the furthermost of the portals. Reduces cooldown.", "facets_loc": ["Underlord summons uncontrollable demonic Warriors and Archers after travelling through the Fiend's Gate that attack nearby enemies. These units deal %underling_building_damage_reduction_tooltip%%% damage to buildings."]}, "changed_fields": [{"field": "cooldowns", "old": [110, 105, 100], "new": [115, 105, 95]}, {"field": "AbilityCooldown", "old": {"base": [110, 105, 100], "scepter": [20], "shard": null}, "new": {"base": [115, 105, 95], "scepter": [20], "shard": null}}, {"field": "aura_radius", "old": null, "new": {"base": [0], "scepter": [1200], "shard": null}}, {"field": "shot_cooldown", "old": null, "new": {"base": [0], "scepter": [0.8], "shard": null}}, {"field": "shot_damage", "old": null, "new": {"base": [0], "scepter": [0], "shard": null}}, {"field": "shot_movement_speed_pct", "old": null, "new": {"base": [0], "scepter": [40], "shard": null}}, {"field": "shot_slow_duration", "old": null, "new": {"base": [0], "scepter": [2.5], "shard": null}}, {"field": "shot_speed", "old": null, "new": {"base": [0], "scepter": [950], "shard": null}}, {"field": "shot_vision", "old": null, "new": {"base": [0], "scepter": [100], "shard": null}}, {"field": "shot_vision_duration", "old": null, "new": {"base": [0], "scepter": [1.5], "shard": null}}, {"field": "warp_channel_duration", "old": {"base": [3.5], "scepter": null, "shard": null}, "new": {"base": [3.5, 3.25, 3], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:abyssal_underlord_dark_portal:aoe_damage:scepter", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "6e0a7e13d695487c8eee", "mechanism": "channeled", "mechanism_zh": "持续施法", "definition": "施法者自身需要持续引导，被打断即停止", "condition": "base", "decision": "reject"}, {"review_id": "audit:abyssal_underlord_dark_portal:displace_other:base", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "audit:abyssal_underlord_dark_portal:ground_zone:scepter", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "audit:abyssal_underlord_dark_portal:root:scepter", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "138331cab6893993b41e", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "scepter_upgrade", "decision": "reject"}, {"review_id": "c989d06692066a02ad9f", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}]}, {"subject": "abyssal_underlord_raid_boss", "name_zh": "孽主·侵略大军", "category": "3_说明文字", "text_741f": {"desc_loc": "After an allied hero Teleports, they temporarily gain Damage Reduction and Movement Speed. Allies receive %dark_portal_multiplier%x bonuses if teleporting via Fiend's Gate."}, "text_742": {"desc_loc": "After an allied hero Teleports, they temporarily gain a Physical Damage Barrier based on their max health and Movement Speed. Allies receive %dark_portal_multiplier%x bonuses if teleporting via Fiend's Gate."}, "changed_fields": [{"field": "barrier_max_health_pct", "old": null, "new": {"base": [8.5], "scepter": null, "shard": null}}, {"field": "buff_duration", "old": {"base": [5], "scepter": null, "shard": null}, "new": {"base": [6], "scepter": null, "shard": null}}, {"field": "damage_reduction", "old": {"base": [3.7], "scepter": null, "shard": null}, "new": null}], "rows": [{"review_id": "ec3e03a5a294a8a824da", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "c5c60221b29ab7606e25", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "accept"}, {"review_id": "d459cb44e9075b5ec96d", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "58d316e6a4678c80739b", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "reject"}, {"review_id": "fa7545c29e6d5ee5a5b5", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "reject"}]}, {"subject": "aether_lens", "name_zh": "Aether Lens", "category": "2_纯数值", "text_741f": {"notes_loc": ["Cast Range bonuses from Aether Lens and Dagon do not stack."]}, "text_742": {"notes_loc": ["Cast Range bonuses from Aether Lens and Dagon do not stack."]}, "changed_fields": [{"field": "item_cost", "old": 2275, "new": 2100}, {"field": "cast_range_bonus", "old": {"base": [225], "scepter": null, "shard": null}, "new": {"base": [200], "scepter": null, "shard": null}}], "rows": [{"review_id": "17e69798a3c6a3f66932", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}]}, {"subject": "alchemist_berserk_potion", "name_zh": "炼金术士·狂暴药剂", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Alchemist throws a potion at an ally, applying a basic dispel and giving them attack speed, movement speed and HP regen. DISPEL TYPE: Basic Dispel", "facets_loc": ["While Alchemist is affected by Chemical Rage, cooldown is reduced by %chemical_rage_cooldown_reduction_pct%%%."]}, "text_742": {"desc_loc": "Alchemist throws a potion at an ally, applying a basic dispel and giving them attack speed, movement speed and HP regen. DISPEL TYPE: Basic Dispel", "facets_loc": ["While Alchemist is affected by Chemical Rage, cooldown is reduced by %chemical_rage_cooldown_reduction_pct%%%."]}, "changed_fields": [{"field": "dispellable", "old": 2, "new": 3}, {"field": "mana_costs", "old": [100], "new": [75]}, {"field": "AbilityManaCost", "old": {"base": [100], "scepter": null, "shard": null}, "new": {"base": [75], "scepter": null, "shard": null}}], "rows": [{"review_id": "ae26e07267b79b539a3f", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "9a8c0166570afbebc9e0", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "6087ba2c896efaf75a14", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}]}, {"subject": "alchemist_goblins_greed", "name_zh": "炼金术士·贪魔的贪婪", "category": "2_纯数值", "text_741f": {"desc_loc": "Alchemist synthesizes additional gold from his enemies and bounty runes. With each kill, Alchemist earns base bonus gold and extra bonus gold. If Alchemist kills another unit which yields gold within the next %duration% seconds, an additional instance of Extra Bonus Gold is added to the total. Additionally, causes bounty runes to yield more gold.", "scepter_loc": "Alchemist melts down Aghanim's Scepter to grant an allied hero all Aghanim's Scepter upgrades. Alchemist will gain bonus %scepter_bonus_damage% damage and %bonus_gold_per_scepter% additional base and max Greevil's Greed Extra Gold for each melted Scepter.", "facets_loc": ["Alchemist gains %gpm_increase_per_stack% GPM for each Aghanim's Scepter he has granted to allies."]}, "text_742": {"desc_loc": "Alchemist synthesizes additional gold from his enemies and bounty runes. With each kill, Alchemist earns base bonus gold and extra bonus gold. If Alchemist kills another unit which yields gold within the next %duration% seconds, an additional instance of Extra Bonus Gold is added to the total. Additionally, causes bounty runes to yield more gold.", "scepter_loc": "Alchemist melts down Aghanim's Scepter to grant an allied hero all Aghanim's Scepter upgrades. Alchemist will gain bonus %scepter_bonus_damage% damage and %bonus_gold_per_scepter% additional base and max Greevil's Greed Extra Gold for each melted Scepter.", "facets_loc": ["Alchemist gains %gpm_increase_per_stack% GPM for each Aghanim's Scepter he has granted to allies."]}, "changed_fields": [{"field": "scepter_bonus_damage", "old": {"base": [15], "scepter": null, "shard": null}, "new": {"base": [20], "scepter": null, "shard": null}}], "rows": [{"review_id": "7a5c71d6bbe8acd03b08", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "b0dbc98060cb0d9273ca", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "accept"}]}, {"subject": "ancient_apparition_bone_chill", "name_zh": "远古冰魄·刺骨严寒", "category": "3_说明文字", "text_741f": {"desc_loc": "When Ancient Apparition deals Magic damage to an enemy with his abilities, it is slowed for a short duration. If the target is a Hero, its Strength is also reduced. Multiple instances of this effect stack and have independent durations.", "scepter_loc": "Increases Base Strength Reduction by %tooltip_scepter_bonus%."}, "text_742": {"desc_loc": "When Ancient Apparition deals Magic damage to an enemy Hero with his abilities its Strength is reduced. Multiple instances of this effect stack and have independent durations.", "scepter_loc": "Increases Base Strength Reduction by %tooltip_scepter_bonus%."}, "changed_fields": [{"field": "movement_slow_pct", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [], "scepter": null, "shard": null}}], "rows": [{"review_id": "8a62e8f48646ffba341c", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "520b3e8b16fbc21a4e03", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "f718ffee4caf02179a56", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "ancient_apparition_chilling_touch", "name_zh": "远古冰魄·极寒之触", "category": "2_纯数值", "text_741f": {"desc_loc": "Enhances Ancient Apparition's attack with increased range and a burst of magical damage and slow.", "scepter_loc": "Removes cooldown."}, "text_742": {"desc_loc": "Enhances Ancient Apparition's attack with increased range and a burst of magical damage and slow.", "scepter_loc": "Removes cooldown."}, "changed_fields": [{"field": "mana_costs", "old": [35], "new": [30]}, {"field": "AbilityManaCost", "old": {"base": [35], "scepter": null, "shard": null}, "new": {"base": [30], "scepter": null, "shard": null}}, {"field": "attacks_as_magic", "old": null, "new": {"base": [0], "scepter": [0], "shard": null}}, {"field": "damage", "old": {"base": [35, 65, 95, 125], "scepter": null, "shard": null}, "new": {"base": [40, 80, 120, 160], "scepter": null, "shard": null}}], "rows": [{"review_id": "6e2259ca556fe474e521", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "8c0f3404b538630621fa", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "b191adef9793c1cf912e", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "ancient_apparition_cold_feet", "name_zh": "远古冰魄·寒霜之足", "category": "3_说明文字", "text_741f": {"desc_loc": "Places a curse on an enemy, dealing damage over time. If the enemy unit doesn't move outside of the given range from the initial location, it will be stunned and frozen in place after %AbilityDuration% seconds.", "notes_loc": ["Deals damage every half second."], "facets_loc": ["Cold Feet becomes an AoE point targeted ability, with the radius depending on the current level of Ice Blast."]}, "text_742": {"desc_loc": "Places a curse on an enemy, dealing damage over time and slowing the target. If the enemy unit doesn't move outside of the given range from the initial location, it will be stunned and frozen in place after %AbilityDuration% seconds.", "notes_loc": ["Deals damage every half second."], "facets_loc": ["Cold Feet becomes an AoE point targeted ability, with the radius depending on the current level of Ice Blast."]}, "changed_fields": [{"field": "leash", "old": null, "new": {"base": [], "scepter": null, "shard": null}}, {"field": "movement_slow", "old": null, "new": {"base": [4, 6, 8, 10], "scepter": null, "shard": null}}], "rows": [{"review_id": "260f6b7f332b274e64b9", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "399a29e359128b7dffd3", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "c4edd5471615128972cf", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "ancient_apparition_ice_blast", "name_zh": "远古冰魄·冰晶爆轰", "category": "2_纯数值", "text_741f": {"desc_loc": "Launches a tracer toward any location on the battlefield, which must be triggered again to mark the area to be blasted by a damaging explosion of hail. The further the tracer travels, the larger the explosion will be. Enemies caught in the explosion, or who touch the icy ball of hail as it travels, are Frostbitten, taking damage over time and prevented from regenerating or healing. If a Frostbitten unit's health drops below a certain percentage, they will instantly shatter.", "notes_loc": ["Upon cast, this ability is replaced by Release, used to stop the tracer on the target area.", "The area of effect is %radius_min% + %radius_grow%*TimeTraveled, capped at %radius_max%.", "Kill will be granted to the source of the damage that triggers the shatter.", "The shatter effect doesn't work on illusions.", "The HP Freeze prevents most kinds of healing, including the fountain, except Sunder, Time Lapse and Supernova."], "shard_loc": "Freezes enemies hit with the current level of Cold Feet for %cold_feet_stun_duration_pct%%% of the duration."}, "text_742": {"desc_loc": "Launches a tracer toward any location on the battlefield, which must be triggered again to mark the area to be blasted by a damaging explosion of hail. The further the tracer travels, the larger the explosion will be. Enemies caught in the explosion, or who touch the icy ball of hail as it travels, are Frostbitten, taking damage over time and prevented from regenerating or healing. If a Frostbitten unit's health drops below a certain percentage, they will instantly shatter.", "notes_loc": ["Upon cast, this ability is replaced by Release, used to stop the tracer on the target area.", "The area of effect is %radius_min% + %radius_grow%*TimeTraveled, capped at %radius_max%.", "Kill will be granted to the source of the damage that triggers the shatter.", "The shatter effect doesn't work on illusions.", "The HP Freeze prevents most kinds of healing, including the fountain, except Sunder, Time Lapse and Supernova."], "shard_loc": "Freezes enemies hit with the current level 