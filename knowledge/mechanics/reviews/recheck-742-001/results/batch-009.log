sm_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}]}, {"subject": "invis_sword", "name_zh": "影刃", "category": "2_纯数值", "text_741f": {"desc_loc": "Active: Shadow Walk Makes you invisible for %windwalk_duration% seconds, or until you attack or cast a spell. While Shadow Walk is active, you move %windwalk_movement_speed%%% faster and can move through units. If attacking to end the invisibility, you gain %windwalk_bonus_damage% bonus physical damage on that attack.", "notes_loc": ["Has a %windwalk_fade_time% second fade time.", "If the invisibility ends without attacking, the bonus damage is lost."]}, "text_742": {"desc_loc": "Active: Shadow Walk Makes you invisible for %windwalk_duration% seconds, or until you attack or cast a spell. While Shadow Walk is active, you move %windwalk_movement_speed%%% faster and can move through units. If attacking to end the invisibility, you gain %windwalk_bonus_damage% bonus physical damage on that attack.", "notes_loc": ["Has a %windwalk_fade_time% second fade time.", "If the invisibility ends without attacking, the bonus damage is lost."]}, "changed_fields": [{"field": "windwalk_movement_speed", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [16], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:invis_sword:attack_modifier:item", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}, {"review_id": "3bf10f3591d4f181d804", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}, {"review_id": "9d8f0a023d6085f3f59b", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "item", "decision": "accept"}, {"review_id": "audit:invis_sword:phased:item", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "item", "decision": "accept"}]}, {"subject": "invoker_chaos_meteor", "name_zh": "祈求者·混沌陨石", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker pulls a flaming meteor from space onto the targeted location. Upon landing, the meteor rolls forward, constantly dealing damage based on the level of Exort , and rolling further based on the level of Wex . Units hit by the meteor will also be set on fire for a short time, receiving additional damage based on the level of Exort .", "notes_loc": ["Deals main damage to enemy units under meteor every %damage_interval% seconds and burns enemies for smaller damage over %burn_duration% seconds.", "The meteor moves at a speed of %travel_speed%."]}, "text_742": {"desc_loc": "Invoker pulls a flaming meteor from space onto the targeted location. Upon landing, the meteor rolls forward, constantly dealing damage based on the level of Exort , and rolling further based on the level of Wex . Units hit by the meteor will also be set on fire for a short time, receiving additional damage based on the level of Exort .", "notes_loc": ["Deals main damage to enemy units under meteor every %damage_interval% seconds and burns enemies for smaller damage over %burn_duration% seconds.", "The meteor moves at a speed of %travel_speed%."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893393", "new": "8724152401"}, {"field": "burn_dps", "old": {"base": [10, 15, 20, 25, 30, 35, 40, 45, 50], "scepter": null, "shard": null}, "new": {"base": [12, 16, 20, 24, 28, 32, 36, 40, 44], "scepter": null, "shard": null}}], "rows": [{"review_id": "4dbc82e2a5beaf6c3908", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "04727d871819c04b8daa", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "reject"}]}, {"subject": "invoker_cold_snap", "name_zh": "祈求者·急速冷却", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker draws the heat from an enemy, chilling them to their very core for a duration based on the level of Quas . The enemy will take damage and be briefly frozen. Further damage taken in this state will freeze the enemy again, dealing bonus damage. The enemy can only be frozen so often, but the freeze cooldown decreases based on the level of Quas .", "notes_loc": ["The freeze stun only triggers on damage greater than %damage_trigger% after reductions."]}, "text_742": {"desc_loc": "Invoker draws the heat from an enemy, chilling them to their very core for a duration based on the level of Quas . The enemy will take damage and be briefly frozen. Further damage taken in this state will freeze the enemy again, dealing bonus damage. The enemy can only be frozen so often, but the freeze cooldown decreases based on the level of Quas .", "notes_loc": ["The freeze stun only triggers on damage greater than %damage_trigger% after reductions."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893385", "new": "8724152393"}], "rows": [{"review_id": "fd941c2a954388107ee9", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "b3be8fbdebf21a072c0b", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "63121a12d5d009ea2164", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_deafening_blast", "name_zh": "祈求者·超震声波", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker unleashes a mighty sonic wave in front of him, dealing damage to any enemy unit it collides with based on the level of Exort . The sheer impact from the blast is enough to knock those enemy units back for a duration based on the level of Quas , then disarm their attacks for a duration based on the level of Wex ."}, "text_742": {"desc_loc": "Invoker unleashes a mighty sonic wave in front of him, dealing damage to any enemy unit it collides with based on the level of Exort . The sheer impact from the blast is enough to knock those enemy units back for a duration based on the level of Quas , then disarm their attacks for a duration based on the level of Wex .", "notes_loc": ["The Knockback is undispellable."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893393", "new": "8724152401"}, {"field": "dispellable", "old": 3, "new": 2}], "rows": [{"review_id": "dd92dae7ea152be32d64", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "7108d88f6f695aca7293", "mechanism": "disarm", "mechanism_zh": "缴械", "definition": "目标无法普通攻击", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_deafening_blast:displace_other:base", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_emp", "name_zh": "祈求者·电磁脉冲", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker builds up a charge of electromagnetic energy at a targeted location which automatically detonates after %delay% seconds. The detonation covers an area, draining mana based on the level of Wex . Deals damage for each point of mana drained. If EMP drains mana from an enemy hero, Invoker gains %self_mana_restore_pct%%% of the mana drained.", "notes_loc": ["Will not affect cycloned units (Tornado or Eul's Scepter of Divinity)."], "shard_loc": "Increases damage for each point of mana drained by EMP and pulls enemy units into the EMP's center at %drag_speed% units per second."}, "text_742": {"desc_loc": "Invoker builds up a charge of electromagnetic energy at a targeted location which automatically detonates after %delay% seconds. The detonation covers an area, draining mana based on the level of Wex . Deals damage for each point of mana drained. If EMP drains mana from an enemy hero, Invoker gains %self_mana_restore_pct%%% of the mana drained.", "notes_loc": ["Will not affect cycloned units (Tornado or Eul's Scepter of Divinity)."], "shard_loc": "Increases damage for each point of mana drained by EMP and pulls enemy units into the EMP's center at %drag_speed% units per second."}, "changed_fields": [{"field": "behavior", "old": "9007207978893425", "new": "8724152433"}], "rows": [{"review_id": "audit:invoker_emp:aoe_damage:base", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "cc39b1e1b3ccd75f3542", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "f85315bd6e54db9931f9", "mechanism": "cyclone_banish", "mechanism_zh": "吹风/放逐", "definition": "使目标短暂离开战场，期间无敌或不可被选取", "condition": "base", "decision": "reject"}, {"review_id": "943644663794109c304d", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "971771ea5ea6063d5b46", "mechanism": "mana_burn", "mechanism_zh": "烧蓝/法力削减", "definition": "减少目标的法力值", "condition": "base", "decision": "accept"}, {"review_id": "e3ecc540da945d8df118", "mechanism": "mana_burn", "mechanism_zh": "烧蓝/法力削减", "definition": "减少目标的法力值", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "cbad3cce63ddbc88aed6", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_forge_spirit", "name_zh": "祈求者·熔炉精灵", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker forges a spirit embodying the strength of fire and fortitude of ice. Damage and armor are based on the level of Exort while attack range, health, and duration are based on the level of Quas . The elemental's scorching attack is capable of melting the armor of enemy heroes. The number of spirits spawned is determined by the lower level of Quas and Exort .", "notes_loc": ["Casting this ability will replace currently summoned Forged Spirits."]}, "text_742": {"desc_loc": "Invoker forges a spirit embodying the strength of fire and fortitude of ice. Damage and armor are based on the level of Exort while attack range, health, and duration are based on the level of Quas . The elemental's scorching attack is capable of melting the armor of enemy heroes. The number of spirits spawned is determined by the lower level of Quas and Exort .", "notes_loc": ["Casting this ability will replace currently summoned Forged Spirits."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893381", "new": "8724152389"}], "rows": [{"review_id": "audit:invoker_forge_spirit:armor_reduction:base", "mechanism": "armor_reduction", "mechanism_zh": "减护甲", "definition": "降低目标护甲", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_forge_spirit:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "87effc6084cec0d18eb7", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_ghost_walk", "name_zh": "祈求者·幽灵漫步", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Invoker manipulates the ice and electrical energies around him, rendering his body invisible and gaining health and mana regen. The elemental imbalance created as a consequence slows nearby enemies based on the level of Quas , and slows Invoker as well based on the level of Wex .", "notes_loc": ["The slow effect does not work on Spell Immune enemies."], "shard_loc": "Ghost Walk now also applies the Ice Wall Damage Per Second to enemy heroes in its area of effect."}, "text_742": {"desc_loc": "Invoker manipulates the ice and electrical energies around him, rendering his body invisible and gaining health and mana regen. The elemental imbalance created as a consequence slows nearby enemies based on the level of Quas , and slows Invoker as well based on the level of Wex .", "notes_loc": ["The slow effect does not work on Spell Immune enemies."], "shard_loc": "Ghost Walk now also applies %ice_wall_damage_multiplier%x the Ice Wall Damage Per Second to enemy heroes in its area of effect."}, "changed_fields": [{"field": "behavior", "old": "9007207848872005", "new": "8594131013"}, {"field": "ice_wall_damage_multiplier", "old": null, "new": {"base": [1], "scepter": null, "shard": [1.25]}}], "rows": [{"review_id": "1cb9f3085c8336d6fb95", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "audit:invoker_ghost_walk:aura:base", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_ghost_walk:healing:base", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "64d5297ad3d1982cdb28", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "accept"}, {"review_id": "bb6d6ad8c9a37329f6db", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}, {"review_id": "184fa5a947ef4f4f4b52", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_ice_wall", "name_zh": "祈求者·寒冰之墙", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Generates a wall of solid ice directly in front of Invoker for a duration based on the level of Quas . The bitter cold emanating from it greatly slows nearby enemies based on the level of Quas and deals damage each second based on the level of Exort .", "scepter_loc": "Ice Wall becomes Ice Floe, Vector Targeted. After a delay, Ice Floe appears as a %wall_width% width Ice Wall. Enemy heroes in its area for longer than %root_delay% seconds become rooted and take magic damage based on Quas ."}, "text_742": {"desc_loc": "Generates a wall of solid ice directly in front of Invoker for a duration based on the level of Quas . The bitter cold emanating from it greatly slows nearby enemies based on the level of Quas and deals damage each second based on the level of Exort .", "scepter_loc": "Ice Wall becomes Ice Floe, Vector Targeted. After a delay, Ice Floe appears as a %wall_width% width Ice Wall. Enemy heroes in its area for longer than %root_delay% seconds become rooted and take magic damage based on Quas ."}, "changed_fields": [{"field": "behavior", "old": "9007207978893381", "new": "8724152389"}], "rows": [{"review_id": "c1dec8c619b837575142", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_ice_wall:ground_zone:base", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "base", "decision": "accept"}, {"review_id": "a2f3f5bc4639b440bb8b", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "f51ce8d127f5248c330e", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "invoker_sun_strike", "name_zh": "祈求者·阳炎冲击", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Sends a catastrophic ray of fierce energy from the sun at any targeted location, incinerating all enemies standing beneath it once it reaches the earth. Deals damage based on the level of Exort , however this damage is spread evenly over all enemies hit.", "notes_loc": ["Gives vision of the target area before the strike.", "Invoker gains experience with kills made from Sun Strike, even if made from outside of experience range."], "scepter_loc": "Creates a Cataclysm when Sun Strike is double tapped. Puts it on a %cataclysm_cooldown% second cooldown. Creates %cataclysm_count% visible %cataclysm_damage_pct%%% damage Sun Strikes within %cataclysm_min_range%-%cataclysm_max_range% range of each enemy hero.", "shard_loc": "If Sun Strike damages an enemy Hero, a Forge Spirit of current level is created at the location."}, "text_742": {"desc_loc": "Sends a catastrophic ray of fierce energy from the sun at any targeted location, incinerating all enemies standing beneath it once it reaches the earth. Deals damage based on the level of Exort , however this damage is spread evenly over all enemies hit.", "notes_loc": ["Gives vision of the target area before the strike.", "Invoker gains experience with kills made from Sun Strike, even if made from outside of experience range."], "scepter_loc": "Creates a Cataclysm when Sun Strike is double tapped. Puts it on a %cataclysm_cooldown% second cooldown. Creates %cataclysm_count% visible %cataclysm_damage_pct%%% damage Sun Strikes within %cataclysm_min_range%-%cataclysm_max_range% range of each enemy hero.", "shard_loc": "If Sun Strike damages an enemy Hero, a Forge Spirit of current level is created at the location."}, "changed_fields": [{"field": "behavior", "old": "9007207978893425", "new": "8724152433"}, {"field": "damage", "old": {"base": [175, 225, 275, 325, 375, 425, 475, 525, 575], "scepter": null, "shard": null}, "new": {"base": [175, 215, 255, 295, 335, 375, 415, 455, 495], "scepter": null, "shard": null}}], "rows": [{"review_id": "747592b2d642d3462ddc", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "a78c1c6e9192882ca73a", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "9b660bb498afb3d3d96e", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "reject"}, {"review_id": "9812505f11ea56b99195", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_sun_strike:summons:shard", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "shard_upgrade", "decision": "accept"}]}, {"subject": "invoker_tornado", "name_zh": "祈求者·强袭飓风", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Unleashes a fast moving tornado that picks up enemy units in its path, suspending them helplessly in the air shortly before allowing them to plummet to their doom. Travels further based on the level of Wex . Holds enemies in the air for a duration based on the level of Quas . Deals base damage plus added damage based on levels in Wex . DISPEL TYPE: Basic Dispel", "notes_loc": ["Units are invulnerable while affected by Tornado, and the damage is dealt when landing."], "scepter_loc": "Tornado spawns twisters along its path. They persist for Tornado's duration plus additional time based on Quas , dealing damage based on Wex in a %twister_radius% radius every %twister_tick_rate% seconds. (half damage to creeps.)"}, "text_742": {"desc_loc": "Unleashes a fast moving tornado that picks up enemy units in its path, suspending them helplessly in the air shortly before allowing them to plummet to their doom. Travels further based on the level of Wex . Holds enemies in the air for a duration based on the level of Quas . Deals base damage plus added damage based on levels in Wex . DISPEL TYPE: Basic Dispel", "notes_loc": ["Units are invulnerable while affected by Tornado, and the damage is dealt when landing."], "scepter_loc": "Tornado spawns twisters along its path. They persist for Tornado's duration plus additional time based on Quas , dealing damage based on Wex in a %twister_radius% radius every %twister_tick_rate% seconds. (half damage to creeps.)"}, "changed_fields": [{"field": "behavior", "old": "9007482856800337", "new": "283602059345"}], "rows": [{"review_id": "audit:invoker_tornado:aoe_damage:base", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "c455bf568f7823d55558", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "18124be56e922136c173", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "76eff6b095de27abcfe6", "mechanism": "cyclone_banish", "mechanism_zh": "吹风/放逐", "definition": "使目标短暂离开战场，期间无敌或不可被选取", "condition": "base", "decision": "accept"}, {"review_id": "audit:invoker_tornado:ground_zone:scepter", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "20136efe598bc5601f28", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "base", "decision": "accept"}]}, {"subject": "jakiro_double_trouble", "name_zh": "杰奇洛·天生一对", "category": "2_纯数值", "text_741f": {"desc_loc": "Jakiro's attacks launch an attack from each head, but deal less damage each.", "notes_loc": ["The second attack ignores Damage Block."], "facets_loc": ["Jakiro deals more damage with his double attacks."]}, "text_742": {"desc_loc": "Jakiro's attacks launch an attack from each head, but deal less damage each.", "notes_loc": ["The second attack ignores Damage Block."], "facets_loc": ["Jakiro deals more damage with his double attacks."]}, "changed_fields": [{"field": "attack_damage_reduction", "old": {"base": [51], "scepter": null, "shard": null}, "new": {"base": [50], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:jakiro_double_trouble:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "bdd9d699b862f68ff0ac", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "1cf9056a0b39a73b1927", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "reject"}]}, {"subject": "jakiro_macropyre", "name_zh": "杰奇洛·烈焰焚身", "category": "2_纯数值", "text_741f": {"desc_loc": "Jakiro exhales a wide line of lasting flames, which deals damage per second to any enemy units caught in the fire.", "notes_loc": ["Units hit by Macropyre will continue to be affected after they leave the area for %linger_duration% additional seconds."], "scepter_loc": "Increases Macropyre duration and causes it to deal Pure damage. Jakiro emits two walls of ice along the edges of the Macropyre that slow any enemies trying to cross them by %ice_edge_movement_slow%%%."}, "text_742": {"desc_loc": "Jakiro exhales a wide line of lasting flames, which deals damage per second to any enemy units caught in the fire.", "notes_loc": ["Units hit by Macropyre will continue to be affected after they leave the area for %linger_duration% additional seconds."], "scepter_loc": "Increases Macropyre duration and causes it to deal Pure damage. Jakiro emits two walls of ice along the edges of the Macropyre that slow any enemies trying to cross them by %ice_edge_movement_slow%%%."}, "changed_fields": [{"field": "damage", "old": {"base": [100, 150, 200], "scepter": null, "shard": null}, "new": {"base": [100, 140, 180], "scepter": null, "shard": null}}], "rows": [{"review_id": "a88d82585f1d2c31a1d5", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:jakiro_macropyre:ground_zone:base", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "base", "decision": "accept"}, {"review_id": "audit:jakiro_macropyre:ground_zone:scepter", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "2b8ea9c77fd1f5ef174d", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "scepter_upgrade", "decision": "accept"}]}, {"subject": "javelin", "name_zh": "标枪", "category": "5_增删或退出", "text_741f": {"desc_loc": "Passive: Pierce Grants each attack a %bonus_chance%%% chance to pierce through evasion and deal %bonus_chance_damage% bonus magical damage."}, "text_742": {"desc_loc": "Passive: Pierce Grants each attack a %bonus_chance%%% chance to pierce through evasion and deal %bonus_chance_damage% bonus magical damage."}, "changed_fields": [], "rows": [{"review_id": "audit:javelin:attack_modifier:item", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}, {"review_id": "5c264e13ddd9d4f7ad3e", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "item", "decision": "reject"}, {"review_id": "a581d07de7956f6aa2cc", "mechanism": "pierce_evasion", "mechanism_zh": "克敌机先", "definition": "攻击无视闪避（必中）", "condition": "item", "decision": "accept"}]}, {"subject": "juggernaut_blade_fury", "name_zh": "主宰·剑刃风暴", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Causes a bladestorm of destructive force around Juggernaut, rendering him debuff immune with %immunity_resist%%% magic resistance and dealing damage every %blade_fury_damage_tick%s to nearby enemy units. Applies a strong dispel at the end of the spin.", "notes_loc": ["You can use items during Blade Fury.", "Juggernaut can still perform attacks while in Blade Fury. However, only units that are not affected by Blade Fury, such as wards or structures, will take damage from these attacks."], "scepter_loc": "Increases radius and slows enemies in the area of effect. Juggernaut preforms an attack on affected enemies every %attack_interval%s."}, "text_742": {"desc_loc": "Causes a bladestorm of destructive force around Juggernaut, rendering him debuff immune with %immunity_resist%%% magic resistance and dealing damage every %blade_fury_damage_tick%s to nearby enemy units. Applies a basic dispel at the start and end of the spin. DISPEL TYPE: Basic Dispel", "notes_loc": ["You can use items during Blade Fury."], "scepter_loc": "Allows Juggernaut to attack his enemies during Blade Fury even while moving. These attacks deal %scepter_attack_damage_pct%%% damage and Item Potency."}, "changed_fields": [{"field": "ability_has_scepter", "old": false, "new": true}, {"field": "scepter_attack_damage_pct", "old": null, "new": {"base": [0], "scepter": [75], "shard": null}}], "rows": [{"review_id": "7408fd0f3da3a40cff1f", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "f326696738e9506b9b76", "mechanism": "applies_strong_dispel", "mechanism_zh": "施加强驱散", "definition": "移除目标身上可被强驱散的效果（含多数眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "e34f0441ca6b11791787", "mechanism": "debuff_immunity", "mechanism_zh": "减益免疫/技能免疫", "definition": "处于减益免疫（技能免疫）时，只有能无视减益免疫的效果才对其生效（如碎颅锤的重击可以眩晕开了黑皇杖的单位）", "condition": "base", "decision": "accept"}]}, {"subject": "juggernaut_healing_ward", "name_zh": "主宰·治疗守卫", "category": "2_纯数值", "text_741f": {"desc_loc": "Summons a Healing Ward which heals all nearby allied units, based on their max health. The Healing Ward moves at %healing_ward_movespeed_tooltip% movement speed after being summoned. Lasts %abilityduration% seconds.", "notes_loc": ["The Healing Ward can be controlled.", "Multiple Healing Wards do not stack."], "shard_loc": "Increases ward healing and health."}, "text_742": {"desc_loc": "Summons a Healing Ward which heals all nearby allied units, based on their max health. The Healing Ward moves at %healing_ward_movespeed_tooltip% movement speed after being summoned. Lasts %abilityduration% seconds.", "notes_loc": ["The Healing Ward can be controlled.", "Multiple Healing Wards do not stack."], "shard_loc": "Increases ward healing and health."}, "changed_fields": [], "rows": [{"review_id": "audit:juggernaut_healing_ward:aura:base", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "base", "decision": "accept"}, {"review_id": "c20f8d937ae4e0dae860", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "49fd3157811306c89414", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "reject"}]}, {"subject": "juggernaut_omni_slash", "name_zh": "主宰·无敌斩", "category": "3_说明文字", "text_741f": {"desc_loc": "Juggernaut leaps towards the target enemy units, and then slashes the target and other nearby enemy units at an increased attack rate. Juggernaut is invulnerable for the duration. DISPEL TYPE: Basic Dispel", "notes_loc": ["You can use items during Omnislash."]}, "text_742": {"desc_loc": "Juggernaut leaps towards the target enemy unit and then slashes it. Juggernaut continues to jump slash nearby random enemies (including the previously slashed enemy) until the duration ends or there are no enemies nearby. Jump rate is dependent on Juggernaut's attack speed. Juggernaut is invulnerable and has increased attack speed during Omnislash. DISPEL TYPE: Basic Dispel", "notes_loc": ["You can use items during Omnislash."]}, "changed_fields": [], "rows": [{"review_id": "a31aebe8d8c97f75d245", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "60c8259359829a6b58ab", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "ecd599b5d2d6763c1d61", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "base", "decision": "accept"}, {"review_id": "t5:juggernaut_omni_slash:pierces_debuff_immunity", "mechanism": "pierces_debuff_immunity", "mechanism_zh": "无视减益免疫", "definition": "效果对处于减益免疫的敌方仍生效（技能看immunity=3，装备看官方说明）", "condition": "base", "decision": "accept"}, {"review_id": "d5c51bbe075846ce968b", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "audit:juggernaut_omni_slash:terrain_walk:base", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "base", "decision": "accept"}, {"review_id": "21a89dfcc604949f819f", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "kaya", "name_zh": "Kaya", "category": "2_纯数值", "text_741f": {"notes_loc": ["Multiple instances of this item do not stack."]}, "text_742": {"notes_loc": ["Multiple instances of this item do not stack."]}, "changed_fields": [{"field": "item_cost", "old": 2100, "new": 2000}, {"field": "spell_amp", "old": {"base": [10], "scepter": null, "shard": null}, "new": {"base": [6], "scepter": null, "shard": null}}], "rows": [{"review_id": "3c4d15cec20660fda248", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}, {"review_id": "b23ed9599099223fcc0d", "mechanism": "spell_amp", "mechanism_zh": "法术放大", "definition": "提高技能造成的伤害", "condition": "item", "decision": "accept"}]}, {"subject": "kaya_and_sange", "name_zh": "Kaya and Sange", "category": "2_纯数值", "text_741f": {}, "text_742": {}, "changed_fields": [{"field": "item_cost", "old": 4200, "new": 4000}, {"field": "hp_regen_amp", "old": {"base": [16], "scepter": null, "shard": null}, "new": {"base": [20], "scepter": null, "shard": null}}, {"field": "mana_regen_multiplier", "old": {"base": [30], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "spell_amp", "old": {"base": [12], "scepter": null, "shard": null}, "new": {"base": [10], "scepter": null, "shard": null}}], "rows": [{"review_id": "9ce58b76e83e3dbc4a31", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}