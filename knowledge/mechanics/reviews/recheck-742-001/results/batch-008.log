%%."]}, "changed_fields": [{"field": "max_damage", "old": {"base": [600, 975, 1350], "scepter": null, "shard": null}, "new": {"base": [550, 875, 1200], "scepter": null, "shard": null}}], "rows": [{"review_id": "15892019f9f677b09ce1", "mechanism": "applies_break", "mechanism_zh": "施加破坏", "definition": "使目标的被动技能暂时失效", "condition": "base", "decision": "accept"}, {"review_id": "f990071c12149ccf704d", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "reject"}, {"review_id": "audit:hoodwink_sharpshooter:self_mobility:base", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "7fc443168024024ec304", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "audit:hoodwink_sharpshooter:terrain_walk:base", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "base", "decision": "accept"}]}, {"subject": "hurricane_pike", "name_zh": "飓风长戟", "category": "3_说明文字", "text_741f": {"desc_loc": "Active: Hurricane Thrust Pushes you and target enemy %enemy_length% units away from each other, and for %range_duration% seconds, allows you to make %max_attacks% attacks against the target without range restrictions and with +%bonus_attack_speed% attack speed. Can be cast on self or allies to push the target %push_length% units in the direction it is facing. Enemy Range: %cast_range_enemy%", "notes_loc": ["Self-cast will use Hurricane Pike on yourself.", "Hurricane Pike doesn't interrupt the target's actions.", "Will not work on a unit inside Chronosphere, Duel, or Black Hole.", "Attack Range bonuses from Monkey King Bar and Dragon Lance and its upgrades do not stack."]}, "text_742": {"desc_loc": "Active: Hurricane Thrust Pushes you and target enemy %enemy_length% units away from each other, and for %