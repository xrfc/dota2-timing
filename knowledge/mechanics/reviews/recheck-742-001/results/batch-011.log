finition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "09192929b9ff1be1c99d", "mechanism": "ethereal", "mechanism_zh": "虚无", "definition": "单位进入虚无状态：无法攻击，也不会受到物理攻击；魔法和纯粹伤害仍可作用", "condition": "base", "decision": "accept"}, {"review_id": "e08e2b451fe9773cfd64", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "1efbe18c7fe3d18bedbd", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "reject"}, {"review_id": "2d59c5a069b17fad1602", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "base", "decision": "accept"}, {"review_id": "5fa7df90ed38e15060e2", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "leshrac_pulse_nova", "name_zh": "拉席克·脉冲新星", "category": "2_纯数值", "text_741f": {"desc_loc": "Creates waves of damaging energy around Leshrac, one per second, to damage nearby enemy units. Drains Leshrac's mana with each pulse."}, "text_742": {"desc_loc": "Creates waves of damaging energy around Leshrac, one per second, to damage nearby enemy units. Drains Leshrac's mana with each pulse."}, "changed_fields": [{"field": "damage", "old": {"base": [80, 135, 180], "scepter": null, "shard": null}, "new": {"base": [80, 130, 180], "scepter": null, "shard": null}}], "rows": [{"review_id": "0c65c30ed965c48f1ac9", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:leshrac_pulse_nova:aura:base", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "base", "decision": "accept"}, {"review_id": "aedbf4c26fc8f6b33b22", "mechanism": "mana_burn", "mechanism_zh": "烧蓝/法力削减", "definition": "减少目标的法力值", "condition": "base", "decision": "reject"}, {"review_id": "2f74a6c42e0901b67a6f", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "reject"}]}, {"subject": "lich_chain_frost", "name_zh": "巫妖·连环霜冻", "category": "2_纯数值", "text_741f": {"desc_loc": "Releases an orb of frost that bounces between nearby enemy units up to %jumps% times, slowing and damaging each time it hits. Each bounce increases the damage for the subsequent bounces. Chain Frost lingers on its last target if it fails to bounce and can bounce again if new targets become available.", "notes_loc": ["Chain Frost cannot be disjointed.", "Chain Frost has a movement speed of %projectile_speed%.", "Chain Frost doesn't bounce to Zombies."], "facets_loc": ["Chain Frost lingers on its last target if it fails to bounce and can bounce again if new targets become available.", "Killing an enemy with Chain Frost increases the number of bounces."]}, "text_742": {"desc_loc": "Releases an orb of frost that bounces between nearby enemy units up to %jumps% times, slowing and damaging each time it hits. Each bounce increases the damage for the subsequent bounces. Chain Frost lingers on its last target if it fails to bounce and can bounce again if new targets become available.", "notes_loc": ["Chain Frost cannot be disjointed.", "Chain Frost has a movement speed of %projectile_speed%.", "Chain Frost doesn't bounce to Zombies."], "facets_loc": ["Chain Frost lingers on its last target if it fails to bounce and can bounce again if new targets become available.", "Killing an enemy with Chain Frost increases the number of bounces."]}, "changed_fields": [{"field": "bonus_jump_damage", "old": {"base": [15, 20, 25], "scepter": null, "shard": null}, "new": {"base": [20], "scepter": null, "shard": null}}, {"field": "damage", "old": {"base": [250, 400, 550], "scepter": null, "shard": null}, "new": {"base": [250, 375, 500], "scepter": null, "shard": null}}], "rows": [{"review_id": "b4535016cefa201edbf5", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "252377b025cd8b4bc923", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "61a3018927dd8c4e61c6", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "lich_death_charge", "name_zh": "巫妖·献身", "category": "2_纯数值", "text_741f": {"desc_loc": "Sacrifice an allied creep to convert its current health into mana for Lich and give Lich its experience bounty. Begins the game on cooldown and with no charges.", "notes_loc": ["Cannot sacrifice ancients or creep-heroes.", "Sacrificed creeps count as denies and can give experience to enemy heroes. Lich's experience bounty and enemy heroes' deny experience are independent."]}, "text_742": {"desc_loc": "Sacrifice an allied creep to convert its current health into mana for Lich and give Lich its experience bounty. Begins the game on cooldown and with no charges.", "notes_loc": ["Cannot sacrifice ancients or creep-heroes.", "Sacrificed creeps count as denies and can give experience to enemy heroes. Lich's experience bounty and enemy heroes' deny experience are independent."]}, "changed_fields": [{"field": "AbilityCharges", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [3], "scepter": null, "shard": null}}], "rows": [{"review_id": "e5f085f17367dc19dc5f", "mechanism": "charges", "mechanism_zh": "充能", "definition": "技能或物品用一次消耗一点；只决定数值或层数的不算", "condition": "base", "decision": "accept"}, {"review_id": "f4ba8bac27eec3648b86", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "accept"}, {"review_id": "b88f2a84aca49f906e33", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}]}, {"subject": "lich_frost_nova", "name_zh": "巫妖·寒霜爆发", "category": "2_纯数值", "text_741f": {"desc_loc": "Blasts the target enemy unit with damaging frost, dealing area damage and slowing movement and attack rates for %abilityduration% seconds. The primary target receives both base and area damage."}, "text_742": {"desc_loc": "Blasts the target enemy unit with damaging frost, dealing area damage and slowing movement and attack rates for %abilityduration% seconds. The primary target receives both base and area damage."}, "changed_fields": [{"field": "cast_ranges", "old": [575, 600, 625, 650], "new": [650]}, {"field": "mana_costs", "old": [110, 120, 130, 140], "new": [105, 120, 135, 150]}, {"field": "AbilityCastRange", "old": {"base": [575, 600, 625, 650], "scepter": null, "shard": null}, "new": {"base": [650], "scepter": null, "shard": null}}, {"field": "AbilityManaCost", "old": {"base": [110, 120, 130, 140], "scepter": null, "shard": null}, "new": {"base": [105, 120, 135, 150], "scepter": null, "shard": null}}], "rows": [{"review_id": "093a1fd1779cc6582701", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:lich_frost_nova:attack_slow:base", "mechanism": "attack_slow", "mechanism_zh": "减攻速", "definition": "降低敌方单位的攻击速度", "condition": "base", "decision": "accept"}, {"review_id": "a47cb9c109c45ae1d2dd", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "b482d1009ac1faec6bcf", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "lich_frost_shield", "name_zh": "巫妖·冰霜魔盾", "category": "2_纯数值", "text_741f": {"desc_loc": "Applies a magical frost shield around the target, reducing damage from attacks against it. While the shield is active, ice magic will affect nearby enemy units every %interval% seconds, dealing minor damage and slowing them.", "notes_loc": ["Spell-immune enemies are not affected by the damage or slow.", "Frost Shield can be cast on buildings."], "facets_loc": ["Whenever an enemy dies under the effect of Frost Shield, its duration is increased."]}, "text_742": {"desc_loc": "Applies a magical frost shield around the target, reducing damage from attacks against it. While the shield is active, ice magic will affect nearby enemy units every %interval% seconds, dealing minor damage and slowing them.", "notes_loc": ["Spell-immune enemies are not affected by the damage or slow.", "Frost Shield can be cast on buildings."], "facets_loc": ["Whenever an enemy dies under the effect of Frost Shield, its duration is increased."]}, "changed_fields": [{"field": "movement_slow", "old": {"base": [20, 25, 30, 35], "scepter": null, "shard": null}, "new": {"base": [21, 24, 27, 30], "scepter": null, "shard": null}}], "rows": [{"review_id": "ac6348c7c84c52545fe1", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:lich_frost_shield:aura:base", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "base", "decision": "accept"}, {"review_id": "audit:lich_frost_shield:damage_block:base", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "accept"}, {"review_id": "e70280591ee791c99e25", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "lich_ice_spire", "name_zh": "巫妖·寒冰尖柱", "category": "3_说明文字", "text_741f": {"desc_loc": "Creates an Ice Spire at the target spot, slowing enemies around it. Can take %max_hero_attacks% hero hits or %max_creep_attacks% creep hits and when destroyed it will create a Frost Blast around it. Chain Frost can be cast on the Spire and can bounce to the Spire and damage the spire by 1 hero attack if there are no other enemies in range. Lich can cast Frost Shield on the Spire. Each Frost Shield tick will heal the spire by 1 hero attack."}, "text_742": {"desc_loc": "Creates an Ice Spire at the target spot, slowing enemies around it. When destroyed it will create a Frost Blast around it. Chain Frost can be cast on the Spire and can bounce to the Spire and damage the spire by 1 pip if there are no other enemies in range. Lich can cast Frost Shield on the Spire. Each Frost Shield tick will heal the spire by 1 pip."}, "changed_fields": [{"field": "max_creep_attacks", "old": {"base": [8], "scepter": null, "shard": null}, "new": {"base": [16], "scepter": null, "shard": null}}], "rows": [{"review_id": "2fc7933b0f45461014f0", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:lich_ice_spire:ground_zone:shard", "mechanism": "ground_zone", "mechanism_zh": "场地魔法", "definition": "在地面某个位置留下一块持续一段时间的作用区域，单位留在其中就持续受影响（如寒冰之墙、臭云、烟幕）；区域跟着单位走的归光环，瞬间生效一次的不算", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "5bd57d05a91336a3a658", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "reject"}, {"review_id": "a3e35747df00ad143a04", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "life_stealer_feast", "name_zh": "噬魂鬼·盛宴", "category": "3_说明文字", "text_741f": {"desc_loc": "Lifestealer's attacks deal damage and provide heal for a percentage of his target's max health. He gains permanent max HP whenever he kills a unit.", "notes_loc": ["Works on allies and enemies. Does not affect Roshan.", "The heal is independent of the damage.", "Break disables the gaining of new stacks.", "Break does not disable the bonuses from existing stacks."], "facets_loc": ["Feast's max HP per hero kill is increased."]}, "text_742": {"desc_loc": "Lifestealer's attacks deal damage and provide heal for a percentage of his target's max health. He gains %bonus_hp_per_creep% permanent max HP whenever he kills a creep and %bonus_hp_per_hero% permanent max HP whenever he kills a hero.", "notes_loc": ["Works on allies and enemies. Does not affect Roshan.", "The heal is independent of the damage.", "Break disables the gaining of new stacks.", "Break does not disable the bonuses from existing stacks."], "facets_loc": ["Feast's max HP per hero kill is increased."]}, "changed_fields": [{"field": "bonus_hp_per_creep_num_required", "old": null, "new": {"base": [1], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:life_stealer_feast:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "0d70687c66fd9e1422ca", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "02d8e202a2237dc6f898", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "d75a019ffb8517ce13ce", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}]}, {"subject": "life_stealer_infest", "name_zh": "噬魂鬼·感染", "category": "3_说明文字", "text_741f": {"desc_loc": "Lifestealer infests the body of a target unit, becoming undetectable, and healing for a portion of his max hitpoints every second while inside. He can then explode from the host body, dealing damage to nearby enemies. If the infested unit is an enemy creep or a neutral creep, he can take control of the unit's ability to move and attack, and the creep loses a portion of their max hitpoints over time. Does not work on enemy heroes. DISPEL TYPE: Basic Dispel", "notes_loc": ["Lifestealer gains experience while under the effects of Infest.", "Creeps that are controlled while Infested gain Infest's movement speed bonus.", "Does not trigger spell reflect.", "Infest can be used on Ancient creeps."], "scepter_loc": "Increases cast range and reduces cooldown to %bonus_AbilityCooldown%s. Infest may target enemy heroes for a short duration, attacking them from the inside while increasing Lifestealer's regeneration rate.", "shard_loc": "Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health.", "facets_loc": ["Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health. Infest can be used on Ancient creeps."]}, "text_742": {"desc_loc": "Lifestealer infests the body of a target unit, becoming undetectable, and healing for a portion of his max hitpoints every second while inside. He can then explode from the host body, dealing damage to nearby enemies. If the infested unit is an enemy creep or a neutral creep, he can take control of the unit's ability to move and attack, and the creep loses a portion of their max hitpoints over time. Does not work on enemy heroes. DISPEL TYPE: Basic Dispel", "notes_loc": ["Lifestealer gains experience while under the effects of Infest.", "Creeps that are controlled while Infested gain Infest's movement speed bonus.", "Infest can be used on Ancient creeps."], "scepter_loc": "Increases cast range and reduces cooldown to %bonus_AbilityCooldown%s. Infest may target enemy heroes for a short duration, attacking them from the inside while increasing Lifestealer's regeneration rate.", "shard_loc": "Infest explosion applies a %dot_duration%s duration Open Wounds to enemies in the damage radius. Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health.", "facets_loc": ["Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health. Infest can be used on Ancient creeps."]}, "changed_fields": [{"field": "radius", "old": {"base": [700], "scepter": null, "shard": null}, "new": {"base": [600], "scepter": null, "shard": null}}, {"field": "self_regen", "old": {"base": [3, 4, 5], "scepter": [100], "shard": null}, "new": {"base": [2, 3, 4], "scepter": [100], "shard": null}}], "rows": [{"review_id": "ce62b9b47e1de40bb5b8", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "f3f0e08c16c8ef070b22", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "9a4cbd6de85300219de1", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "06769b54a5b2194031ea", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "reject"}, {"review_id": "17db8bbd8e9307c003e5", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "bbb16bbd8ee85bd314c7", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "audit:life_stealer_infest:invulnerable_untargetable:base", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "base", "decision": "accept"}, {"review_id": "9a45a4b5622ed6d01a0a", "mechanism": "spell_reflect", "mechanism_zh": "反弹指向技能", "definition": "把指向技能反弹给施法者", "condition": "base", "decision": "reject"}, {"review_id": "ea405d449c65ac7ff287", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "accept"}, {"review_id": "8804d4b34b90572aa12b", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "life_stealer_open_wounds", "name_zh": "噬魂鬼·撕裂伤口", "category": "3_说明文字", "text_741f": {"desc_loc": "Lifestealer rends an enemy unit, slowing the victim's movement speed and allowing all allies to regain health for a percentage of the damage they deal to that unit. The victim recovers movement speed over the duration.", "notes_loc": ["Open Wounds slows over 8 different steps: 50% / 50% / 40% / 30% / 20% / 10% / 10% / 10%, with the slow decreasing one step per second.", "The amount healed is amplified by Lifestealer's Health Restoration Amplification."], "facets_loc": ["Open Wounds' cooldown is refreshed if a unit dies while afflicted by Open Wounds."]}, "text_742": {"desc_loc": "Lifestealer rends an enemy unit, slowing the victim's movement speed and allowing all allies to regain health for a percentage of the damage they deal to that unit. The victim recovers movement speed over the duration.", "notes_loc": ["Open Wounds slows over 8 different steps: 50% / 50% / 40% / 30% / 20% / 10% / 10% / 10%, with the slow decreasing one step per second.", "The amount healed is amplified by Lifestealer's Health Restoration Amplification."]}, "changed_fields": [], "rows": [{"review_id": "113239b4eeb78ff