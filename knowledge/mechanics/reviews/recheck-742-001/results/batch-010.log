ho_hero_damage", "old": {"base": [20, 40, 60, 80], "scepter": null, "shard": null}, "new": null}, {"field": "katana_echo_damage", "old": {"base": [70, 80, 90, 100], "scepter": null, "shard": null}, "new": {"base": [30, 45, 60, 75], "scepter": null, "shard": null}}], "rows": [{"review_id": "25abbff94fa02fd63f09", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "6e93c7eadd18437bb4ec", "mechanism": "cleave", "mechanism_zh": "分裂溅射", "definition": "攻击伤害波及周围单位", "condition": "base", "decision": "reject"}, {"review_id": "89ee81f0bf151b2d2331", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "reject"}, {"review_id": "12707a51acba6c7feef7", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "173567d02a46d573f168", "mechanism": "tree_destroy", "mechanism_zh": "砍树", "definition": "能摧毁树木", "condition": "base", "decision": "accept"}]}, {"subject": "kez_falcon_rush", "name_zh": "凯·天隼冲击", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Kez gains the ability to rush towards enemy targets to deliver echoing secondary attacks. While in this state, Kez has phased collision and slow resistance.", "notes_loc": ["Does not work on buildings."]}, "text_742": {"desc_loc": "Kez gains the ability to rush towards enemy targets to deliver echoing secondary attacks with reduced damage and Item Potency. While in this state, Kez has phased collision and slow resistance.", "notes_loc": ["Does not work on buildings."]}, "changed_fields": [{"field": "behavior", "old": "9007207978895365", "new": "8724154373"}, {"field": "echo_proc_chance_reduction", "old": {"base": [50], "scepter": null, "shard": null}, "new": null}], "rows": [{"review_id": "311957e27ab488741475", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "base", "decision": "accept"}, {"review_id": "audit:kez_falcon_rush:self_mobility:base", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "06a5de3d0fd2e0f5a126", "mechanism": "slow_resistance", "mechanism_zh": "减速抗性", "definition": "降低自身受到的减速效果（如散夜对剑+30%）", "condition": "base", "decision": "accept"}, {"review_id": "audit:kez_falcon_rush:terrain_walk:base", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "base", "decision": "accept"}]}, {"subject": "kez_grappling_claw", "name_zh": "凯·制敌爪钩", "category": "2_纯数值", "text_741f": {"desc_loc": "Kez swings on a grappling hook towards the target unit or tree. When the grappling hook collides with the target, that unit has slowed movement speed. Upon reaching the enemy target, Kez lands an attack on them."}, "text_742": {"desc_loc": "Kez swings on a grappling hook towards the target unit or tree. When the grappling hook collides with the target, that unit has slowed movement speed. Upon reaching the enemy target, Kez lands an attack on them."}, "changed_fields": [{"field": "lifesteal_pct", "old": null, "new": {"base": [], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:kez_grappling_claw:self_mobility:base", "mechanism": "self_mobility", "mechanism_zh": "自身位移", "definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置", "condition": "base", "decision": "accept"}, {"review_id": "169f4a2dd389208a7345", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "audit:kez_grappling_claw:terrain_walk:base", "mechanism": "terrain_walk", "mechanism_zh": "无视地形", "definition": "移动时不受悬崖等不可通行地形阻挡，也能穿过树木", "condition": "base", "decision": "accept"}, {"review_id": "c0b284d96d6c570035a7", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "kez_raptor_dance", "name_zh": "凯·猛禽之舞", "category": "3_说明文字", "text_741f": {"desc_loc": "Kez enters into an uncontrollable state for %AbilityCastPoint% second, becoming invulnerable for %invuln_period%s and receiving a basic dispel. If the cast completes successfully, Kez performs a series of deadly radial slashes around him that deal damage based on the max health of the target and heal Kez for a percentage of all damage dealt.", "notes_loc": ["Slash Lifesteal is reduced to %illusion_lifesteal_pct%%% when slashing a creep or an illusion."]}, "text_742": {"desc_loc": "Kez enters into an uncontrollable state for %AbilityCastPoint% second, becoming invulnerable for %invuln_period%s and receiving a basic dispel. If the cast completes successfully, Kez performs a series of deadly radial slashes around him that deal a fixed damage attack based on the target's max health with enhanced lifesteal.", "notes_loc": ["Slash Lifesteal is reduced to %illusion_lifesteal_pct%%% when slashing an illusion. Slashes do not lifesteal from creeps."]}, "changed_fields": [{"field": "damage", "old": 4, "new": 1}, {"field": "base_damage", "old": {"base": [40, 70, 100], "scepter": null, "shard": null}, "new": {"base": [50, 100, 150], "scepter": null, "shard": null}}, {"field": "max_health_damage_pct", "old": {"base": [2.5], "scepter": null, "shard": null}, "new": {"base": [2.75, 3.25, 3.75], "scepter": null, "shard": null}}, {"field": "radius", "old": {"base": [450], "scepter": null, "shard": null}, "new": {"base": [425], "scepter": null, "shard": null}}], "rows": [{"review_id": "a553d93fa8416ec4c65c", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "34d49f98bbe4145b8bfa", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "f3094bee1ae808d5f1cf", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "7ff5b4e12460315eb2cb", "mechanism": "invulnerable_untargetable", "mechanism_zh": "无敌/不可选取", "definition": "暂时无法被伤害或无法被指向", "condition": "base", "decision": "accept"}, {"review_id": "0d46ed5bd8d5d6d4b681", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "base", "decision": "accept"}]}, {"subject": "kez_ravens_veil", "name_zh": "凯·渡鸦之纱", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Kez releases a wave of smoke that applies his Mark to nearby enemy heroes, briefly reducing their vision. Kez receives a basic dispel and gains bonus movement speed and invisibility until he attacks or casts a spell.", "facets_loc": ["Increases Raven's Veil invisibility duration."]}, "text_742": {"desc_loc": "Kez releases a wave of smoke that applies his Mark to nearby enemy heroes, briefly reducing their vision. Kez receives a basic dispel and gains bonus movement speed and invisibility until he attacks or casts a spell.", "facets_loc": ["Increases Raven's Veil invisibility duration."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893317", "new": "8724152325"}], "rows": [{"review_id": "9928b3c2f681327327f3", "mechanism": "applies_basic_dispel", "mechanism_zh": "施加弱驱散", "definition": "移除目标身上可被弱驱散的效果", "condition": "base", "decision": "accept"}, {"review_id": "97abeeb16f46c73ec456", "mechanism": "blind", "mechanism_zh": "致盲", "definition": "使敌方单位的攻击有概率落空", "condition": "base", "decision": "reject"}, {"review_id": "ccddb7e2e265e98e6cbc", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "f4d4cd9fba1b58888bef", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "accept"}, {"review_id": "ea6685531031a2fdfbb8", "mechanism": "reduce_vision", "mechanism_zh": "减视野", "definition": "降低目标的视野", "condition": "base", "decision": "accept"}]}, {"subject": "kez_shodo_sai", "name_zh": "凯·翔影之钗", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Kez has a chance to critically strike the target when attacking with Sais. Kez may activate the ability to disarm himself, lock his facing, and parry attacks and attack effects from the targeted direction for %parry_duration% seconds. If an attack is parried from an enemy Hero in this way, that Hero is stunned for %parry_stun_duration%s and gains a Mark. When a Marked target is attacked by Kez, it will guarantee a critical strike and stun the target. The sub-ability may be used to cancel the blocking early.", "shard_loc": "Parrying creates a stronger Mark that deals additional stun and critical damage."}, "text_742": {"desc_loc": "Kez has a chance to critically strike the target when attacking with Sais. Kez may activate the ability to disarm himself, lock his facing, and parry attacks and attack effects from the targeted direction for %parry_duration% seconds. If an attack is parried from an enemy Hero in this way, that Hero is stunned for %parry_stun_duration%s and gains a Mark. When a Marked target is attacked by Kez, it will guarantee a critical strike and stun the target. The sub-ability may be used to cancel the blocking early.", "shard_loc": "Parrying creates a stronger Mark that deals additional stun and critical damage."}, "changed_fields": [{"field": "behavior", "old": "9007207987283985", "new": "8732542993"}, {"field": "sai_proc_vuln_chance", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [24], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:kez_shodo_sai:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "audit:kez_shodo_sai:bash:base", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "base", "decision": "accept"}, {"review_id": "8b18a1eff9621f1f1a10", "mechanism": "critical", "mechanism_zh": "暴击", "definition": "攻击造成额外倍数伤害；有概率触发或强化下一次攻击都算", "condition": "base", "decision": "accept"}, {"review_id": "bc97e72082cd9fb79155", "mechanism": "critical", "mechanism_zh": "暴击", "definition": "攻击造成额外倍数伤害；有概率触发或强化下一次攻击都算", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "audit:kez_shodo_sai:damage_block:base", "mechanism": "damage_block", "mechanism_zh": "护盾/伤害吸收/减伤", "definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）", "condition": "base", "decision": "accept"}, {"review_id": "796f6b340e16e4ede7e4", "mechanism": "disarm", "mechanism_zh": "缴械", "definition": "目标无法普通攻击", "condition": "base", "decision": "reject"}, {"review_id": "01228bc6db96dec2b57a", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "ff8f0c62748d6c1b064f", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "kez_talon_toss", "name_zh": "凯·利爪飞掷", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Kez throws a Sai at the target unit, applying a fixed damage attack and silence.", "notes_loc": ["The fixed damage attack has True Strike."]}, "text_742": {"desc_loc": "Kez throws a Sai at the target unit, applying a fixed damage attack and silence.", "notes_loc": ["The fixed damage attack has True Strike."]}, "changed_fields": [{"field": "behavior", "old": "9007207978893353", "new": "8724152361"}], "rows": [{"review_id": "44d0b9b85078983e9287", "mechanism": "pierce_evasion", "mechanism_zh": "克敌机先", "definition": "攻击无视闪避（必中）", "condition": "base", "decision": "accept"}, {"review_id": "c059bf76c6485c442ae8", "mechanism": "silence", "mechanism_zh": "沉默", "definition": "目标无法施放技能（仍可攻击、使用物品）", "condition": "base", "decision": "accept"}, {"review_id": "53a9bc0036fa00575b0b", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "kunkka_ghostship", "name_zh": "昆卡·幽灵船", "category": "3_说明文字", "text_741f": {"desc_loc": "Summons a ghostly ship that sails through the battle before smashing apart, damaging and stunning all enemies caught near the wreckage. Allied heroes touched by the Ghostship are given a %rum_factor%x strong swig of The Admiral's Rum.", "notes_loc": ["Actual area of effect of ship's collision is larger than the boat itself.", "The boat has a movement speed of %ghostship_speed%."], "scepter_loc": "Ghostship creates a fleet of %fleet_count% ships at the target point on a %fleet_interval% second interval. Each ship now also fires %num_cannon_volleys% waves of cannonballs from the port and starboard side that deal %cannon_ball_damage_pct%%% of Ghostship's damage as they pass through enemies."}, "text_742": {"desc_loc": "Summons a ghostly ship that sails through the battle before smashing apart, damaging and stunning all enemies caught near the wreckage. Allied heroes touched by the Ghostship are given a %rum_factor%x strong swig of The Admiral's Rum.", "notes_loc": ["Actual area of effect of ship's collision is larger than the boat itself.", "The boat has a movement speed of %ghostship_speed%."], "scepter_loc": "Ghostship creates a fleet of %fleet_count% ships at the target point on a %fleet_interval% second interval. Each ship now also fires %num_cannon_volleys% waves of cannonballs from the port and starboard side, plus %forward_cannon_count% straight ahead, that deal %cannon_ball_damage_pct%%% of Ghostship's damage as they pass through 