: "e8685a92b0014583d3e4", "mechanism": "true_sight", "mechanism_zh": "真视", "definition": "可看见隐身单位", "condition": "base", "decision": "accept"}]}, {"subject": "bloodstone", "name_zh": "血精石", "category": "2_纯数值", "text_741f": {"desc_loc": "Active: Bloodpact Increases Bloodstone's Spell Lifesteal to %spell_lifesteal_while_active%%%. Lasts %buff_duration% seconds. Passive: Spell Weakness Aura Enemy units take %aura_spell_vulnerability%%% increased damage from spells. Radius: %aura_radius%", "notes_loc": ["Spell Weakness Aura does not stack with Veil of Discord's Spell Weakness."]}, "text_742": {"desc_loc": "Active: Bloodpact Increases Bloodstone's Spell Lifesteal to %spell_lifesteal_while_active%%%. Lasts %buff_duration% seconds. Passive: Spell Weakness Aura Enemy units take %aura_spell_vulnerability%%% increased damage from spells. Radius: %aura_radius%", "notes_loc": ["Spell Weakness Aura does not stack with Veil of Discord's Spell Weakness."]}, "changed_fields": [{"field": "cooldowns", "old": [35], "new": [30]}, {"field": "AbilityCooldown", "old": {"base": [35], "scepter": null, "shard": null}, "new": {"base": [30], "scepter": null, "shard": null}}, {"field": "aura_spell_vulnerability", "old": {"base": [10], "scepter": null, "shard": null}, "new": {"base": [8], "scepter": null, "shard": null}}, {"field": "spell_lifesteal_while_active", "old": {"base": [60], "scepter": null, "shard": null}, "new": {"base": [70], "scepter": null, "shard": null}}], "rows": [{"review_id": "c1e0d0c931d07a344abd", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "item", "decision": "reject"}, {"review_id": "da1fe5b4658a3f7f250e", "mechanism": "aura", "mechanism_zh": "光环", "definition": "跟着单位持续影响周围单位；对友军或敌方都算，并记作用对象；固定在地上的区域归场地魔法", "condition": "item", "decision": "accept"}, {"review_id": "4d33c804e01513f66d21", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "item", "decision": "reject"}, {"review_id": "847cbcb56409d5684dfc", "mechanism": "lifesteal", "mechanism_zh": "吸血", "definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）", "condition": "item", "decision": "accept"}, {"review_id": "b5155d42b834e8a63217", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "item", "decision": "accept"}]}, {"subject": "bloodthorn", "name_zh": "血棘", "category": "3_说明文字", "text_741f": {"desc_loc": "Active: Soul Rend Silences a target for %silence_duration% seconds. At the end of the silence, an additional %silence_damage_percent%%% of all damage taken during the silence will be dealt to the target as magical damage. All attacks on the silenced target will deal additional damage equal to %proc_damage_heroes% if the attacker is a hero, and %proc_damage_creeps%, if the attacker is a creep. Provides True Strike for your attacks and attacks from your controlled units against the silenced target. Passive: Pierce Grants each attack a %proc_chance%%% chance to pierce through evasion and deal %passive_proc_damage% bonus magical damage."}, "text_742": {"desc_loc": "Active: Soul Rend Silences a target for %silence_duration% seconds. At the end of the silence, an additional %silence_damage_percent%%% of all damage taken during the silence will be dealt to the target as magical damage. All attacks on the silenced target will deal additional damage equal to %proc_damage_heroes% if the attacker is a hero, and %proc_damage_creeps%, if the attacker is a creep. Provides True Strike for your attacks and attacks from your controlled units against the silenced target."}, "changed_fields": [{"field": "item_cost", "old": 6400, "new": 6250}, {"field": "passive_proc_damage", "old": {"base": [60], "scepter": null, "shard": null}, "new": null}, {"field": "proc_chance", "old": {"base": [40], "scepter": null, "shard": null}, "new": null}, {"field": "proc_damage_creeps", "old": {"base": [25], "scepter": null, "shard": null}, "new": {"base": [20], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:bloodthorn:attack_modifier:item", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "item", "decision": "accept"}, {"review_id": "audit:bloodthorn:incoming_damage_amp:item", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "item", "decision": "accept"}, {"review_id": "8e0f2fd2cc75bb460610", "mechanism": "magic_resist_reduction", "mechanism_zh": "减魔抗/魔法易伤", "definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害", "condition": "item", "decision": "reject"}, {"review_id": "e57e91809a3631493e3c", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}, {"review_id": "6b7d62cdc72b370c4032", "mechanism": "pierce_evasion", "mechanism_zh": "克敌机先", "definition": "攻击无视闪避（必中）", "condition": "item", "decision": "accept"}, {"review_id": "72703b77330b2889566e", "mechanism": "pierce_evasion", "mechanism_zh": "克敌机先", "definition": "攻击无视闪避（必中）", "condition": "item", "decision": "accept"}, {"review_id": "c5c89a459a131403bff3", "mechanism": "silence", "mechanism_zh": "沉默", "definition": "目标无法施放技能（仍可攻击、使用物品）", "condition": "item", "decision": "accept"}, {"review_id": "87ea31fe89cdc0961f5e", "mechanism": "spell_amp", "mechanism_zh": "法术放大", "definition": "提高技能造成的伤害", "condition": "item", "decision": "reject"}]}, {"subject": "boots", "name_zh": "速度之靴", "category": "5_增删或退出", "text_741f": {}, "text_742": {"desc_loc": "Movement speed bonuses from multiple pairs of boots do not stack."}, "changed_fields": [{"field": "behavior", "old": null, "new": "2"}, {"field": "target_team", "old": null, "new": 0}, {"field": "target_type", "old": null, "new": 0}, {"field": "flags", "old": null, "new": 0}, {"field": "damage", "old": null, "new": 0}, {"field": "immunity", "old": null, "new": 0}, {"field": "dispellable", "old": null, "new": 0}, {"field": "ability_has_scepter", "old": null, "new": false}, {"field": "ability_has_shard", "old": null, "new": false}, {"field": "cast_ranges", "old": null, "new": [0]}, {"field": "cast_points", "old": null, "new": [0]}, {"field": "channel_times", "old": null, "new": [0]}, {"field": "cooldowns", "old": null, "new": [0]}, {"field": "durations", "old": null, "new": [0]}, {"field": "damages", "old": null, "new": [0, 0, 0, 0]}, {"field": "mana_costs", "old": null, "new": [0]}, {"field": "health_costs", "old": null, "new": []}, {"field": "item_cost", "old": null, "new": 500}, {"field": "bonus_movement_speed", "old": null, "new": {"base": [45], "scepter": null, "shard": null}}], "rows": [{"review_id": "fcab0823b9cf802c2ef8", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "item", "decision": "accept"}]}, {"subject": "bounty_hunter_shuriken_toss", "name_zh": "赏金猎人·投掷飞镖", "category": "2_纯数值", "text_741f": {"desc_loc": "Hurls a deadly shuriken at an enemy unit, dealing damage and slowing the target's movement speed. The shuriken will bounce to any Tracked units who are within a %bounce_aoe% radius of each other.", "scepter_loc": "Increases cast range and applies Jinada on hit."}, "text_742": {"desc_loc": "Hurls a deadly shuriken at an enemy unit, dealing damage and slowing the target's movement speed. The shuriken will bounce to any Tracked units who are within a %bounce_aoe% radius of each other.", "scepter_loc": "Increases cast range and applies Jinada on hit."}, "changed_fields": [], "rows": [{"review_id": "7469215ada7c28a99e33", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:bounty_hunter_shuriken_toss:economy:scepter", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "5f06fa0115fbb9bbbe64", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "4adb849a1ebd828ab4d1", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "bounty_hunter_track", "name_zh": "赏金猎人·追踪术", "category": "2_纯数值", "text_741f": {"desc_loc": "Tracks an enemy hero, granting True Sight of the target, increasing the damage they take and providing information on how much gold it is carrying. If the target dies, Bounty Hunter and nearby heroes collect a bonus bounty of gold. Casting Track does not take you out of invisibility.", "notes_loc": ["Bounty Hunter will get the bonus gold if the target dies while Track is active, regardless of how it died.", "Track's effect is only visible to allies.", "You can see the amount of gold the target is carrying by mousing over the debuff icon above the target's ability bar.", "Bonus gold is reliable gold."]}, "text_742": {"desc_loc": "Tracks an enemy hero, granting True Sight of the target, increasing the damage they take and providing information on how much gold it is carrying. If the target dies, Bounty Hunter and nearby heroes collect a bonus bounty of gold. Casting Track does not take you out of invisibility.", "notes_loc": ["Bounty Hunter will get the bonus gold if the target dies while Track is active, regardless of how it died.", "Track's effect is only visible to allies.", "You can see the amount of gold the target is carrying by mousing over the debuff icon above the target's ability bar.", "Bonus gold is reliable gold."]}, "changed_fields": [{"field": "target_damage_amp", "old": {"base": [8, 12, 16], "scepter": null, "shard": null}, "new": {"base": [6, 10, 14], "scepter": null, "shard": null}}], "rows": [{"review_id": "0f0e423bcf367d725787", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "accept"}, {"review_id": "audit:bounty_hunter_track:grant_vision:base", "mechanism": "grant_vision", "mechanism_zh": "提供视野", "definition": "提供目标或区域的视野", "condition": "base", "decision": "accept"}, {"review_id": "audit:bounty_hunter_track:incoming_damage_amp:base", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "accept"}, {"review_id": "audit:bounty_hunter_track:reveal:base", "mechanism": "reveal", "mechanism_zh": "显形", "definition": "使隐身单位显形，不等于持续真视", "condition": "base", "decision": "accept"}, {"review_id": "3b5c2596011f2cde4194", "mechanism": "true_sight", "mechanism_zh": "真视", "definition": "可看见隐身单位", "condition": "base", "decision": "accept"}, {"review_id": "1260c5b7e6450e3e4f8f", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "bounty_hunter_wind_walk", "name_zh": "赏金猎人·暗影步", "category": "2_纯数值", "text_741f": {"desc_loc": "Bounty Hunter becomes invisible and gains bonus movement speed and the ability to move through other units until he attacks or casts a spell. If he breaks the invisibility with an attack, that attack will stun the target for a short duration.", "notes_loc": ["Will not break most channeling of spells upon activation."]}, "text_742": {"desc_loc": "Bounty Hunter becomes invisible and gains bonus movement speed and the ability to move through other units until he attacks or casts a spell. If he breaks the invisibility with an attack, that attack will stun the target for a short duration.", "notes_loc": ["Will not break most channeling of spells upon activation."]}, "changed_fields": [{"field": "bonus_move_speed_pct", "old": {"base": [11, 14, 17, 20], "scepter": null, "shard": null}, "new": {"base": [9, 12, 15, 18], "scepter": null, "shard": null}}, {"field": "stun_duration", "old": {"base": [1, 1.2, 1.4, 1.6], "scepter": null, "shard": null}, "new": {"base": [0.9, 1.1, 1.3, 1.5], "scepter": null, "shard": null}}], "rows": [{"review_id": "audit:bounty_hunter_wind_walk:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "d79cea01edef8201f179", "mechanism": "channel_interrupt", "mechanism_zh": "打断持续施法", "definition": "说明明确写打断持续施法；眩晕、沉默等已有控制不重复记", "condition": "base", "decision": "reject"}, {"review_id": "70d512d52eecf0f53f7b", "mechanism": "economy", "mechanism_zh": "经济经验", "definition": "提供额外金钱或经验；只是正常赏金不算", "condition": "base", "decision": "reject"}, {"review_id": "68f783785e1e58600dd2", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "fe95f9901a60f35e5a9e", "mechanism": "invisibility", "mechanism_zh": "隐身", "definition": "使自身、队友、召唤物或复制体隐身", "condition": "base", "decision": "accept"}, {"review_id": "audit:bounty_hunter_wind_walk:phased:base", "mechanism": "phased", "mechanism_zh": "相位移动", "definition": "移动不受单位碰撞阻挡", "condition": "base", "decision": "accept"}, {"review_id": "c8288ad225616bae04db", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}]}, {"subject": "brewmaster_cinder_brew", "name_zh": "酒仙·余烬佳酿", "category": "2_纯数值", "text_741f": {"desc_loc": "Rolls a barrel of ale at enemies that damages enemies along its path and spills out at the target location. Any enemy in the path or the spill area is drenched in cinder brew, becoming slowed. If the enemy receives Magic or Pure damage, they will be ignited, extending the duration by %extra_duration%s and causing them to take damage over time.", "facets_loc": ["Cinder Brew is now a rolling barrel of ale that drenches enemies in its path and explodes at the end."]}, "text_742": {"desc_loc": "Rolls a barrel of ale at enemies that damages enemies along its path and spills out at the target location. Any enemy in the path or the spill area is drenched in cinder brew, becoming slowed. If the enemy receives Magic or Pure damage, they will be ignited, extending the duration by %extra_duration%s and causing them to take damage over time.", "facets_loc": ["Cinder Brew is now a rolling barrel of ale that drenches enemies in its path and explodes at the end."]}, "changed_fields": [{"field": "total_ignite_damage", "old": {"base": [80, 160, 240, 320], "scepter": null, "shard": null}, "new": {"base": [75, 150, 225, 300], "scepter": null, "shard": null}}], "rows": [{"review_id": "afac2657e8ffcba73902", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "0782f020843ab6efdd4b", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "brewmaster_liquid_courage", "name_zh": "酒仙·壮胆酒", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "When Brewmaster drops below %min_health_threshold%%% Health he gains a Status Resistance buff and his movement speed alternates every %speed_toggle_time%s between being faster and being slower. The effect becomes stronger at lower health, scaling from 0 up to max values at %max_health_threshold%%% Health.", "shard_loc": "Toss a strong drink to a teammate or drink it yourself, activating the maximum power effect of Liquid Courage and granting %max_hp_regen%%% Max HP Regen per second. Lasts %drink_duration% seconds."}, "text_742": {"desc_loc": "After taking %damage_threshold% damage from player-controlled units, Brewmaster gains a Status Resistance buff for %trigger_duration%s and his movement speed alternates every %speed_toggle_time%s between being faster and being slower. Damage taken is reset if Brewmaster takes no damage for %damage_reset_interval%s. Can only trigger once every %trigger_cooldown%s.", "notes_loc": ["Damage from Roshan counts towards the damage threshold."], "shard_loc": "Liquid Courage can be activated to toss a strong drink to a teammate or yourself to gain the effects of Liquid Courage and %max_hp_regen%%% Max HP Regen per second. Increases speed increase. Lasts %drink_duration% seconds."}, "changed_fields": [{"field": "behavior", "old": "1688849860263939", "new": "1688849860263938"}, {"field": "AbilityCooldown", "old": {"base": [0], "scepter": null, "shard": [20]}, "new": {"base": [0], "scepter": null, "shard": [15]}}, {"field": "damage_reset_interval", "old": null, "new": {"base": [7], "scepter": null, "shard": null}}, {"field": "damage_threshold", "old": null, "new": {"base": [400], "scepter": null, "shard": null}}, {"field": "max_health_threshold", "old": {"base": [20], "scepter": null, "shard": null}, "new": null}, {"field": "max_speed", "old": {"base": [30], "scepter": null, "shard": null}, "new": {"base": [30], "scepter": null, "shard": [20]}}, {"field": "min_health_threshold", "old": {"base": [50], "scepter": null, "shard": null}, "new": null}, {"field": "trigger_cooldown", "old": null, "new": {"base": [15], "scepter": null, "shard": null}}, {"field": "trigger_duration", "old": null, "new": {"base": [5], "scepter": null, "shard": null}}], "rows": [{"review_id": "250196a73630c3bbf96f", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "reject"}, {"review_id": "5a7c27e4b74f1655d4a3", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "audit:brewmaster_liquid_courage:healing:shard", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "5d66ef354906cd9023bb", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "reject"}, {"review_id": "0022a156f62ba85785ef", "mechanism": "status_resistance", "mechanism_zh": "状态抗性", "definition": "缩短自身受到的控制与减益的持续时间（如散夜对剑+16%）", "condition": "base", "decision": "accept"}]}, {"subject": "brewmaster_primal_split", "name_zh": "酒仙·元素分离", "category": "2_纯数值", "text_741f": {"desc_loc": "Splits Brewmaster into elements, forming 3 specialized warriors, adept at survival, each with their own abilities. If any of them survive until the end of their summoned timer, the Brewmaster is reborn. Each Warrior gains its respective Drunken Brawler stance.", "notes_loc": ["The Earth Element will carry all auras that the Brewmaster has, as well as True Sight.", "The Fire Element has phased movement.", "When the spell ends, Brewmaster will take the place of an element in this order, assuming they are alive: Earth, Storm, Fire."], "scepter_loc": "Primal Split gains %scepter_bonus_levels% max and current level, improving the Brewlings and their abilities. Allows Primal Split to be cancelled early, and causes the Brewlings to be Brewed Up when Primal Split begins."}, "text_742": {"desc_loc": "Splits Brewmaster into elements, forming 3 specialized warriors, adept at survival, each with their own abilities. If any of them survive until the end of their summoned timer, the Brewmaster is reborn. Each Warrior gains its respective Drunken Brawler stance.", "notes_loc": ["The Earth Element will carry all auras that the Brewmaster has, as well as True Sight.", "The Fire Element has phased movement.", "When the spell ends, Brewmaster will take the place of an element in this order, assuming they are alive: Earth, Storm, Fire."], "scepter_loc": "Primal Split gains %scepter_bonus_level