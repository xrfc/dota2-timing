ew_id": "c8eeada3c8e88f89102a", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}, {"review_id": "db5562db44ae41f971df", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "item", "decision": "accept"}]}, {"subject": "armlet", "name_zh": "莫尔迪基安的臂章", "category": "4_行为/目标/驱散/免疫/A杖魔晶", "text_741f": {"desc_loc": "Toggle: Unholy Strength When active, Unholy Strength grants +%unholy_bonus_damage% damage, +%unholy_bonus_strength% strength and +%unholy_bonus_armor% armor, but drains %unholy_health_drain_per_second% health per second. You cannot die from the health drain when Unholy Strength is activated, nor from the strength loss when Unholy Strength is deactivated.", "notes_loc": ["The strength change will affect both maximum and current HP, but you cannot die from the change.", "The strength change occurs over 0.6 seconds.", "Activating or deactivating Unholy Strength does not interrupt channeling."]}, "text_742": {"desc_loc": "Toggle: Unholy Strength When active, Unholy Strength grants +%unholy_bonus_damage% damage, +%unholy_bonus_strength% Strength and +%unholy_bonus_armor% armor, but drains %unholy_health_drain_per_second% health per second. You cannot die from the health drain when Unholy Strength is activated, nor from the strength loss when Unholy Strength is deactivated.", "notes_loc": ["The strength change will affect both maximum and current HP, but you cannot die from the change.", "The strength change occurs over 0.6 seconds.", "Activating or deactivating Unholy Strength does not interrupt channeling."]}, "changed_fields": [{"field": "behavior", "old": "4194820", "new": "70368748372484"}], "rows": [{"review_id": "25cd2befd5561643ce77", "mechanism": "channel_interrupt", "mechanism_zh": "打断持续施法", "definition": "说明明确写打断持续施法；眩晕、沉默等已有控制不重复记", "condition": "item", "decision": "reject"}, {"review_id": "0eccc36ddc805920436b", "mechanism": "death_prevention", "mechanism_zh": "免死", "definition": "在一段时间内不会被打死（如薄葬、回光返照）", "condition": "item", "decision": "reject"}, {"review_id": "f84e4bdfe2a3d5640d2e", "mechanism": "death_prevention", "mechanism_zh": "免死", "definition": "在一段时间内不会被打死（如薄葬、回光返照）", "condition": "item", "decision": "reject"}, {"review_id": "audit:armlet:healing:item", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "item", "decision": "accept"}]}, {"subject": "axe_battle_hunger", "name_zh": "斧王·战斗饥渴", "category": "2_纯数值", "text_741f": {"desc_loc": "Enrages an enemy unit, causing it to take damage over time until it kills another unit or the duration ends. The enemy is slowed as long as they are facing away from Axe.", "notes_loc": ["Destroying buildings will also remove the debuff."], "shard_loc": "Multiple instances of Battle Hunger can stack on a single target."}, "text_742": {"desc_loc": "Enrages an enemy unit, causing it to take damage over time until it kills another unit or the duration ends. The enemy is slowed as long as they are facing away from Axe.", "notes_loc": ["Destroying buildings will also remove the debuff."], "shard_loc": "Multiple instances of Battle Hunger can stack on a single target."}, "changed_fields": [{"field": "slow", "old": {"base": [18, 22, 26, 30], "scepter": null, "shard": null}, "new": {"base": [16, 19, 22, 25], "scepter": null, "shard": null}}], "rows": [{"review_id": "b4ba7669b6a17639ec30", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "bd909cf643394668bb95", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "e2824561e903d4b1b36a", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "axe_berserkers_call", "name_zh": "斧王·狂战士之吼", "category": "2_纯数值", "text_741f": {"desc_loc": "Axe taunts nearby enemy units, forcing them to attack him while he gains bonus armor during the duration.", "shard_loc": "Berserker's Call applies Battle Hunger to affected units.", "facets_loc": ["Berserker's Call gives Axe increased bonus armor and increases the attack speed of the affected units."]}, "text_742": {"desc_loc": "Axe taunts nearby enemy units, forcing them to attack him while he gains bonus armor during the duration.", "shard_loc": "Berserker's Call applies Battle Hunger to affected units.", "facets_loc": ["Berserker's Call gives Axe increased bonus armor and increases the attack speed of the affected units."]}, "changed_fields": [], "rows": [{"review_id": "audit:axe_berserkers_call:slow:shard", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "31ac2fb544d936000f99", "mechanism": "taunt", "mechanism_zh": "嘲讽", "definition": "单位被迫攻击某个目标：强迫敌人攻击施法者、决斗、被迫攻击队友、周围单位被迫攻击指定目标、强迫自身攻击都算", "condition": "base", "decision": "accept"}]}, {"subject": "axe_counter_helix", "name_zh": "斧王·反击螺旋", "category": "3_说明文字", "text_741f": {"desc_loc": "After a set number of attacks, Axe will perform a helix counter attack, dealing pure damage to all nearby enemies.", "notes_loc": ["Counter Helix triggers when the attack hits.", "Illusions' counters don't increase when they attack when you have a Scepter."], "scepter_loc": "Counter Helix now applies a stacking debuff to enemies hit by it that causes them to deal less total attack damage to Axe. Counter Helix no longer has a cooldown and its counter advances when Axe attacks."}, "text_742": {"desc_loc": "After a set number of attacks, Axe will perform a helix counter attack, dealing pure damage to all nearby enemies.", "notes_loc": ["Illusions' counters don't increase when they attack when you have a Scepter."], "scepter_loc": "Counter Helix now applies a stacking debuff to enemies hit by it that causes them to deal less total attack damage to Axe. Counter Helix no longer has a cooldown and its counter advances when Axe attacks."}, "changed_fields": [{"field": "debuff_duration", "old": {"base": [0], "scepter": [6], "shard": null}, "new": {"base": [0], "scepter": [7], "shard": null}}], "rows": [{"review_id": "0ca85166d6eb6646b8ad", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "45dc3687ea59eefe295f", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}, {"review_id": "9f4ef3b647a41254167c", "mechanism": "damage_return", "mechanism_zh": "反伤", "definition": "受到攻击或伤害时触发的反击伤害：按比例返还所受伤害、固定值反击，或受伤触发的范围伤害（如半人马·反伤、斧王·反击螺旋、钢毛后背）；攻击者不一定被打到也算，记条件", "condition": "base", "decision": "accept"}]}, {"subject": "axe_culling_blade", "name_zh": "斧王·淘汰之刃", "category": "2_纯数值", "text_741f": {"desc_loc": "Axe spots a weakness and strikes, dealing pure damage. When an enemy hero is killed with Culling Blade, its cooldown is reset, and all nearby allied units gain bonus movement speed and armor. Axe permanently drenches his blade every time he kills an enemy Hero with Culling Blade, gaining bonus armor for each stack.", "notes_loc": ["Culling Blade death cannot be prevented with other abilities like Shallow Grave."]}, "text_742": {"desc_loc": "Axe spots a weakness and strikes, dealing pure damage. When an enemy hero is killed with Culling Blade, its cooldown is reset, and all nearby allied units gain bonus movement speed and armor. Axe permanently drenches his blade every time he kills an enemy Hero with Culling Blade, gaining bonus armor for each stack.", "notes_loc": ["Culling Blade death cannot be prevented with other abilities like Shallow Grave."]}, "changed_fields": [{"field": "speed_bonus", "old": {"base": [20, 25, 30], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}], "rows": [{"review_id": "f778949844863d898b95", "mechanism": "cooldown_reset", "mechanism_zh": "刷新冷却", "definition": "立刻重置冷却", "condition": "base", "decision": "accept"}, {"review_id": "0d3e4c482d88004fb58d", "mechanism": "execute", "mechanism_zh": "斩杀", "definition": "目标低于生命阈值时直接杀死", "condition": "base", "decision": "accept"}, {"review_id": "6c58753a281ae7c69578", "mechanism": "haste", "mechanism_zh": "加速", "definition": "提升自身、自己的单位或友方的移动速度（顺带加一点移速的也算）；只让敌人变慢的不算", "condition": "base", "decision": "accept"}, {"review_id": "e0af26270370f77ae0b7", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "bane_brain_sap", "name_zh": "祸乱之源·蚀脑", "category": "2_纯数值", "text_741f": {"desc_loc": "Feasts on the vital energies of an enemy unit, healing Bane and dealing damage.", "shard_loc": "Reduces cooldown by %bonus_AbilityCooldown%. Causes Brain Sap to become a %shard_radius% AoE spell. Secondary targets only heal for %shard_secondary_target_heal_pct%%%."}, "text_742": {"desc_loc": "Feasts on the vital energies of an enemy unit, healing Bane and dealing damage.", "shard_loc": "Reduces cooldown by %bonus_AbilityCooldown%. Causes Brain Sap to become a %shard_radius% AoE spell. Secondary targets only heal for %shard_secondary_target_heal_pct%%%."}, "changed_fields": [{"field": "AbilityCooldown", "old": {"base": [17, 15, 13, 11], "scepter": null, "shard": [3]}, "new": {"base": [17, 15, 13, 11], "scepter": null, "shard": [4]}}], "rows": [{"review_id": "57bc0f003b1a45f41cf4", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "audit:bane_brain_sap:aoe_damage:shard", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "shard_upgrade", "decision": "accept"}, {"review_id": "e5950d9618750a3af0f7", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "base", "decision": "accept"}, {"review_id": "ee4efca2197c20e479f8", "mechanism": "healing", "mechanism_zh": "治疗/回复", "definition": "恢复生命值（治疗、生命恢复），含属性生命恢复（如治疗指环+4.5）", "condition": "shard_upgrade", "decision": "reject"}, {"review_id": "d88a435418d4898d340d", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "bane_fiends_grip", "name_zh": "祸乱之源·魔爪", "category": "2_纯数值", "text_741f": {"desc_loc": "CHANNELED - Grips an enemy unit, disabling it and causing heavy damage over time, while stealing mana every %fiend_grip_tick_interval% seconds based on the unit's maximum mana.", "scepter_loc": "Reduces Fiend's Grip cooldown by %bonus_AbilityCooldown%s. Fiend's Grip now creates two uncontrollable illusions that are also channeling Fiend's Grip on the target. Illusions take %scepter_incoming_illusion_damage%%% incoming damage and immediately die if they are interrupted. Damage does not stack."}, "text_742": {"desc_loc": "CHANNELED - Grips an enemy unit, disabling it and causing heavy damage over time, while stealing mana every %fiend_grip_tick_interval% seconds based on the unit's maximum mana.", "scepter_loc": "Reduces Fiend's Grip cooldown by %bonus_AbilityCooldown%s. Fiend's Grip now creates two uncontrollable illusions that are also channeling Fiend's Grip on the target. Illusions take %scepter_incoming_illusion_damage%%% incoming damage and immediately die if they are interrupted. Damage does not stack."}, "changed_fields": [{"field": "cooldowns", "old": [120, 110, 100], "new": [125, 110, 95]}, {"field": "AbilityCooldown", "old": {"base": [120, 110, 100], "scepter": [40], "shard": null}, "new": {"base": [125, 110, 95], "scepter": [35], "shard": null}}, {"field": "scepter_incoming_illusion_damage", "old": {"base": [0], "scepter": [225], "shard": null}, "new": {"base": [0], "scepter": [200], "shard": null}}], "rows": [{"review_id": "5ceccc6e1381cc05d491", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "ad2e6f6bf320668956f4", "mechanism": "channel_interrupt", "mechanism_zh": "打断持续施法", "definition": "说明明确写打断持续施法；眩晕、沉默等已有控制不重复记", "condition": "scepter_upgrade", "decision": "reject"}, {"review_id": "7d7ee27fa905964fff9b", "mechanism": "channeled", "mechanism_zh": "持续施法", "definition": "施法者自身需要持续引导，被打断即停止", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "e683545cf52a65e6276f", "mechanism": "channeled", "mechanism_zh": "持续施法", "definition": "施法者自身需要持续引导，被打断即停止", "condition": "base", "decision": "accept"}, {"review_id": "2b8b90e2f4748da95fc0", "mechanism": "illusions", "mechanism_zh": "幻象", "definition": "制造自身或他人的幻象", "condition": "scepter_upgrade", "decision": "accept"}, {"review_id": "1d29eb4d1a0c64ca5fdd", "mechanism": "mana_burn", "mechanism_zh": "烧蓝/法力削减", "definition": "减少目标的法力值", "condition": "base", "decision": "accept"}, {"review_id": "d29d7320e605c107a8fb", "mechanism": "mana_gain", "mechanism_zh": "自身回蓝/吸蓝", "definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算", "condition": "base", "decision": "accept"}, {"review_id": "audit:bane_fiends_grip:stun:base", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "accept"}, {"review_id": "629cda520d28e440a01f", "mechanism": "unit_target_spell", "mechanism_zh": "单体指向技能", "definition": "主动技能或物品施放时，可以选择敌方单位为目标；允许同一技能或物品也能选择友方。指向方式不推断是否触发林肯格挡或莲花反弹，具体交互分别核对。", "condition": "base", "decision": "accept"}]}, {"subject": "basher", "name_zh": "碎颅锤", "category": "3_说明文字", "text_741f": {"desc_loc": "Passive: Bash Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage. Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_loc": ["Does not stack with other sources of Bash.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode.", "Does not grant Bash to Clones and Tempest Doubles."]}, "text_742": {"desc_loc": "Passive: Bash Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage. Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_loc": ["Does not stack with other sources of Bash.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode.", "Does not grant Bash to Clones, Illusions, or Tempest Doubles."]}, "changed_fields": [], "rows": [{"review_id": "4e036070674d288ff9f1", "mechanism": "bash", "mechanism_zh": "重击", "definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算", "condition": "item", "decision": "accept"}, {"review_id": "14fac6de51de9ca62862", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "item", "decision": "accept"}]}, {"subject": "batrider_flamebreak", "name_zh": "蝙蝠骑士·烈焰破击", "category": "2_纯数值", "text_741f": {"desc_loc": "Hurls an explosive cocktail that explodes when it reaches the target location, knocking back, slowing and dealing damage over time to enemies in the area."}, "text_742": {"desc_loc": "Hurls an explosive cocktail that explodes when it reaches the target location, knocking back, slowing and dealing damage over time to enemies in the area."}, "changed_fields": [{"field": "damage_impact", "old": {"base": [25, 50, 75, 100], "scepter": null, "shard": null}, "new": {"base": [30, 60, 90, 120], "scepter": null, "shard": null}}], "rows": [{"review_id": "0baff3438ea203536d81", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "11d60487289b0f38738d", "mechanism": "displace_other", "mechanism_zh": "位移他人", "definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）", "condition": "base", "decision": "accept"}, {"review_id": "4217e62d61239b8329df", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}, {"review_id": "f4596c5a1de109539014", "mechanism": "stun", "mechanism_zh": "眩晕", "definition": "使目标无法行动和施法的硬控（含小眩晕）", "condition": "base", "decision": "reject"}]}, {"subject": "batrider_sticky_napalm", "name_zh": "蝙蝠骑士·粘性燃油", "category": "2_纯数值", "text_741f": {"desc_loc": "Drenches an area in sticky oil, amplifying damage from Batrider's attacks and abilities and slowing the movement speed and turn rate of enemies. Additional casts of Sticky Napalm continue to increase damage, up to %max_stacks% stacks. Applies a small amount of damage with each cast.", "notes_loc": ["All damage from Batrider gets amplified, except for Radiance, Orb of Venom, Urn of Shadows, and Spirit Vessel.", "Sticky Napalm does not require turning to cast.", "Sticky Napalm deals %creep_damage_pct%%% damage to creeps."], "shard_loc": "Sticky Napalm no longer has a stack limit. Sticky Napalm deals damage to structures.", "facets_loc": ["Increases the max level of Sticky Napalm. Level %max_level_tooltip% Sticky Napalm causes every attack to apply %napalm_stacks_on_attack_tooltip% stack of Sticky Napalm."]}, "text_742": {"desc_loc": "Drenches an area in sticky oil, amplifying damage from Batrider's attacks and abilities and slowing the movement speed and turn rate of enemies. Additional casts of Sticky Napalm continue to increase damage, up to %max_stacks% stacks. Applies a small amount of damage with each cast.", "notes_loc": ["All damage from Batrider gets amplified, except for Radiance, Orb of Venom, Urn of Shadows, and Spirit Vessel.", "Sticky Napalm does not require turning to cast.", "Sticky Napalm deals %creep_damage_pct%%% damage to creeps."], "shard_loc": "Sticky Napalm no longer has a stack limit. Sticky Napalm deals damage to structures.", "facets_loc": ["Increases the max level of Sticky Napalm. Level %max_level_tooltip% Sticky Napalm causes every attack to apply %napalm_stacks_on_attack_tooltip% stack of Sticky Napalm."]}, "changed_fields": [{"field": "cooldowns", "old": [3], "new": [4]}, {"field": "mana_costs", "old": [22], "new": [25]}, {"field": "AbilityCooldown", "old": {"base": [3], "scepter": null, "shard": null}, "new": {"base": [4], "scepter": null, "shard": null}}, {"field": "AbilityManaCost", "old": {"base": [22], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "application_damage", "old": {"base": [5, 10, 15, 20], "scepter": null, "shard": null}, "new": {"base": [7, 14, 21, 28], "scepter": null, "shard": null}}, {"field": "creep_damage_pct", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "damage", "old": {"base": [2.5, 5, 7.5, 10], "scepter": null, "shard": null}, "new": {"base": [6, 12, 18, 24], "scepter": null, "shard": null}}, {"field": "duration", "old": {"base": [6], "scepter": null, "shard": null}, "new": {"base": [7], "scepter": null, "shard": null}}, {"field": "max_stacks", "old": {"base": [20], "scepter": null, "shard": null}, "new": {"base": [10], "scepter": null, "shard": null}}, {"field": "movement_speed_pct", "old": {"base": [-0.75, -1.5, -2.25, -3], "scepter": null, "shard": null}, "new": {"base": [2, 4, 6, 8], "scepter": null, "shard": null}}, {"field": "stacks_per_cast", "old": {"base": [2], "scepter": null, "shard": null}, "new": {"base": [1], "scepter": null, "shard": null}}, {"field": "turn_rate_pct", "old": {"base": [-10, -30, -50, -70], "scepter": null, "shard": null}, "new": {"base": [10, 25, 40, 55], "scepter": null, "shard": null}}], "rows": [{"review_id": "81157b4fb558c79b51c1", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "accept"}, {"review_id": "audit:batrider_sticky_napalm:attack_modifier:base", "mechanism": "attack_modifier", "mechanism_zh": "攻击特效", "definition": "让普通攻击附带额外效果：减甲、减速、减疗、烧蓝、额外伤害、中毒、降低属性等；有概率触发或只强化下一次攻击也算。单纯提高攻击力、攻速，以及吸血、暴击、分裂弹射归各自词条", "condition": "base", "decision": "accept"}, {"review_id": "d872f140e9b137a1ee5b", "mechanism": "incoming_damage_amp", "mechanism_zh": "伤害加深", "definition": "让目标受到更多物理伤害或全部伤害（只加深魔法的归上一项）", "condition": "base", "decision": "accept"}, {"review_id": "d0392d3b6a8acfffb04f", "mechanism": "slow", "mechanism_zh": "减速", "definition": "降低敌方单位的移动速度", "condition": "base", "decision": "accept"}]}, {"subject": "beastmaster_inner_beast", "name_zh": "兽王·野性之心", "category": "2_纯数值", "text_741f": {"desc_loc": "Untaps the inner fury of Beastmaster and units he controls, passively increasing their attack speed.", "notes_loc": ["Break disables the passive attack speed bonus."], "facets_loc": ["Attack Speed bonus is increased by the number of units affected by Inner Beast.", "Can be activated to increase Beastmaster's attack speed and allow him to apply the Wild Axes damage amplification debuff on his attack target."]}, "text_742": {"desc_loc": "Untaps the inner fury of Beastmaster and units he controls, passively increasing their attack speed.", "notes_loc": ["Break disables the passive attack speed bonus."], "facets_loc": ["Attack Speed bonus is increased by the number of units affected by Inner Beast.", "Can be activated to increase Beastmaster's attack speed and allow him to apply the Wild Axes damage amplification debuff on his attack target."]}, "changed_fields": [], "rows": [{"review_id": "30baeead3c528c0db0ee", "mechanism": "break_sensitive", "mechanism_zh": "可被破坏", "definition": "技能（或技能的一部分）会被破坏暂时失效；以游戏文件IsBreakable=1为准", "condition": "base", "decision": "accept"}]}, {"subject": "beastmaster_summon_raptor", "name_zh": "兽王·召唤猛禽", "category": "2_纯数值", "text_741f": {"desc_loc": "Beastmaster summons %hawk_count% hawks that circle around Beastmaster and dive-bombs at enemies with a base attack rate of every %hawk_base_attack_interval%s, damaging and rooting them. Attack rate increases with the Hawk's attack speed. Prioritizes heroes.", "shard_loc": "Increases Hawk duration by %bonus_duration%s and summons an additional Hawk."}, "text_742": {"desc_loc": "Beastmaster summons %hawk_count% hawks that circle around Beastmaster and dive-bombs at enemies with a base attack rate of every %hawk_base_attack_interval%s, damaging and rooting them. Attack rate increases with the Hawk's attack speed. Prioritizes heroes.", "shard_loc": "Increases Hawk duration by %bonus_duration%s and summons an additional Hawk."}, "changed_fields": [{"field": "cooldowns", "old": [30], "new": [25]}, {"field": "AbilityCooldown", "old": {"base": [30], "scepter": null, "shard": null}, "new": {"base": [25], "scepter": null, "shard": null}}, {"field": "dive_damage", "old": {"base": [60, 95, 130, 165], "scepter": null, "shard": null}, "new": {"base": [70, 110, 150, 190], "scepter": null, "shard": null}}], "rows": [{"review_id": "3f7c58d6be7d8debd459", "mechanism": "aoe_damage", "mechanism_zh": "范围伤害", "definition": "一次施放或一次攻击能对多个敌方单位造成伤害", "condition": "base", "decision": "reject"}, {"review_id": "8dbc804dd760634bd920", "mechanism": "root", "mechanism_zh": "缠绕", "definition": "目标不能移动，闪烁和传送类也不能用，但仍能攻击和施法", "condition": "base", "decision": "accept"}, {"review_id": "61e19753ed69ee1e25d2", "mechanism": "summons", "mechanism_zh": "召唤物", "definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算", "condition": "base", "decision": "accept"}]}, {"subject": "beastmaster_summon_razorback", "name_zh": "兽王·召唤刀背兽", "category": "2_纯数值", "text_741f": {"desc_loc": "Beastmaster calls forth a Boar to aid in the battlefield. The