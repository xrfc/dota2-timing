{"subject": "enchantress_little_friends", "name_zh": "魅惑魔女·密友", "name_en": "Little Friends", "description_zh": "魅惑魔女缠绕一个敌方单位。目标附近所有敌方、友方和中立非英雄单位会攻击魅惑魔女选定的目标，并且具有攻击速度和移动速度加成，持续%duration%秒。", "description_en": "Enchantress roots an enemy unit. All creeps, ally, enemy and neutral within a radius will gain bonus movement and attack speed and attack the chosen target for %duration% seconds.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["duration", "bonus_attack_speed", "bonus_move_speed", "radius", "root_base_duration", "root_per_target", "max_root", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "enchantress_untouchable", "name_zh": "魅惑魔女·不可侵犯", "name_en": "Untouchable", "description_zh": "魅惑魔女让她的敌人神魂颠倒，受到他们攻击时会降低其攻击速度。", "description_en": "Enchantress beguiles her enemies, slowing their attacks when she is attacked.", "notes_zh": ["所有直接攻击魅惑魔女的敌方单位都会被减速。", "减速效果在攻击单位产生攻击动作时出现，而不是伤害生效时。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["slow_attack_speed", "slow_duration"]}, {"subject": "enchantress_rabblerouser", "name_zh": "魅惑魔女·煽动野怪", "name_en": "Rabble-Rouser", "description_zh": "魅惑魔女使所有中立生物和魅惑魔女控制下的单位对敌方英雄造成额外伤害。", "description_en": "Enchantress causes neutral creeps or any unit under her control to deal additional damage to enemy Heroes.", "notes_zh": ["不会影响劝化的中立生物、痛苦魔方和肉山。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_amp"]}, {"subject": "huskar_inner_fire", "name_zh": "哈斯卡·心炎", "name_en": "Inner Fire", "description_zh": "在炽烈的狂暴下将附近所有敌人击退至固定距离外，造成伤害和沉默。", "description_en": "In a fiery rage, knocks all nearby enemies away from you to a fixed distance, dealing damage and silencing them.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["health_cost", "damage", "radius", "disarm_duration", "knockback_distance", "min_knockback_distance", "knockback_duration", "min_knockback_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "huskar_burning_spear", "name_zh": "哈斯卡·沸血之矛", "name_en": "Burning Spear", "description_zh": "哈斯卡将其长矛点燃，在普通攻击的同时对敌方单位造成持续伤害。多次攻击会造成持续伤害叠加。每次攻击都将牺牲哈斯卡部分生命值。", "description_en": "Huskar sets his spears aflame, dealing damage over time with his regular attack.  Multiple attacks will stack additional damage.  Each attack drains some of Huskar's health.", "notes_zh": ["沸血之矛在多次施放到目标身上效果可以叠加。没有叠加上限。", "哈斯卡不能使用此技能自杀。", "炙矛可热不会对肉山造成额外的最大生命值烧灼伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["max_health_cost", "burn_damage", "burn_damage_max_pct", "duration", "AbilityCastRange"]}, {"subject": "huskar_berserkers_blood", "name_zh": "哈斯卡·狂战士之血", "name_en": "Berserker's Blood", "description_zh": "哈斯卡的伤痛赐予他力量，根据他损失的生命值将获得攻击速度、魔法抗性和生命恢复加成。生命恢复为力量的一定百分比。", "description_en": "Huskar's injuries feed his power, giving increased attack speed, magic resistance and health regen based on missing health. Health regen is a percentage of your strength.", "notes_zh": ["加成效果为线性增加，满血时没有加成，%hp_threshold_max%%%生命时达到最大加成。"], "granted_by": "", "upgrades": {"shard": {"zh": "哈斯卡可以消耗一定生命来主动开启狂战士之血，炙疗哈斯卡。进行驱散，然后在一定延迟后回复消耗的生命，并且每驱散一个负面状态，他就会额外回复生命。\n\n驱散类型：弱驱散", "en": "Huskar can activate Berserker's Blood for a health cost to cauterize himself. Dispels Huskar, then after a delay, heals for the amount of health consumed plus an additional bonus per debuff dispelled.DISPEL TYPE: Basic Dispel"}}, "is_passive": true, "value_names": ["maximum_attack_speed", "maximum_health_regen", "maximum_magic_resist", "hp_threshold_max", "activatable", "activation_healthcost_pct", "activation_cooldown", "activation_delay", "activation_heal_pct_per_debuff"]}, {"subject": "huskar_blood_magic", "name_zh": "哈斯卡·血魔法", "name_en": "Blood Magic", "description_zh": "哈斯卡没有魔法值。物品的魔法消耗会转换为生命消耗。哈斯卡的生命消耗为魔法伤害，可以被魔法抗性减少。", "description_en": "Huskar does not have mana. Mana costs of items are converted into health costs.Huskar's Health Costs are Magical Damage and can be reduced by Magic Resist.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": []}, {"subject": "huskar_life_break", "name_zh": "哈斯卡·牺牲", "name_en": "Life Break", "description_zh": "哈斯卡牺牲自己的生命来摧毁敌人的生命，他跃向一个目标，造成目标当前生命值一定百分比的伤害，并且降低目标的移动和攻击速度。哈斯卡在跳跃过程中为减益免疫，并且魔法抗性提升%immunity_resist%%%。\n\n驱散类型：弱驱散", "description_en": "Huskar draws upon his health to break an enemy's life, leaping at a target to shatter a percentage of that hero's current health and slow both their movement and attack speed.  While leaping, Huskar is Debuff Immune with %immunity_resist%%% magic resistance.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["如果哈斯卡在跳跃时受到控制技能，或目标在0.015秒内移动1400码以上，跳跃就会停止。", "减速效果无视减益免疫。", "牺牲无法被躲避。"], "granted_by": "", "upgrades": {"scepter": {"zh": "强迫敌方目标攻击哈斯卡，并提升施法距离。", "en": "Forces the enemy target to attack Huskar and increases cast range."}}, "is_passive": false, "value_names": ["health_cost_percent", "health_damage", "charge_speed", "tooltip_health_damage", "tooltip_health_cost_percent", "movespeed", "attack_speed", "slow_duration_tooltip", "taunt_duration", "cast_range_bonus", "immunity_resist", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "night_stalker_void", "name_zh": "暗夜魔王·虚空", "name_en": "Void", "description_zh": "制造一个伤害性的虚空，对一个敌方单位造成减速及伤害。夜晚时虚空可以造成短暂眩晕，打断持续施法，并且效果的持续时间更长。", "description_en": "Creates a damaging void that slows an enemy unit and deals damage. At night, Void also mini-stuns, interrupting channeling abilities, and its effects lasts longer.", "notes_zh": ["虚空在白天不会对敌人造成眩晕。"], "granted_by": "", "upgrades": {"shard": {"zh": "虚空现在影响目标范围内所有单位。", "en": "Void now affects all units in a radius around the target."}}, "is_passive": false, "value_names": ["damage", "duration_day", "duration_night", "movespeed_slow", "attackspeed_slow", "invisible_damage_pers", "invisible_damage_tickrate", "max_level", "max_level_tooltip", "cast_radius", "cast_radius_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "night_stalker_crippling_fear", "name_zh": "暗夜魔王·伤残恐惧", "name_en": "Crippling Fear", "description_zh": "暗夜魔王恐吓附近所有敌人，使他们在他身边时被沉默，并受到伤害。效果在夜晚持续更久。", "description_en": "Night Stalker horrifies all nearby enemies, causing them to become silenced and take damage over time while near him.  The effect lasts longer at night.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration_day", "duration_night", "mana_interval", "radius", "dps", "tick_rate", "AbilityManaCost", "AbilityCooldown"]}]
