anted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["tooltip_clones", "required_level", "levels_between_upgrades", "max_level", "dps_penalty_pct"]}, {"subject": "meepo_geomancy", "name_zh": "米波·地卜术", "name_en": "Geomancy", "description_zh": "米波会根据所在地形给予自身和克隆体可叠加的加成效果。每个米波都会给予其他米波自身的加成。如果%tree_radius%范围内有树木，他会获得%tree_regen%点/秒生命恢复。如果他站在土地上，他会获得%dirt_move_speed%%%移动速度加成。如果他在水中，他的攻击会减缓目标%water_move_slow%%%移速，持续%water_slow_duration%秒。", "description_en": "Meepo grants stacking bonuses to himself and his clones based on their terrain.  Each Meepo grants his bonus to the other Meepos.If there is a tree within %tree_radius% range, he receives %tree_regen% HP regen.If he is standing on dirt, he receives %dirt_move_speed%%% bonus movement speed.If he is in the water, his attacks slow the target by %water_move_slow%%% for %water_slow_duration% seconds.", "notes_zh": ["土地包括所有水之外的地形。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["tree_radius", "tree_regen", "dirt_move_speed", "water_move_slow", "water_slow_duration"]}, {"subject": "meepo_megameepo_fling", "name_zh": "米波·超大米波摔扔", "name_en": "MegaMeepo Fling", "description_zh": "在超大米波形态下，米波将最上端的米波向%AbilityCastRange%范围内目标扔出，造成伤害和减速。", "description_en": "In MegaMeepo form, Meepo flings the topmost meepo towards a target within a %AbilityCastRange% range, dealing damage and slowing their movement speed.", "notes_zh": ["不会触发法术反弹。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["fling_damage", "fling_radius", "fling_movespeed", "fling_slow_duration", "movement_slow", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "treant_natures_grasp", "name_zh": "树精卫士·自然卷握", "name_en": "Nature's Grasp", "description_zh": "朝目标地点制造藤蔓。藤蔓对穿过的敌人造成减速和伤害。对非英雄单位造成的伤害减少%creep_penalty%%%。", "description_en": "Creates vines towards the target location. Vines slow down and deal damage to enemies that walk through. Does %creep_penalty%%% less damage to creeps.", 