_en": "Kicks the closest enemy unit in the drawn direction, stunning, damaging, and slowing them. Also deals damage to all heroes within %search_radius% radius of its landing area. Cooldown is reduced by %creep_cooldown_reduction_pct%%% if kicking a creep.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["air_time", "push_length", "move_slow", "slow_duration", "damage", "search_radius", "creep_cooldown_reduction_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "octarine_core", "name_zh": "玲珑心", "name_en": "Octarine Core", "description_en": "Passive: Cooldown Reduction Reduces the cooldown time of all spells and items.", "notes_en": [], "attributes": ["+ 25% Cooldown Reduction", "+ 450 Health", "+ 450 Mana", "+ 6 Mana Regeneration"], "is_item": true}, {"subject": "travel_boots", "name_zh": "远行鞋", "name_en": "Boots of Travel", "description_en": "Upgrade: Town Portal Scroll Upgrades your Town Portal Scroll, allowing it to target units, reduces cooldown and does not consume a charge on usage.  Movement speed bonuses from multiple pairs of boots do not stack.", "notes_en": ["Movement speed bonuses from boots do not stack."], "attributes": ["+ 90 Movement Speed", "TOWN PORTAL SCROLL COOLDOWN: 40"], "is_item": true}, {"subject": "travel_boots_2", "name_zh": "远行鞋", "name_en": "Boots of Travel 2", "description_en": "Upgrade: Town Portal Scroll Upgrades your Town Portal Scroll, allowing it to target units and heroes, reduces cooldown, channel time and does not consume a charge on usage.  Movement speed bonuses from multiple pairs of boots do not stack.", "notes_en": ["Movement speed bonuses from boots do not stack."], "attributes": ["+ 110 Movement Speed", "TOWN PORTAL SCROLL COOLDOWN: 40", "TOWN PORTAL SCROLL CHANNEL TIME: 2"], "is_item": true}]
