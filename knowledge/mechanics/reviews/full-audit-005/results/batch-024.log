true, "value_names": ["radius", "tick_interval", "damage"]}, {"subject": "ember_spirit_fire_remnant", "name_zh": "灰烬之灵·残焰", "name_en": "Fire Remnant", "description_zh": "可以放出一个残焰，向目标地点冲去，速度为灰烬之灵移动速度的%speed_multiplier%%%。使用“激活残焰”技能后，灰烬之灵向所有残焰像冲去，将其摧毁并造成范围伤害，并移动至最近的残焰像。灰烬之灵最后会到达离目标地点最近的残焰像。", "description_en": "Sends a Fire Remnant that runs to the target location at %speed_multiplier%%% Ember Spirit's speed. Using Activate Fire Remnant, Ember Spirit will dash out to all active Fire Remnants, destroying them and dealing damage in an area and then moving to the nearest Remnant.  Ember Spirit will end at the Remnant closest to the targeted location.", "notes_zh": ["学习后马上拥有3个残焰（上限数量）。"], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离、初始残焰速度和最大能量点数。", "en": "Increases cast range, initial remnant speed, and maximum charges."}, "shard": {"zh": "灰烬之灵附近范围内有敌方英雄阵亡时，恢复一点残焰能量点数。另外，灰烬之灵阵亡时会在原地留下一个残焰。", "en": "If an enemy hero dies near Ember Spirit, a Fire Remnant charge will be replenished. Additionally, when Ember Spirit dies a Fire Remnant is spawned at his location."}}, "is_passive": false, "value_names": ["speed_multiplier", "damage", "radius", "duration", "scepter_range", "scepter_speed_multiplier", "scepter_max_charges", "shard_charge_radius", "apply_immolation_to_remnant", "AbilityCastRange", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityCooldown"]}, {"subject": "earth_spirit_boulder_smash", "name_zh": "大地之灵·巨石冲击", "name_en": "Boulder Smash", "description_zh": "大地之灵将敌方单位或友方单位作为目标，将其击飞，目标将沿他面朝的方向飞行一段距离。如果大地之灵点地为目标，他将击飞%remnant_smash_radius_tooltip%范围内距离最近的单位，优先以残岩为目标。击飞的单位或残岩会对碰到的所有单位造成伤害。如果敌人是被残岩击中还将额外被减速。残岩被击飞的距离比其他单位更远。", "description_en": "Earth Spirit smashes the target enemy or ally, sending them in the direction he is facing. If Earth Spirit targets an area, he will smash the nearest unit in a %remnant_smash_radius_tooltip% radius, prioritizing Stone Remnants. The travelling unit or Remnant damages all enemy units it hits.  If an enemy is hit by a Stone Remnant, they are also slowed. Stone Remnants travel further than other units.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "rock_search_aoe", "rock_damage", "move_slow", "duration", "speed", "unit_distance", "rock_distance", "remnant_smash_radius_tooltip", "creep_multiplier", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_rolling_boulder", "name_zh": "大地之灵·巨石翻滚", "name_en": "Rolling Boulder", "description_zh": "大地之灵化身为巨石，经过%delay%秒延迟后向目标位置翻滚，对经过的敌人造成伤害和眩晕，伤害值为%damage% + %damage_str%%%力量。如果撞到敌方英雄或自身被眩晕，翻滚都会中止。如果翻滚过程中经过残岩将会大幅提高翻滚距离和速度，造成的眩晕时间更长。", "description_en": "Earth Spirit gathers himself into a boulder and, after a %delay%s delay, rolls toward the target location, dealing %damage% + %damage_str%%% STR damage and stunning enemy units. He will stop if he collides with an enemy hero or is stunned. If he rolls over a Stone Remnant, he will travel further and faster, and stun enemies for longer.", "notes_zh": ["翻滚时经过残岩会将其摧毁。", "巨石的作用范围为%radius%。", "大地之灵在滚动时无法作为目标，而且无敌。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "speed", "rock_speed", "distance", "rock_distance_multiplier", "delay", "damage", "stun_duration", "rock_bonus_duration", "damage_str", "destroy_stone", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_geomagnetic_grip", "name_zh": "大地之灵·地磁之握", "name_en": "Geomagnetic Grip", "description_zh": "大地之灵将目标残岩或友方单位拉扯到自己所在的位置，行进路径上被击中的敌人都会被沉默并受到伤害。拉扯的残岩也会对击中的敌人造成伤害。以友军为目标时施法距离减少。", "description_en": "Earth Spirit pulls the target Stone Remnant or Allied Unit. Enemies struck by the gripped target will be silenced.Pulled Remnants also deal damage to struck enemies.Cast range is reduced when targeting an ally.", "notes_zh": ["如果目标处于时间结界，决斗或黑洞之中则不起作用。", "地磁之握还可以对友方小兵施放。"], "granted_by": "", "upgrades": {"shard": {"zh": "冷却时间减少至%AbilityCooldown%秒，对友方单位的施法距离和牵引速度提升。", "en": "Decreases cooldown to %AbilityCooldown%s and increases allied unit cast range and pull speed."}}, "is_passive": false, "value_names": ["radius", "rock_damage", "pull_units_per_second", "duration", "pull_units_per_second_heroes", "cast_range_heroes", "speed", "total_pull_distance", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_stone_caller", "name_zh": "大地之灵·残岩", "name_en": "Stone Remnant", "description_zh": "在指定位置召唤一块残岩。残岩没有视野，为无敌状态，可以加强大地之灵的技能效果。召唤残岩需要消耗一点能量点数，能量点数会随时间恢复。残岩拥有%AbilityCharges%点能量点数。每点未使用的残岩能量都会使大地之灵被动获得%attack_damage_per_stone%%%攻击力加成，并且技能用过残岩后会额外获得%attack_damage_per_stone_used%%%攻击力加成，持续%buff_duration%秒（无法叠加）。", "description_en": "Call a Stone Remnant to the target location.  Stone Remnants have no vision and are invulnerable, and can be used with Earth Spirit's abilities.  Calling a Stone Remnant consumes a charge, which recharge over time. Stone Remnant has %AbilityCharges% charges.Earth Spirit passively gains %attack_damage_per_stone%%% bonus damage per unused Stone Remnant charge, and gains an additional %attack_damage_per_stone_used%%% bonus damage for %buff_duration%s when a Stone Remnant is targeted with an ability (does not stack).", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "rolling_offset_distance", "attack_damage_per_stone", "attack_damage_per_stone_used", "buff_duration", "AbilityCastRange", "AbilityCharges", "AbilityChargeRestoreTime"]}, {"subject": "earth_spirit_petrify", "name_zh": "大地之灵·残岩魔咒", "name_en": "Enchant Remnant", "description_zh": "大地之灵对一名英雄施法，使其暂时获得残岩的属性。经过短时间后残岩就会碎裂，释放出英雄，并对周围单位造成伤害。可以对残岩施放。对残岩施放时冷却时间为5秒。对友方英雄施放时施法距离更远。", "description_en": "Earth Spirit temporarily enchants a hero, granting them the properties of a Stone Remnant. After a short duration the remnant shatters, releasing the hero and damaging nearby enemies. Can be cast on Stone Remnants. Has a 5 second cooldown when used that way.Has a larger cast range when cast on an ally hero.", "notes_zh": ["如果大地之灵自身受到残岩魔咒的效果，也可以成为巨石冲击的目标。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage", "aoe", "ally_cast_range", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "earth_spirit_magnetize", "name_zh": "大地之灵·磁化", "name_en": "Magnetize", "description_zh": "将附近小范围内的敌方单位磁化，使其短时间内受到伤害。被磁化的英雄单位将会引起附近残岩的爆炸，每次爆炸都将摧毁残岩并刷新残岩附近单位身上的磁化时间（若附近单位未被磁化则为其施加一个磁化效果）。该过程可重复数次。如果一个被磁化的英雄受到了地磁之握或巨石冲击的作用，那么所有被磁化的英雄都会受到同样效果。", "description_en": "Magnetizes units in a small nearby area, causing them to take damage for a short duration. Magnetized heroes cause nearby Stone Remnants to explode, destroying the remnant and refreshing Magnetize's duration on all nearby enemies. This process can repeat multiple times. If an enemy hero is affected by Geomagnetic Grip or Boulder Smash, all magnetized heroes share the effects.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["cast_radius", "damage_per_second", "damage_duration", "rock_search_radius", "rock_explosion_radius", "damage_interval", "rock_explosion_delay", "silence_duration", "slow_duration", "magnetize_self", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "terrorblade_reflection", "name_zh": "恐怖利刃·倒影", "name_en": "Reflection", "description_zh": "恐怖利刃映出目标区域内所有敌方英雄的黑暗倒影对其进行反制，目标在短时间内将被自身倒影攻击，移动速度和攻击速度都会降低。倒影为无敌状态。", "description_en": "Terrorblade brings forth an invulnerable dark reflection of all enemy heroes in a target area. Affected enemy heroes have movement and attack speeds slowed and attacked by their reflection.", "notes_zh": ["无法以倒影的幻象为目标，并且幻象为无敌，减速效果被移除后幻象将被摧毁。", "倒影只会攻击该技能指定的目标。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["illusion_duration", "illusion_outgoing_damage", "illusion_outgoing_tooltip", "move_slow", "attack_slow", "range", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "terrorblade_conjure_image", "name_zh": "恐怖利刃·惑幻", "name_en": "Conjure Image", "description_zh": "创造一个恐怖利刃的幻象，可以攻击敌人造成伤害。", "description_en": "Creates an illusion of Terrorblade that deals damage.", "notes_zh": ["惑幻产生的幻象在外观上与普通幻象不同。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["illusion_duration", "illusion_outgoing_damage", "illusion_outgoing_tooltip", "illusion_incoming_damage", "illusion_incoming_damage_total_tooltip", "show_particle_effect", "appear_as_illusion", "hp_cost_perc", "illusions_spawn_with_full_hp", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}]
