te":"狂战士之吼会对作用下单位施加战斗饥渴。；使他受到持续伤害","uncertain":false}]},{"subject":"axe_battle_hunger","mechanisms":[{"mechanism":"slow","condition":"base","quote":"敌人只要背朝斧王还将被减速。","uncertain":false}]},{"subject":"axe_counter_helix","mechanisms":[{"mechanism":"damage_return","condition":"base","quote":"受到一定次数攻击后，斧王就会做出螺旋反击，对附近所有敌方单位造成纯粹伤害。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"对附近所有敌方单位造成纯粹伤害。","uncertain":false},{"mechanism":"attack_damage_reduction","condition":"scepter","quote":"对击中的敌人施加一个可叠加的负面效果，使其对斧王造成的攻击伤害减少。","uncertain":false}]},{"subject":"axe_culling_blade","mechanisms":[{"mechanism":"cooldown_reset","condition":"base","quote":"淘汰之刃击杀敌方英雄时将重置冷却时间","uncertain":false},{"mechanism":"execute","condition":"base","quote":"淘汰之刃的斩杀效果无法被薄葬等技能阻止。","uncertain":true}]},{"subject":"axe_one_man_army","mechanisms":[]},{"subject":"bane_enfeeble","mechanisms":[{"mechanism":"attack_damage_reduction","condition":"base","quote":"降低敌人的总攻击力和施法距离。","uncertain":false}]},{"subject":"bane_brain_sap","mechanisms":[{"mechanism":"healing","condition":"base","quote":"造成伤害并回复自身生命值。","uncertain":false},{"mechanism":"aoe_damage","condition":"shard","quote":"蚀脑变成%shard_radius%作用范围的技能。次级目标只有%shard_secondary_target_heal_pct%%%治疗效果。","uncertain":false}]},{"subject":"bane_nightmare","mechanisms":[{"mechanism":"sleep","condition":"base","quote":"让目标敌方或友方英雄进入沉睡。睡着的单位会向祸乱之源选定的方向走去，受到攻击便会醒来。","uncertain":false},{"mechanism":"forced_action","condition":"base","quote":"睡着的单位会向祸乱之源选定的方向走去","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"在噩梦的第一秒，作用单位是无敌状态。","uncertain":false}]},{"subject":"bane_fiends_grip","mechanisms":[{"mechanism":"stun","condition":"base","quote":"抓住一个敌方单位，使其失去行动能力","uncertain":false},{"mechanism":"mana_burn","condition":"base","quote":"同时每%fiend_grip_tick_interval%秒按目标最大魔法值一定比例吸取魔法。","uncertain":false},{"mechanism":"mana_gain","condition":"base","quote":"while stealing mana every %fiend_grip_tick_interval% seconds based on the unit's maximum mana.","uncertain":false},{"mechanism":"illusions","condition":"scepter","quote":"魔爪将产生两个不可控制的幻象","uncertain":false}]},{"subject":"bane_ichor_of_nyctasha","mechanisms":[]},{"subject":"bloodseeker_bloodrage","mechanisms":[{"mechanism":"spell_amp","condition":"base","quote":"获得攻击速度和技能增强加成","uncertain":false},{"mechanism":"attack_modifier","condition":"shard","quote":"血怒下血魔的攻击现在造成%max_health_dmg_pct%%%目标最大生命值的纯粹伤害。","uncertain":false}]},{"subject":"bloodseeker_blood_bath","mechanisms":[{"mechanism":"silence","condition":"base","quote":"区域范围内所有敌人都会受到伤害，并被沉默。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"区域范围内所有敌人都会受到伤害","uncertain":false}]},{"subject":"bloodseeker_thirst","mechanisms":[{"mechanism":"true_sight","condition":"base","quote":"他还将获得该英雄的视野和真实视域。","uncertain":false},{"mechanism":"grant_vision","condition":"base","quote":"他还将获得该英雄的视野和真实视域。","uncertain":false}]},{"subject":"bloodseeker_sanguivore","mechanisms":[{"mechanism":"healing","condition":"base","quote":"血魔每杀死一个单位都会回复部分生命","uncertain":false}]},{"subject":"bloodseeker_rupture","mechanisms":[{"mechanism":"charges","condition":"scepter","quote":"提供%AbilityCharges%点割裂能量点数。","uncertain":false}]},{"subject":"crystal_maiden_crystal_nova","mechanisms":[{"mechanism":"slow","condition":"base","quote":"降低目标区域内的敌人的移动速度。","uncertain":false},{"mechanism":"grant_vision","condition":"base","quote":"冰霜新星在持续时间内提供目标区域的视野。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"A burst of damaging frost slows enemy movement in the targeted area.","uncertain":false}]},{"subject":"crystal_maiden_frostbite","mechanisms":[{"mechanism":"disarm","condition":"base","quote":"禁止移动和攻击","uncertain":false},{"mechanism":"root","condition":"base","quote":"冰封禁制为捆缚效果。","uncertain":false}]},{"subject":"crystal_maiden_brilliance_aura","mechanisms":[{"mechanism":"mana_gain","condition":"base","quote":"地图上所有友方单位获得额外魔法恢复。；水晶室女被动获得魔法恢复增强。","uncertain":false},{"mechanism":"aura","condition":"base","quote":"地图上所有友方单位获得额外魔法恢复。水晶室女附近%proximity_bonus_radius%范围内友军获得更高的魔法恢复。","uncertain":false}]},{"subject":"crystal_maiden_crystal_clone","mechanisms":[{"mechanism":"self_mobility","condition":"shard","quote":"向一个方向滑行","uncertain":false},{"mechanism":"projectile_dodge","condition":"shard","quote":"躲避多种飞行过程中的攻击和技能弹道","uncertain":false},{"mechanism":"summons","condition":"shard","quote":"在原地制造一个自身的冰晶克隆；如果克隆受到了足量伤害，或者超过一定时间都会碎裂","uncertain":false},{"mechanism":"root","condition":"shard","quote":"对附近%frostbite_radius%范围内敌人施加冰封禁制。；冰封禁制为捆缚效果。","uncertain":false},{"mechanism":"disarm","condition":"shard","quote":"对附近%frostbite_radius%范围内敌人施加冰封禁制。；禁止移动和攻击","uncertain":false},{"mechanism":"aoe_damage","condition":"shard","quote":"对附近%frostbite_radius%范围内敌人施加冰封禁制。；并持续造成伤害。","uncertain":false},{"mechanism":"damage_return","condition":"shard","quote":"如果克隆受到了足量伤害，或者超过一定时间都会碎裂，对附近%frostbite_radius%范围内敌人施加冰封禁制。","uncertain":false}]},{"subject":"crystal_maiden_glacial_guard","mechanisms":[{"mechanism":"damage_block","condition":"base","quote":"水晶室女消耗在她技能上的一部分魔法会转化为物理护盾。","uncertain":false}]}]}
