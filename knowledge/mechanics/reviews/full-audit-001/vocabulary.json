},
{
"id": "lifesteal",
"zh": "吸血",
"definition": "攻击或技能恢复自身生命：按造成的伤害、按目标生命或每次攻击固定值（攻击吸血、技能吸血、如噬魂鬼·盛宴、附魂面具）"
},
{
"id": "heal_reduction",
"zh": "治疗削减",
"definition": "降低或禁止目标的任何形式生命恢复，含属性回复；提升生命上限的效果不受影响"
},
{
"id": "mana_burn",
"zh": "烧蓝/法力削减",
"definition": "减少目标的法力值"
},
{
"id": "mana_gain",
"zh": "自身回蓝/吸蓝",
"definition": "为自己恢复或从其他单位抽取法力（如莱恩法力吸取），含属性回蓝和回蓝倍率；对友军生效且能给自己回蓝的也算"
},
{
"id": "illusions",
"zh": "幻象",
"definition": "制造自身或他人的幻象"
},
{
"id": "summons",
"zh": "召唤物",
"definition": "召唤有血量的单位（可控或不可控都算），以及夺取已有单位的控制权；按受攻击次数计算的单位和死亡守卫不算"
},
{
"id": "self_mobility",
"zh": "自身位移",
"definition": "闪烁、冲刺、跳跃、传送等主动改变自身位置"
},
{
"id": "displace_other",
"zh": "位移他人",
"definition": "拉、推、交换、投掷其他单位（如动人之舐、移形换位）"
},
{
"id": "damage_return",
"zh": "反伤",
"definition": "受到攻击或伤害时触发的反击伤害：按比例返还所受伤害、固定值反击，或受伤触发的范围伤害（如半人马·反伤、斧王·反击螺旋、钢毛后背）；攻击者不一定被打到也算，记条件"
},
{
"id": "bash",
"zh": "重击",
"definition": "攻击或技能造成重击（眩晕目标）；有概率、固定攻击次数或技能触发都算"
},
{
"id": "pierce_evasion",
"zh": "克敌机先",
"definition": "攻击无视闪避（必中）"
},
{
"id": "critical",
"zh": "暴击",
"definition": "攻击造成额外倍数伤害；有概率触发或强化下一次攻击都算"
},
{
"id": "ethereal",
"zh": "虚无",
"definition": "单位进入虚无状态：无法攻击，也不会受到物理攻击；魔法和纯粹伤害仍可作用"
},
{
"id": "armor_reduction",
"zh": "减护甲",
"definition": "降低目标护甲"
},
{
"id": "magic_resist_reduction",
"zh": "减魔抗/魔法易伤",
"definition": "降低目标魔抗，或让目标受到更多魔法或技能伤害"
},
{
"id": "incoming_damage_amp",
"zh": "伤害加深",
