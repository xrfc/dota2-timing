},
{
"id": "evasion",
"zh": "闪避",
"definition": "自身有概率使敌方攻击落空"
},
{
"id": "blind",
"zh": "致盲",
"definition": "使敌方单位的攻击有概率落空"
},
{
"id": "debuff_immunity",
"zh": "减益免疫/技能免疫",
"definition": "处于减益免疫（技能免疫）时，只有能穿透减益免疫的效果才对其生效（如碎颅锤的重击可以眩晕开了黑皇杖的单位）"
},
{
"id": "pierces_debuff_immunity",
"zh": "穿透减益免疫",
