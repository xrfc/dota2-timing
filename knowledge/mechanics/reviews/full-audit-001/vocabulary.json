},
{
"id": "attack_damage_reduction",
"zh": "减攻击力",
"definition": "降低目标的攻击力"
},
{
"id": "spell_block",
"zh": "格挡指向技能",
"definition": "使指向自身或队友的技能失效"
},
{
"id": "spell_reflect",
"zh": "反弹指向技能",
"definition": "把指向技能反弹给施法者"
},
{
"id": "projectile_dodge",
"zh": "躲避弹道",
