},
{
"id": "mobility_lock",
"zh": "限制位移",
"definition": "阻止目标闪烁、传送或离开范围；只是不能走的归定身"
},
{
"id": "cleave",
"zh": "分裂溅射",
"definition": "攻击伤害波及周围单位"
},
{
"id": "attack_modifier",
"zh": "攻击特效",
"definition": "给攻击附加效果的法球类技能"
},
{
"id": "spell_amp",
"zh": "法术放大",
"definition": "提高技能造成的伤害"
},
{
"id": "aura",
"zh": "光环",
"definition": "持续影响周围单位；对友军或敌方都算，并记作用对象"
},
{
"id": "reveal",
"zh": "显形",
"definition": "使隐身单位显形，不等于持续真视"
},
{
"id": "grant_vision",
"zh": "提供视野",
"definition": "提供目标或区域的视野"
},
{
"id": "reduce_vision",
"zh": "减视野",
"definition": "降低目标的视野"
},
{
"id": "phased",
"zh": "相位移动",
"definition": "移动不受单位碰撞阻挡"
},
{
"id": "flying",
"zh": "飞行",
"definition": "飞行移动，能越过地形"
},
{
"id": "tree_walk",
"zh": "穿树",
"definition": "能穿过树木移动"
},
{
"id": "tree_destroy",
"zh": "砍树",
"definition": "能摧毁树木"
},
{
"id": "respawn",
"zh": "重生",
"definition": "死亡后复活，或影响复活"
},
{
"id": "execute",
"zh": "斩杀",
"definition": "目标低于生命阈值时直接杀死"
},
{
"id": "hp_removal",
"zh": "生命移除",
"definition": "直接移除生命，不算伤害"
},
{
"id": "spell_steal",
"zh": "偷技能",
"definition": "获得其他单位的技能"
},
{
"id": "stat_steal",
"zh": "偷属性",
"definition": "夺取目标的属性"
},
{
"id": "cooldown_reduction",
"zh": "减冷却",
"definition": "技能能缩短技能或物品的冷却；A杖或魔晶只降低技能自身冷却的不记，从字段读"
},
{
"id": "cooldown_reset",
"zh": "刷新冷却",
"definition": "立刻重置冷却"
},
{
"id": "economy",
"zh": "经济经验",
"definition": "提供额外金钱或经验；只是正常赏金不算"
},
{
"id": "charges",
"zh": "充能",
"definition": "技能或物品用一次消耗一点；只决定数值或层数的不算"
},
{
"id": "aoe_damage",
"zh": "范围伤害",
"definition": "一次施放或一次攻击能对多个敌方单位造成伤害"
}
]