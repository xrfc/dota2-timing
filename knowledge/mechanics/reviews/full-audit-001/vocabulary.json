},
{
"id": "invulnerable_untargetable",
"zh": "无敌/不可选取",
"definition": "暂时无法被伤害或无法被指向"
},
{
"id": "damage_block",
"zh": "护盾/伤害吸收/减伤",
"definition": "吸收一定伤害、按比例减少受到的伤害，或把受到的伤害延迟结算（如统帅朗姆酒、虚妄之诺）"
},
{
"id": "death_prevention",
"zh": "免死",
"definition": "在一段时间内不会被打死（如薄葬、回光返照）"
},
{
"id": "status_resistance",
"zh": "状态抗性",
"definition": "缩短自身受到的控制与减益的持续时间（如散夜对剑+16%）"
},
{
"id": "slow_resistance",
"zh": "减速抗性",
"definition": "降低自身受到的减速效果（如散夜对剑+30%）"
},
{
"id": "applies_basic_dispel",
"zh": "施加弱驱散",
"definition": "移除目标身上可被弱驱散的效果"
},
{
"id": "applies_strong_dispel",
"zh": "施加强驱散",
"definition": "移除目标身上可被强驱散的效果（含多数眩晕）"
},
{
"id": "applies_break",
"zh": "施加破坏",
"definition": "使目标的被动技能暂时失效"
},
{
"id": "invisibility",
"zh": "隐身",
"definition": "使自身、队友、召唤物或复制体隐身"
},
{
"id": "true_sight",
"zh": "真视",
"definition": "可看见隐身单位"
},
{
"id": "healing",
"zh": "治疗/回复",
