[{"subject": "primal_beast_colossal", "name_zh": "獸·庞", "name_en": "Colossal", "description_zh": "獸拥有%base_slow_resist%%%基础减速抗性，每拥有%hp_per_threshold%点生命上限就获得+%aoe_per_threshold%%%作用范围加成和+%slow_resistance_per_threshold%%%减速抗性。", "description_en": "Primal Beast has %base_slow_resist%%% base Slow Resistance and gains %aoe_per_threshold%%% bonus Area of Effect and %slow_resistance_per_threshold%%% Slow Resistance for every %hp_per_threshold% Max Health.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["hp_per_threshold", "base_slow_resist", "slow_resistance_per_threshold", "aoe_per_threshold", "current_slow_resistance", "current_aoe", "trample_bonus", "model_scale_per_stack"]}, {"subject": "muerta_dead_shot", "name_zh": "琼英碧灵·弹无虚发", "name_en": "Dead Shot", "description_zh": "琼英碧灵向一个敌方单位或一棵树发射一颗幽灵子弹。子弹击中时会对敌人造成伤害和短暂减速，然后沿矢量目标的方向弹去。跳弹将会对穿过的所有单位造成伤害，击中英雄后停下。被跳弹击中的英雄会被恐惧。", "description_en": "Muerta fires a ghostly trickshot at an enemy unit or tree. When the bullet strikes, it damages and briefly slows, then ricochets in the targeted direction.The ricochet damages all units that it passes through, stopping when it hits a hero. Heroes hit by the ricochet are feared away from the impact.", "notes_zh": ["被恐惧的敌人为相位状态，无法被减速。", "跳弹的行进距离为弹无虚发施法距离的%ricochet_distance_multiplier%倍。", "可以弹离减益免疫目标。"], "granted_by": "", "upgrades": {"scepter": {"zh": "弹无虚发的伤害提升。弹无虚发的作用范围在弹跳后会扩大，并且跳弹恐惧敌人时会穿过敌方英雄。", "en": "Dead Shot damage is increased. Dead Shot expands after it ricochets and pierces through enemy heroes as it fears them."}}, "is_passive": false, "value_names": ["damage", "speed", "radius", "ricochet_radius_start", "ricochet_radius_end", "ricochet_radius_expansion_per_second", "ricochet_distance_multiplier", "ricochet_fear_duration", "impact_slow_percent", "impact_slow_duration", "scepter_pierces", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityManaCost"]}, {"subject": "muerta_the_calling", "name_zh": "琼英碧灵·唤魂", "name_en": "The Calling", "description_zh": "召唤%num_revenants%个亡魂，缓慢地环绕目标地点。在区域内的敌人会被减速。亡魂会在敌人穿过时造成伤害和沉默。", "description_en": "Summons a group of %num_revenants% revenants that slowly circle the targeted location. Enemies within the area are slowed. Revenants deal damage and silence enemies as they pass through them.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "duration", "hit_radius", "dead_zone_distance", "num_revenants", "speed_initial", "speed_max", "acceleration", "aura_movespeed_slow", "silence_duration", "rotation_direction", "hp_regen_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "muerta_gunslinger", "name_zh": "琼英碧灵·神枪在手", "name_en": "Gunslinger", "description_zh": "可以开关。开启后，琼英碧灵攻击时有几率对另一个目标再射一枪。", "description_en": "Toggleable. When toggled on, Muerta's attacks have a chance to fire a second shot at another target.", "notes_zh": ["如果距离内没有其他单位，她会向原目标发射两枪。", "第二枪可以击中琼英碧灵攻击距离加上%target_search_bonus_range%范围内的单位。", "第二枪可以触发攻击特效。", "以英雄优先，然后是非英雄单位，然后是建筑。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["double_shot_chance", "target_search_bonus_range", "bonus_damage"]}, {"subject": "muerta_spectral_slug", "name_zh": "琼英碧灵·幽魂子弹", "name_en": "Spectral Slug", "description_zh": "琼英碧灵对一个敌人射出一颗幽灵子弹，造成伤害，将其击退并将其变为虚无状态，持续%duration%秒——使他们对物理伤害免疫，并且无法攻击。目标被减速，并且承受的魔法伤害增加%bonus_spell_damage_pct%%%。敌人不会被击出琼英碧灵的攻击距离。", "description_en": "Muerta shoots a spectral bullet at an enemy, dealing damage, knocking them back, and turning them ethereal for %duration%s - rendering them immune to physical damage and unable to attack. The target is slowed and %bonus_spell_damage_pct%%% more vulnerable to magic damage. Enemies will not be knocked out of Muerta's attack range.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["projectile_speed", "damage", "knockback_distance", "knockback_duration", "duration", "slow_pct", "bonus_spell_damage_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "muerta_pierce_the_veil", "name_zh": "琼英碧灵·越界", "name_en": "Pierce the Veil", "description_zh": "琼英碧灵变身，成为虚无状态，获得基础攻击力加成和相位移动状态。被动使总是可以攻击虚无状态下的目标，并且她在虚无状态下也能攻击。在她或目标处于虚无时，她的所有攻击伤害均为魔法伤害，她的物理吸血被视为技能吸血。驱散类型：弱驱散", "description_en": "Muerta transforms, becoming ethereal, gaining bonus base damage and phased movement.Passively allows Muerta to always attack ethereal targets and attack when she is ethereal. When either she or her target is ethereal, all of her attack damage is dealt as magical damage and her physical lifesteal is treated as spell lifesteal.DISPEL TYPE: Basic Dispel", "notes_zh": ["琼英碧灵在变身期间可以躲避弹道。", "琼英碧灵在变身后无法攻击建筑。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "transform_duration", "base_damage_percent", "modelscale", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "muerta_supernatural", "name_zh": "琼英碧灵·超自然", "name_en": "Supernatural", "description_zh": "每当琼英碧灵附近%stack_collection_range%范围内有敌方英雄阵亡，她就会获得一层%spell_amp_per_stack%%%技能增强的叠加效果。琼英碧灵阵亡时，她会失去一半（向下取整）的叠加层数。", "description_en": "Whenever an enemy hero dies within %stack_collection_range% units of Muerta, she gains a stack of %spell_amp_per_stack%%% spell amplification. When Muerta dies she loses half the stacks, rounded down.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["stack_collection_range", "spell_amp_per_stack", "max_stacks"]}, {"subject": "ringmaster_tame_the_beasts", "name_zh": "百戏大王·驯兽术", "name_en": "Tame the Beasts", "description_zh": "持续施法 - 百戏大王卷起他的鞭子，最多持续%abilitychanneltime%秒，然后猛甩出去。被鞭打的敌人会受到伤害，并且被恐惧，逃离百戏大王。持续施法时间会使伤害和恐惧时间成倍增加，但是作用范围减少。", "description_en": "CHANNELED - Ringmaster twirls his whip for up to %abilitychanneltime% second then cracks it. Whipped enemies are damaged and flee in fear from Ringmaster. Channel time exponentially increases damage and extends the fear duration, but reduces the radius.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_width", "end_width", "damage_min", "damage_max", "crack_duration", "max_multiplier", "magic_resist", "has_debuff_immunity", "fear_duration_min", "fear_duration_max", "AbilityCastRange", "AbilityChannelTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ringmaster_the_box", "name_zh": "百戏大王·逃生技", "name_en": "Escape Act", "description_zh": "把一名友方英雄装进可动的异维度箱子。友军被装入后拥有相位移动状态，获得额外魔法抗性、减速抗性和移动速度。并且无法成为目标，被锁闭、沉默和缴械。效果结束后或者移动到初始区域之外箱子都会打开。", "description_en": "Ringmaster packs himself or an allied hero into a mobile, extradimensional box. Boxed units gain phased movement, slow resistance, bonus magic resistance, and bonus movement speed. They are also untargetable, muted, silenced, and disarmed. The box will pop open after the effect expires or it moves out of the initial area.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "逃生技拥有%max_charges%点能量点数。逃生箱打开时会朝所有方向放出尖刀戏匕首，并且范围内所有敌人受到伤害。", "en": "Escape Act has %max_charges% charges. When the box pops open, Impalement Art daggers are thrown in all directions, and all enemies around it take damage."}}, "is_passive": false, "value_names": ["leash_radius", "invis_duration", "move_speed", "magic_resist", "slow_resist", "transform_time", "model_scale_time", "leap_distance", "leap_speed", "leap_acceleration", "strong_dispel", "grant_flying", "max_charges", "launch_daggers_count", "launch_daggers_range"]}, {"subject": "ringmaster_impalement", "name_zh": "百戏大王·尖刀戏", "name_en": "Impalement Arts", "description_zh": "百戏大王向自己精心选择的地点扔出一把匕首。匕首击中敌人会造成即时伤害，短暂减速击中的单位，并且使他们流血。流血的英雄受到基于目标最大生命值一定百分比的每秒伤害，流血的非英雄单位受到每秒固定伤害。", "description_en": "Ringmaster throws one of his daggers to a precise point of his choosing. If he strikes an enemy, the dagger deals impact damage, briefly slows the unit hit, and causes them to bleed. The bleeding deals a percentage of the victim's maximum health in damage every second to heroes and flat damage per second to creeps.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_impact", "bleed_health_pct", "bleed_creep_dps", "bleed_duration", "slow_percent", "slow_duration", "dagger_speed", "dagger_width", "dagger_vision", "tick_interval", "dagger_pass_through", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime"]}, {"subject": "ringmaster_spotlight", "name_zh": "百戏大王·聚光灯", "name_en": "Spotlight", "description_zh": "百戏大王用%spotlight_count%束聚光灯照亮一片区域。灯光下的敌人有几率丢失攻击，隐身状态下也会显形。被光束击中的幻象会逐渐消散，每秒失去一定百分比的最大生命值。这些效果在灯束离开后会粘滞%linger_duration%秒。", "description_en": "Ringmaster shines %spotlight_count% spotlights that sweep over an area. Enemies in the light have a chance to miss their attacks and are revealed if invisible. Illusions hit by the beam fade away, losing a percentage of their maximum health each second. These effects linger for %linger_duration% seconds after leaving the light.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["radius", "illusion_percent_damage", "pulse_interval", "duration", "miss_chance", "initial_speed", "sweep_speed", "sweep_radius", "linger_duration", "spotlight_count", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ringmaster_wheel", "name_zh": "百戏大王·奇观轮", "name_en": "Wheel of Wonder", "description_zh": "百戏大王推出奇观轮向目标地点滚去，击退沿途的敌人。到达目的地后，范围内的敌人会持续受到伤害，并且被减速%aura_slow%%%。敌方英雄面对转轮超过%face_duration%秒会被迷住，朝其走去。首个敌人着迷后会触发转轮爆炸的倒计时。如果没有触发倒计时，在%trap_duration%秒后转轮会自动爆炸。", "description_en": "Ringmaster rolls the Wheel of Wonder to the targeted location, knocking aside enemies along the way. After it reaches its target, enemies in range of the wheel take damage over time and are slowed by %aura_slow%%%.Enemy heroes who face the wheel for more than %face_duration% seconds are mesmerized and drawn towards it. The first enemy to be mesmerized triggers a timer for the wheel to explode. If the timer is not triggered, it will automatically explode after %trap_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["min_range", "mesmerize_radius", "projectile_speed", "trap_duration", "wheel_stun", "face_duration", "aura_tick_interval", "aura_damage", "aura_slow", "explosion_damage", "vision_radius", "tick_rate", "vision_cone", "knockback_radius", "knockback_duration"]}, {"subject": "ringmaster_dark_carnival_souvenirs", "name_zh": "百戏大王·暗黑狂欢主持", "name_en": "Dark Carnival Barker", "description_zh": "只要百戏大王附近%souvenir_collection_range%范围内有敌方英雄阵亡，他就会随机获得一件可用一次的暗黑狂欢纪念品。额外的纪念品会以能量的形式存下。如果百戏大王没有纪念品，阵亡时会获得一件。", "description_en": "Ringmaster receives a random single-use Dark Carnival Souvenir whenever an enemy hero dies within %souvenir_collection_range% units of him. Additional Souvenirs are held as charges.If Ringmaster does not have a Souvenir when he dies he will be granted one.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["souvenir_collection_range", "use_souvenir_set_1"]}, {"subject": "ringmaster_funhouse_mirror", "name_zh": "百戏大王·哈哈镜", "name_en": "Funhouse Mirror", "description_zh": "使用：比例失真制造英雄的%images_count%个不完美幻象，持续%illusion_duration%秒。幻象继承%tooltip_damage_outgoing_ranged%%%攻击力，承受%tooltip_damage_incoming_total_pct%%%伤害。", "description_en": "Use: Proportion DistortionCreates %images_count% imperfect image of your hero that lasts %illusion_duration% seconds. Your illusion deals %tooltip_damage_outgoing_ranged%%% and takes  %tooltip_damage_incoming_total_pct%%% damage.", "notes_zh": ["有%invuln_duration%秒的施法时间，其间处于无敌状态。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["images_count", "illusion_duration", "images_do_damage_percent_melee", "tooltip_damage_outgoing_melee", "images_take_damage_percent", "tooltip_damage_incoming_total_pct", "tooltip_damage_outgoing_ranged", "invuln_duration", "vision_radius", "num_scale_sets", "model_scale_animate_time", "illusion_model_scale_3", "health_bar_offset_1", "health_bar_offset_2", "health_bar_offset_3"]}, {"subject": "ringmaster_strongman_tonic", "name_zh": "百戏大王·强力水", "name_en": "Strongman Tonic", "description_zh": "使用：强力吸收暂时提升友方英雄的力量，数值为%strength_bonus_base% + %strength_bonus_per_level% * 百戏大王等级，持续%duration%秒。效果会维持%effect_strength_max_duration%秒然后在持续时间内不断减弱。", "description_en": "Use: Forcefully ImbibeTemporarily increases an allied hero's Strength by %strength_bonus_base% plus %strength_bonus_per_level% per Ringmaster's level for %duration% seconds. The effect holds for %effect_strength_max_duration% seconds and then deteriorates over the duration.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["projectile_speed", "strength_bonus_base", "strength_bonus_per_level", "model_scale", "model_scale_animate_time", "duration", "effect_strength_max_duration", "AbilityCastRange", "AbilityCharges", "AbilityCooldown"]}, {"subject": "ringmaster_whoopee_cushion", "name_zh": "百戏大王·整蛊垫", "name_en": "Whoopee Cushion", "description_zh": "使用：噗把英雄向前推动%leap_distance%距离。在身后留下一团%fart_cloud_radius%范围的臭云，持续%fart_cloud_duration%秒，使敌人减速%fart_cloud_slow%%%。", "description_en": "Use: WhoopsiePropels your hero forward %leap_distance% units. Leaves a %fart_cloud_radius% radius stink cloud behind for %fart_cloud_duration% seconds that slows enemies by %fart_cloud_slow%%%.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["leap_distance", "leap_speed", "leap_acceleration", "fart_cloud_duration", "fart_cloud_slow", "fart_cloud_aura_linger_duration", "fart_cloud_radius", "AbilityCharges", "AbilityCooldown"]}, {"subject": "ringmaster_summon_unicycle", "name_zh": "百戏大王·独轮车", "name_en": "Unicycle", "description_zh": "使用：上车召唤一辆快速的独轮车并骑上去，持续%mount_duration%秒。上车%damage_grace_period%秒后受到来自敌方英雄的伤害超过%damage_threshold%点会让他下车。撞到树木会将其摧毁，并且独轮车会减速。攻击、使用持续施法类技能或者撞到单位和其他障碍物都会使他下车。", "description_en": "Use: Saddle UpSummons a speedy unicycle to ride around on for %mount_duration% seconds. %damage_grace_period%s after mounting the unicycle, taking damage from enemy hero sources greater than %damage_threshold% dismounts the rider. Crashing into trees destroys them and slows the unicycle. Attacking, using channeled abilities, or crashing into units and other obstacles also dismounts the rider.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["mount_cast_point", "mount_duration", "tree_impact_speed_divisor", "max_speed", "acceleration", "turn_rate_min", "turn_rate_max", "impact_radius", "knockback_distance", "damage_grace_period", "damage_threshold", "AbilityCastPoint", "AbilityCharges", "AbilityCooldown"]}, {"subject": "kez_echo_slash", "name_zh": "凯·回音重斩", "name_en": "Echo Slash", "description_zh": "凯挥舞他的长刀向前沿一条直线斩击%katana_distance%距离，攻击区域内的敌人并施加短暂的%tag_slow%%%减速。经过短暂延迟后，这个区域会被再次攻击。英雄会承受额外伤害。", "description_en": "Kez slashes forward in a %katana_distance% distance line with his Katana, attacking enemies in an area and applying a brief %tag_slow%%% impact slow. After a short delay, the area is attacked again. Heroes take bonus damage.", "notes_zh": ["会摧毁树木。不会继承分裂效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["katana_echo_damage", "echo_hero_damage", "katana_strikes", "strike_interval", "katana_radius", "katana_distance", "travel_distance", "tag_slow", "tag_slow_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_grappling_claw", "name_zh": "凯·制敌爪钩", "name_en": "Grappling Claw", "description_zh": "凯向目标单位或者树木发射一枚抓钩并摆荡过去。抓钩碰到目标后，该单位会被减速。凯到达敌方目标时，落地会发动一次攻击。", "description_en": "Kez swings on a grappling hook towards the target unit or tree.  When the grappling hook collides with the target, that unit has slowed movement speed. Upon reaching the enemy target, Kez lands an attack on them.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["land_distance", "projectile_speed", "grapple_speed", "max_distance_break", "debuff_duration", "katana_ms_slow_pct", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_kazurai_katana", "name_zh": "凯·影武长刀", "name_en": "Kazurai Katana", "description_zh": "长刀的攻击和技能会对敌人施加一个可叠加的持续伤害效果，持续时间内造成原攻击伤害一定百分比的额外伤害。凯可以主动使用技能，刺中目标，阻止他们移动或转身。目标身上的影武长刀效果爆发，使部分叠加数值立刻造成伤害。", "description_en": "Katana attacks and abilities apply a stacking damage over time to enemies that deals a percentage of the original attack's damage as additional damage over time. Kez may activate the ability to impale the target with his attack, preventing them from moving or turning. The target's Katana debuff bursts, causing some of the stacks to deal damage instantly.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "刺中后凯能从当次攻击吸血%lifesteal_pct%%%。如果从背后刺中目标，目标会被眩晕。提升最大爆发叠加数值。", "en": "Kez lifesteals %lifesteal_pct%%% from the impale. If the impale comes from behind the target, the target is stunned. Increases max burst stacks."}}, "is_passive": false, "value_names": ["katana_bleed_duration", "katana_bleed_attack_damage_pct", "impale_duration", "bleed_as_rupture_pct", "lifesteal_pct", "creep_lifesteal_reduction_pct", "max_stacks", "backstab_angle", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_switch_weapons", "name_zh": "凯·流派变换", "name_en": "Switch Discipline", "description_zh": "凯可以在影武长刀和翔影双钗之间变换。基于装备的武器，他会获得不同的攻击特性和技能。技能会一起升级，而且使用后，相对的武器技能也会进入冷却。凯切换到长刀后第一次长刀攻击或技能会造成额外伤害，切换到双钗后会获得额外移动速度。", "description_en": "Kez switches between his Kazurai Katana and Shodo Sai.He gains different attack capabilities and abilities based on the weapon equipped. The abilities level up together, and when an ability is used, the associated alternate weapon ability also goes on cooldown.Kez deals extra damage on the first Katana hit or ability after switching to Katana, and gains bonus speed after switching to Sai.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "在使用流派变换后%scepter_cooldown_timer%秒内施放的第一个技能不会使相对的武器技能进入冷却，或者已进入冷却的技能会结束冷却。施放任何武器的技能都会重置流派变换的冷却时间。", "en": "Casting a weapon ability that would set its alternate weapon ability on cooldown does not do so if it's the first one used within %scepter_cooldown_timer% seconds after casting Switch Discipline or if it was already on cooldown.Casting any weapon ability refreshes the cooldown of Switch Discipline."}}, "is_passive": false, "value_names": ["katana_attack_range", "katana_base_attack_time", "katana_agility_bonus_base_damage", "katana_swap_bonus_damage", "sai_attack_range", "sai_base_attack_time", "sai_swap_bonus_movement_speed", "sai_swap_duration", "scepter_cooldown_timer", "AbilityCooldown"]}, {"subject": "kez_raptor_dance", "name_zh": "凯·猛禽之舞", "name_en": "Raptor Dance", "description_zh": "凯进入不可控制的状态，持续%AbilityCastPoint%秒，%invuln_period%秒为无敌状态并获得一次弱驱散效果。如果施法成功完成，凯会对周围发动致命的辐射状斩击，基于目标的最大生命值造成伤害，并且造成伤害的一定百分比会治疗凯。", "description_en": "Kez enters into an uncontrollable state for %AbilityCastPoint% second, becoming invulnerable for %invuln_period%s and receiving a basic dispel.If the cast completes successfully, Kez performs a series of deadly radial slashes around him that deal damage based on the max health of the target and heal Kez for a percentage of all damage dealt.", "notes_zh": ["斩击非英雄单位或幻象时吸血量减少至%illusion_lifesteal_pct%%%。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["strike_interval", "strikes", "radius", "base_damage", "max_health_damage_pct", "lifesteal_pct", "illusion_lifesteal_pct", "invuln_period", "basic_dispel", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_falcon_rush", "name_zh": "凯·天隼冲击", "name_en": "Falcon Rush", "description_zh": "开启后凯可以向敌方目标冲去，发动的攻击会重复一次。在这个状态下，凯拥有相位移动状态和减速抗性。", "description_en": "Kez gains the ability to rush towards enemy targets to deliver echoing secondary attacks.  While in this state, Kez has phased collision and slow resistance.", "notes_zh": ["不会对建筑生效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["rush_range", "rush_speed", "base_echo_damage", "slow_resist", "duration", "break_range", "bonus_attack_speed", "echo_proc_chance_reduction", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_talon_toss", "name_zh": "凯·利爪飞掷", "name_en": "Talon Toss", "description_zh": "凯向目标单位掷出一把钗，施加一次固定伤害的攻击，并造成沉默。", "description_en": "Kez throws a Sai at the target unit, applying a fixed damage attack and silence.", "notes_zh": ["固定伤害的攻击具有克敌机先效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "speed", "silence_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "kez_shodo_sai", "name_zh": "凯·翔影之钗", "name_en": "Shodo Sai", "description_zh": "装备双钗时凯的攻击有几率对敌人造成致命一击。凯可以主动开启技能，使自身被缴械，面朝方向被锁定，招架来自目标方向的攻击和攻击效果，持续%parry_duration%秒。如果有敌方英雄的攻击被招架，该英雄会被眩晕%parry_stun_duration%秒并获得印记，拥有印记的目标被凯攻击时必定会造成致命一击，并且被眩晕。子技能可以用于提前取消招架状态。", "description_en": "Kez has a chance to critically strike the target when attacking with Sais.Kez may activate the ability to disarm himself, lock his facing, and parry attacks and attack effects from the targeted direction for %parry_duration% seconds. If an attack is parried from an enemy Hero in this way, that Hero is stunned for %parry_stun_duration%s and gains a Mark.  When a Marked target is attacked by Kez, it will guarantee a critical strike and stun the target.The sub-ability may be used to cancel the blocking early.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "招架会产生更强的印记，造成额外眩晕和致命一击伤害。", "en": "Parrying creates a stronger Mark that deals additional stun and critical damage."}}, "is_passive": false, "value_names": ["sai_proc_vuln_chance", "base_crit_pct", "stun_duration", "vuln_duration", "forward_angle", "speed_penalty", "parry_duration", "parry_bonus_crit", "parry_bonus_stun_duration", "parry_stun_duration", "parry_only_heroes", "AbilityManaCost", "AbilityCooldown"]}]
