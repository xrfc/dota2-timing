[{"subject": "meepo_earthbind", "name_zh": "米波·地之束缚", "name_en": "Earthbind", "description_zh": "向目标地点扔出一张网，缠绕区域内所有敌方单位。", "description_en": "Tosses a net at the target point, rooting down all enemy units in an area around it.", "notes_zh": ["地之束缚可以使敌方单位在进入隐身后显形，但是不能作用于已经隐身的单位。", "对减益免疫单位和肉山无效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "radius", "speed", "megameepo_net_offset", "true_strike", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "meepo_poof", "name_zh": "米波·忽悠", "name_en": "Poof", "description_zh": "通过从大地中汲取神秘的能量，一个米波可以在持续施法%cast_duration%秒后传送至另一个米波或自身所在之处，在离开和到达的区域都对敌人造成伤害。如果技能设为多样施法（右键点击技能栏图标）状态，所有米波也会对目标施放忽悠。对地施放后，除了选中的米波外所有米波会忽悠至最近的地点。", "description_en": "Drawing mystical energies from the earth, a Meepo can teleport to another Meepo or itself after channeling for %cast_duration% seconds, damaging the enemy in both the departure and arrival locations. If the ability is in alt-cast state, all Meepos will also cast Poof to the target. When cast on the ground, all Meepos except the selected one will Poof to the closest location.", "notes_zh": ["可以点击小地图施放。", "可以传送至米波的幻象。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["cast_duration", "radius", "poof_damage", "megameepo_poof_scaling", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "meepo_ransack", "name_zh": "米波·洗劫", "name_en": "Ransack", "description_zh": "每次攻击都会窃取敌人的生命值，并治疗所有其他米波相同数值生命。对非英雄单位的效果减少至60%。", "description_en": "Steals health from the enemy with each strike and heals all other Meepos for that amount.Reduced to 60% against creeps.", "notes_zh": ["治疗数值会被生命回复增强效果提升。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["health_steal_heroes"]}, {"subject": "meepo_petrify", "name_zh": "米波·掘地", "name_en": "Dig", "description_zh": "挖掘进入地下，对自身施加驱散效果，无敌且不能作为目标，持续%duration%秒。持续时间内回复最大生命值的%hp_restore%%%。被缠绕时无法施放。驱散类型：弱驱散", "description_en": "Digs into the ground for a short duration, dispelling Meepo and causing him to become invulnerable and untargetable for %duration%s. Restores %hp_restore%%% of his max health over that duration.DISPEL TYPE: Basic Dispel", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["duration", "hp_restore", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "meepo_megameepo", "name_zh": "米波·超大米波", "name_en": "MegaMeepo", "description_zh": "主米波将%radius%范围内其他米波放到自己的肩膀上。在这个形态下，他会获得其他米波%stats_pct%%%的属性，并且可以把他们扔向敌人，造成伤害和减速。\n\n生效时地之束缚会产生额外的网，身上每只米波都会使忽悠造成额外%poof_damage_factor%%%伤害。", "description_en": "Primary Meepo mounts all other Meepos in a %radius% radius around him on top of his shoulders. While in this form, he gains %stats_pct%%% of the other Meepo stats and can Fling them at enemies, dealing damage and slowing them.\n\n When cast, Earthbind generates additional nets and Poof deals %poof_damage_factor%%% more damage for each Meepo on top.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "damage_distribution_duration", "end_knockback_duration", "end_knockback_distance", "stats_pct", "poof_damage_factor", "AbilityCooldown"]}, {"subject": "meepo_divided_we_stand", "name_zh": "米波·分则能成", "name_en": "Divided We Stand", "description_zh": "米波再召唤出一个米波，可以跟随米波本体升级并共用物品。技能的冷却时间相互独立，但是物品的冷却时间在米波之间共用，回城卷轴除外。来自物品的攻击力、攻击速度、生命值、魔法值、恢复效果、法力损毁和触发几率会根据米波数量均分，在每只身上的效果减少%dps_penalty_pct%%%。任意米波阵亡都会导致所有米波全体死亡。", "description_en": "Meepo summons another Meepo, which levels up and shares items and experience with the main Meepo. Ability cooldowns are independent, but items share cooldowns between Meepos, except Teleport Scrolls. Damage, attack speed, health, mana, regeneration, mana burn, and proc chance bonuses from items are distributed equally among the amount of Meepos, making them %dps_penalty_pct%%% less effective.If any Meepo dies, they all die.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["tooltip_clones", "required_level", "levels_between_upgrades", "max_level", "dps_penalty_pct"]}, {"subject": "meepo_geomancy", "name_zh": "米波·地卜术", "name_en": "Geomancy", "description_zh": "米波会根据所在地形给予自身和克隆体可叠加的加成效果。每个米波都会给予其他米波自身的加成。如果%tree_radius%范围内有树木，他会获得%tree_regen%点/秒生命恢复。如果他站在土地上，他会获得%dirt_move_speed%%%移动速度加成。如果他在水中，他的攻击会减缓目标%water_move_slow%%%移速，持续%water_slow_duration%秒。", "description_en": "Meepo grants stacking bonuses to himself and his clones based on their terrain.  Each Meepo grants his bonus to the other Meepos.If there is a tree within %tree_radius% range, he receives %tree_regen% HP regen.If he is standing on dirt, he receives %dirt_move_speed%%% bonus movement speed.If he is in the water, his attacks slow the target by %water_move_slow%%% for %water_slow_duration% seconds.", "notes_zh": ["土地包括所有水之外的地形。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["tree_radius", "tree_regen", "dirt_move_speed", "water_move_slow", "water_slow_duration"]}, {"subject": "meepo_megameepo_fling", "name_zh": "米波·超大米波摔扔", "name_en": "MegaMeepo Fling", "description_zh": "在超大米波形态下，米波将最上端的米波向%AbilityCastRange%范围内目标扔出，造成伤害和减速。", "description_en": "In MegaMeepo form, Meepo flings the topmost meepo towards a target within a %AbilityCastRange% range, dealing damage and slowing their movement speed.", "notes_zh": ["不会触发法术反弹。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["fling_damage", "fling_radius", "fling_movespeed", "fling_slow_duration", "movement_slow", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "treant_natures_grasp", "name_zh": "树精卫士·自然卷握", "name_en": "Nature's Grasp", "description_zh": "朝目标地点制造藤蔓。藤蔓对穿过的敌人造成减速和伤害。对非英雄单位造成的伤害减少%creep_penalty%%%。", "description_en": "Creates vines towards the target location. Vines slow down and deal damage to enemies that walk through. Does %creep_penalty%%% less damage to creeps.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "creep_penalty", "movement_slow", "vines_duration", "creation_interval", "initial_latch_delay", "vine_spawn_interval", "latch_range", "latch_vision", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "treant_leech_seed", "name_zh": "树精卫士·寄生种子", "name_en": "Leech Seed", "description_zh": "树精卫士的攻击会对敌方单位种下一颗吸取生命的种子。该单位会受到额外魔法伤害，被缠绕和缴械一小段时间，并放出%healing_pulse_count%次治疗脉冲，最多对附近%max_heal_units%名友军根据当次攻击造成的伤害进行治疗。", "description_en": "Treant's attack plants a life-sapping seed in an enemy unit. That unit takes additional magic damage, is rooted and disarmed for a short duration, and emits %healing_pulse_count% healing pulses to up to %max_heal_units% nearby allies of Treant Protector based on the damage dealt by the attack.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "flat_heal", "leech_heal", "leech_damage", "max_heal_units", "radius", "healing_pulse_count", "projectile_speed", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "treant_living_armor", "name_zh": "树精卫士·活体护甲", "name_en": "Living Armor", "description_zh": "将目标英雄或建筑笼罩在保护性外壳中，治疗目标并格挡来自玩家控制来源的伤害。每次本技能格挡伤害后，下次的伤害格挡量都会减少。如果伤害格挡量降至0，加成效果会提前移除。", "description_en": "Infuses the target hero or structure with a protective coating which heals the target and blocks damage from player-controlled sources. Each time this spell blocks damage, the block amount is decreased. If the damage block is decreased to 0, the buff is removed early.", "notes_zh": ["低于%damage_block_threshold%点的伤害会被无视。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["heal_per_second", "duration", "aoe_radius", "damage_block_base", "passive_reset_cd", "damage_block_loss", "damage_block_threshold", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "treant_eyes_in_the_forest", "name_zh": "树精卫士·丛林之眼", "name_en": "Eyes In The Forest", "description_zh": "树精卫士对目标树木灌注魔力。注魔后树木将拥有周围的顺畅视野。树眼持续%duration%秒，为隐形状态，但是寄生的树木被摧毁或者树眼直接被攻击后都会被摧毁。", "description_en": "Treant Protector enchants a tree, which grants him unobstructed vision in that location. The eyes last for %duration% seconds and are invisible, but are destroyed if their host tree is destroyed or if they are attacked directly.", "notes_zh": ["丛林之眼的树木产生的疯狂生长效果也可以造成伤害。", "如果敌人拥有真实视域，他们将会发现被灌注魔力的树木。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["vision_aoe", "hits_to_kill", "duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"]}, {"subject": "treant_natures_guise", "name_zh": "树精卫士·自然蔽护", "name_en": "Nature's Guise", "description_zh": "只要靠近树木就会获得移动速度加成。树精卫士在%cooldown_time%秒内不受到伤害就会额外获得树木穿行。树木穿行时，自然蔽护可以主动使用，使树精卫士获得隐身状态，直到他主动攻击，或不再靠近树木。", "description_en": "Grants bonus movement speed when near trees. Treant Protector additionally has Tree Walking if he has not taken damage for %cooldown_time% seconds. While Tree Walking, Nature's Guise can be activated to grant Treant invisibility until he attacks or is no longer near a tree.", "notes_zh": ["自然蔽护效果下树精卫士可以直接穿过树木。", "自然卷握的藤蔓在这个技能下被视为树木。", "树木穿行时，受到伤害并不会禁用主动效果或树木穿行。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "grace_time", "cooldown_time", "movement_bonus", "AbilityCooldown"]}, {"subject": "treant_overgrowth", "name_zh": "树精卫士·疯狂生长", "name_en": "Overgrowth", "description_zh": "在树精卫士周围召唤出疯狂生长的伤害性藤条和枝干，造成伤害并且阻止被缠绕的敌人移动、闪烁、进入隐身或攻击。", "description_en": "Summons an overgrowth of vines and branches around Treant that deal damage to afflicted enemies and prevent them from moving, blinking, going invisible, or attacking.", "notes_zh": ["效果无视减益免疫，但是在期间获得减益免疫状态将挣脱控制。"], "granted_by": "", "upgrades": {"scepter": {"zh": "冷却时间降低至%AbilityCooldown%秒。施放疯狂生长时，树精卫士从土壤中汲取力量，他的身体急剧增大，持续%bloom_duration%秒。变大后他会获得相位移动状态，移动速度为固定%movement_speed%，%strength_bonus%%%力量加成，并且拥有在%splash_radius%范围内造成%splash_pct%%%攻击伤害的溅射攻击。", "en": "Decreases Cooldown to %AbilityCooldown% seconds. When casting Overgrowth, Treant Protector draws power from the soil, greatly increasing his size for %bloom_duration% seconds. While enlarged, he gains phased movement with a fixed speed of %movement_speed%, %strength_bonus%%% bonus Strength, and a splashing attack that deals %splash_pct%%% of his attack damage in a %splash_radius% unit radius."}}, "is_passive": false, "value_names": ["duration", "radius", "damage", "bloom_duration", "strength_bonus", "splash_pct", "splash_radius", "movement_speed", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_fireblast", "name_zh": "食人魔魔法师·火焰爆轰", "name_en": "Fireblast", "description_zh": "以一波火焰轰击一个敌方单位，造成伤害并使目标眩晕。", "description_en": "Blasts an enemy unit with a wave of fire, dealing damage and stunning the target.", "notes_zh": ["触发多重施法时，两次火焰爆轰之间有%multicast_delay%秒的间隔。"], "granted_by": "", "upgrades": {"scepter": {"zh": "很精通的火焰爆轰，冷却时间减少%bonus_AbilityCooldown%秒，施法速度提升%bonus_cast_speed%%%。", "en": "Fireblast is refined, reducing cooldown by %bonus_AbilityCooldown%s and increasing cast speed by %bonus_cast_speed%%%."}}, "is_passive": false, "value_names": ["stun_duration", "multicast_delay", "fireblast_damage", "fireblast_proc", "bonus_cast_speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_ignite", "name_zh": "食人魔魔法师·引燃", "name_en": "Ignite", "description_zh": "使目标和另一个随机单位浸透在挥发性化学物质中，导致其瞬间被火焰吞噬。目标处在极度痛苦之中，受到伤害并且移动缓慢。", "description_en": "Drenches the target and another random unit in volatile chemicals, causing it to burst into flames. The target is in immense pain, taking damage and moving more slowly.", "notes_zh": ["多重施法将使此技能有几率对%ignite_multicast_aoe%范围内的随机敌方单位进行多次施放。", "引燃现在击中已受到作用的单位后会增加持续时间。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "burn_damage", "slow_movement_speed_pct", "projectile_speed", "multicast_delay", "ignite_multicast_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_bloodlust", "name_zh": "食人魔魔法师·嗜血术", "name_en": "Bloodlust", "description_zh": "激起一个友方单位的狂暴，增加其移动和攻击速度。对食人魔魔法师自身施放时攻击速度加成更高。可以对防御塔施放。", "description_en": "Incites a frenzy in a friendly unit, increasing its movement speed and attack speed. Gives bonus attack speed if cast on Ogre himself. Can be cast on towers.", "notes_zh": ["触发多重施法时，%multicast_bloodlust_aoe%范围内的友方单位将随机获得嗜血术效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["modelscale", "bonus_movement_speed", "bonus_attack_speed", "self_bonus", "duration", "multicast_bloodlust_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_unrefined_fireblast", "name_zh": "食人魔魔法师·未精通的火焰爆轰", "name_en": "Unrefined Fireblast", "description_zh": "操控一波火焰轰击一个敌方单位，造成%base_damage% + %str_multiplier%倍食人魔力量的伤害并使目标眩晕。魔法消耗为食人魔魔法师当前魔法的%scepter_mana%%%。", "description_en": "Blasts an enemy unit with a wave of fire, dealing %base_damage% + %str_multiplier%x Ogre's Strength in damage and stunning the target. Its mana cost is %scepter_mana%%% of Ogre Magi's current mana.", "notes_zh": ["触发多重施法时，两次火焰爆轰之间有%multicast_delay%秒的间隔。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["stun_duration", "multicast_delay", "scepter_mana", "base_damage", "str_multiplier", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_smash", "name_zh": "食人魔魔法师·烈火护盾", "name_en": "Fire Shield", "description_zh": "创造一个围绕友军目标的护盾，吸收接下来%attacks%次来自敌方英雄攻击的一定百分比伤害。吸收伤害后向攻击者发射火球。可以对防御塔施放。", "description_en": "Creates a shield around the target ally, absorbing a percentage of the damage of next %attacks% attacks from enemy heroes. When damage is absorbed, a fireball is launched at the attacker. Can be cast on towers.", "notes_zh": ["触发多重施法时，%multicast_fireshield_aoe%范围内的友方单位将随机获得烈火护盾效果。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["damage", "attacks", "duration", "multicast_fireshield_aoe", "projectile_speed", "damage_absorb_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_dumb_luck", "name_zh": "食人魔魔法师·傻福", "name_en": "Dumb Luck", "description_zh": "食人魔魔法师的智力值上限为0。他通过力量来获得魔法和魔法恢复。", "description_en": "Ogre Magi's max Intelligence is 0. He receives mana and mana regeneration from Strength.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["mana_per_str", "mana_regen_per_str", "level_one_ability_points", "level_two_ability_points", "required_level_reduction"]}, {"subject": "ogre_magi_multicast", "name_zh": "食人魔魔法师·多重施法", "name_en": "Multicast", "description_zh": "使食人魔魔法师在单次施法中有概率多次施放同一技能和物品。每%strength_for_one_pct%点力量提升%one_tooltip%%%多重施法几率。", "description_en": "Enables Ogre Magi to cast his abilities and items multiple times with each use. Each point of Strength adds to Multicast chance. Every %strength_for_one_pct% Strength adds %one_tooltip%%%.", "notes_zh": ["只有指向性技能和物品有几率触发多重施法。", "指向性技能和物品额外对食人魔周围一定作用范围内敌人和中立生物生效。火焰爆轰和未精通的火焰爆轰将对同个目标生效多次。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["multicast_2_times", "multicast_3_times", "multicast_4_times", "strength_for_one_pct", "one_tooltip"]}, {"subject": "undying_decay", "name_zh": "不朽尸王·腐朽", "name_en": "Decay", "description_zh": "不朽尸王偷取区域内所有敌方英雄的力量，造成基础伤害并将敌人的力量据为己有。对非英雄单位造成%creep_damage_multiplier%倍伤害。", "description_en": "Undying steals strength from all enemy heroes in an area, dealing base damage as he claims the enemy's strength for himself. Deals %creep_damage_multiplier%x damage to creeps.", "notes_zh": ["窃据的力量可以叠加，但是敌方英雄的力量至少为1点。", "力量的窃取先于技能造成的伤害。", "可以作用隐形单位。"], "granted_by": "", "upgrades": {"scepter": {"zh": "提升力量窃取。", "en": "Increases strength steal."}}, "is_passive": false, "value_names": ["decay_damage", "str_steal", "decay_duration", "radius", "str_scale_up", "creep_damage_multiplier", "shard_buff_duration", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "undying_soul_rip", "name_zh": "不朽尸王·噬魂", "name_en": "Soul Rip", "description_zh": "不朽尸王从附近的所有单位身上扯出生命力，并使用它治疗队友或伤害敌人。可以使用噬魂治疗墓碑。", "description_en": "Undying rips health away from all nearby units and uses it to heal an ally, or damage an enemy. Soul Rip can also be used to heal Tombstone.", "notes_zh": ["可以治疗墓碑，但是不能治疗或伤害其他建筑。", "不会扯出隐身单位、无敌单位、战争迷雾内单位或减益免疫敌人的生命力。", "可以扯出减益免疫友军，包括僵尸的生命力。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_unit", "max_units", "radius", "tombstone_heal", "strength_share_percent", "strength_share_duration", "strength_share_model_scale", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "undying_tombstone", "name_zh": "不朽尸王·墓碑", "name_en": "Tombstone", "description_zh": "在目标位置召唤一座墓碑。墓碑会不断在其附近的每个敌方单位身边产生僵尸攻击他们。僵尸拥有死亡渴望技能，使他们的攻击带有减速效果，并且若目标的生命值低于一定百分比，僵尸的攻击和移动速度会提升。", "description_en": "Summons a tombstone at the target point.  Zombies will frequently spawn next to every enemy unit in the area around the Tombstone, and attack them.  Zombies have the Deathlust ability, which causes their attacks to slow the target, and if the target reaches below a certain amount of health, increases the attack and movement speed of the zombie.", "notes_zh": ["墓碑免疫技能，但是可以被噬魂治疗。", "僵尸和墓碑均免疫技能。", "如果初始目标死亡或丢失视野，僵尸将会死亡。"], "granted_by": "", "upgrades": {"shard": {"zh": "墓碑可以对友方英雄施放，让他们躲进墓碑。进入墓碑的英雄%tombstone_bunker_cd%秒内无法离开，离开后同样的时间内无法再次进入。如果英雄在内时墓碑被摧毁，该英雄会被眩晕%tombstone_stun_penalty%秒。", "en": "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."}}, "is_passive": false, "value_names": ["tombstone_health", "hits_to_destroy_tooltip", "duration", "radius", "health_threshold_pct_tooltip", "zombie_interval", "zombie_damage_tooltip", "zombie_bonus_damage", "zombie_health", "bunker_units", "tombstone_grab_radius", "tombstone_bunker_cd", "tombstone_stun_penalty", "AbilityCastRange", "AbilityCastPoint"]}, {"subject": "undying_ceaseless_dirge", "name_zh": "不朽尸王·挽歌犹唱", "name_en": "Ceaseless Dirge", "description_zh": "不朽尸王阵亡时会立刻在泉水复活。比赛开始时处于冷却状态。无法被刷新。", "description_en": "When Undying dies he will instantly respawn in the fountain. Begins the game on cooldown. Cannot be refreshed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["respawn_delay", "AbilityCooldown"]}]
