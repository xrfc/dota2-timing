[{"subject": "jakiro_macropyre", "name_zh": "杰奇洛·烈焰焚身", "name_en": "Macropyre", "description_zh": "杰奇洛释放出烈焰风暴，烈焰风暴作用范围很宽，并持续数秒。烈焰风暴每秒都会对作用范围内的敌人造成伤害。", "description_en": "Jakiro exhales a wide line of lasting flames, which deals damage per second to any enemy units caught in the fire.", "notes_zh": ["被烈焰焚身击中后离开区域还将额外受到%linger_duration%秒伤害效果。"], "granted_by": "", "upgrades": {"scepter": {"zh": "提升烈焰焚身的持续时间，并且变为纯粹伤害。杰奇洛会在烈焰焚身边缘放出两道冰墙，对试图穿过的所有敌人减速%ice_edge_movement_slow%%%。", "en": "Increases Macropyre duration and causes it to deal Pure damage. Jakiro emits two walls of ice along the edges of the Macropyre that slow any enemies trying to cross them by %ice_edge_movement_slow%%%."}}, "is_passive": false, "value_names": ["damage", "path_width", "duration", "burn_interval", "linger_duration", "pure_damage_type", "pierces_magic_immunity", "ice_edge_path_radius", "ice_edge_path_offset", "ice_edge_linger_duration", "ice_edge_movement_slow", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "batrider_sticky_napalm", "name_zh": "蝙蝠骑士·粘性燃油", "name_en": "Sticky Napalm", "description_zh": "用粘性油浸透一块区域，蝙蝠骑士的攻击和技能对敌人造成额外伤害，并降低他们的移动速度和转身速率。再次施法可以继续提高伤害，最多叠加%max_stacks%次。每次施放还会造成少量伤害。", "description_en": "Drenches an area in sticky oil, amplifying damage from Batrider's attacks and abilities and slowing the movement speed and turn rate of enemies. Additional casts of Sticky Napalm continue to increase damage, up to %max_stacks% stacks. Applies a small amount of damage with each cast.", "notes_zh": ["所有来自蝙蝠骑士的伤害均会加深，辉耀，淬毒之珠，影之灵龛和魂之灵瓮除外。", "粘性燃油无需转身即可施放。", "粘性燃油对非英雄单位造成%creep_damage_pct%%%伤害。"], "granted_by": "", "upgrades": {"shard": {"zh": "粘性燃油不再具有叠加上限。粘性燃油会对建筑造成伤害。", "en": "Sticky Napalm no longer has a stack limit.Sticky Napalm deals damage to structures."}}, "is_passive": false, "value_names": ["max_level", "max_level_tooltip", "stacks_per_cast", "damage", "radius", "duration", "movement_speed_pct", "turn_rate_pct", "max_stacks", "unlimited_stacks", "creep_damage_pct", "application_damage", "building_damage_pct", "napalm_stacks_on_attack", "napalm_stacks_on_attack_tooltip"]}, {"subject": "batrider_flamebreak", "name_zh": "蝙蝠骑士·烈焰破击", "name_en": "Flamebreak", "description_zh": "投掷一瓶爆炸性的混合物，到达目标地点时爆炸，击退区域内的敌人并造成减速和持续伤害。", "description_en": "Hurls an explosive cocktail that explodes when it reaches the target location, knocking back, slowing and dealing damage over time to enemies in the area.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_impact", "damage_per_second", "damage_duration", "explosion_radius", "collision_radius", "stun_duration", "speed", "knockback_distance", "knockback_height", "knockback_duration", "napalm_stacks", "slow", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "batrider_firefly", "name_zh": "蝙蝠骑士·火焰飞行", "name_en": "Firefly", "description_zh": "蝙蝠骑士飞向天空，从空中留下一道燃烧的尾迹。飞行时，燃烧尾迹会破坏树木，对经过的敌人造成伤害。在火焰飞行持续时间的最后会达到最高移动速度加成。", "description_en": "Batrider takes to the skies, moving increasingly fast and laying down a trail of flames from the air. The fire damages any enemies it touches and destroys trees below Batrider. Maximum movement speed bonus is reached at the end of Firefly's duration.", "notes_zh": ["火焰飞行期间蝙蝠骑士可以飞越任何单位，树木和不可通行的地形。", "如果蝙蝠骑士在持续时间结束时正好在不可通行的地形上方，那么他将会卡住。", "蝙蝠骑士死亡后火焰效果将继续存在。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "radius", "duration", "tick_interval", "tree_radius", "movement_speed_pct_total", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "batrider_smoldering_resin", "name_zh": "蝙蝠骑士·闷烧树脂", "name_en": "Smoldering Resin", "description_zh": "蝙蝠骑士的攻击会施加一个负面效果，每%tick_rate%秒造成%tick_attack_damage_pct%%%攻击伤害，持续%total_ticks%秒。", "description_en": "Batrider's attacks apply a debuff that deals %tick_attack_damage_pct%%% of the attack damage every %tick_rate%s for %total_ticks%s.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["total_ticks", "tick_rate", "tick_attack_damage_pct"]}, {"subject": "batrider_flaming_lasso", "name_zh": "蝙蝠骑士·燃烧枷锁", "name_en": "Flaming Lasso", "description_zh": "用枷锁捆住一个敌人，在蝙蝠骑士的后面拖行。被拖行的单位不能移动、攻击或使用技能。传送或闪烁会打破枷锁。", "description_en": "Lassoes an enemy and drags them in Batrider's wake. Dragged units cannot move, attack, or use abilities.  Teleporting or blinking will break the lasso.", "notes_zh": ["杀死目标或蝙蝠骑士都能在技能结束前打破枷锁。", "如果蝙蝠骑士在0.05秒内移动距离超过425码枷锁将会断裂。", "蝙蝠骑士在使用燃烧枷锁时不能攻击。"], "granted_by": "", "upgrades": {"scepter": {"zh": "燃烧枷锁除了抓取目标外，还能抓取目标附近%grab_radius_scepter%范围内最近的友方英雄。第二目标将与第一目标相连。", "en": "Flaming Lasso grabs both its target, as well as the target's nearest allied hero within %grab_radius_scepter% units. The secondary target is tethered to the first."}}, "is_passive": false, "value_names": ["duration", "drag_distance", "break_distance", "damage", "grab_radius_scepter", "tick_rate", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chen_penitence", "name_zh": "陈·赎罪", "name_en": "Penitence", "description_zh": "对敌方单位造成伤害，并使其移动变慢，友军攻击他时攻速提升。", "description_en": "Damages enemy unit, forces it to move slower and lets allies attack it more quickly.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "speed", "bonus_movement_speed", "bonus_attack_speed", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chen_holy_persuasion", "name_zh": "陈·神圣劝化", "name_en": "Holy Persuasion", "description_zh": "陈控制住敌方小兵或者中立生物，并获得击杀金钱一定百分比的金钱。被劝化目标的最大生命值会被设为%health_min%。被劝化的单位将提升移动速度和伤害输出。陈自己的单位如果在%unsummon_time%秒内未受到伤害可以在全地图范围内成为技能的目标，施放后取消劝化。", "description_en": "Chen takes control of an enemy or neutral creep and receives a percentage of its bounty. Its maximum health is set to %health_min%. Converted creeps will have increased movement speed and bonus damage. Chen may globally target his own creep if it has not taken damage in the last %unsummon_time% seconds to unsummon it.", "notes_zh": ["如果达到劝化生物的数量上限后再劝化生物，最早劝化的单位将立即死亡。", "拥有阿哈利姆魔晶后可以对远古中立生物施放本技能。", "升级此技能后在升级前劝化的单位并不会增加生命值。", "劝化时单位的魔法恢复至满魔。"], "granted_by": "", "upgrades": {"shard": {"zh": "神圣劝化可以对远古中立生物施放。根据上帝之手等级可以控制最多1/2/3个远古生物。使中立生物的部分技能额外升1级。", "en": "Allows Holy Persuasion to target Ancient creeps. Can control up to 1/2/3 Ancient creeps based on Hand of God's level. Additionally levels up some abilities of creeps by 1 level."}}, "is_passive": false, "value_names": ["max_units", "level_req", "health_min", "gold_pct", "movement_speed_bonus", "damage_bonus", "creep_ability_level", "unsummon_time", "unsummon_cooldown_reduction", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chen_divine_favor", "name_zh": "陈·神力恩泽", "name_en": "Divine Favor", "description_zh": "被动提供光环，提供生命恢复加成。可以主动对友军施放，提供护甲加成，以及治疗和生命恢复增强。\n\n对陈施放后，陈控制的所有单位都会获得增益效果。", "description_en": "Passively provides an aura that grants increased health regeneration. Can be cast on allies to provide them with bonus armor and increasing the healing and health regeneration they receive.\n\nIf cast on Chen, all units controlled by Chen receive the buff.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["heal_rate", "aura_radius", "duration", "bonus_armor", "heal_amp", "creep_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chen_zealot", "name_zh": "陈·狂热者", "name_en": "Zealot", "description_zh": "陈复活时都会带着一个狂热者加入战斗，这是近战小兵战士，可以牺牲自己治疗友军，或者对敌人造成伤害。狂热者会获得神圣劝化的加成效果，并且和其他线上近战小兵一样随着游戏时间的增加提升属性，获得额外基础攻击力。狂热者会在陈身边复活。狂热者技能可以主动使用，在%teleport_delay%秒延迟后把控制下的目标单位传送到陈的身边。如果陈是技能的目标，将传送控制的所有单位。受到来自敌方英雄及其单位的伤害会中止传送过程。", "description_en": "Whenever Chen respawns, he is joined by a Zealot, a melee warrior creep with the ability to sacrifice itself to heal or deal damage to an enemy.  The Zealot receives Holy Persuasion's benefits and scales up with other lane melee creeps as game time increases and gains extra base damage.  The Zealot respawns next to Chen.Zealot may be activated to teleport a unit under your control to Chen after a %teleport_delay% second delay.  If Chen is targeted, it will teleport all units you control. Taking damage from enemy heroes or their units will cancel the teleport.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["zealots", "zealot_respawn_time", "damage", "bonus_hp", "teleport_delay", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chen_hand_of_god", "name_zh": "陈·上帝之手", "name_en": "Hand of God", "description_zh": "治疗地图上的所有友军英雄以及陈控制的所有单位。一开始先施加高额治疗，在之后%hot_duration%秒内持续进行小额治疗。", "description_en": "Heals all allied heroes on the map as well as all units under Chen's control. A large heal is applied at first and a slow heal over time is applied for %hot_duration% seconds afterwards.", "notes_zh": ["可以治疗无敌和被隐藏/放逐友军。"], "granted_by": "", "upgrades": {"scepter": {"zh": "上帝之手的冷却时间降低至%AbilityCooldown%秒，并且变为持续施法型技能，持续最多%AbilityChannelTime%秒。初始治疗会在持续施法起始时发生，持续施法期间其他附近友方单位变为减益免疫状态，拥有%debuff_immune_resist%%%魔法抗性，而且持续治疗的威力提升%nearby_hot_boost%%%。", "en": "Decreases the cooldown of Hand of God to %AbilityCooldown%s and it becomes a channelled spell that lasts for up to %AbilityChannelTime% seconds. The initial heal happens at the start of the channel, and while channeling other nearby allied units become debuff immune with %debuff_immune_resist%%% magic resistance and the power of the heal over time is increased by %nearby_hot_boost%%%."}}, "is_passive": false, "value_names": ["heal_amount", "hot_duration", "heal_per_second", "ancient_creeps_scepter", "does_purge", "full_heal_on_chen_and_creeps", "debuff_immune_radius", "debuff_immune_resist", "nearby_hot_boost", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "spectre_spectral_dagger", "name_zh": "幽鬼·幽鬼之刃", "name_en": "Spectral Dagger", "description_zh": "幽鬼掷出一把匕首，留下一条暗影之径，对路径上的敌人造成伤害并减缓其移动速度。被匕首击中的单位移动时也会留下暗影之径。幽鬼在暗影之径上移速提升，并且可以无视地形移动。", "description_en": "Spectre flings a dagger to draw a Shadow Path, dealing damage and slowing the movement speed of any enemies along the trail. Units hit by the dagger also trail a Shadow Path. While treading the path, Spectre moves faster and phases through otherwise impassable terrain.", "notes_zh": ["在离开暗影之径后%dagger_grace_period%秒内碰撞体积依然为0，作为缓冲时间。", "不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "bonus_movespeed", "dagger_path_duration", "hero_path_duration", "buff_persistence", "dagger_radius", "path_radius", "vision_radius", "speed", "dagger_grace_period", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "spectre_shadow_step", "name_zh": "幽鬼·如影随形", "name_en": "Shadow Step", "description_zh": "对目标制造一个无法控制的幻象，对其进行攻击。子技能空降可以将本体传送至幻象，并将其摧毁。", "description_en": "Sends an uncontrollable illusion at a target that follows and attacks the target.The Reality sub-ability may be used to teleport to the illusion, destroying it.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "illusion_damage_incoming", "tooltip_illusion_total_damage_incoming", "illusion_outgoing_damage", "move_speed", "bonus_move_speed_illusion_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "spectre_dispersion", "name_zh": "幽鬼·折射", "name_en": "Dispersion", "description_zh": "幽灵会分散对她造成的部分伤害，将其反弹给附近的所有敌人。敌人离她越远，受到的伤害越低。", "description_en": "Spectre disperses part of the damage dealt to her, reflecting it to all nearby enemies. The effect lessens with distance.", "notes_zh": ["幽鬼本身不承受被折射的伤害。", "幻象并不继承此技能。", "伤害在减免前折射，并且折射的伤害与原伤害类型相同。", "这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {"shard": {"zh": "折射可以主动施放，吸收和反弹的伤害比例提升%activation_bonus_pct%%%，持续%activation_duration%秒。冷却时间为%activation_cooldown%秒。魔法消耗为%activation_manacost%点。", "en": "Dispersion can be activated to increase the amount absorbed and reflected by Dispersion by %activation_bonus_pct%%% of its base values for %activation_duration%s. Cooldown %activation_cooldown%. Manacost %activation_manacost%."}}, "is_passive": true, "value_names": ["damage_reflection_pct", "min_radius", "max_radius", "activation_cooldown", "activation_manacost", "activation_bonus_pct", "activation_duration"]}, {"subject": "spectre_desolate", "name_zh": "幽鬼·荒芜", "name_en": "Desolate", "description_zh": "当敌人附近%radius%范围内没有他们的友军时，幽鬼和她的幻象的攻击对他们造成额外纯粹伤害。", "description_en": "Spectre and her illusions deal bonus Pure damage if attacking an enemy that does not have any allied units within a %radius% radius around them.", "notes_zh": ["伤害在幽鬼攻击前产生。", "幽鬼的幻象继承荒芜。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_damage", "radius", "illusion_damage_outgoing"]}, {"subject": "spectre_haunt", "name_zh": "幽鬼·鬼影重重", "name_en": "Haunt", "description_zh": "创造一个复仇鬼影分别攻击每个敌方英雄。鬼影无法控制，受到额外伤害，造成的伤害低于幽鬼本体。鬼影移动无视地形。子技能空降可以将本体传送至幻象，并将其摧毁。", "description_en": "Creates a spectral nemesis to haunt all enemy Heroes.Haunt illusions are uncontrollable, take extra damage, and deal less damage than Spectre herself.  They ignore terrain.The Reality sub-ability may be used to teleport to the illusion, destroying it.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "幽鬼第一次对鬼影重重的幻象使用空降时，目标附近%fear_aoe%范围内的敌人会被恐惧，朝远离幽鬼的方向奔跑%fear_duration%秒，并且移动速度降低%fear_movespeed_slow%%%。冷却时间减少%scepter_cooldown_reduction_tooltip%秒。", "en": "The first time Spectre uses Reality on a Haunt illusion, enemies in a %fear_aoe% area around the target are Feared away from Spectre for %fear_duration%s and have their movement speed slowed by %fear_movespeed_slow%%%.Reduces cooldown by %scepter_cooldown_reduction_tooltip%s."}}, "is_passive": false, "value_names": ["scepter_cooldown_reduction_tooltip", "duration", "illusion_damage_outgoing", "tooltip_outgoing", "illusion_damage_incoming", "tooltip_illusion_total_damage_incoming", "destroy_if_target_is_dead", "fear_duration", "fear_aoe", "fear_movespeed_slow", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "doom_bringer_devour", "name_zh": "末日使者·吞噬", "name_en": "Devour", "description_zh": "消化一个敌军或中立生物，获得其特殊技能。开启多样施法（右键点击技能栏图标）后，末日使者不会获得其技能。持续时间与冷却时间相同。", "description_en": "Consumes an enemy or neutral creep, acquiring any special abilities that it possessed. If alt-cast is activated, Doom will not acquire the creep's abilities. Duration is equal to the cooldown.", "notes_zh": ["末日使者将获得该生物的正常金钱，还有技能的额外金钱。", "如果吞噬的单位没有技能，之前获得的技能将会保留。"], "granted_by": "", "upgrades": {"shard": {"zh": "吞噬拥有%AbilityCharges%点能量点数，能以远古生物为目标。获得的野怪技能拥有%bonus_aoe_pct%%%额外作用范围和%bonus_spell_amp_pct%%%额外技能增强。", "en": "Devour has %AbilityCharges% charges and can target Ancients. Stolen creep abilities have %bonus_aoe_pct%%% increased AoE and %bonus_spell_amp_pct%%% increased spell amplification."}}, "is_passive": false, "value_names": ["bonus_gold", "creep_level", "hero_ability_steal_time", "can_target_ancient", "bonus_aoe_pct", "bonus_spell_amp_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "doom_bringer_scorched_earth", "name_zh": "末日使者·焦土", "name_en": "Scorched Earth", "description_zh": "用火焰覆盖周围的土地，对敌人造成伤害，同时末日使者的移动速度和生命恢复得到提升。", "description_en": "Carpets the nearby earth in flames which damage enemies, while also granting Doom increased movement speed and health regeneration.", "notes_zh": ["焦土会跟随末日使者，以他所在位置为中心。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "bonus_health_regen", "radius", "bonus_movement_speed_pct", "duration", "is_permanent", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "doom_bringer_infernal_blade", "name_zh": "末日使者·阎刃", "name_en": "Infernal Blade", "description_zh": "末日挥舞他的炽烈之剑，将敌人点燃。造成%ministun_duration%秒眩晕，并施加一个燃烧效果，持续%burn_duration%秒，每秒造成伤害，数值为基础伤害+目标最大生命值的一定百分比。", "description_en": "Doom swings his burning sword, igniting the enemy. Stuns for %ministun_duration% seconds and applies a %burn_duration% second burn that deals a base damage plus a percentage of the target's Max HP as damage per second.", "notes_zh": ["可以打断持续施法类技能。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["burn_damage", "burn_damage_pct", "burn_duration", "ministun_duration", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "doom_bringer_doom", "name_zh": "末日使者·末日", "name_en": "Doom", "description_zh": "对敌人施加末日诅咒，对其进行驱散，并且使其无法施放技能或获得任何治疗效果，同时造成持续伤害。\n\n驱散类型：弱驱散", "description_en": "Inflicts a curse that dispels an enemy and prevents them from casting spells or healing in any way, while taking damage over time.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "末日对敌人施加破坏效果。末日作用下目标%scepter_aura_radius%范围内友军也会受到末日的作用。可以对自身施放末日，使末日作用于末日使者周围的敌人。", "en": "Doom applies Break to enemies. Allies in a %scepter_aura_radius% radius around the doomed target also suffer the effects of Doom. Allows Doom to be self-cast to affect enemies around himself with Doom."}}, "is_passive": false, "value_names": ["duration", "damage", "deniable_pct", "does_break", "does_mute", "scepter_aura_radius", "applies_dispel_to_self", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "doom_bringer_lvl_pain", "name_zh": "末日使者·等级？痛苦", "name_en": "Lvl ? Pain", "description_zh": "末日使者的攻击会诅咒敌方英雄。%damage_debuff_duration%秒后，被诅咒的英雄会爆发出一根火柱，对自身和%spread_radius%范围内所有敌方单位造成伤害，伤害量为诅咒期间内承受来自末日使者的%bonus_damage_pct_base%%%伤害。如果被诅咒的英雄等级为%level_multiplier%的倍数，诅咒的伤害和作用范围会提升%bonus_at_level_pct%%%。", "description_en": "Doom's attacks curse enemy heroes. After %damage_debuff_duration%s, the cursed hero bursts with a pillar of fire, damaging itself and all units in a %spread_radius% AoE for %bonus_damage_pct_base%%% of the damage taken from Doom during the curse. The damage and radius of the curse is %bonus_at_level_pct%%% stronger if the enemy's level is a multiple of %level_multiplier%.", "notes_zh": ["末日使者达到满级后也会生效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_damage_pct_base", "damage_debuff_duration", "spread_radius", "level_multiplier", "bonus_at_level_pct"]}, {"subject": "ancient_apparition_cold_feet", "name_zh": "远古冰魄·寒霜之足", "name_en": "Cold Feet", "description_zh": "对一个敌人施加诅咒，造成持续伤害。如果目标没有在%AbilityDuration%秒内远离初始地点走出足够距离，那么将被眩晕并冻在原地。", "description_en": "Places a curse on an enemy, dealing damage over time.  If the enemy unit doesn't move outside of the given range from the initial location, it will be stunned and frozen in place after %AbilityDuration% seconds.", "notes_zh": ["每0.5秒造成一次伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "break_distance", "stun_duration", "area_of_effect", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ancient_apparition_ice_vortex", "name_zh": "远古冰魄·冰霜漩涡", "name_en": "Ice Vortex", "description_zh": "创造一个寒冰能量的漩涡，对范围内敌人造成伤害和减速，并增加他们受到的魔法伤害。", "description_en": "Creates a vortex of icy energy that slows, deals damage, and increases magic damage done to enemies in its range.", "notes_zh": ["提供放置地点的小片视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "drag_speed", "movement_speed_pct", "spell_resist_pct", "vision_aoe", "damage_per_second", "vortex_duration", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ancient_apparition_chilling_touch", "name_zh": "远古冰魄·极寒之触", "name_en": "Chilling Touch", "description_zh": "使自己的普通攻击附带距离提升，高额魔法伤害和减速效果。", "description_en": "Enhances Ancient Apparition's attack with increased range and a burst of magical damage and slow.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "移除了冷却时间。", "en": "Removes cooldown."}}, "is_passive": false, "value_names": ["damage", "duration", "slow", "slow_duration", "attack_range_bonus", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ancient_apparition_bone_chill", "name_zh": "远古冰魄·刺骨严寒", "name_en": "Bone Chill", "description_zh": "每当远古冰魄通过他的技能对敌人造成魔法伤害，敌人就会减速一段时间。如果目标是英雄，力量还会降低。多个本效果会叠加，并且持续时间相互独立。", "description_en": "When Ancient Apparition deals Magic damage to an enemy with his abilities, it is slowed for a short duration. If the target is a Hero, its Strength is also reduced. Multiple instances of this effect stack and have independent durations.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "基础力量降低提升%tooltip_scepter_bonus%。", "en": "Increases Base Strength Reduction by %tooltip_scepter_bonus%."}}, "is_passive": true, "value_names": ["str_reduction", "tooltip_scepter_bonus", "str_reduction_duration", "movement_slow_pct"]}]
