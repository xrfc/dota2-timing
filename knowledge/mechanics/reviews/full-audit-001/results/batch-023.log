[{"subject": "shredder_flamethrower", "name_zh": "伐木机·喷火装置", "name_en": "Flamethrower", "description_zh": "伐木机向面朝的方向放出一道火焰。施加一个负面效果，造成每秒伤害，并减缓敌人的移动速度。对建筑造成的伤害有所减少。", "description_en": "Releases a flame in the direction Timbersaw is facing. Applies a debuff that deals damage per second and slows enemy movement speed. Affects buildings for reduced damage.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_second", "duration", "width", "length", "move_slow_pct", "building_dmg_pct", "debuff_linger_duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shredder_chakram", "name_zh": "伐木机·锯齿飞轮", "name_en": "Chakram", "description_zh": "伐木机将主锯刃射向目标区域，锯刃会高速旋转，对周围的敌方单位造成伤害。在锯刃作用范围内的敌方单位每损失最大生命值的%slow_health_percentage%%%，他们的移动速度都会进一步被降低。锯刃在发射和收回的过程中都将造成伤害并砍倒碰到的树木。在发射锯刃后伐木机将无法攻击，同时会持续消耗魔法。", "description_en": "Fires Timbersaw's main saw blade at the target location where it will spin in place, dealing damage in an area around it.  Enemies caught in the saw blade will move more slowly for every %slow_health_percentage%%% of health missing. The blade deals damage and cuts down trees in its path when fired and retracted.  While active the ability costs mana, and Timbersaw loses the ability to attack.", "notes_zh": ["如果伐木机魔法不足或移动超过%break_distance%距离，锯齿飞轮将会飞回。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["speed", "radius", "pass_damage", "damage_per_second", "slow", "damage_interval", "break_distance", "mana_per_second", "pass_slow_duration", "slow_health_percentage", "castpoint_scepter", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shredder_exposure_therapy", "name_zh": "伐木机·暴露疗法", "name_en": "Exposure Therapy", "description_zh": "伐木机只要摧毁一棵树就会获得魔法。", "description_en": "Whenever Timbersaw destroys a tree, he gains mana.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["mana_restore", "health_restore"]}, {"subject": "bristleback_viscous_nasal_goo", "name_zh": "钢背兽·粘稠鼻液", "name_en": "Viscous Nasal Goo", "description_zh": "用鼻涕包裹一个敌方单位，降低护甲和移动速度，持续%goo_duration%秒。多次施放的效果会叠加，并且刷新持续时间。", "description_en": "Covers a target in snot, causing it to have reduced armor and movement speed for %goo_duration% seconds.  Multiple casts stack and refresh the duration.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["goo_speed", "goo_duration", "base_armor", "armor_per_stack", "base_move_slow", "move_slow_per_stack", "stack_limit", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bristleback_quill_spray", "name_zh": "钢背兽·刺针扫射", "name_en": "Quill Spray", "description_zh": "将尖刺喷射向敌人，对钢背兽附近的敌人造成伤害。任何单位最近%quill_stack_duration%秒内每次受到刺针扫射的打击都会受到额外伤害。", "description_en": "Sprays enemy units with quills dealing damage in an area of effect around Bristleback.  Deals bonus damage for every time a unit was hit by Quill Spray in the last %quill_stack_duration% seconds.", "notes_zh": ["刺针扫射的伤害不能被伤害格挡类技能减免。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "quill_base_damage", "quill_stack_damage", "quill_stack_duration", "max_damage", "projectile_speed", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bristleback_bristleback", "name_zh": "钢背兽·钢毛后背", "name_en": "Bristleback", "description_zh": "如果伤害来自钢背兽的侧面或者背后，他所受的伤害将会降低。钢背兽每次从背后受到一定量伤害会自动释放一次当前等级的刺针扫射。", "description_en": "Bristleback takes less damage if hit on the sides or rear. If Bristleback takes enough damage from the rear, he releases a Quill Spray of the current level.", "notes_zh": ["钢背兽的背面是以背部中心点为原点，向左向右各呈70度角的扇形区域。", "钢背兽的侧面是以背部中心点为原点，向左向右各呈110度角的扇形区域，背面的扇形区域不算在内。", "这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "钢毛后背增加主动效果。钢背兽将背部转向目标方向，%activation_delay%秒后以%activation_spray_interval%秒间隔朝背部前方的锥形范围强行连续喷出%activation_num_quill_sprays%次刺针扫射。钢背兽在这段时间内面朝方向被锁定，被缴械，并且移动速度减缓%activation_movement_speed_pct%%%。", "en": "Adds active ability to Bristleback. Bristleback rotates towards the targeted direction and, after %activation_delay%s, forcefully ejects %activation_num_quill_sprays% sequential Quill Sprays in a tight conical pattern out of his back every %activation_spray_interval%s. Bristleback's facing is locked during this time, he is disarmed, and his speed is reduced by %activation_movement_speed_pct%%%."}}, "is_passive": true, "value_names": ["side_damage_reduction", "back_damage_reduction", "side_angle", "back_angle", "quill_release_threshold", "quill_release_interval", "goo_radius", "activation_cooldown", "activation_manacost", "activation_delay", "activation_num_quill_sprays", "activation_spray_interval", "activation_angle", "activation_movement_speed_pct", "activation_turn_rate_pct"]}, {"subject": "bristleback_hairball", "name_zh": "钢背兽·毛团", "name_en": "Hairball", "description_zh": "向目标地点咳出一团满是刺针的毛团。毛团会在该地点爆开，范围内的敌人都将受到多个鼻液叠加效果和单次刺针扫射的作用。", "description_en": "Coughs a quill-packed hairball towards the target location. Erupts at the location, hitting enemies with Viscous Nasal Goo stacks and Quill Spray.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["projectile_speed", "radius", "quill_stacks", "goo_stacks", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bristleback_warpath", "name_zh": "钢背兽·战意", "name_en": "Warpath", "description_zh": "钢背兽每次使用技能时都会进入狂暴状态，移动速度和攻击力都将提升。", "description_en": "Bristleback works himself up into a fury every time he casts a spell, increasing his movement speed and damage.", "notes_zh": ["钢背兽的幻象也能继承加成效果。", "使用物品不会触发战意。", "破坏会使技能无法获得新的叠加效果。", "破坏不会使现有叠加效果提供的加成失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_per_stack", "aspd_per_stack", "move_speed_per_stack", "stack_duration", "max_stacks"]}, {"subject": "bristleback_prickly", "name_zh": "钢背兽·尖刺在背", "name_en": "Prickly", "description_zh": "钢背兽攻击身后的敌方英雄时拥有额外伤害和负面效果持续时间增强。", "description_en": "Bristleback has bonus damage and debuff duration amp against enemy heroes that are behind him.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["amp_pct", "angle"]}, {"subject": "tusk_ice_shards", "name_zh": "巨牙海民·寒冰碎片", "name_en": "Ice Shards", "description_zh": "巨牙海民将数块寒冰碎片压缩成蕴含冰冻能量的冰球，对所有接触到冰球的敌人造成伤害。冰球到达目标地点时会产生一个障碍物，持续%shard_duration%秒。", "description_en": "Tusk compresses shards of ice into a ball of frozen energy that damages all enemies it comes in contact with. When the ball reaches its target destination the shards are released, creating a barrier that lasts for %shard_duration% seconds.", "notes_zh": ["将创造不可通行的障碍。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["shard_width", "shard_damage", "shard_count", "shard_speed", "shard_duration", "shard_angle_step", "shard_distance", "aghs_shard_move_slow", "aghs_shard_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_snowball", "name_zh": "巨牙海民·雪球", "name_en": "Snowball", "description_zh": "巨牙海民开始卷成雪球。右键点击%snowball_grab_radius%范围内的友方英雄能使其加入雪球。发动雪球后，雪球经过的单位将会被眩晕并受到伤害。雪球每卷入一个英雄，它的伤害和眩晕时间都会得到提升。", "description_en": "Tusk begins rolling into a snowball. Allies within a %snowball_grab_radius% radius can also be added to the snowball by right-clicking on them, even while the snowball is moving. Once launched, any enemies caught in the snowball's path will be stunned and take damage. Each allied Hero in the snowball will add to its damage and stun duration.", "notes_zh": ["雪球在发动后经过最大3秒将会解体。", "使用发动雪球技能就能提前发动雪球。", "幻象不会进入雪球，但是米波的克隆体以及巨牙海民控制的其他单位将一同进入雪球。", "米波的分身也能卷入雪球，并提升雪球的伤害。", "队友可以点击雪球，使自己进入雪球。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["snowball_damage", "snowball_speed", "snowball_damage_bonus", "stun_duration", "stun_duration_bonus", "snowball_windup_radius", "snowball_duration", "snowball_radius", "snowball_grow_rate", "snowball_windup", "snowball_grab_radius", "snowball_speed_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "tusk_tag_team", "name_zh": "巨牙海民·摔角行家", "name_en": "Tag Team", "description_zh": "主动使用后暂时施加一个具有负面效果的光环，使作用范围内的敌人被攻击时承受额外物理伤害，并且移动速度被减缓。持续%debuff_duration%秒。", "description_en": "Activate to temporarily apply a negative debuff aura around you, causing enemies that are attacked under it to take bonus physical damage and reduced movement speed. Lasts %debuff_duration% seconds.", "notes_zh": ["影响来自友方英雄、巨牙海民和他控制的所有单位的普通攻击。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "movement_slow", "slow_duration", "debuff_duration", "radius", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_drinking_buddies", "name_zh": "巨牙海民·酒友", "name_en": "Drinking Buddies", "description_zh": "巨牙海民伸出手来触碰友方单位，拉近彼此。触碰后巨牙海民和他的友军获得移动速度和护甲加成。", "description_en": "Tusk reaches out to tag an allied unit, pulling them closer. Once tagged, both Tusk and his tagged ally gain movement speed and armor.", "notes_zh": ["如果巨牙海民和目标友军相距在%min_distance%距离以内，就不会拉动他们。", "在雪球期间无法使用。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["alt_cast_castrange_pct", "buff_duration", "pull_duration", "min_distance", "max_distance", "movespeed_bonus", "armor_bonus", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_walrus_kick", "name_zh": "巨牙海民·海象飞踢", "name_en": "Walrus Kick", "description_zh": "将最近的敌方单位向目标方向踢上一脚，对其造成眩晕，伤害和减速。另外对落地区域%search_radius%范围内所有英雄造成伤害。飞踢非英雄单位会使冷却时间减少%creep_cooldown_reduction_pct%%%。", "description_en": "Kicks the closest enemy unit in the drawn direction, stunning, damaging, and slowing them. Also deals damage to all heroes within %search_radius% radius of its landing area. Cooldown is reduced by %creep_cooldown_reduction_pct%%% if kicking a creep.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["air_time", "push_length", "move_slow", "slow_duration", "damage", "search_radius", "creep_cooldown_reduction_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_walrus_punch", "name_zh": "巨牙海民·海象神拳！", "name_en": "Walrus PUNCH!", "description_zh": "巨牙海民为他强力的海象神拳做好准备，下一次攻击将会造成额外伤害并暴击，同时将目标打到半空中。", "description_en": "Tusk connects with his mighty Walrus Punch, a critical strike with bonus damage so powerful it launches its victim into the air.", "notes_zh": ["海象神拳！拥有克敌机先效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "crit_multiplier", "air_time", "push_length", "proc_chance", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tusk_bitter_chill", "name_zh": "巨牙海民·严寒", "name_en": "Bitter Chill", "description_zh": "被动降低%radius%范围内所有敌方英雄的攻击速度。", "description_en": "Passively slows the attack speed of all enemy heroes within a %radius% unit radius.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "attack_speed_slow"]}, {"subject": "skywrath_mage_arcane_bolt", "name_zh": "天怒法师·奥法鹰隼", "name_en": "Arcane Bolt", "description_zh": "天怒法师施放出缓慢移动的奥术鹰群，对敌方单位造成基于天怒法师智力值的伤害。", "description_en": "Skywrath Mage launches a slow-moving bolt of arcane magic, dealing damage to an enemy unit based on Skywrath Mage's intelligence.", "notes_zh": ["鹰群移动得非常缓慢（500移速），提供325范围的视野。击中目标后，将给予目标区域的视野，持续3.34秒。", "奥法鹰隼无法被躲避。"], "granted_by": "", "upgrades": {"shard": {"zh": "天怒法师施放奥法鹰隼时，会产生%total_bolt_count%个鹰隼，其中一个飞往原目标，而另外的两个飞往原目标附近%extra_bolt_search_radius%范围内随机敌人。以英雄为首要目标。", "en": "When Skywrath Mage casts Arcane Bolt, %total_bolt_count% bolts are created, one aimed at the original target, and two others aimed at random enemies within %extra_bolt_search_radius% range of the original target. Heroes will take priority."}}, "is_passive": false, "value_names": ["pierce_spell_immunity", "bolt_speed", "bolt_vision", "bolt_damage", "int_multiplier", "vision_duration", "extra_bolt_search_radius", "total_bolt_count", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skywrath_mage_concussive_shot", "name_zh": "天怒法师·震荡光弹", "name_en": "Concussive Shot", "description_zh": "天怒法师释放一个远距离的光弹，将击中超大范围内最近的英雄。击中后会对英雄附近范围内所有单位造成伤害和减速。", "description_en": "Skywrath Mage sets off a long range shot that hits the closest hero within a long range.  Upon impact, it deals damage and slows in an area of effect.", "notes_zh": ["如果作用范围内没有英雄或英雄处于迷雾中，震荡光弹将以最近的敌方小兵或中立生物为目标。", "击中英雄后附近的非英雄单位也会受到伤害。", "光弹将给予400范围的附近视野，击中后将获得目标区域的视野，持续3.34秒。"], "granted_by": "", "upgrades": {"scepter": {"zh": "天怒法师施放震荡光弹时，会随机对原目标附近%scepter_radius%范围内另一个敌人施放相同的技能。以英雄为首要目标。", "en": "When Skywrath Mage casts Concussive Shot, a different random target within %scepter_radius% range of the original target will be hit with the same ability. Heroes will take priority."}}, "is_passive": false, "value_names": ["launch_radius", "launch_global", "slow_radius", "speed", "damage", "slow_duration", "movement_speed_pct", "shot_vision", "vision_duration", "scepter_radius", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skywrath_mage_ancient_seal", "name_zh": "天怒法师·上古封印", "name_en": "Ancient Seal", "description_zh": "天怒法师利用上古符文将目标单位封印，目标单位将被沉默，受到魔法伤害时将承受额外伤害。", "description_en": "Skywrath Mage seals the targeted unit with an ancient rune, silencing it and causing it to take additional damage from spells.", "notes_zh": ["减少魔法抗性的效果对非英雄单位无效。"], "granted_by": "", "upgrades": {"scepter": {"zh": "天怒法师施放上古封印时，会随机对原目标附近%scepter_radius%范围内另一个敌人施放相同的技能。以英雄为首要目标。", "en": "Anytime Skywrath Mage casts Ancient Seal, a different random target within %scepter_radius% range of the original target will be affected by the same ability. Heroes will take priority."}}, "is_passive": false, "value_names": ["resist_debuff", "seal_duration", "scepter_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skywrath_mage_shield_of_the_scion", "name_zh": "天怒法师·天裔之盾", "name_en": "Shield of the Scion", "description_zh": "每次天怒法师用技能对敌方英雄造成魔法伤害时，他都会获得小型的魔法伤害护盾。每个加成状态独立叠加。", "description_en": "Every time Skywrath Mage deals magical damage to an enemy hero with his abilities, he gains a small magic damage barrier. Each buff stacks independently.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["stack_duration", "damage_barrier", "barrier_duration"]}, {"subject": "skywrath_mage_mystic_flare", "name_zh": "天怒法师·神秘之耀", "name_en": "Mystic Flare", "description_zh": "天怒法师操控终极魔力，召唤精准致命的奥术力场毁灭对手。%duration%秒期间对范围内所有敌方英雄造成大量伤害，伤害由所有英雄平摊。", "description_en": "Skywrath Mage uses his ultimate magical ability to conjure a precise and violent mystical field that lays waste to his adversaries. Deals massive damage distributed evenly among any Heroes in the area over %duration% seconds.", "notes_zh": ["神秘之耀只会作用于英雄。神秘之耀不会对类英雄单位造成伤害。", "神秘之耀在没有敌方英雄时将对敌方非英雄单位造成伤害。", "神秘之耀会立刻摧毁幻象。"], "granted_by": "", "upgrades": {"scepter": {"zh": "天怒法师施放神秘之耀时，原目标附近%scepter_radius%范围内另一个敌人的位置上也会产生一个神秘之耀。以英雄为首要目标。", "en": "When Skywrath Mage casts Mystic Flare, another Mystic Flare will be created on the position of a different random target enemy within %scepter_radius% range of the original target. Heroes will take priority."}}, "is_passive": false, "value_names": ["radius", "duration", "damage", "damage_interval", "scepter_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "abaddon_death_coil", "name_zh": "亚巴顿·迷雾缠绕", "name_en": "Mist Coil", "description_zh": "亚巴顿以自身的部分生命为代价，释放出一团致命迷雾，可以对敌方单位造成伤害，或者治疗友方单位。", "description_en": "Abaddon releases a coil of deathly mist that can damage an enemy unit or heal a friendly unit at the cost of some of Abaddon's health.", "notes_zh": ["亚巴顿不能使用此技能自杀。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["self_damage", "self_damage_enemy_target", "missile_speed", "damage_heal", "effect_radius", "perform_attack", "damage_percentage_on_perform_attack", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "abaddon_aphotic_shield", "name_zh": "亚巴顿·无光之盾", "name_en": "Aphotic Shield", "description_zh": "召唤黑暗能量环绕友方单位，驱散他们并创造一个全伤害护盾，护盾在消失前能吸收一定量的伤害。护盾消失或被摧毁后将会爆炸，对附近区域的单位造成伤害，伤害值为护盾的最大吸收量。\n\n驱散类型：强驱散", "description_en": "Summons dark energies around an ally unit, dispelling them and creating an all damage barrier that absorbs a set amount of damage before expiring. When the barrier is destroyed it will burst and deal damage equal to the amount it could absorb to an area around it.\n\nDISPEL TYPE: Strong Dispel", "notes_zh": ["不论护盾因持续时间结束或吸收足够伤害后被摧毁都将造成最大伤害。", "爆炸将不会对战争迷雾内单位造成伤害。"], "granted_by": "", "upgrades": {"shard": {"zh": "会对附近敌人造成吸收伤害的%absorb_to_damage%%%。", "en": "%absorb_to_damage%%% of absorbed damage is dealt to nearby enemies."}}, "is_passive": false, "value_names": ["duration", "radius", "damage_absorb", "regen", "absorb_to_damage", "absorb_damage_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "abaddon_frostmourne", "name_zh": "亚巴顿·魔霭诅咒", "name_en": "Curse of Avernus", "description_zh": "亚巴顿打击一个敌人，使其受到寒心诅咒的作用，被减速，并且持续受到伤害，同时所有攻击目标的单位将提升攻击速度。对建筑的持续伤害减少%tower_dps_pct%%%。", "description_en": "Abaddon strikes an enemy, affecting them by a chilling curse, slowing them, causing them to take damage over time, and all attacks against them gain an attack speed boost. Damage over time component to buildings is reduced by %tower_dps_pct%%%.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["slow_duration", "hit_count", "curse_duration", "curse_slow", "curse_attack_speed", "curse_dps", "tower_dps_pct", "curse_interval"]}, {"subject": "abaddon_withering_mist", "name_zh": "亚巴顿·凋零迷雾", "name_en": "Withering Mist", "description_zh": "对敌人造成伤害时会施加凋零迷雾的负面效果，持续%duration%秒。受作用敌人如果血量低于%hp_threshold_pct%%%，那么生命回复会降低%heal_reduction_pct%%%。", "description_en": "Damaging enemies applies the Withering Mist debuff for %duration%s. Affected enemies have their Health Restoration reduced by %heal_reduction_pct%%% if they are below %hp_threshold_pct%%% HP.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["hp_threshold_pct", "heal_reduction_pct", "duration"]}]
