{"objects":[{"subject":"undying_flesh_golem","mechanisms":[{"mechanism":"slow","condition":"base","quote":"攻击附带减速和伤害加深效果","uncertain":false},{"mechanism":"incoming_damage_amp","condition":"base","quote":"攻击附带减速和伤害加深效果","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"攻击附带减速和伤害加深效果，还会产生墓碑的僵尸","uncertain":false},{"mechanism":"summons","condition":"base","quote":"还会产生墓碑的僵尸","uncertain":true}]},{"subject":"rubick_telekinesis","mechanisms":[{"mechanism":"stun","condition":"base","quote":"被投下的单位会砸晕落地点附近的敌人","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"拉比克可以使用次级技能将目标扔往目标方向","uncertain":false},{"mechanism":"self_mobility","condition":"shard","quote":"可以对自身或友军施放隔空取物","uncertain":false}]},{"subject":"rubick_fade_bolt","mechanisms":[{"mechanism":"attack_damage_reduction","condition":"base","quote":"降低他们的攻击力和技能伤害","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"在多个敌方单位之间流动，造成伤害","uncertain":false}]},{"subject":"rubick_arcane_supremacy","mechanisms":[{"mechanism":"spell_amp","condition":"base","quote":"额外技能增强","uncertain":false}]},{"subject":"rubick_spell_steal","mechanisms":[{"mechanism":"spell_steal","condition":"base","quote":"学习这个英雄最后释放的技能的秘密。拉比克将可以使用这个技能","uncertain":false}]},{"subject":"rubick_curiosity","mechanisms":[]},{"subject":"disruptor_thunder_strike","mechanisms":[{"mechanism":"slow","condition":"base","quote":"攻击速度和移动速度降低效果","uncertain":false},{"mechanism":"grant_vision","condition":"base","quote":"提供目标的视野","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"每次打击会伤害附近小范围内的敌方单位","uncertain":false}]},{"subject":"disruptor_glimpse","mechanisms":[{"mechanism":"displace_other","condition":"base","quote":"将目标英雄传送回他%backtrack_time%秒前所在位置","uncertain":false}]},{"subject":"disruptor_kinetic_field","mechanisms":[{"mechanism":"mobility_lock","condition":"base","quote":"创造一个敌人无法通过的环形动能屏障","uncertain":false}]},{"subject":"disruptor_kinetic_fence","mechanisms":[{"mechanism":"mobility_lock","condition":"shard","quote":"创造一面敌人无法通过的动能墙壁","uncertain":false}]},{"subject":"disruptor_electromagnetic_repulsion","mechanisms":[{"mechanism":"damage_return","condition":"base","quote":"每当干扰者受到%effect_radius%范围内来自任意来源的%damage_threshold%点伤害，附近所有敌人都会受到%damage_per_int%倍干扰者智力值的伤害","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"被推开最多%effect_radius%距离","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"附近所有敌人都会受到%damage_per_int%倍干扰者智力值的伤害","uncertain":false}]},{"subject":"disruptor_static_storm","mechanisms":[{"mechanism":"silence","condition":"base","quote":"沉默区域内的所有敌方单位","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"在持续时间内伤害并沉默区域内的所有敌方单位","uncertain":false},{"mechanism":"mute","condition":"scepter","quote":"锁闭物品","uncertain":false}]},{"subject":"nyx_assassin_impale","mechanisms":[{"mechanism":"stun","condition":"base","quote":"落地时被眩晕","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"敌方单位受到伤害，然后被抛向空中","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"岩石尖刺在地上沿一条直线穿刺而出。敌方单位受到伤害","uncertain":false}]},{"subject":"nyx_assassin_jolt","mechanisms":[{"mechanism":"mana_burn","condition":"base","quote":"并燃烧部分魔法","uncertain":false}]},{"subject":"nyx_assassin_spiked_carapace","mechanisms":[{"mechanism":"stun","condition":"base","quote":"同时眩晕攻击者","uncertain":false},{"mechanism":"damage_block","condition":"base","quote":"无效化司夜刺客受到的伤害（每个攻击者最多作用一次）","uncertain":false},{"mechanism":"damage_return","condition":"base","quote":"尖刺外壳可以反弹并无效化司夜刺客受到的伤害（每个攻击者最多作用一次）","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"反弹并无效化司夜刺客受到的伤害（每个攻击者最多作用一次）","uncertain":true}]},{"subject":"nyx_assassin_burrow","mechanisms":[{"mechanism":"invisibility","condition":"scepter","quote":"并且是隐身状态","uncertain":false},{"mechanism":"damage_block","condition":"scepter","quote":"司夜刺客受到的所有伤害都会降低","uncertain":false},{"mechanism":"cooldown_reduction","condition":"scepter","quote":"穿刺的冷却时间减少","uncertain":false}]},{"subject":"nyx_assassin_neuro_sting","mechanisms":[{"mechanism":"mana_burn","condition":"base","quote":"燃烧造成伤害一定百分比的魔法","uncertain":false}]},{"subject":"nyx_assassin_vendetta","mechanisms":[{"mechanism":"invisibility","condition":"base","quote":"司夜刺客进入隐身状态","uncertain":false},{"mechanism":"applies_break","condition":"base","quote":"并对目标施加破坏效果","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"当次攻击将造成超高额外伤害，并对目标施加破坏效果","uncertain":false},{"mechanism":"flying","condition":"shard","quote":"移动无视地形","uncertain":false}]},{"subject":"naga_siren_mirror_image","mechanisms":[{"mechanism":"illusions","condition":"base","quote":"制造多个受娜迦海妖控制的镜像","uncertain":false},{"mechanism":"applies_basic_dispel","condition":"base","quote":"驱散类型：弱驱散","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"娜迦海妖在施法时有%invuln_duration%秒的无敌时间","uncertain":false}]},{"subject":"naga_siren_ensnare","mechanisms":[{"mechanism":"root","condition":"base","quote":"将其困在原地，使其无法移动或闪烁","uncertain":false},{"mechanism":"pierces_debuff_immunity","condition":"scepter","quote":"诱捕可以对减益免疫单位施放并且生效","uncertain":false},{"mechanism":"applies_break","condition":"scepter","quote":"诱捕会施加破坏效果","uncertain":false}]},{"subject":"naga_siren_rip_tide","mechanisms":[{"mechanism":"armor_reduction","condition":"base","quote":"降低他们的护甲，持续%duration%秒","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"每经过%hits%次攻击后就会对敌人造成额外伤害，并降低他们的护甲","uncertain":false}]},{"subject":"naga_siren_eelskin","mechanisms":[{"mechanism":"evasion","condition":"base","quote":"娜迦海妖拥有闪避加成","uncertain":false}]},{"subject":"naga_siren_song_of_the_siren","mechanisms":[{"mechanism":"sleep","condition":"base","quote":"陷入停滞状态，既无法行动也不会受到攻击；如果她远离了作用单位，他们将会醒来","uncertain":true},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"海妖之歌作用下的单位处于无敌状态，不会受到任何伤害","uncertain":false},{"mechanism":"aura","condition":"base","quote":"娜迦海妖周围的所有敌人受到魔法影响陷入停滞状态","uncertain":false},{"mechanism":"healing","condition":"shard","quote":"海妖之歌范围内友军每秒会恢复一定百分比的生命和魔法","uncertain":false},{"mechanism":"mana_gain","condition":"shard","quote":"Allies in range of Song of the Siren recover a percentage of their health and mana per second.","uncertain":true},{"mechanism":"aura","condition":"shard","quote":"海妖之歌范围内友军每秒会恢复一定百分比的生命和魔法","uncertain":false}]},{"subject":"keeper_of_the_light_illuminate","mechanisms":[{"mechanism":"grant_vision","condition":"base","quote":"获得沿途的视野","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"光波沿直线向前发出，造成伤害","uncertain":false}]},{"subject":"keeper_of_the_light_blinding_light","mechanisms":[{"mechanism":"blind","condition":"base","quote":"造成致盲，使他们的部分攻击不能命中","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"把区域内的单位击退到区域边缘","uncertain":false},{"mechanism":"tree_destroy","condition":"base","quote":"落地后受作用单位将摧毁150范围内的树木","uncertain":false}]}]}
