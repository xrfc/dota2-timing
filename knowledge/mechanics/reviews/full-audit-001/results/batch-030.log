[{"subject": "kez_ravens_veil", "name_zh": "凯·渡鸦之纱", "name_en": "Raven's Veil", "description_zh": "凯释放出一阵迷烟，对附近敌方英雄施加标记，暂时削弱他们的视野。凯获得弱驱散效果、移动速度加成和隐身状态，直到他攻击或施法。", "description_en": "Kez releases a wave of smoke that applies his Mark to nearby enemy heroes, briefly reducing their vision. Kez receives a basic dispel and gains bonus movement speed and invisibility until he attacks or casts a spell.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["blast_radius", "blast_speed", "buff_duration", "blind_duration", "bonus_ms", "basic_dispel", "apply_parry_bonus", "mark_only_heroes", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_catchy_lick", "name_zh": "朗戈·动人之舐", "name_en": "Catchy Lick", "description_zh": "朗戈用他的舌头舔舐目标单位，把它拉回一小段距离，施加弱驱散，如果是敌人还会造成伤害。\n\n击杀目标或驱散目标的效果后都会使朗戈暂时获得生命恢复。\n\n驱散类型：弱驱散", "description_en": "Largo licks the targeted unit with his tongue, pulling it back a short distance, applying a basic dispel, and dealing damage if it's an enemy.\n\nKilling or dispelling an effect from a target grants Largo temporary health regeneration.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["可以舔舐神符，将其牵引。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "pull_distance", "pull_distance_ally", "pull_duration", "dispel_hp_regen", "buff_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_frogstomp", "name_zh": "朗戈·蛙力千钧", "name_en": "Frogstomp", "description_zh": "朗戈把小青蛙扔到一片区域。他们每%stomp_interval%秒都会践踏地面，造成伤害和短暂眩晕并且区域内敌人的移动速度会被减缓。", "description_en": "Largo tosses froglings to an area. They stomp the ground every %stomp_interval% second, dealing damage and ministuns, and enemies in the area have reduced movement speed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_per_stomp", "total_ticks", "slow", "radius", "stun_duration", "stomp_interval", "delay", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_croak_of_genius", "name_zh": "朗戈·灵呱一闪", "name_en": "Croak of Genius", "description_zh": "朗戈对一名友方英雄弹奏一首小调。英雄的技能和物品拥有的魔法消耗降低，并且造成伤害后会回响，接下来%damage_duration%秒内再次造成原本伤害的一定百分比。\n\n只要作用下的英雄消耗了魔法，本增益的剩余持续时间都会减少%duration_reduction%秒。朗戈身上的持续时间不会减少。", "description_en": "Largo strums a tune to a friendly hero. The hero's items and abilities have reduced mana cost and a percentage of their damage reverberates over the following %damage_duration% seconds.\n\nWhen an affected hero spends mana, the remaining buff duration is reduced by %duration_reduction%s. Duration is not reduced for Largo himself.", "notes_zh": ["只适用于可受到技能增强作用的伤害来源。", "只会在来源和目标相距%max_distance%以内时施加伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_portion_pct", "damage_duration", "damage_hp_pct", "mana_cost_reduction", "duration", "duration_reduction", "max_distance", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_encore", "name_zh": "朗戈·安可", "name_en": "Encore", "description_zh": "朗戈对自身或队友施加的增益效果会延长持续时间。", "description_en": "Buffs that Largo applies to himself or his team have extended duration.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "只要朗戈对友方英雄施加单位目标技能的增益效果，他也会获得该增益。只要朗戈对自身施加，该增益也会施加给指向性技能的施法距离内最近的友方英雄。", "en": "Whenever Largo applies a Unit Target buff to a friendly hero, he also gets the buff.If Largo targets himself, the buff is also applied to the nearest allied hero within the cast range of the targeted ability."}}, "is_passive": true, "value_names": ["buff_amplification", "repeat_buff"]}, {"subject": "largo_amphibian_rhapsody", "name_zh": "朗戈·两栖狂想曲", "name_en": "Amphibian Rhapsody", "description_zh": "朗戈准备好弹奏乐曲。他被缴械，而他的技能栏切换为3个乐曲技能，每个都有不同的效果。乐曲只有弹在节拍上才会生效。\n\n每次成功弹奏他都会获得一层律动的叠加效果。每层叠加效果都会对他提供额外护甲，并且降低每首乐曲的魔法消耗，但是他只要错过一次节拍就会失去一层叠加效果。叠加效果在朗戈的乐曲结束后还会粘滞一小段时间。", "description_en": "Largo gets ready to groove. He is disarmed and his ability bar switches to 3 song abilities, each with different effects. Songs are only effective if strummed on the beat.\n\nEvery time he strums successfully, he gains a stack of Groovin'. Each stack gives him bonus armor and reduces the mana cost of every song, but he loses a stack if he misses a beat. Stacks linger for a short duration when Largo's song ends.", "notes_zh": ["这个模式下可以使用物品。"], "granted_by": "", "upgrades": {"scepter": {"zh": "朗戈在每次节拍时可以弹奏两首乐曲。", "en": "Largo can play two songs per beat by strumming both at the same time."}}, "is_passive": false, "value_names": ["radius", "rhythm_interval", "rhythm_grace_period", "max_stacks", "armor_per_stack", "song_cost_reduction_per_stack_tooltip", "stack_duration", "double_song", "armor_ally_pct", "AbilityCooldown"]}, {"subject": "largo_song_fight_song", "name_zh": "朗戈·巨腹闪电战", "name_en": "Bullbelly Blitz", "description_zh": "朗戈弹奏的乐曲对附近敌人造成%burst_damage%点魔法伤害。乐曲还会使附近友方英雄的技能增强提升，并且他们的攻击造成额外魔法伤害。", "description_en": "Largo plays a song that deals %burst_damage% magical damage to nearby enemies. The song also increases nearby allied heroes' spell amplification and grants their attacks additional magic damage.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "这首乐曲用于两首共弹时每层律动都会额外造成%damage_per_stack%点魔法伤害。", "en": "Deals additional %damage_per_stack% magic damage per Groovin' stack when this song is used in double-strumming."}}, "is_passive": false, "value_names": ["double_song", "song_cost_reduction_per_stack", "radius", "burst_damage", "damage_per_stack", "magic_damage_bonus", "spell_amp_bonus", "battle_burst_duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_song_double_time", "name_zh": "朗戈·疾步生风", "name_en": "Hotfeet Hustle", "description_zh": "朗戈弹奏的乐曲会提升附近友方单位的移动速度，还有短时间的减速抗性。", "description_en": "Largo plays a song that increases nearby friendly units' movement speed and grants a brief slow resistance.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["double_song", "song_cost_reduction_per_stack", "radius", "movespeed_bonus_burst", "slow_resistance", "movement_burst_duration", "slow_resistance_burst_duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "largo_song_good_vibrations", "name_zh": "朗戈·大屿灵药", "name_en": "Island Elixir", "description_zh": "朗戈弹奏的乐曲会治疗附近友方英雄。", "description_en": "Largo plays a song that heals nearby friendly heroes.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["double_song", "song_cost_reduction_per_stack", "radius", "heal_burst", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "abyssal_blade", "name_zh": "深渊之刃", "name_en": "Abyssal Blade", "description_en": "Active: Overwhelm  Stuns a target enemy unit for %stun_duration% seconds.   Pierces Debuff Immunity.   Passive: Bash  Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage.  Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_en": ["The stun is melee range.", "Does not stack with other bashes, and does not grant bash to Clones and Tempest Doubles.", "Multiple sources of damage block do not stack.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode."], "attributes": ["+ 35 Damage", "+ 30 Strength", "+ 30% Slow Resistance", "+ 16% Health Restoration"], "is_item": true}, {"subject": "aegis", "name_zh": "不朽之守护", "name_en": "Aegis of the Immortal", "description_en": "Passive: Reincarnation  Brings you to life with full health and mana %reincarnate_time% seconds after you die, at the location where you died.   Reincarnation must be used within %disappear_time_minutes_tooltip% minutes or Aegis of the Immortal disappears. If it expires, it will heal you over 5 seconds (dispels on damage).", "notes_en": ["Pronounced as ayy jis."], "attributes": [], "is_item": true}, {"subject": "aeon_disk", "name_zh": "永恒之盘", "name_en": "Aeon Disk", "description_en": "Passive: Combo Breaker  When you take damage and your health falls below %health_threshold_pct%%%, a strong dispel is applied and you gain a %buff_duration% second buff that provides +%status_resistance%%% Status Resistance and causes all damage you deal and are dealt to be reduced to zero. Only triggers on player based damage. Cooldown increases every time it triggers.  Dispel Type:  Strong Dispel", "notes_en": [], "attributes": ["+ 250 Health", "+ 300 Mana", "COOLDOWN: 105.0 / 125.0 / 145.0 / 165.0"], "is_item": true}, {"subject": "aether_lens", "name_zh": "以太透镜", "name_en": "Aether Lens", "description_en": "", "notes_en": ["Cast Range bonuses from Aether Lens and Dagon do not stack."], "attributes": ["+ 300 Mana", "+ 2.5 Mana Regeneration", "+ 225 Cast Range"], "is_item": true}, {"subject": "aghanims_shard", "name_zh": "阿哈利姆魔晶", "name_en": "Aghanim's Shard", "description_en": "Passive: Ability Upgrade Upgrades an existing ability or adds a new ability to your hero.", "notes_en": [], "attributes": [], "is_item": true}, {"subject": "aghanims_shard_roshan", "name_zh": "阿哈利姆魔晶 - 消耗品", "name_en": "Aghanim's Shard - Consumable", "description_en": "Passive: Ability Upgrade Upgrades an existing ability or adds a new ability to your hero.", "notes_en": [], "attributes": [], "is_item": true}, {"subject": "ancient_janggo", "name_zh": "韧鼓", "name_en": "Drum of Endurance", "description_en": "Active: Endurance  Gives +%bonus_attack_speed_pct% attack speed and +%bonus_movement_speed_pct%%% movement speed to nearby allies for %duration% seconds.  Radius: %radius%     Passive: Swiftness Aura Grants %aura_movement_speed% movement speed and %aura_health_regen% health regeneration to allies.    Radius: %radius%", "notes_en": [], "attributes": ["+ 8 Strength"], "is_item": true}, {"subject": "angels_demise", "name_zh": "绝刃", "name_en": "Khanda", "description_en": "Passive: Empower Spell  The next Unit Target spell you cast on an enemy deals a separate %bonus_spell_damage% additional damage, disables their passives, and slows their movement speed by %slow%%% for %slow_duration%s.", "notes_en": ["The slow debuff is dispellable.", "The break debuff is not dispellable."], "attributes": ["+ 450 Health", "+ 450 Mana", "+ 8 All Attributes", "+ 7 Health Regeneration", "+ 3 Mana Regeneration"], "is_item": true}, {"subject": "arcane_blink", "name_zh": "秘奥闪光", "name_en": "Arcane Blink", "description_en": "Active: Arcane Blink  Teleport to a target point up to %blink_range% units away.   After teleportation, you restore %heal_amount% health and %mana_amount% mana.  Arcane Blink cannot be used for %blink_damage_cooldown% seconds after taking damage from an enemy hero or Roshan.", "notes_en": ["Self-casting will cause you to teleport in the direction of your team's fountain."], "attributes": ["+ 25 Intelligence"], "is_item": true}, {"subject": "arcane_boots", "name_zh": "奥术鞋", "name_en": "Arcane Boots", "description_en": "Active: Replenish Restores %replenish_amount% mana to all nearby allies.  Radius: %replenish_radius%   Passive: Basilius Aura Grants %aura_mana_regen% mana regeneration to allies.    Radius: %aura_radius% Movement speed bonuses from multiple pairs of boots do not stack.", "notes_en": ["Does not work on Meepo clones."], "attributes": ["+ 45 Movement Speed", "+ 0.25 Mana Regeneration", "+ 125 Mana"], "is_item": true}, {"subject": "armlet", "name_zh": "莫尔迪基安的臂章", "name_en": "Armlet of Mordiggian", "description_en": "Toggle: Unholy Strength When active, Unholy Strength grants +%unholy_bonus_damage% damage, +%unholy_bonus_strength% strength and +%unholy_bonus_armor% armor, but drains %unholy_health_drain_per_second% health per second.   You cannot die from the health drain when Unholy Strength is activated, nor from the strength loss when Unholy Strength is deactivated.", "notes_en": ["The strength change will affect both maximum and current HP, but you cannot die from the change.", "The strength change occurs over 0.6 seconds.", "Activating or deactivating Unholy Strength does not interrupt channeling."], "attributes": ["+ 15 Damage", "+ 25 Attack Speed", "+ 6 Armor", "+ 5 Health Regeneration"], "is_item": true}, {"subject": "assault", "name_zh": "强袭胸甲", "name_en": "Assault Cuirass", "description_en": "Passive: Assault Aura  Grants %aura_attack_speed% attack speed and %aura_positive_armor% armor to nearby allied units and structures, and decreases nearby enemy unit and structure armor by %aura_negative_armor%.  Radius: %aura_radius%", "notes_en": [], "attributes": ["+ 30 Attack Speed", "+ 10 Armor"], "is_item": true}, {"subject": "basher", "name_zh": "碎颅锤", "name_en": "Skull Basher", "description_en": "Passive: Bash  Grants melee heroes a %bash_chance_melee%%% chance on hit to stun the target for %bash_duration% seconds and deal %bonus_chance_damage% bonus physical damage.  Bash chance for ranged heroes is %bash_chance_ranged%%%.", "notes_en": ["Does not stack with other sources of Bash.", "The following heroes cannot trigger Bash on this item: Spirit Breaker, Faceless Void, Slardar, and Kez while in Sai mode.", "Does not grant Bash to Clones and Tempest Doubles."], "attributes": ["+ 30 Damage", "+ 10 Strength"], "is_item": true}, {"subject": "belt_of_strength", "name_zh": "力量腰带", "name_en": "Belt of Strength", "description_en": "", "notes_en": [], "attributes": ["+ 6 Strength"], "is_item": true}, {"subject": "bfury", "name_zh": "狂战斧", "name_en": "Battle Fury", "description_en": "Active: Chop Tree  Destroy a target tree.    Passive: Quell  Increases attack damage against non-hero units by %quelling_bonus% for melee heroes, and %quelling_bonus_ranged% for ranged.    Passive: Cleave  Deals %cleave_damage_percent%%% of attack damage as physical damage in a cone up to %cleave_distance% around the target. Deals %cleave_damage_percent_creep%%% against creeps. (Melee Only)", "notes_en": ["Cleave damage goes through spell immunity.", "If multiple sources of Cleave are present, each Cleave's damage is applied separately."], "attributes": ["+ 50 Damage", "+ 7.5 Health Regeneration", "+ 2.75 Mana Regeneration"], "is_item": true}, {"subject": "black_grimoire", "name_zh": "Black Grimoire\n(Warlock)", "name_en": "Black Grimoire\\n(Warlock)", "description_en": "Use: Profane Knowledge Hero kills and assists empower the Black Grimoire, granting it charges. Right-click to consume and grant %xp_per_charge% experience per charge. Starts on cooldown.   This item cannot be dropped.", "notes_en": [], "attributes": [], "is_item": true}]
