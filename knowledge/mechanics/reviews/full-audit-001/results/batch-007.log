e},{"mechanism":"pierce_evasion","condition":"base","quote":"死亡守卫拥有%bonus_accuracy%%%额外必中率。","uncertain":false},{"mechanism":"aoe_damage","condition":"scepter","quote":"死亡守卫的攻击会向附近英雄弹射。","uncertain":false}]},{"subject":"riki_smoke_screen","mechanisms":[{"mechanism":"silence","condition":"base","quote":"沉默其中的敌人","uncertain":false},{"mechanism":"blind","condition":"base","quote":"同时使他们的攻击落空。","uncertain":false},{"mechanism":"aura","condition":"base","quote":"丢下一个烟雾弹，沉默其中的敌人，同时使他们的攻击落空。","uncertain":false},{"mechanism":"armor_reduction","condition":"shard","quote":"烟幕中的敌人护甲降低%armor_reduction%点","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"shard","quote":"无法成为他们友军的目标。","uncertain":false}]},{"subject":"riki_blink_strike","mechanisms":[{"mechanism":"slow","condition":"base","quote":"如果是敌人对其造成%slow_pct_tooltip%%%短暂减速","uncertain":false},{"mechanism":"self_mobility","condition":"base","quote":"传送到目标背后","uncertain":false}]},{"subject":"riki_tricks_of_the_trade","mechanisms":[{"mechanism":"cyclone_banish","condition":"base","quote":"力丸转移出现实位面","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"Riki phases out of the world","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"每隔一段时间从背后随机攻击附近的%interval_targets%个随机敌方单位。","uncertain":false}]},{"subject":"riki_innate_backstab","mechanisms":[]},{"subject":"riki_backstab","mechanisms":[{"mechanism":"invisibility","condition":"base","quote":"力丸遁入阴影，变为隐身状态","uncertain":false},{"mechanism":"economy","condition":"base","quote":"击杀英雄和助攻会提供额外经验。","uncertain":false}]},{"subject":"enigma_malefice","mechanisms":[{"mechanism":"stun","condition":"base","quote":"使它受到多次伤害并反复被眩晕。","uncertain":false},{"mechanism":"summons","condition":"shard","quote":"每次眩晕都会在目标身旁产生一个虚灵体。这些虚灵体不会再次分裂。","uncertain":false}]},{"subject":"enigma_demonic_conversion","mechanisms":[{"mechanism":"healing","condition":"base","quote":"虚灵会再次分裂，并完全回复生命值。","uncertain":false},{"mechanism":"summons","condition":"base","quote":"召唤三个谜团自身的碎片。虚灵的生命值会有所增加","uncertain":false}]},{"subject":"enigma_midnight_pulse","mechanisms":[{"mechanism":"tree_destroy","condition":"base","quote":"此技能将摧毁范围内的树木。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"使一块区域浸入暗共振中，对敌方单位造成%base_damage% + 基于敌人当前生命值的伤害。","uncertain":false}]},{"subject":"enigma_event_horizon","mechanisms":[{"mechanism":"slow","condition":"base","quote":"%radius%范围内的单位远离谜团时会受到移速惩罚。","uncertain":false},{"mechanism":"aura","condition":"base","quote":"%radius%范围内的单位远离谜团时会受到移速惩罚。","uncertain":false}]},{"subject":"enigma_black_hole","mechanisms":[{"mechanism":"stun","condition":"base","quote":"被黑洞影响的单位不能移动、攻击或施法。","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"Summons a vortex that sucks in nearby enemy units.","uncertain":false},{"mechanism":"aoe_damage","condition":"scepter","quote":"黑洞额外造成等同于单位%scepter_pct_damage%%%最大生命值的每秒伤害","uncertain":false}]}]}
