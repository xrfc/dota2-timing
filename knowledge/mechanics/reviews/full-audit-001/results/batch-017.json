{"objects":[{"subject":"invoker_wex","mechanisms":[]},{"subject":"invoker_exort","mechanisms":[]},{"subject":"invoker_invoke","mechanisms":[{"mechanism":"cooldown_reduction","condition":"base","quote":"每个元素球的等级都会减少%cooldown_reduction_per_orb%秒元素祈唤的冷却时间。","uncertain":false}]},{"subject":"invoker_cold_snap","mechanisms":[{"mechanism":"stun","condition":"base","quote":"敌人将受到伤害并被短暂冻结，后续攻击会使敌人再次冻结并造成额外伤害。","uncertain":false}]},{"subject":"invoker_ghost_walk","mechanisms":[{"mechanism":"invisibility","condition":"base","quote":"使自己隐形并且获得生命和魔法恢复。","uncertain":false},{"mechanism":"healing","condition":"base","quote":"使自己隐形并且获得生命和魔法恢复。","uncertain":false},{"mechanism":"mana_gain","condition":"base","quote":"使自己隐形并且获得生命和魔法恢复。","uncertain":false},{"mechanism":"slow","condition":"base","quote":"各种元素的不平衡导致附近敌人的移动速度被减缓","uncertain":false},{"mechanism":"aura","condition":"base","quote":"各种元素的不平衡导致附近敌人的移动速度被减缓","uncertain":false},{"mechanism":"aoe_damage","condition":"shard","quote":"现在幽灵漫步还会对范围内的敌方英雄施加寒冰之墙的每秒伤害。","uncertain":false}]},{"subject":"invoker_tornado","mechanisms":[{"mechanism":"cyclone_banish","condition":"base","quote":"将路径上的敌方单位卷起，使其在空中无助地漂浮一段时间","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"被强袭飓风吹起时单位处于无敌状态，落地时受到伤害。","uncertain":false},{"mechanism":"applies_basic_dispel","condition":"base","quote":"驱散类型：弱驱散","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"将路径上的敌方单位卷起；被强袭飓风吹起时单位处于无敌状态，落地时受到伤害。","uncertain":false}]},{"subject":"invoker_emp","mechanisms":[{"mechanism":"mana_burn","condition":"base","quote":"爆炸将覆盖一定区域，并根据雷元素的等级损毁敌方的魔法值。","uncertain":false},{"mechanism":"mana_gain","condition":"base","quote":"祈求者将获得%self_mana_restore_pct%%%损毁的魔法。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"爆炸将覆盖一定区域，并根据雷元素的等级损毁敌方的魔法值。对敌方英雄造成损毁魔法值一定百分比的伤害。","uncertain":false},{"mechanism":"displace_other","condition":"shard","quote":"将敌方单位以每秒%drag_speed%距离的速度向电磁脉冲的中心牵引。","uncertain":false}]},{"subject":"invoker_alacrity","mechanisms":[]},{"subject":"invoker_chaos_meteor","mechanisms":[{"mechanism":"aoe_damage","condition":"base","quote":"每隔一段时间撞击一次作用范围内的敌人，造成基于火元素等级的撞击伤害","uncertain":false}]},{"subject":"invoker_sun_strike","mechanisms":[{"mechanism":"aoe_damage","condition":"base","quote":"区域内敌人将平摊所有伤害。","uncertain":false},{"mechanism":"grant_vision","condition":"base","quote":"施放后立即获得目标区域的视野。","uncertain":false},{"mechanism":"economy","condition":"base","quote":"祈求者使用阳炎冲击击杀英雄后，即使不在经验范围内也能获得经验。","uncertain":false},{"mechanism":"summons","condition":"shard","quote":"阳炎冲击对敌方英雄造成伤害时，该地点会产生当前等级的熔炉精灵。","uncertain":false}]},{"subject":"invoker_forge_spirit","mechanisms":[{"mechanism":"summons","condition":"base","quote":"创造出熔炉精灵。熔炉精灵的攻击力和护甲取决于火元素的等级，攻击距离、持续时间和生命值取决于冰元素的等级。","uncertain":false},{"mechanism":"armor_reduction","condition":"base","quote":"元素的灼热攻击能够熔化敌方英雄的护甲。","uncertain":false}]},{"subject":"invoker_ice_wall","mechanisms":[{"mechanism":"slow","condition":"base","quote":"冰霜之墙放射出的寒冰之气将对敌方单位造成减速和伤害","uncertain":false},{"mechanism":"aura","condition":"base","quote":"The bitter cold emanating from it greatly slows nearby enemies","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"冰霜之墙放射出的寒冰之气将对敌方单位造成减速和伤害","uncertain":false},{"mechanism":"root","condition":"scepter","quote":"在浮冰内停留超过%root_delay%秒的敌方英雄会基于冰的等级被缠绕并受到魔法伤害。","uncertain":false}]},{"subject":"invoker_deafening_blast","mechanisms":[{"mechanism":"disarm","condition":"base","quote":"同时让他们无法进行攻击","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"声波的绝对冲击能够将敌方单位击退","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"祈求者在自己前方释放出超强的声波，对所有敌方单位造成伤害","uncertain":false}]},{"subject":"silencer_curse_of_the_silent","mechanisms":[{"mechanism":"slow","condition":"base","quote":"并且移动速度被减缓。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"诅咒目标区域，造成伤害并使敌人持续受到伤害","uncertain":false}]},{"subject":"silencer_glaives_of_wisdom","mechanisms":[{"mechanism":"stat_steal","condition":"base","quote":"每次攻击窃取目标的智力","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"沉默术士用他的智慧强化刀刃，每次攻击窃取目标的智力，并造成基于他智力值的额外伤害。","uncertain":false},{"mechanism":"cleave","condition":"shard","quote":"使智慧之刃向%bounce_range% 范围内的随机敌人弹射%bounce_count%次","uncertain":false},{"mechanism":"aoe_damage","condition":"shard","quote":"使智慧之刃向%bounce_range% 范围内的随机敌人弹射%bounce_count%次","uncertain":false}]},{"subject":"silencer_last_word","mechanisms":[{"mechanism":"grant_vision","condition":"base","quote":"向目标施加魔咒，提供目标的视野","uncertain":false},{"mechanism":"silence","condition":"base","quote":"只要目标施放技能或魔咒消失，目标就会受到伤害并被沉默。","uncertain":false}]},{"subject":"silencer_brain_drain","mechanisms":[{"mechanism":"incoming_damage_amp","condition":"base","quote":"沉默术士对被沉默的目标造成更多伤害","uncertain":false},{"mechanism":"damage_block","condition":"base","quote":"沉默术士对被沉默的目标造成更多伤害，受到来自他们的伤害减少。","uncertain":false},{"mechanism":"stat_steal","condition":"base","quote":"沉默术士都会永久窃取其%permanent_int_steal_amount%点智力。","uncertain":false}]},{"subject":"silencer_global_silence","mechanisms":[{"mechanism":"silence","condition":"base","quote":"阻止地图上所有敌方英雄和单位施法。","uncertain":false},{"mechanism":"pierces_debuff_immunity","condition":"base","quote":"沉默效果对隐身和减益免疫单位有效","uncertain":false},{"mechanism":"slow","condition":"scepter","quote":"全领域静默在全领域静默的持续时间内对英雄施加奥术诅咒。\n诅咒目标区域，造成伤害并使敌人持续受到伤害，并且移动速度被减缓。","uncertain":false},{"mechanism":"aoe_damage","condition":"scepter","quote":"全领域静默在全领域静默的持续时间内对英雄施加奥术诅咒。\n诅咒目标区域，造成伤害并使敌人持续受到伤害","uncertain":false}]},{"subject":"obsidian_destroyer_arcane_orb","mechanisms":[{"mechanism":"attack_modifier","condition":"base","quote":"殁境神蚀者的攻击附带基于剩余魔法值的额外纯粹伤害。","uncertain":false}]},{"subject":"obsidian_destroyer_astral_imprisonment","mechanisms":[{"mechanism":"cyclone_banish","condition":"base","quote":"将其禁锢在星体中。被隐藏的英雄处于无敌和无法行动状态。","uncertain":false},{"mechanism":"invulnerable_untargetable","condition":"base","quote":"被隐藏的英雄处于无敌和无法行动状态。","uncertain":false},{"mechanism":"aoe_damage","condition":"shard","quote":"星体禁锢现在会造成范围伤害。","uncertain":false}]},{"subject":"obsidian_destroyer_objurgation","mechanisms":[{"mechanism":"damage_block","condition":"base","quote":"施放后，殁境神蚀者获得全伤害护盾，数值为固定值 + 最大魔法值的一定百分比。","uncertain":false},{"mechanism":"applies_strong_dispel","condition":"scepter","quote":"阻止生效时，殁境神蚀者获得一次强驱散","uncertain":false}]},{"subject":"obsidian_destroyer_equilibrium","mechanisms":[{"mechanism":"mana_gain","condition":"base","quote":"被动拥有一定几率在施放技能时回复最大魔法值的一定百分比。","uncertain":false}]},{"subject":"obsidian_destroyer_sanity_eclipse","mechanisms":[{"mechanism":"aoe_damage","condition":"base","quote":"Unleashes a psychic blast that deals damage to enemies based on the difference between your max mana and the target's max mana.","uncertain":false}]},{"subject":"lycan_summon_wolves","mechanisms":[{"mechanism":"summons","condition":"base","quote":"召唤%wolf_count%头精灵狼为狼人战斗。","uncertain":false},{"mechanism":"invisibility","condition":"base","quote":"3级精灵狼获得永久隐身","uncertain":false},{"mechanism":"slow","condition":"base","quote":"4级精灵狼获得致残技能，20%几率使目标残废，造成每秒8点伤害，并失去60攻击速度，持续4秒。","uncertain":false},{"mechanism":"phased","condition":"shard","quote":"这个主动技能使精灵狼获得相位移动，闪避，移动速度和攻击速度。","uncertain":false},{"mechanism":"evasion","condition":"shard","quote":"这个主动技能使精灵狼获得相位移动，闪避，移动速度和攻击速度。","uncertain":false}]},{"subject":"lycan_howl","mechanisms":[{"mechanism":"armor_reduction","condition":"base","quote":"狼人和精灵狼周围%radius%范围内所有敌人的护甲和攻击力降低。","uncertain":false},{"mechanism":"attack_damage_reduction","condition":"base","quote":"狼人和精灵狼周围%radius%范围内所有敌人的护甲和攻击力降低。","uncertain":false}]}]}