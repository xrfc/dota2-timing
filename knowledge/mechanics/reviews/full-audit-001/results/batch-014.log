[{"subject": "night_stalker_midnight_feast", "name_zh": "暗夜魔王·午夜盛宴", "name_en": "Midnight Feast", "description_zh": "暗夜魔王攻击敌方单位时治疗自身。在夜晚可以主动施放，秒杀一个非远古非英雄单位，并回复暗夜魔王的最大生命值和最大魔法值的一定百分比。", "description_en": "Night Stalker heals himself when attacking enemy units. At night, the ability can be activated to instantly destroy a non-ancient creep and restore a percentage of Night Stalker's maximum health and mana.", "notes_zh": ["攻击获得的生命值受到生命回复的影响，攻击非英雄目标时会减少。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["attack_heal", "hp_restore", "mp_restore", "AbilityCastRange", "AbilityCooldown"]}, {"subject": "night_stalker_hunter_in_the_night", "name_zh": "暗夜魔王·暗夜猎影", "name_en": "Hunter in the Night", "description_zh": "暗夜魔王在夜晚如鱼得水，攻击和移动都变得迅速。", "description_en": "Night Stalker is in his element at night, attacking and moving with great swiftness.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "移动速度加成提升%bonus_bonus_movement_speed_pct_night%%%，攻击速度加成提升%bonus_bonus_attack_speed_night%。击杀敌方英雄会重置所有基础技能的冷却时间。", "en": "Increases bonus movement speed by %bonus_bonus_movement_speed_pct_night%%% and attack speed by %bonus_bonus_attack_speed_night%. Killing an enemy hero resets all basic ability cooldowns."}}, "is_passive": true, "value_names": ["bonus_movement_speed_pct_night", "bonus_attack_speed_night", "reset_cooldowns", "bonus_status_resist_night"]}, {"subject": "night_stalker_darkness", "name_zh": "暗夜魔王·黑暗飞升", "name_en": "Dark Ascension", "description_zh": "暗夜魔王遮住太阳，让夜晚立刻降临，使他的力量可以得到最大程度的发挥。在此期间暗夜魔王获得飞行能力和攻击力加成。拥有顺畅视野。", "description_en": "Night Stalker smothers the sun and summons instant darkness, so that he might use his powers at their fullest. Night Stalker gains flight and bonus damage during this time. Has unobstructed vision.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "bonus_damage", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "broodmother_insatiable_hunger", "name_zh": "育母蜘蛛·极度饥渴", "name_en": "Insatiable Hunger", "description_zh": "对活物体液的强烈饥渴提高了育母蜘蛛的攻击力，并使她和她的小蜘蛛的攻击附带吸血效果。", "description_en": "A violent lust for vital fluids increases Broodmother's attack damage and gives her and her Spiderlings a vampiric attack.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "开启极度饥渴后，攻击力加成每%shard_damage_tick_interval%秒提升%shard_damage_per_tick%%%。", "en": "While Hunger is active, the bonus damage is increased by %shard_damage_per_tick%%% every %shard_damage_tick_interval%s."}}, "is_passive": false, "value_names": ["bonus_damage", "lifesteal_pct", "duration", "bat_bonus", "shard_damage_per_tick", "shard_damage_tick_interval", "aura_radius", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "broodmother_spin_web", "name_zh": "育母蜘蛛·织网", "name_en": "Spin Web", "description_zh": "编织出一张蜘蛛网，育母蜘蛛在蛛网里被动提升移动速度和转身速率，并且获得无视地形移动的能力。织网现在可向其他蛛网触及的区域全地图施放。蛛网永久存在，不过可以手动摧毁。当其数量超过上限，最早的蛛网将会消失。", "description_en": "Spins a large web that grants Broodmother a passive movement speed increase and increases her Turn Rate, while in its vicinity, as well as giving free movement.Spin Web can be cast from anywhere as long as the new web touches an existing web. Webs never expire, and can be manually destroyed. When the maximum limit of webs is exceeded, the oldest web disappears.", "notes_zh": ["也会作用于小蜘蛛。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "count", "bonus_movespeed", "bonus_turn_rate", "degen", "break_move_cap", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"]}, {"subject": "broodmother_incapacitating_bite", "name_zh": "育母蜘蛛·麻痹之咬", "name_en": "Incapacitating Bite", "description_zh": "育母蜘蛛用毒液削弱敌方单位，使她的攻击带有减速效果，中毒单位的攻击有一定概率落空，并且被攻击时承受额外伤害。", "description_en": "Broodmother's venom cripples enemy units, causing her attacks to slow and giving the affected unit a chance to miss its attacks and extra damage from attacks.", "notes_zh": ["攻击落空几率与闪避和上下坡丢失叠加。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["miss_chance", "bonus_movespeed", "duration", "attack_damage"]}, {"subject": "broodmother_sticky_snare", "name_zh": "育母蜘蛛·蛛纱陷阱", "name_en": "Spinner's Snare", "description_zh": "育母蜘蛛可以制造出最多%count%个触碰已有蛛网的隐形网线。敌方英雄穿过网线将会触发陷阱，被缠绕，在战争迷雾中显形，并持续受到伤害。网线一开始被触发后，多名英雄还可以在同根网线上被绊倒，直到网线被摧毁。只要有人触发陷阱，育母蜘蛛的队友就会在小地图上发现。", "description_en": "Broodmother may create up to %count% invisible web lines touching any existing web. Enemy Heroes that cross the web line will spring the trap, becoming rooted, revealed in fog, and take damage over time.  Multiple Heroes can trip on the same line until it's destroyed after being initially triggered.  Broodmother's team is alerted via the minimap when an enemy has triggered the snare.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["formation_delay", "root_duration", "damage_per_second", "count", "width", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"]}, {"subject": "broodmother_spiders_milk", "name_zh": "育母蜘蛛·蜘蛛奶", "name_en": "Spider's Milk", "description_zh": "育母蜘蛛击杀一个单位后，她和%kill_heal_aoe%范围内她控制的所有单位都会获得持续%kill_heal_duration%秒的状态效果，每%tick_rate%秒治疗一定生命，治疗量为遇害者生命值的一定百分比。非英雄单位提供的治疗量减少%kill_creeps_penalty%%%。", "description_en": "Whenever Broodmother kills a unit, she and all units under her control in a %kill_heal_aoe% radius receive a buff for %kill_heal_duration%s that heals them for a percentage of the victim's health every %tick_rate% seconds. Healing from creeps is reduced by %kill_creeps_penalty%%%.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["kill_heal_heroes", "kill_creeps_penalty", "kill_heal_aoe", "kill_heal_duration", "tick_rate"]}, {"subject": "broodmother_spawn_spiderlings", "name_zh": "育母蜘蛛·孵化蜘蛛", "name_en": "Spawn Spiderlings", "description_zh": "育母蜘蛛将她的卵注入敌人体内，造成伤害和减速，持续%slow_duration%秒。如果目标在感染期间被击杀，卵会孵化成小蜘蛛。", "description_en": "Broodmother injects her young into an enemy unit, dealing damage and slowing them for %slow_duration% seconds. The spiderlings will hatch if the target is killed while under this influence.", "notes_zh": ["如果目标在受到此技能后%buff_duration%秒内被杀死，小蜘蛛就会孵化。", "被小蜘蛛杀死的单位会生出额外的小蜘蛛。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["buff_duration", "spiderling_duration", "damage", "damage_bonus", "hp_bonus", "count", "projectile_speed", "tooltip_spiderling_hp", "slow_duration", "movement_speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bounty_hunter_shuriken_toss", "name_zh": "赏金猎人·投掷飞镖", "name_en": "Shuriken Toss", "description_zh": "向一个敌方单位掷出一枚致命的飞镖，对目标造成伤害，并且减缓目标的移动速度。只要目标周围%bounce_aoe%范围内存在被追踪术标记的单位，飞镖就能向其弹射。", "description_en": "Hurls a deadly shuriken at an enemy unit, dealing damage and slowing the target's movement speed.  The shuriken will bounce to any Tracked units who are within a %bounce_aoe% radius of each other.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离并且击中时施加忍术。", "en": "Increases cast range and applies Jinada on hit."}}, "is_passive": false, "value_names": ["bonus_damage", "speed", "bounce_aoe", "slow_duration", "scepter_cooldown", "passthrough_width", "cast_range", "slow", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bounty_hunter_jinada", "name_zh": "赏金猎人·忍术", "name_en": "Jinada", "description_zh": "赏金猎人准备好他的下次攻击，造成额外伤害并窃取若干不可靠金钱。", "description_en": "Bounty Hunter plans his next hit, dealing bonus damage and stealing some unreliable gold.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "gold_steal", "AbilityCastRange", "AbilityCooldown"]}, {"subject": "bounty_hunter_wind_walk", "name_zh": "赏金猎人·暗影步", "name_en": "Shadow Walk", "description_zh": "赏金猎人进入隐身，获得移动速度加成，并能够穿越其它单位，直到他攻击或使用技能。破隐一击会短暂眩晕目标。", "description_en": "Bounty Hunter becomes invisible and gains bonus movement speed and the ability to move through other units until he attacks or casts a spell.  If he breaks the invisibility with an attack, that attack will stun the target for a short duration.", "notes_zh": ["开启后不会打断大多数持续施法技能。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "fade_time", "stun_duration", "ally_fade_time", "damage_reduction_pct", "bonus_move_speed_pct", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bounty_hunter_wind_walk_ally", "name_zh": "赏金猎人·暗影情谊", "name_en": "Friendly Shadow", "description_zh": "对友军目标施加暗影步及其所有加成效果。友方单位的渐隐时间是%fade_time%秒。施放时不会使赏金猎人脱离隐身状态。", "description_en": "Applies Shadow Walk and all of its bonuses to the target ally. Allied fade time is %fade_time%s. Does not break Bounty Hunter's invisibility when cast.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["fade_time", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "bounty_hunter_big_game_hunter", "name_zh": "赏金猎人·职业猎人", "name_en": "Big Game Hunter", "description_zh": "如果阵亡的敌人是重大目标，赏金猎人获得的击杀和助攻金钱提升%kill_assist_gold_bonus_percent%%%。敌方英雄的财产总和在他们团队中排名为前三就被视为重大目标。", "description_en": "Bounty Hunter receives %kill_assist_gold_bonus_percent%%% more kill and assist gold if the dying enemy hero is Big Game. An enemy hero is considered Big Game if they are one of the top 3 net worth heroes on the enemy team.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["kill_assist_gold_bonus_percent"]}, {"subject": "bounty_hunter_track", "name_zh": "赏金猎人·追踪术", "name_en": "Track", "description_zh": "追踪一个敌方英雄，获得目标的真实视域，使目标受到的伤害增加，同时掌握目标当前携带的金钱数额。如果目标在被追踪期间死亡，赏金猎人和附近友方英雄都将获得若干金钱奖励。施放追踪术不会脱离隐身。", "description_en": "Tracks an enemy hero, granting True Sight of the target, increasing the damage they take and providing information on how much gold it is carrying. If the target dies, Bounty Hunter and nearby heroes collect a bonus bounty of gold. Casting Track does not take you out of invisibility.", "notes_zh": ["只要目标在追踪术期间以任何方式死亡，赏金猎人都能获得金钱奖励。", "追踪术效果仅对友方单位可见。", "鼠标移至目标技能栏上方的负面效果图标可以看到目标携带的金钱数额。", "金钱奖励为不可靠金钱。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["target_damage_amp", "bonus_gold_radius", "bonus_gold_self", "bonus_gold", "duration", "gold_steal", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "weaver_the_swarm", "name_zh": "编织者·虫群", "name_en": "The Swarm", "description_zh": "编织者放出%count%只编织者幼虫，每只幼虫都会紧紧缠住它遇到的敌人，攻击敌人并削弱他们的护甲，直到幼虫被杀死。", "description_en": "Weaver launches a swarm of %count% young Weavers that latch on any enemy unit in their path, attacking and reducing armor until it is killed.", "notes_zh": ["甲虫抓住目标后将一直留在目标身上，除非甲虫被击杀或持续时间结束。", "甲虫免疫技能，需要一个单位的%destroy_attacks%次攻击才能被击杀。英雄造成双倍伤害。", "幼虫提供视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "attack_rate", "count", "armor_reduction", "duration", "destroy_attacks", "radius", "speed", "spawn_radius", "shard_cooldown_reduction", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "weaver_shukuchi", "name_zh": "编织者·缩地", "name_en": "Shukuchi", "description_zh": "编织者进入隐身身，达到移动速度上限，在穿过敌方单位时还将造成伤害。", "description_en": "Weaver shifts out of visibility, gaining max movement speed and doing harm to any enemies it passes through.", "notes_zh": ["每次施放的技能只能对相同单位造成一次伤害。"], "granted_by": "", "upgrades": {"shard": {"zh": "缩地在造成伤害的敌人身上留下一个标记，持续%geminate_attack_mark_duration%秒。编织者脱离缩地状态%shukuchi_attack_delay%秒后，附近%shukuchi_attack_mark_radius%范围内拥有印记的敌人都会被连击的第二次攻击击中。", "en": "Shukuchi puts a mark on enemies it damages that last %geminate_attack_mark_duration% seconds. %shukuchi_attack_delay%s after Weaver exits Shukuchi, enemies with a mark within %shukuchi_attack_mark_radius% range will also be attacked with a secondary Geminate attack"}}, "is_passive": false, "value_names": ["damage", "speed", "radius", "fade_time", "duration", "geminate_attack_mark_duration", "min_movespeed_override", "shukuchi_attack_mark_radius", "shukuchi_attack_delay", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "weaver_geminate_attack", "name_zh": "编织者·连击", "name_en": "Geminate Attack", "description_zh": "允许编织者立刻发动两次攻击。", "description_en": "Allows Weaver to dispatch two attacks at once.", "notes_zh": ["第二次攻击将在编织者第一次攻击的%delay%秒后发出，并且没有距离限制。", "额外伤害仅对连击的攻击有效，初始攻击没有额外伤害。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["delay", "extra_attack", "bonus_damage", "shard_beetle_search_range", "AbilityCastRange", "AbilityCooldown"]}, {"subject": "weaver_time_lapse", "name_zh": "编织者·时光倒流", "name_en": "Time Lapse", "description_zh": "编织者回到五秒前的时间点，获得当时的生命值和魔法值。不影响冷却时间、金钱和经验。\n\n驱散类型：强驱散", "description_en": "Weaver warps backward to whatever position it was in five seconds earlier--regaining the HP and mana from that time. No effect on cooldown, gold or experience.\n\nDISPEL TYPE: Strong Dispel", "notes_zh": ["能够移除编织者身上大部分的负面状态。", "时光倒流可以躲避攻击和技能弹道。"], "granted_by": "", "upgrades": {"scepter": {"zh": "时光倒流可以对%abilitycastrange%施法距离内的友方英雄施放。", "en": "Time Lapse may target allied Heroes with %abilitycastrange% cast range."}}, "is_passive": false, "value_names": ["targets_allies", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "weaver_threads_of_fate", "name_zh": "编织者·命运之线", "name_en": "Threads of Fate", "description_zh": "每当编织者的攻击或技能对敌方英雄造成伤害后，如果编织者在他们%thread_setup_distance%范围内停留达到%thread_setup_time%秒，他就会织出命运之线，短暂减速敌人并把他们与编织者相连。每织出一条命运之线就会使编织者获得攻击力加成。", "description_en": "Whenever Weaver deals damage to an enemy hero with an attack or ability, if he remains within %thread_setup_distance% range of them for %thread_setup_time%s, he establishes a Thread of Fate that briefly slows the enemy and ties Weaver and the enemy together. Each established thread of fate grants bonus damage to Weaver.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["thread_setup_distance", "thread_setup_time", "established_thread_duration", "established_thread_break_distance", "damage_per_thread_hero", "death_linger_duration", "slow_duration", "slow_percent"]}, {"subject": "jakiro_dual_breath", "name_zh": "杰奇洛·冰火交加", "name_en": "Dual Breath", "description_zh": "杰奇洛对面前的敌人先后喷出寒冰和火焰。寒冰吐息减速敌人，火焰吐息对敌人造成持续伤害。", "description_en": "An icy blast followed by a wave of fire launches out in a path in front of Jakiro. The ice slows enemies, while the fire delivers damage over time.", "notes_zh": ["最远能伤害1025距离外的单位。", "两次吐息有%fire_delay%秒的间隔。", "不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_radius", "end_radius", "speed", "fire_delay", "burn_damage", "slow_movement_speed_pct", "slow_attack_speed_pct", "speed_fire", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "jakiro_ice_path", "name_zh": "杰奇洛·冰封路径", "name_en": "Ice Path", "description_zh": "在杰奇洛前方制造一条冰封路径，对触及到的敌人造成伤害并眩晕。", "description_en": "Creates a path of ice that stuns and damages enemies that touch it.", "notes_zh": ["路径完全成形需要%path_delay%秒。", "冰封路径消失后眩晕效果也会消失。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["path_delay", "stun_duration", "path_duration", "path_radius", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "jakiro_liquid_fire", "name_zh": "杰奇洛·液态火", "name_en": "Liquid Fire", "description_zh": "杰奇洛的火焰燃烧效果范围内的敌人，并降低他们的攻击速度。和液态冰共用冷却时间。", "description_en": "Jakiro burns his enemies in an area of effect with fire added to his attack, while slowing their attacks. Shares a cooldown with Liquid Frost.", "notes_zh": ["对单位和建筑都有效。"], "granted_by": "", "upgrades": {"shard": {"zh": "杰奇洛的液态火没有魔法消耗，并且不再和液态冰共用冷却时间。", "en": "Jakiro's Liquid Fire has no mana cost and no longer shares a cooldown with Liquid Frost."}}, "is_passive": false, "value_names": ["slow_attack_speed_pct", "radius", "damage", "pct_health_damage", "tick_rate", "building_dmg_pct", "shares_cooldown", "AbilityCastRange", "AbilityDuration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "jakiro_liquid_ice", "name_zh": "杰奇洛·液态冰", "name_en": "Liquid Frost", "description_zh": "杰奇洛的攻击使他的敌人受寒，减缓其移动速度，持续%duration%秒，并且被杰奇洛的攻击和其他技能击中后承受额外伤害。这个效果对建筑无效。与液态火共用冷却时间。", "description_en": "Jakiro chill his enemies with ice added to his attack, slowing movement for %duration% seconds and increasing damage taken from Jakiro's attacks and abilities. This effect does not apply to buildings. Shares a cooldown with Liquid Fire.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "杰奇洛的液态冰没有魔法消耗，并且不再和液态火共用冷却时间。", "en": "Jakiro's Liquid Frost has no mana cost and no longer shares a cooldown with Liquid Fire."}}, "is_passive": false, "value_names": ["movement_slow", "damage", "bonus_instance_damage_from_other_abilities", "pct_health_damage", "duration", "tick_rate", "shares_cooldown", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "jakiro_double_trouble", "name_zh": "杰奇洛·天生一对", "name_en": "Double Trouble", "description_zh": "杰奇洛攻击时两个头都会发动攻击，不过每个头造成的伤害减少。", "description_en": "Jakiro's attacks launch an attack from each head, but deal less damage each.", "notes_zh": ["第二次攻击无视伤害格挡。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["second_attack_delay", "attack_damage_reduction"]}]
