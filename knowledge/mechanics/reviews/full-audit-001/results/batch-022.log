aspd_increase_mana_cost_pct", "aspd_increase_max_aspd_time", "attack_buff_cooldown", "min_duration"]}, {"subject": "medusa_stone_gaze", "name_zh": "美杜莎·石化凝视", "name_en": "Stone Gaze", "description_zh": "任何盯着蛇发女妖的敌方单位的攻击速度和移动速度均将被减缓。如果一单位在石化凝视期间盯着蛇发女妖超过%face_duration%秒，该单位会被完全石化。被石化的单位处于眩晕状态，受到物理攻击时承受额外伤害。", "description_en": "Any enemy units looking at Medusa will have their movement and attack speed slowed.  If %face_duration% seconds of total time is accumulated looking at Medusa while Stone Gaze is active, that unit will turn to stone.  Petrified units are stunned, and take bonus physical attack damage.", "notes_zh": ["无论敌方单位是在美杜莎施放技能期间的何时受到石化凝视作用，他受到的技能效果都是满额的持续时间。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "slow", "stone_duration", "face_duration", "vision_cone", "bonus_physical_damage", "speed_boost", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "troll_warlord_switch_stance", "name_zh": "巨魔战将·战斗姿态", "name_en": "Battle Stance", "description_zh": "巨魔战将从使用远程攻击切换为近战攻击。近战下巨魔战将的基础攻击间隔降低至%base_attack_time%。巨魔战将每拥有%attack_speed_interval%攻击速度加成获得%armor_per_interval%点护甲。", "description_en": "Troll Warlord swaps from using ranged to melee attacks. While melee, Troll Warlord's base attack time is improved to %base_attack_time%.Troll Warlord gains %armor_per_interval% armor per %attack_speed_interval% bonus attack speed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_range", "base_attack_time", "armor_per_interval", "attack_speed_interval", "armor_bonus_tooltip", "AbilityCastPoint"]}, {"subject": "troll_warlord_whirling_axes_ranged", "name_zh": "巨魔战将·旋风飞斧（远程）", "name_en": "Whirling Axes (Ranged)", "description_zh": "巨魔战将掷出手中的五把飞斧，减速并伤害前方%axe_range%范围锥形区域内的敌方单位。", "description_en": "Troll hurls a fistful of five axes in a cone shape over %axe_range% range, slowing and damaging enemy units.", "notes_zh": ["无法作用于肉山。", "不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "旋风飞斧（远程）可以驱散敌人。降低冷却时间和魔法消耗。驱散类型：弱驱散", "en": "Causes Whirling Axes (Ranged) to dispel enemies. Reduces cooldown and mana cost.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["axe_width", "axe_speed", "axe_range", "axe_damage", "axe_slow_duration", "movement_speed", "axe_spread", "axe_count", "pierces_magic_immunity", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "troll_warlord_whirling_axes_melee", "name_zh": "巨魔战将·旋风飞斧（近战）", "name_en": "Whirling Axes (Melee)", "description_zh": "巨魔战将掷出两把飞斧环绕在他周围，使敌方单位受到伤害，并且部分普通攻击将不能命中。", "description_en": "Troll hurls two axes around him in a close range area of effect, damaging enemy units and causing them to miss some attacks.", "notes_zh": ["无法作用于肉山。"], "granted_by": "", "upgrades": {"scepter": {"zh": "旋风飞斧（近战）可以驱散自己。降低冷却时间和魔法消耗。驱散类型：弱驱散", "en": "Causes Whirling Axes (Melee) to dispel Troll Warlord. Reduces cooldown and mana cost.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["damage", "hit_radius", "max_range", "axe_movement_speed", "blind_duration", "blind_pct", "whirl_duration", "pierces_magic_immunity", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "troll_warlord_fervor", "name_zh": "巨魔战将·热血战魂", "name_en": "Fervor", "description_zh": "当巨魔战将持续攻击同一个目标时，他会攻击得越来越快。如果改变目标，则额外的攻速加成清零。", "description_en": "With each continuous blow on the same target, Troll gains increased attack speed.  If Troll changes targets, the stacks drop to zero.", "notes_zh": ["破坏会使技能无法获得新的叠加效果。", "破坏会使阿哈利姆魔晶的几率触发失效。"], "granted_by": "", "upgrades": {"shard": {"zh": "巨魔战将在攻击敌方单位时拥有%base_chance%%% + 热血战魂叠加次数*%extra_attack_chance_per_stack%%%的几率对远程攻击距离 + %range_buffer%范围内任意单位发动一次额外的远程攻击。", "en": "Grants Troll %base_chance%%% + %extra_attack_chance_per_stack%%% chance per Fervor stack of firing an additional ranged attack to any unit within its ranged attack range plus %range_buffer% when attacking an enemy unit."}}, "is_passive": true, "value_names": ["attack_speed", "max_stacks", "stack_limit_during_battle_trance", "extra_attack_chance_per_stack", "base_chance", "armor_per_stack", "range_buffer"]}, {"subject": "troll_warlord_berserkers_rage", "name_zh": "巨魔战将·狂战士之怒", "name_en": "Berserker's Rage", "description_zh": "近战形态下巨魔战将的攻击有几率触发诱捕，阻止目标移动或使用位移类技能。另外近战形态下还拥有额外移动速度。远程形态下巨魔战将的攻击有几率使目标残废，造成额外伤害，并且降低目标的移动和攻击速度。", "description_en": "While in melee form, Troll Warlord's attacks have a chance to ensnare, preventing the target from moving or using mobility spells and has additional movement speed.When in ranged form, Troll Warlord's attacks have a chance to Maim the target, dealing bonus damage, and slowing the target's movement and attack speed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_move_speed", "bonus_range", "base_attack_time", "ensnare_chance", "ensnare_duration", "maim_chance", "maim_duration", "maim_slow", "maim_attack_slow", "maim_damage"]}, {"subject": "troll_warlord_battle_trance", "name_zh": "巨魔战将·战斗专注", "name_en": "Battle Trance", "description_zh": "巨魔战将释放出强大的战斗专注，强迫自身持续攻击%range%距离内最近的敌方单位，以英雄优先。专注期间不会因伤害而阵亡。提供额外吸血，攻击速度，减速抗性和移动速度。施放时施加弱驱散。 \n\n驱散类型：弱驱散", "description_en": "Troll unleashes a powerful battle trance, that forces you to continuously attack the closest enemy unit within %range% range, prioritizing heroes. Damage does not kill you during this mode. Grants you bonus lifesteal, attack speed, slow resistance and movement speed. Applies a Basic Dispel.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["巨魔战将在战斗专注作用下仍然可以使用他的物品技能，但是无法执行其他指令。", "斧王的淘汰之刃还是能斩杀巨魔战将。", "巨魔战将会获得目标的视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["trance_duration", "lifesteal", "attack_speed", "attack_speed_share_percent", "movement_speed", "slow_resistance", "range", "stack_limit_tooltip", "ignore_attack_speed_limit", "strong_dispel", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "centaur_hoof_stomp", "name_zh": "半人马战行者·马蹄践踏", "name_en": "Hoof Stomp", "description_zh": "经过短暂的蓄力后，半人马战行者猛踏地面，眩晕并伤害身边的敌方单位。在延迟期间，他被缴械，但可以移动。", "description_en": "After a brief windup, Centaur Warrunner slams the ground, stunning and damaging nearby enemy units. During the delay, he is disarmed but can move.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "stomp_damage", "stun_duration", "windup_time", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "centaur_double_edge", "name_zh": "半人马战行者·双刃剑", "name_en": "Double Edge", "description_zh": "半人马战行者以猛烈的力量进行近战攻击，对目标周围单位和自身造成伤害。将基于力量值造成额外伤害。此技能无法用于自杀。", "description_en": "Centaur strikes a mighty blow at melee range, damaging both himself and a small area around the target. Deals extra damage based on your strength. Centaur cannot die from Double Edge.", "notes_zh": ["双刃剑对目标和自身都造成魔法伤害。"], "granted_by": "", "upgrades": {"shard": {"zh": "双刃剑可以对敌人造成减速，并且每击中一名英雄都会暂时提升半人马战行者的力量值。每次叠加都会刷新持续时间，最多叠加%shard_max_stacks%次。", "en": "Causes Double Edge to slow enemy heroes and increase Centaur's strength per hero hit for a short time. Duration refreshes per stack, up to a max of %shard_max_stacks% stacks."}}, "is_passive": false, "value_names": ["edge_damage", "strength_damage", "radius", "shard_str_pct", "shard_str_duration", "shard_max_stacks", "shard_movement_slow", "shard_movement_slow_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "centaur_return", "name_zh": "半人马战行者·反伤", "name_en": "Retaliate", "description_zh": "半人马战行者向攻击他的单位发出反击。反弹固定伤害加上自身力量的一定百分比。对防御塔的伤害减半。", "description_en": "Centaur counters all attacks, dealing damage back to the attacker. Returns a fixed amount plus a percentage of your strength. Deals half damage to towers.", "notes_zh": ["反伤会在受到攻击时触发。", "反伤能对防御塔造成伤害。", "这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["return_damage", "return_damage_str", "aura_radius", "aura_enabled"]}, {"subject": "centaur_work_horse", "name_zh": "半人马战行者·马到成功", "name_en": "Work Horse", "description_zh": "半人马战行者套上一辆便车。开启后半人马战行者获得当前等级奔袭冲撞的加成效果，而且可以对友方目标施放便车。", "description_en": "Centaur hitches a cart behind him. While active, Centaur gains the benefit of Stampede for the current level of Stampede, and can cast Hitch a Ride on a target ally.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["duration", "melee_attack_range", "air_duration", "air_height", "break_distance", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "centaur_stampede", "name_zh": "半人马战行者·奔袭冲撞", "name_en": "Stampede", "description_zh": "半人马战行者带领所有队友向胜利冲锋，所有友方英雄达到极限移动速度，并使踩到的敌人减速。每个敌人只会受到一次踩踏作用，并受到基于半人马战行者力量值的伤害。", "description_en": "Centaur leads all allies into a vicious charge causing them to move through units at max speed and slow any enemy units they trample. Trampled enemies take damage based on Centaur Warrunner's strength. Each enemy can be trampled once.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "scepter_bonus_duration", "strength_damage", "slow_duration", "radius", "slow_movement_speed", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "centaur_horsepower", "name_zh": "半人马战行者·开足马力", "name_en": "Horsepower", "description_zh": "半人马战行者获得移动速度加成，数值为%strength_to_movement_pct%%%自身力量值。这个移动速度加成不与鞋类物品叠加。", "description_en": "Centaur Warrunner gains %strength_to_movement_pct%%% of his strength as bonus movement speed. This Movement speed bonus does not stack with bonuses from boots.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["strength_to_movement_pct", "current_speed"]}, {"subject": "magnataur_shockwave", "name_zh": "马格纳斯·震荡波", "name_en": "Shockwave", "description_zh": "马格纳斯放出一道能量波，对一条直线上的敌方单位造成伤害，并将他们朝自身牵引，同时受到短暂减速效果。", "description_en": "Magnus sends out a wave of force, damaging enemy units in a line, pulling them towards him, and slowing them for a brief period.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["shock_speed", "shock_width", "shock_damage", "movement_slow", "slow_duration", "pull_duration", "pull_distance", "max_level", "basic_slow_duration", "return_damage_pct", "return_shockwave_bonus_distance", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "magnataur_empower", "name_zh": "马格纳斯·授予力量", "name_en": "Empower", "description_zh": "对友军施放时，给予攻击力加成并使其获得分裂效果。\n\n授予力量总是在马格纳斯身上生效，拥有%self_multiplier%%%额外效果。", "description_en": "When cast on an ally, grants them bonus damage and cleave on attack. \n\n Empower is always on Magnus with %self_multiplier%%% larger bonus.", "notes_zh": ["攻击力加成根据基础攻击力和主属性加成计算。", "分裂伤害无视减益免疫。", "远程单位的攻击没有分裂效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["empower_duration", "bonus_damage_pct", "cleave_damage_pct", "cleave_starting_width", "cleave_ending_width", "cleave_distance", "self_multiplier", "always_on", "self_multiplier_bonus_max_stacks", "self_multiplier_bonus_per_stack", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "magnataur_skewer", "name_zh": "马格纳斯·巨角冲撞", "name_en": "Skewer", "description_zh": "马格纳斯向前冲刺，用他巨大的犀角将敌人挑起。被击中的英雄将被拽至终点，然后受到伤害并且移动速度被减缓。根据行进的距离伤害也会提升。", "description_en": "Magnus rushes forward, goring enemy units on his massive tusk. Heroes hit on the way will be dragged to the destination, then damaged and affected by slowed movement speed. The damage is increased based on distance traveled.", "notes_zh": ["马格纳斯受到眩晕、妖术或放逐作用时，巨角冲撞都会被打断。"], "granted_by": "", "upgrades": {"shard": {"zh": "提升距离，并且使敌人穿过树木和高台时造成额外伤害。", "en": "Increases range and deals additional damage when skewering enemies into trees or cliffs."}}, "is_passive": false, "value_names": ["skewer_speed", "range", "slow_pct", "skewer_radius", "slow_duration", "skewer_damage", "damage_distance_pct", "tree_radius", "tree_hit_damage", "cliff_hit_damage", "terrain_hit_cooldown", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "magnataur_horn_toss", "name_zh": "马格纳斯·长角抛物", "name_en": "Horn Toss", "description_zh": "马格纳斯顶起前方的敌人，将其甩在身后。敌人受到伤害，滞空%air_duration%秒并处于眩晕状态，而且落地后还会眩晕一段时间。", "description_en": "Magnus tosses any enemies in front of him, launching them to his rear. Enemies take damage, spend %air_duration% seconds in the air, and are stunned while in the air and an additional amount of time after landing.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["damage", "radius", "air_duration", "air_height", "slow_duration", "pull_offset", "destination_offset", "pull_angle", "horn_toss_slow_pct", "stun_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "magnataur_solid_core", "name_zh": "马格纳斯·坚固核心", "name_en": "Solid Core", "description_zh": "马格纳斯的减速抗性得到提升，并且受到敌人技能和物品的击退效果减少。", "description_en": "Magnus has increased slow resistance and suffers less knockback from enemy's abilities and items.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["knockback_reduction", "slow_resistance"]}, {"subject": "magnataur_reverse_polarity", "name_zh": "马格纳斯·两极反转", "name_en": "Reverse Polarity", "description_zh": "马格纳斯改变物质的属性，将附近的敌人拖拽至他的前方，并且以震击对他们造成伤害和眩晕。", "description_en": "Magnus changes properties of matter, pulling all nearby enemies in front of him and stunning them with a damaging slam.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["pull_radius", "push_radius", "max_knockback_distance", "knockback_height", "polarity_damage", "hero_stun_duration", "pull_duration", "stat_buff_duration", "stats_per_stack", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shredder_whirling_death", "name_zh": "伐木机·死亡旋风", "name_en": "Whirling Death", "description_zh": "伐木机使极其锋利的刀刃飞旋，对敌人造成伤害并摧毁他周围的树木。如果敌方英雄受到了作用，他的主属性将在短时间内降低少许。如果该技能施放过程中砍倒了树木则会根据砍倒的数量造成额外伤害。", "description_en": "Timbersaw whirls extremely sharp edges, damaging enemies and destroying trees around him in an area. If an enemy hero is affected, it loses some of its primary attribute for a short duration. Whirling Death will deal bonus damage per tree destroyed.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["whirling_radius", "whirling_damage", "tree_damage_scale", "whirling_tick", "stat_loss_pct", "stat_loss_univ", "duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shredder_timber_chain", "name_zh": "伐木机·伐木锯链", "name_en": "Timber Chain", "description_zh": "伐木机发射一条锯链，锯链会嵌入第一棵碰到的树里，然后将他拉向那棵树。行进过程中任何碰到的敌方单位都会受到伤害。", "description_en": "Timbersaw fires a chain that embeds itself in the first tree it hits, pulling him towards it.  Any enemy in the path takes damage.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["chain_radius", "radius", "speed", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shredder_reactive_armor", "name_zh": "伐木机·活性护甲", "name_en": "Reactive Armor", "description_zh": "伐木机每受到一次物理攻击，他的生命恢复和护甲值都会提升。英雄攻击提供%stacks_per_hero_attack%倍提升。", "description_en": "Each time Timbersaw is attacked, he gains increased health regen and armor. Hero attacks are counted as %stacks_per_hero_attack%x the amount.", "notes_zh": ["破坏会使技能无法获得新的叠加效果。", "破坏不会使现有叠加效果提供的加成失效。"], "granted_by": "", "upgrades": {"scepter": {"zh": "活性护甲可以主动施放，获得最大叠加次数和%initial_shield%点生命的护盾。护盾的恢复速度为每秒%shield_per_sec% + 伐木机%radius%范围内每名敌方英雄都会增加%shield_per_sec_per_enemy%，最高为%max_shield%。%duration%秒后伐木机会对%explosion_radius%范围内每个英雄造成伤害，数值为%base_explosion% + 护盾剩余生命，而且失去全部护盾。", "en": "Reactive Armor can now be activated to get max stacks and %initial_shield% damage barrier. Grants Timbersaw %shield_per_sec% + %shield_per_sec_per_enemy% barrier amount per second for each enemy hero within %radius% radius of Timbersaw up to a maximum of %max_shield%. After %duration% seconds, Timbersaw deals damage to every hero within %explosion_radius% radius equal to %base_explosion% + his remaining barrier amount and loses all of his barrier."}}, "is_passive": true, "value_names": ["bonus_armor", "bonus_hp_regen", "stack_limit", "stack_duration", "stacks_per_hero_attack", "initial_shield", "shield_per_sec", "shield_per_sec_per_enemy", "max_shield", "duration", "radius", "explosion_radius", "base_explosion", "AbilityManaCost", "AbilityCooldown"]}]
