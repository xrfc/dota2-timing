[{"subject": "keeper_of_the_light_chakra_magic", "name_zh": "光之守卫·查克拉魔法", "name_en": "Chakra Magic", "description_zh": "恢复目标单位的魔法值，并减少所有冷却中基础技能（非大招）的冷却时间。对自身使用时效果提升%self_bonus%%%。", "description_en": "Restores mana to the target unit and reduces cooldowns of all basic abilities currently on cooldown by a fixed amount. Is %self_bonus%%% more effective when used on himself.", "notes_zh": ["查克拉魔法无法减少终极技能的冷却时间。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["mana_restore", "cooldown_reduction", "mana_leak_pct", "duration", "self_bonus", "strong_dispel", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_radiant_bind", "name_zh": "光之守卫·炎阳之缚", "name_en": "Solar Bind", "description_zh": "削弱一个敌人的魔法抗性，并施加减速效果，目标移动的距离越长，减速效果越大。", "description_en": "Weakens an enemy's magical resistance, and applies a slow that increases in strength the more the target moves.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "获得%AbilityCharges%点能量点数。", "en": "Grants %AbilityCharges% charges."}}, "is_passive": false, "value_names": ["duration", "slow", "magic_resistance", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_will_o_wisp", "name_zh": "光之守卫·灵光", "name_en": "Will-O-Wisp", "description_zh": "在目标区域召唤幻火。幻火交替闪亮和闪灭。闪亮时蛊惑敌人靠近，并造成伤害。", "description_en": "Summons Ignis Fatuus at the targeted area. Alternates on and off, drawing enemies closer with its mesmerising flicker.", "notes_zh": ["幻火会对作用范围内所有敌人施加朝其牵引的效果，该牵引效果不会打断。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["on_count", "radius", "hit_count", "wisp_damage", "off_duration", "on_duration", "off_duration_initial", "fixed_movement_speed", "wisp_duration_tooltip", "bounty", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_spirit_form", "name_zh": "光之守卫·灵魂形态", "name_en": "Spirit Form", "description_zh": "伊扎洛暂时使身体发光，获得施法距离加成，提升光明速度的移速加成，并且冲击波将由一个单独的灵魂施法，可以治疗友军。", "description_en": "Ezalor temporarily turns his body luminescent, gaining cast range, increasing the speed bonus from Bright Speed, and allows Illuminate to be channeled by a separate spirit and heal allies.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升冲击波的治疗效果。", "en": "Increases illuminate heal."}}, "is_passive": false, "value_names": ["duration", "movement_speed", "cast_range", "illuminate_heal", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_bright_speed", "name_zh": "光之守卫·光明速度", "name_en": "Bright Speed", "description_zh": "光之守卫每%intelligence_per_speed%点智力都会获得1移动速度。只要光之守卫移动%movement_per_vision%距离，他就会留下一道光，可以看到%vision_radius%范围，持续%vision_duration%秒。", "description_en": "Keeper of the Light gains 1 movement speed for every %intelligence_per_speed% Intelligence.Whenever Keeper of the Light moves %movement_per_vision% distance, he leaves behind light that allows him to see %vision_radius% range for %vision_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["intelligence_per_speed", "movement_per_vision", "vision_radius", "vision_duration", "current_speed"]}, {"subject": "wisp_tether", "name_zh": "艾欧·羁绊", "name_en": "Tether", "description_zh": "将艾欧和一个友方单位连接在一起，提高双方的移动速度。当艾欧回复生命或魔法时，连在一起的友军将获得一部分回复效果。距离过远时连接将会断开，也可以主动断开连接。羁绊会减速触碰到的敌人。", "description_en": "Tethers Io to an allied unit, granting bonus movement speed to both. When Io restores health or mana, the tethered unit gains a portion of that amount. The tether breaks when the allied unit moves too far away, or Io cancels the tether. Tether slows enemies touching it.", "notes_zh": ["如果羁绊的目标距离艾欧700码以外，艾欧将链接目标并将自己向目标牵引（牵引后相距300码）。", "被羁绊连接的单位回复速度相比更快，艾欧满血时也能回复。", "艾欧的移动速度与羁绊目标一致。"], "granted_by": "", "upgrades": {"shard": {"zh": "羁绊会对触碰到的敌人造成伤害。艾欧会回复%damage_to_heal%%%造成伤害。", "en": "Tether damages enemies touching it. Io is healed for %damage_to_heal%%% of the damage done."}}, "is_passive": false, "value_names": ["radius", "movespeed", "latch_distance", "latch_speed", "tether_heal_amp", "tether_mana_amp", "slow", "slow_duration", "damage", "damage_to_heal", "tick_rate", "tether_attack_damage_pct", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "wisp_spirits", "name_zh": "艾欧·幽魂", "name_en": "Spirits", "description_zh": "召唤五个围绕艾欧起舞的幽魂，对所有碰触到的单位造成伤害。如果碰到的是敌方英雄，幽魂会爆炸，对其附近的所有敌人造成伤害。普通单位碰到幽魂会受到轻微伤害，但是不会使其爆炸。持续时间结束后，幽魂将自动爆炸。", "description_en": "Summon five particle spirits that dance in a circle around Io. If a particle collides with an enemy hero, it explodes, damaging all enemy units in an area around it.  Creeps take minor damage from touching a particle spirit, but do not cause them to explode.  When its duration ends, any remaining Spirits explode.", "notes_zh": ["召唤后艾欧可以拉近或拉远幽魂。"], "granted_by": "", "upgrades": {"scepter": {"zh": "每秒被动产生幽魂围绕艾欧，直至数量上限。幽魂撞到英雄会将其短暂减速。可以主动施放来引爆幽魂。", "en": "Spirits now passively spawn around Io constantly every second up to the max. Spirits colliding with enemy Heroes slows them briefly. Can be activated to explode spirits."}}, "is_passive": false, "value_names": ["creep_damage", "hero_damage", "revolution_time", "min_range", "default_radius", "max_range", "hero_hit_radius", "explode_radius", "hit_radius", "spirit_movement_rate", "spirit_duration", "spirit_amount", "scepter_slow_pct", "scepter_slow_duration", "spirit_spawn_time"]}, {"subject": "wisp_overcharge", "name_zh": "艾欧·过载", "name_en": "Overcharge", "description_zh": "艾欧获得攻击速度、技能增强和基于最大生命值的生命恢复。如果艾欧和一个友军连接，该单位也会获得过载提供的所有增益效果。", "description_en": "Io gains attack speed, spell amplification, and health regeneration based on max health. If Io is Tethered to an ally, that unit also gains any bonuses granted by Overcharge.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_attack_speed", "bonus_spell_amp", "hp_regen", "duration", "unslowable", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "wisp_spirits_in", "name_zh": "艾欧·拉近幽魂", "name_en": "Spirits In", "description_zh": "让幽魂靠近你。可以切换开关状态。", "description_en": "Sends the spirits closer to you. Can be toggled on and off.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": []}, {"subject": "wisp_spirits_out", "name_zh": "艾欧·拉远幽魂", "name_en": "Spirits Out", "description_zh": "让幽魂远离你。可以切换开关状态。", "description_en": "Sends the spirits farther away from you. Can be toggled on and off.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": []}, {"subject": "wisp_relocate", "name_zh": "艾欧·降临", "name_en": "Relocate", "description_zh": "将艾欧和与其连接的友军传送到地图上任何位置。持续时间结束后艾欧和相连的友军会被传送回原位。双击将传送回己方的泉水。", "description_en": "Teleports Io and a tethered ally to any location. After the spell expires, Io and the tethered ally will return to their original location. Double-click to teleport to your team's base fountain.", "notes_zh": ["敌人在施法延迟期间会在大地图和小地图上目标区域都收到视觉特效提示。", "如果艾欧在施法延迟期间被控制，降临将会取消。", "如果羁绊连接了友方英雄，该英雄将和你一起被传送。你可以随时断开连接，防止英雄和你一同传送。", "只有英雄、类英雄单位和幻象可以降临。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["cast_delay", "return_time", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "wisp_equilibrium", "name_zh": "艾欧·衡势", "name_en": "Equilibrium", "description_zh": "艾欧获得伤害输出增强，血量越高，数值越高。同时，艾欧还获得生命回复和治疗增强，血量越低，数值越高。", "description_en": "Io gains outgoing damage amplification the closer it is to full health, and Health Restoration and Healing Amplification the closer it is to zero health.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["damage_amplification", "heal_amplification", "current_damage_amp", "current_heal_amp"]}, {"subject": "visage_grave_chill", "name_zh": "维萨吉·黄泉颤抖", "name_en": "Grave Chill", "description_zh": "维萨吉吸取目标单位的移动和攻击速度，自身和附近的佣兽获得等量加成。", "description_en": "Visage drains the movement and attack speed of the targeted unit, gaining the drained speed for itself and nearby Familiars.", "notes_zh": ["两个状态效果是分开驱散的。", "速度加成和目标的速度减少相互独立。", "维萨吉周围%radius%内的佣兽也将获得黄泉颤抖的加成效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["chill_duration", "movespeed_bonus", "attackspeed_bonus", "radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_soul_assumption", "name_zh": "维萨吉·灵魂超度", "name_en": "Soul Assumption", "description_zh": "每次附近英雄（不论敌我）受到的伤害超过%damage_limit%点，维萨吉就能集聚灵魂精华的能量。将精华释放后，会对目标单位造成基础伤害，每一点集聚的能量还将造成额外伤害。", "description_en": "Visage gathers charges of soul essence each time nearby heroes take more than %damage_limit% damage. When the essence is released, it deals base damage as well as damage for each gathered soul charge.", "notes_zh": ["能量点数只计算来自玩家或肉山的伤害，必须大于%damage_min%点小于%damage_max%点。自残型伤害和灵魂超度造成的伤害不计算在内。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bolt_speed", "soul_base_damage", "soul_charge_damage", "stack_limit", "stack_duration", "damage_limit", "radius", "damage_min", "damage_max", "target_count", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_gravekeepers_cloak", "name_zh": "维萨吉·陵卫斗篷", "name_en": "Gravekeeper's Cloak", "description_zh": "维萨吉产生数层屏障来保护他，降低受到的伤害。每当他受到来自玩家的伤害，就会失去一层屏障，失去的屏障需要一定时间才能恢复。维萨吉的佣兽在%radius%范围内也会受到斗篷的保护，承伤降低的数值取决于维萨吉拥有的层数。", "description_en": "Visage generates a layered barrier that protects him from damage.  If he receives damage from a player, one layer is removed, and takes time to recover.Visage's Familiars are protected by his cloak when within %radius% range of him, based on the number of layers Visage has.", "notes_zh": ["每次维萨吉受到来自其他玩家的伤害超过最小伤害时，保护层就会移除一层。", "佣兽在维萨吉周围%radius%范围内将获得当前陵卫斗篷的承伤降低效果。", "破坏会使技能无法获得新的叠加效果。", "破坏不会使现有叠加效果提供的加成失效。"], "granted_by": "", "upgrades": {"shard": {"zh": "获得主动效果，维萨吉可以化作石像形态，对身边375范围内的敌人造成0.8/1.0/1.2秒眩晕，同时造成60/100/140点伤害，获得6秒无敌状态。最多恢复%shard_hp_restoration_pct%%%生命值。", "en": "Gains an active component, allowing Visage to use Stone Form, stunning enemies for 0.8 / 1.0 / 1.2 seconds in an 375 area around it, dealing 60 / 100 / 140 damage and becoming invulnerable for 6 seconds.  Restores up to %shard_hp_restoration_pct%%% of your health."}}, "is_passive": true, "value_names": ["max_layers", "damage_reduction", "recovery_time", "minimum_damage", "radius", "max_damage_reduction", "shard_hp_restoration_pct", "shard_cooldown", "shard_manacost"]}, {"subject": "visage_silent_as_the_grave", "name_zh": "维萨吉·静如古墓", "name_en": "Silent as the Grave", "description_zh": "维萨吉获得飞行移动状态和移动速度加成。攻击或施法后，将失去移速加成和飞行移动状态，同时维萨吉和他的佣兽在%bonus_duration%秒内拥有额外攻击力。", "description_en": "Visage gains flying movement and bonus movement speed.  Upon attacking or casting, the speed and flying movement are lost and Visage and his familiars deal additional attack damage for %bonus_duration%s.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "移动速度、额外攻击力和持续时间提升。维萨吉和佣兽在持续时间内为隐身状态，直到失去飞行移动状态。", "en": "Increases movement speed, damage, and duration. Turns Visage and familiars invisible for the duration until the flying movement is lost."}}, "is_passive": false, "value_names": ["flight_duration", "movespeed_bonus", "bonus_duration", "bonus_damage", "invis", "fly_timer", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_summon_familiars", "name_zh": "维萨吉·召唤佣兽", "name_en": "Summon Familiars", "description_zh": "召唤%familiar_count%只盲眼的佣兽为维萨吉作战。佣兽拥有石像形态技能，可以化为石像，在落地时使敌人眩晕。在石像形态中的佣兽无敌，并且迅速回复生命值。佣兽被击杀时给予高额奖励。\n\n技能可以设为多样施法（右键点击技能栏图标），在%recall_duration%秒后召回维萨吉的佣兽，在此期间佣兽无法攻击或行动。", "description_en": "Conjures %familiar_count% blind Familiars to fight for Visage.  Familiars possess the Stone Form ability, that allows them to turn into stone, stunning enemies upon landing.  While in Stone Form, Familiars are invulnerable, and rapidly regenerate their health.  Familiars grant high bounty when killed.\n\nThe ability can be cast in the alt-cast state to recall Visages familiars after %recall_duration%s, during which they cannot attack or act.", "notes_zh": ["施放召唤佣兽后已有的佣兽将会死亡。", "佣兽在维萨吉周围时将获得当前陵卫斗篷的承伤降低效果和黄泉颤抖的加成效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["familiar_hp", "familiar_armor", "familiar_attack_range", "familiar_base_movespeed", "familiar_bounty", "familiar_attack_damage", "visage_base_damage", "bonus_damage", "familiar_count", "armor_reduction_per_hit", "armor_reduction_duration", "in_formation", "back_distance", "side_distance", "return_distance"]}, {"subject": "slark_dark_pact", "name_zh": "斯拉克·黑暗契约", "name_en": "Dark Pact", "description_zh": "短暂延迟后，斯拉克牺牲部分生命力，清除大部分负面状态并对自己和周围敌方单位造成伤害。斯拉克自身只受到造成伤害的%self_damage_pct%%%。\n\n驱散类型：强驱散", "description_en": "After a short delay, Slark sacrifices some of his life blood, purging most negative debuffs and dealing damage to enemy units around him and to himself.  Slark only takes %self_damage_pct%%% of the damage.\n\nDISPEL TYPE: Strong Dispel", "notes_zh": ["经过%delay%秒施法延迟后，每隔%pulse_interval%秒释放1道伤害波造成伤害，总共%total_pulses%道。", "每道伤害波还会移除斯拉克身上的负面效果。", "不能使用此技能自杀。", "如果斯拉克死亡，伤害波将停止释放。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["delay", "pulse_duration", "radius", "total_damage", "total_pulses", "pulse_interval", "self_damage_pct", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "slark_pounce", "name_zh": "斯拉克·突袭", "name_en": "Pounce", "description_zh": "斯拉克向前跳跃，束缚第一个碰到的英雄并施加能量转移的叠加效果。该单位只能在斯拉克着地点附近的有限范围内移动。", "description_en": "Slark leaps forward, leashing and applying Essence Shift stacks to the first hero he connects. That unit can only move a limited distance away from Slark's landing position.", "notes_zh": ["施放后斯拉克以%pounce_speed%的速度向前跳跃，抓住敌方英雄或跳跃%pounce_distance%距离后停下。", "不能束缚减益免疫单位。", "斯拉克落地点附近的树木将会被摧毁。"], "granted_by": "", "upgrades": {"scepter": {"zh": "变为充能型技能，并且提升距离。", "en": "Provides charges and increases range."}}, "is_passive": false, "value_names": ["pounce_distance", "pounce_speed", "pounce_acceleration", "pounce_radius", "leash_duration", "leash_radius", "max_charges", "charge_restore_time", "pounce_distance_scepter", "essence_stacks", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "slark_saltwater_shiv", "name_zh": "斯拉克·海浪短刀", "name_en": "Saltwater Shiv", "description_zh": "斯拉克用他的海浪短刀划开目标，窃取目标一部分的移动速度、生命恢复和生命回复。这个效果独立叠加。", "description_en": "Slark slices the target with his salty shiv, stealing a portion of the target's movement speed, Health Regen and Health Restoration.These effects stack independently.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "health_rest_steal", "regen_steal", "ms_steal", "melee_range_buffer", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "slark_depth_shroud", "name_zh": "斯拉克·深海护罩", "name_en": "Depth Shroud", "description_zh": "在目标地点创造一团云雾。作用范围内所有友军为隐藏状态，受到暗影之舞的作用。", "description_en": "Creates a cloud at the target location. All allies inside the radius are hidden and affected by Shadow Dance.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["duration", "radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "slark_essence_shift", "name_zh": "斯拉克·能量转移", "name_en": "Essence Shift", "description_zh": "斯拉克的攻击会偷走敌方英雄的生命能量，每次吸取他们的%stat_loss%点全属性并转化成自身额外%agi_gain%点敏捷值。只要敌方英雄带着该效果在斯拉克300范围内阵亡，他将永久窃取%stat_loss%点敏捷。", "description_en": "Slark steals the life essence of enemy heroes with his attacks, draining %stat_loss% of each of their attributes and converting them to bonus %agi_gain% Agility. If Slark kills an affected enemy hero, he permanently steals %stat_loss% Agility.", "notes_zh": ["属性值最少为1点。", "斯拉克或受到作用的单位死亡后，阵亡单位因能量转移变化的属性值将回归正常。但是两方的属性值相互独立，并无关联。", "斯拉克无需完成击杀就能永久窃取敏捷，只要敌方英雄身上拥有能量转移状态时在斯拉克的窃取范围内阵亡即可。", "破坏会使技能无法获得临时的叠加效果。依然可以获得永久的叠加效果。", "破坏不会使现有叠加效果提供的加成失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["agi_gain", "stat_loss", "duration", "steal_radius"]}, {"subject": "slark_shadow_dance", "name_zh": "斯拉克·暗影之舞", "name_en": "Shadow Dance", "description_zh": "当斯拉克不处于敌方视野内时，他会被动获得移动速度加成和生命恢复。如果受到来自中立单位的伤害，%neutral_disable%秒内会失去被动移速和生命恢复加成。主动开启后，斯拉克将自己藏进暗影之云，变成隐身状态，不会被反隐手段发现。攻击、施法、使用物品都不会使斯拉克显形，但是敌人可以看见暗影之云。", "description_en": "When not visible to the enemy team, Slark passively gains bonus movement speed and health regeneration.  If Slark is damaged by a neutral unit, the passive movement and health regeneration bonuses are lost for %neutral_disable% seconds.When activated, Slark hides himself in a cloud of shadows, becoming immune to detection. Attacking, casting spells, and using items will not reveal Slark, but enemies can see the cloud itself.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_movement_speed", "bonus_regen", "activation_delay", "neutral_disable", "duration", "attack_speed", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "medusa_split_shot", "name_zh": "美杜莎·分裂箭", "name_en": "Split Shot", "description_zh": "美杜莎施展魔法将她的箭分裂成若干支箭矢。分裂箭造成的伤害为正常攻击力的一定百分比。额外目标不会受到其他攻击特效（比如致命一击）的作用。", "description_en": "Medusa magically splits her shot into several arrows. These arrows deal a lower percent of her normal damage.The extra targets will not receive other attack effects (such as critical strike).", "notes_zh": ["次级目标将是除了主要目标外距离最近的敌方单位。", "如果在分裂箭激活的状态下创造幻象，幻象也将继承此技能。"], "granted_by": "", "upgrades": {"scepter": {"zh": "使分裂箭的次级攻击也能继承攻击特效，并且目标数量提升。", "en": "Allows on-hit effects to apply to the secondary attacks from Split Shot. Increases arrow count."}}, "is_passive": false, "value_names": ["damage_modifier", "damage_modifier_tooltip", "arrow_count", "process_procs", "split_shot_bonus_range", "AbilityCastPoint"]}, {"subject": "medusa_mystic_snake", "name_zh": "美杜莎·秘术异蛇", "name_en": "Mystic Snake", "description_zh": "放出一条秘术异蛇在敌人之间跳跃，造成伤害。每次跳跃后伤害和速度都会增加。抵达最后一个目标后，它会返回到美杜莎身上为其恢复魔法值。异蛇会返还所有目标最大魔法值一定百分比的魔法。", "description_en": "A mystic snake made of energy jumps from target to target dealing damage. Damage and speed increases with each jump. After it reaches its last target, it returns to Medusa to replenish her with mana. The snake returns a percentage of the targets' total mana.", "notes_zh": ["秘术异蛇无法躲避。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "snake_jumps", "jump_delay", "snake_damage", "snake_mana_steal", "snake_scale", "initial_speed", "return_speed", "stone_form_scepter_base", "stone_form_scepter_increment", "movement_slow", "max_attacks", "mana_per_damage", "attack_buff_duration", "AbilityCastRange"]}]
