 "bonus_night_vision", "transformation_time", "crit_chance", "crit_multiplier", "health_bonus", "is_wolfpack", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "brewmaster_thunder_clap", "name_zh": "酒仙·雷霆一击", "name_en": "Thunder Clap", "description_zh": "猛击地面，造成伤害并降低附近敌方单位的移动速度和攻击速度。", "description_en": "Slams the ground, dealing damage and slowing the movement speed and attack rate of nearby enemy units.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "damage", "movement_slow", "attack_speed_slow", "duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "brewmaster_cinder_brew", "name_zh": "酒仙·余烬佳酿", "name_en": "Cinder Brew", "description_zh": "向敌人扔出一个酒桶，对沿途的敌人造成伤害，并在目标地点溅出酒液。路径上和溅酒点的敌人会浸满余烬佳酿，并且被减速。受到魔法或纯粹伤害后还将被点燃。点燃时持续时间增加%extra_duration%秒，并且受到持续伤害。", "description_en": "Rolls a barrel of ale at enemies that damages enemies along its path and spills out at the target location.Any enemy in the path or the spill area is drenched in cinder brew, becoming slowed.  If the enemy receives Magic or Pure damage, they will be ignited, extending the duration by %extra_duration%s and causing them to take damage over time.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "total_ignite_damage", "movement_slow", "radius", "extra_duration", "projectile_speed", "projectile_width", "barrel_width", "barrel_impact_damage", "min_movement", "max_movement", "fear_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "brewmaster_drunken_brawler", "name_zh": "酒仙·醉拳", "name_en": "Drunken Brawler", "description_zh": "酒仙可以根据操控的元素来切换拳法。每当酒仙施放技能，他都会进入浸酒状态，拳法的威力提升%brewed_up_bonus%%%，持续%brewed_up_duration%秒。如果他在浸酒状态下又施放了技能，持续时间会延长%brewed_up_duration_extend%秒。浸酒状态结束后，他会进入大醉状态，%hangover_time%秒内无法再次进入浸酒状态。大地拳法 - 获得护甲和魔法抗性加成。狂风拳法 - 获得闪避和移动速度加成。烈火拳法 - 获得攻击速度加成，并且拥有几率造成致命一击伤害。", "description_en": "Brewmaster can switch stances based on the elements he controls.Whenever Brewmaster casts an ability, he becomes Brewed Up, increasing his stance power by %brewed_up_bonus%%% for %brewed_up_duration%s.  If he casts another ability while Brewed Up, the duration is extended by %brewed_up_duration_extend%s. After Brewed Up expires, he is hungover and cannot Brew Up again for %hangover_time%s.Earth Brawler gains bonus Magic Resistance and Armor.Storm Brawler gains bonus Evasion and Movement Speed.Fire Brawler gains bonus Attack Speed and chance to critical strike.", "notes_zh": ["与其他闪避效果为非线性叠加。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["magic_resist", "bonus_armor", "dodge_chance", "bonus_move_speed", "crit_chance", "crit_multiplier", "attack_speed", "stance_multiplier_tooltip", "brewed_up_duration", "brewed_up_duration_extend", "brewed_up_bonus", "hangover_time"]}, {"subject": "brewmaster_liquid_courage", "name_zh": "酒仙·壮胆酒", "name_en": "Liquid Courage", "description_zh": "当酒仙的生命值低于%min_health_threshold%%%，他就会获得状态抗性加成，而且他的移动速度每%speed_toggle_time%秒都会在加速和减速之间改变。血量越低，效果越强，从0开始到%max_health_threshold%%%生命值时达到最大数值。", "description_en": "When Brewmaster drops below %min_health_threshold%%% Health he gains a Status Resistance buff and his movement speed alternates every %speed_toggle_time%s between being faster and being slower. The effect becomes stronger at lower health, scaling from 0 up to max values at %max_health_threshold%%% Health.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "向队友丢出一杯烈酒，或自己一饮而尽，获得壮胆酒的最大效果，并且还会获得每秒%max_hp_regen%%%最大生命值的回复。持续%drink_duration%秒。", "en": "Toss a strong drink to a teammate or drink it yourself, activating the maximum power effect of Liquid Courage and granting %max_hp_regen%%% Max HP Regen per second.Lasts %drink_duration% seconds."}}, "is_passive": true, "value_names": ["min_health_threshold", "max_health_threshold", "status_resist", "min_speed", "max_speed", "speed_toggle_time", "drink_duration", "projectile_speed", "max_hp_regen", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "brewmaster_primal_split", "name_zh": "酒仙·元素分离", "name_en": "Primal Split", "description_zh": "酒仙分裂成元素，产生3个各有所长的战士，生存能力极强，每个都拥有独特技能。只要其中任何一个在召唤时间结束后存活下来，酒仙就能重生。每个战士都会获得对应的醉拳拳法。", "description_en": "Splits Brewmaster into elements, forming 3 specialized warriors, adept at survival, each with their own abilities. If any of them survive until the end of their summoned timer, the Brewmaster is reborn.  Each Warrior gains its respective Drunken Brawler stance.", "notes_zh": ["大地战士将继承酒仙的所有光环，以及真视宝石的真视效果。", "烈火战士拥有相位移动的能力。", "技能结束后，酒仙会根据大地→狂风→烈火的顺序选择未阵亡的元素重生。"], "granted_by": "", "upgrades": {"scepter": {"zh": "元素分离获得%scepter_bonus_levels%级最高和当前等级，强化元素战士和他们的技能。元素分离可以提前结束，而且元素分离开始时元素战士是浸酒状态。", "en": "Primal Split gains %scepter_bonus_levels% max and current level, improving the Brewlings and their abilities.Allows Primal Split to be cancelled early, and causes the Brewlings to be Brewed Up when Primal Split begins."}}, "is_passive": false, "value_names": ["duration", "split_duration", "tooltip_earth_brewling_hp", "tooltip_earth_brewling_damage", "tooltip_storm_brewling_hp", "tooltip_storm_brewling_damage", "tooltip_fire_brewling_hp", "tooltip_fire_brewling_damage", "bonus_brewling_hp", "bonus_damage", "primal_split_cancel", "hp_per_attribute", "dmg_per_attribute", "attribute_share_pct", "give_brawler_passive"]}, {"subject": "shadow_demon_disruption", "name_zh": "暗影恶魔·崩裂禁锢", "name_en": "Disruption", "description_zh": "将目标单位从战场上放逐一段时间。回归时会产生该单位的2个具有额外基础攻击力的幻象，受暗影恶魔控制。", "description_en": "Banishes the targeted unit from the battlefield for a short duration.  Upon returning, two illusions of the banished unit with bonus base damage are created under Shadow Demon's control.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["disruption_duration", "illusion_duration", "illusion_outgoing_damage", "illusion_outgoing_tooltip", "illusion_flat_damage", "illusion_incoming_damage", "tooltip_total_illusion_incoming_damage", "illusion_bounty_growth", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shadow_demon_disseminate", "name_zh": "暗影恶魔·散播", "name_en": "Disseminate", "description_zh": "只要目标受到伤害，目标附近%radius%范围内所有敌人，若目标为敌人那也包括目标自身，他们都将受到该伤害的一定百分比。可以对敌方或友方目标施放。敌人被崩裂禁锢隐藏时效果暂停。", "description_en": "Whenever the target takes damage, all enemies, including the target itself if it is an enemy, within %radius% range of the target also receive a portion of that damage. Can target enemy and allied units. Effect is paused if the target is hidden by Disruption.", "notes_zh": ["这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage_reflection_pct", "radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shadow_demon_shadow_poison", "name_zh": "暗影恶魔·暗影剧毒", "name_en": "Shadow Poison", "description_zh": "在一条直线上造成伤害，并以毒咒折磨敌方单位。根据目标身上的叠加层数，毒咒造成1/2/4/8/16倍的叠加伤害，至多%max_multiply_stacks%层。更多层的叠加每层造成%bonus_stack_damage%点伤害。这部分延缓的伤害在暗影毒的持续时间结束后生效，或者使用附属技能立刻造成伤害。", "description_en": "Deals damage in a line, and afflicts enemy units with a poison effect. The poison deals 1/2/4/8/16 times the stack damage based on the number of stacks on the target, up to %max_multiply_stacks% stacks. Additional stacks cause %bonus_stack_damage% damage each.  This deferred damage is dealt when Shadow Poison's duration is expired, or the Release sub-ability is used.", "notes_zh": ["暗影剧毒可以作用处于崩裂禁锢的单位。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["stack_damage", "max_multiply_stacks", "bonus_stack_damage", "radius", "vision_radius", "speed", "hit_damage", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shadow_demon_demonic_cleanse", "name_zh": "暗影恶魔·邪恶净愈", "name_en": "Demonic Cleanse", "description_zh": "净愈目标友方单位，在持续时间内移除负面效果。在持续时间结束时该单位受到治疗效果。崩裂禁锢中的单位依然可以受到邪恶净愈的效果。驱散类型：弱驱散", "description_en": "Cleanses the target allied unit, removing negative buffs for the duration.  At the end of the duration, the unit is healed. Units under the effect of Disruption can still be affected by Demonic Cleanse.DISPEL TYPE: Basic Dispel", "notes_zh": ["净愈的持续时间内将持续移除目标的负面状态。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["purge_damage", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shadow_demon_demonic_purge", "name_zh": "暗影恶魔·邪恶净化", "name_en": "Demonic Purge", "description_zh": "净化目标敌方单位，移除增益魔法效果，并使目标在持续时间内减速。伤害在持续时间结束时计算，在此之前目标单位的移动速度缓慢地恢复。崩裂禁锢中的单位依然可以受到邪恶净化的影响。\n\n驱散类型：弱驱散", "description_en": "Purges the target enemy unit, removing positive buffs, and slowing the target for the duration.  The unit slowly regains its speed until the end of the duration, upon which damage is dealt.  Units under the effect of Disruption can still be affected by Demonic Purge.\n\nDISPEL TYPE: Basic Dispel", "notes_zh": ["减速效果起始时为%max_slow%%%，然后持续减少至%min_slow%%%。", "邪恶净化的持续时间内将持续移除目标的有益状态。"], "granted_by": "", "upgrades": {"scepter": {"zh": "邪恶净化具有破坏效果，并获得%max_charges%点能量点数。", "en": "Causes Demonic Purge to break and gain %max_charges% charges."}}, "is_passive": false, "value_names": ["purge_damage", "max_charges", "charge_restore_time", "max_slow", "min_slow", "apply_poison_stacks", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "shadow_demon_menace", "name_zh": "暗影恶魔·威胁", "name_en": "Menace", "description_zh": "暗影恶魔的攻击会对敌人施加一个可叠加的负面状态，使他们受到的伤害增加，持续%duration%秒。", "description_en": "Shadow Demon's Attacks apply a stacking debuff to the enemy for %duration% seconds that increases their damage taken.", "notes_zh": ["破坏会使技能无法施加新的叠加效果。", "破坏不会使现有叠加效果提供的状态失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["stack", "duration"]}, {"subject": "lone_druid_entangle", "name_zh": "独行德鲁伊·缠绕之根", "name_en": "Entangle", "description_zh": "敌方英雄获得%hits_required%层叠加效果后独行德鲁伊可以缠绕敌方英雄。被缠绕的英雄无法移动，并受到持续伤害。施放时，对区域内每个敌方英雄施加%hits_incremented_on_active%层叠加效果，对敌方非英雄单位施加%hits_required%层。独行德鲁伊的攻击还会被强化%lone_druid_buff_duration%秒，每次攻击敌方英雄都会施加%lone_druid_counters_applied_tooltip%层叠加效果。被缠绕的英雄无法获得叠加层数。升级这个技能也会升级熊灵的缠绕之爪技能。", "description_en": "Allows Lone Druid to Entangle enemies once they gain %hits_required% stacks. Entangled enemies are rooted and take damage over time.When cast, applies %hits_incremented_on_active% stacks to each enemy hero in the area and %hits_required% stacks to enemy creeps. Also empowers Lone Druid for %lone_druid_buff_duration%s, making him apply %lone_druid_counters_applied_tooltip% stack with each attack on enemy heroes. Enemies cannot gain stacks while Entangled.Leveling this ability also levels Spirit Bear's Entangling Claws ability.", "notes_zh": ["被缠绕的单位将无法使用闪烁类技能，如果进入隐身状态也会显形。", "独行德鲁伊的强化增益和敌人叠加计数减益无法被驱散。", "缠绕的减益效果可以被驱散。", "独行德鲁伊或者熊灵的攻击不会使非英雄单位获得叠加效果，只会在施放缠绕之根时使他们被缠绕。", "对肉山的作用机制和英雄相同。"], "granted_by": "", "upgrades": {"scepter": {"zh": "缠绕之根会对区域内敌方英雄施加%hits_required%层叠加效果，并且作用范围提升。触发缠绕的敌人不再受到保护，可以继续获得新的叠加层数。", "en": "Entangle applies %hits_required% stacks to enemy heroes in the area and has increased radius. Enemies no longer have protection from gaining stacks while Entangled."}}, "is_passive": false, "value_names": ["active_radius", "counter_duration", "lone_druid_counters_applied_tooltip", "hits_required", "hits_incremented_on_active", "lone_druid_buff_duration", "nostack_protection", "root_heroes_on_cast", "entangle_duration", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "lone_druid_spirit_link", "name_zh": "独行德鲁伊·灵魂链接", "name_en": "Spirit Link", "description_zh": "连接独行德鲁伊和熊灵，提升双方的移动速度，另外双方共享一定百分比的吸血效果。", "description_en": "Links Lone Druid and the Spirit Bear, increasing their movement speed as well as sharing a percentage of their lifesteal with each other.", "notes_zh": ["破坏会使共享吸血效果失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_movement_speed_druid", "bonus_movement_speed_bear", "lifesteal_percent", "creep_lifesteal_penalty", "lifesteal_both_ways", "duration", "active_bonus"]}, {"subject": "lone_druid_savage_roar", "name_zh": "独行德鲁伊·野蛮咆哮", "name_en": "Savage Roar", "description_zh": "独行德鲁伊和熊灵发出野性的咆哮，使周围敌人恐惧，朝自己的基地狂奔。敌人的移动速度将增加%bonus_speed%%%。", "description_en": "Lone Druid and the Spirit Bear roar fiercely causing nearby enemies to flee towards their base in terror. Their movement speed is increased by %bonus_speed%%%.", "notes_zh": ["被缠绕的英雄将无法移动。", "与熊灵共享冷却时间。"], "granted_by": "", "upgrades": {"shard": {"zh": "施加弱驱散效果，并对施法者附近范围内友军提供移动速度和攻击速度加成。施法效果会在独行德鲁伊和熊灵之间复制，不论双方是否可以施法。驱散类型：弱驱散", "en": "Applies a basic dispel and grants allies in an area around the caster bonus movement and attack speed. Replicates between Lone Druid and Spirit Bear regardless of castability on the other.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["radius", "bonus_speed", "duration", "only_affects_player_units", "shard_radius", "shard_movement_speed_pct", "shard_attack_speed", "shard_duration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "lone_druid_spirit_bear", "name_zh": "独行德鲁伊·熊灵伙伴", "name_en": "Summon Spirit Bear", "description_zh": "召唤一只可以装备物品的熊灵伙伴。若熊灵与独行德鲁伊的距离超过%bear_attack_leash_range%，则不能攻击。如果熊灵死亡，独行德鲁伊会受到自身最大生命值的%backlash_damage%%%作为反冲伤害。\n熊灵拥有粉碎击、回归、缠绕之爪、野蛮咆哮和灵魂链接技能。", "description_en": "Summons a powerful Spirit Bear companion that can equip items.If the bear moves %bear_attack_leash_range% distance away from the Lone Druid, it cannot attack.  Lone Druid suffers %backlash_damage%%% of his max health as backlash damage if the Spirit Bear dies.\nSpirit Bear has Demolish, Return, Entangling Claws, Savage Roar, and Spirit Link abilities.", "notes_zh": ["熊灵受到的大多数技能效果与英雄相同。", "熊灵的基础属性为0，基础护甲为0并拥有%base_magic_resistance%%%基础魔法抗性。熊灵装备的物品或享受的加成效果具有的属性对熊灵的加成效果与全才英雄类似。", "熊灵无法获得经验。熊灵会跟随独行德鲁伊一起升级。", "熊灵拥有自己的阿哈利姆神杖和魔晶升级效果。", "熊灵会获得独行德鲁伊身上中立物品的复制品。这件复制品拥有独立的冷却时间。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bear_hp", "bear_regen_tooltip", "bear_bat", "bear_armor", "backlash_damage", "bear_movespeed", "bear_magic_resistance", "bear_attack_leash_range", "strength_gain_tooltip", "agility_gain_tooltip", "intelligence_gain_tooltip", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "lone_druid_true_form", "name_zh": "独行德鲁伊·真熊形态", "name_en": "True Form", "description_zh": "独行德鲁伊将自己的形态变换为狂怒的熊，失去远程攻击的能力，但是获得额外护甲，额外生命值和额外攻击力。", "description_en": "Lone Druid morphs himself into a raging bear, losing his ranged advantage, but gaining bonus armor, bonus health, and bonus attack damage.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_armor", "bonus_hp", "bonus_attack_damage", "attack_speed_pct", "duration", "transformation_time", "transform_bear", "bonus_slow_resistance", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chaos_knight_chaos_bolt", "name_zh": "混沌骑士·混乱之箭", "name_en": "Chaos Bolt", "description_zh": "对目标单位投掷一支神秘的能量箭。造成随机时间的眩晕和随机的伤害。", "description_en": "Throws a mysterious bolt of energy at the target unit. It stuns for a random duration and deals random damage.", "notes_zh": ["眩晕持续时间和伤害值为负相关。", "附近的幻象也会模仿施法动作。"], "granted_by": "", "upgrades": {"shard": {"zh": "混乱之箭会制造一个混沌之军的幻象来攻击目标。这个幻象造成的伤害减少%illusion_damage_reduction_pct%%%。", "en": "Causes Chaos Bolt to create a Phantasm illusion to attack the target. This illusion deals %illusion_damage_reduction_pct%%% less damage."}}, "is_passive": false, "value_names": ["chaos_bolt_speed", "stun_min", "stun_max", "damage_min", "damage_max", "fake_bolt_distance", "illusion_duration", "illusion_damage_reduction_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chaos_knight_reality_rift", "name_zh": "混沌骑士·实相裂隙", "name_en": "Reality Rift", "description_zh": "将混沌骑士及混沌骑士的幻象和目标单位传送到混沌骑士与目标连线上的一点。降低敌方单位的护甲，持续%duration%秒。", "description_en": "Teleports Chaos Knight, any illusions he has, and the target unit to a point along the line between him and the target. The enemy unit has their armor reduced for %duration%s.", "notes_zh": ["目标单位将会强制面向混沌骑士，而且混沌骑士和幻象默认对目标发动攻击。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["pull_distance", "armor_reduction", "duration", "pierces_immunity", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "chaos_knight_chaos_strike", "name_zh": "混沌骑士·混沌一击", "name_en": "Chaos Strike", "description_zh": "混沌骑士和他的幻象在攻击时有几率造成威力不一的致命一击，并且触发时具有吸血效果。对非英雄单位的吸血效果减少。", "description_en": "Chaos Knight and his illusions' attacks have a chance to deal a critical strike of varying strength with bonus lifesteal. Lifesteal from creeps is reduced.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["chance", "crit_min", "crit_max", "lifesteal", "creep_multiplier"]}, {"subject": "chaos_knight_fundamental_forging", "name_zh": "混沌骑士·基本法则锻造", "name_en": "Fundamental Forging", "description_zh": "混沌骑士的中立物品额外获得一个随机附魔。", "description_en": "Chaos Knight's Neutral Items get an additional random enchantment.", "notes_zh": ["随机附魔会从该级别的所有可选附魔中选取，包括一般不会对力量英雄开放的附魔，拥有负面效果的附魔除外。", "随机附魔不会和选定附魔重复。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": []}, {"subject": "chaos_knight_phantasm", "name_zh": "混沌骑士·混沌之军", "name_en": "Phantasm", "description_zh": "从其他维度召唤若干个混沌骑士的幻象。幻象继承%outgoing_damage_tooltip%%%攻击力，但是承受%incoming_damage_tooltip%%%伤害。\n驱散类型：弱驱散", "description_en": "Summons several phantasmal copies of the Chaos Knight from alternate dimensions. The phantasms are illusions that deal %outgoing_damage_tooltip%%% damage, but take %incoming_damage_tooltip%%% damage.\nDISPEL TYPE: Basic Dispel", "notes_zh": ["能够移除混沌骑士的大部分负面状态。", "混沌骑士在施放时有%invuln_duration%秒的无敌时间，可以躲避眩晕和伤害技能。"], "granted_by": "", "upgrades": {"scepter": {"zh": "增加被动效果。混沌骑士产生幻象时都会有%bonus_illusion_chance%%%几率额外产生一个在其控制下的幻象。施放混沌之军时，会产生全地图上所有友方英雄的一个幻象。", "en": "Gains a passive component.  When an illusion of Chaos Knight is created, there is a %bonus_illusion_chance%%% chance to create an additional illusion under Chaos Knight's control.When Phantasm is activated, also creates an illusion of allied heroes globally."}}, "is_passive": false, "value_names": ["images_count", "illusion_duration", "outgoing_damage", "outgoing_damage_tooltip", "incoming_damage", "incoming_damage_tooltip", "invuln_duration", "vision_radius", "bonus_illusion_chance", "bonus_illusion_count", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}]
