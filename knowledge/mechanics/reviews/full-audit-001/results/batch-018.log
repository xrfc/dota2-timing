uncertain":false}]},{"subject":"shadow_demon_disruption","mechanisms":[{"mechanism":"cyclone_banish","condition":"base","quote":"将目标单位从战场上放逐一段时间。","uncertain":false},{"mechanism":"illusions","condition":"base","quote":"回归时会产生该单位的2个具有额外基础攻击力的幻象，受暗影恶魔控制。","uncertain":false}]},{"subject":"shadow_demon_disseminate","mechanisms":[{"mechanism":"damage_return","condition":"base","quote":"只要目标受到伤害，目标附近%radius%范围内所有敌人，若目标为敌人那也包括目标自身，他们都将受到该伤害的一定百分比。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"目标附近%radius%范围内所有敌人，若目标为敌人那也包括目标自身，他们都将受到该伤害的一定百分比。","uncertain":false}]},{"subject":"shadow_demon_shadow_poison","mechanisms":[{"mechanism":"aoe_damage","condition":"base","quote":"在一条直线上造成伤害，并以毒咒折磨敌方单位。","uncertain":false}]},{"subject":"shadow_demon_demonic_cleanse","mechanisms":[{"mechanism":"applies_basic_dispel","condition":"shard","quote":"在持续时间内移除负面效果。在持续时间结束时该单位受到治疗效果。崩裂禁锢中的单位依然可以受到邪恶净愈的效果。驱散类型：弱驱散","uncertain":false},{"mechanism":"healing","condition":"shard","quote":"在持续时间结束时该单位受到治疗效果。","uncertain":false}]},{"subject":"shadow_demon_demonic_purge","mechanisms":[{"mechanism":"slow","condition":"base","quote":"并使目标在持续时间内减速","uncertain":false},{"mechanism":"applies_basic_dispel","condition":"base","quote":"净化目标敌方单位，移除增益魔法效果","uncertain":false},{"mechanism":"applies_break","condition":"scepter","quote":"邪恶净化具有破坏效果","uncertain":false},{"mechanism":"charges","condition":"scepter","quote":"并获得%max_charges%点能量点数。","uncertain":false}]},{"subject":"shadow_demon_menace","mechanisms":[{"mechanism":"incoming_damage_amp","condition":"base","quote":"使他们受到的伤害增加","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"暗影恶魔的攻击会对敌人施加一个可叠加的负面状态，使他们受到的伤害增加","uncertain":false}]},{"subject":"lone_druid_entangle","mechanisms":[{"mechanism":"root","condition":"base","quote":"被缠绕的英雄无法移动，并受到持续伤害。","uncertain":false},{"mechanism":"attack_modifier","condition":"base","quote":"独行德鲁伊的攻击还会被强化%lone_druid_buff_duration%秒，每次攻击敌方英雄都会施加%lone_druid_counters_applied_tooltip%层叠加效果。","uncertain":false},{"mechanism":"reveal","condition":"base","quote":"如果进入隐身状态也会显形。","uncertain":false},{"mechanism":"aoe_damage","condition":"base","quote":"被缠绕的英雄无法移动，并受到持续伤害。施放时，对区域内每个敌方英雄施加%hits_incremented_on_active%层叠加效果，对敌方非英雄单位施加%hits_required%层。","uncertain":false}]},{"subject":"lone_druid_spirit_link","mechanisms":[{"mechanism":"lifesteal","condition":"base","quote":"另外双方共享一定百分比的吸血效果。","uncertain":false}]},{"subject":"lone_druid_savage_roar","mechanisms":[{"mechanism":"forced_action","condition":"base","quote":"使周围敌人恐惧，朝自己的基地狂奔。","uncertain":false},{"mechanism":"applies_basic_dispel","condition":"shard","quote":"施加弱驱散效果","uncertain":false}]},{"subject":"lone_druid_spirit_bear","mechanisms":[{"mechanism":"summons","condition":"base","quote":"召唤一只可以装备物品的熊灵伙伴。","uncertain":false}]},{"subject":"lone_druid_true_form","mechanisms":[]},{"subject":"chaos_knight_chaos_bolt","mechanisms":[{"mechanism":"stun","condition":"base","quote":"造成随机时间的眩晕和随机的伤害。","uncertain":false},{"mechanism":"illusions","condition":"shard","quote":"混乱之箭会制造一个混沌之军的幻象来攻击目标。","uncertain":false}]},{"subject":"chaos_knight_reality_rift","mechanisms":[{"mechanism":"self_mobility","condition":"base","quote":"将混沌骑士及混沌骑士的幻象和目标单位传送到混沌骑士与目标连线上的一点。","uncertain":false},{"mechanism":"displace_other","condition":"base","quote":"将混沌骑士及混沌骑士的幻象和目标单位传送到混沌骑士与目标连线上的一点。","uncertain":false},{"mechanism":"armor_reduction","condition":"base","quote":"降低敌方单位的护甲","uncertain":false}]},{"subject":"chaos_knight_chaos_strike","mechanisms":[{"mechanism":"lifesteal","condition":"base","quote":"并且触发时具有吸血效果。","uncertain":false},{"mechanism":"critical","condition":"base","quote":"混沌骑士和他的幻象在攻击时有几率造成威力不一的致命一击","uncertain":false}]},{"subject":"chaos_knight_fundamental_forging","mechanisms":[]},{"subject":"chaos_knight_phantasm","mechanisms":[{"mechanism":"invulnerable_untargetable","condition":"base","quote":"混沌骑士在施放时有%invuln_duration%秒的无敌时间","uncertain":false},{"mechanism":"applies_basic_dispel","condition":"base","quote":"驱散类型：弱驱散","uncertain":false},{"mechanism":"illusions","condition":"base","quote":"从其他维度召唤若干个混沌骑士的幻象。","uncertain":false},{"mechanism":"illusions","condition":"scepter","quote":"混沌骑士产生幻象时都会有%bonus_illusion_chance%%%几率额外产生一个在其控制下的幻象。施放混沌之军时，会产生全地图上所有友方英雄的一个幻象。","uncertain":false}]}]}
