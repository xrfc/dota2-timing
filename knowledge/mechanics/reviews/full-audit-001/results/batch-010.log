[{"subject": "death_prophet_carrion_swarm", "name_zh": "死亡先知·地穴虫群", "name_en": "Crypt Swarm", "description_zh": "召唤一群食腐虫在死亡先知面前的敌人中肆虐。", "description_en": "Sends a swarm of winged beasts to savage enemy units in front of Death Prophet.", "notes_zh": ["最远能伤害1110距离外的单位。", "不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "start_radius", "end_radius", "range", "speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "death_prophet_silence", "name_zh": "死亡先知·沉默魔法", "name_en": "Silence", "description_zh": "放出一个弹道，阻止目标区域内的敌人施放魔法。", "description_en": "Fires a projectile that prevents enemy units in a target area from casting spells.", "notes_zh": ["不能阻止使用物品。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "projectile_speed", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "death_prophet_spirit_siphon", "name_zh": "死亡先知·吸魂巫术", "name_en": "Spirit Siphon", "description_zh": "创造一个灵魂连接，将死亡先知与一个敌方单位相连。每秒吸取生命值。", "description_en": "Creates a spirit link between Death Prophet and an enemy unit, draining health from the enemy.", "notes_zh": ["多个连接不能同时作用于一个目标。"], "granted_by": "", "upgrades": {"shard": {"zh": "吸魂巫术的能量点数提升%shard_bonus_charges%点，敌人连续%shard_consecutive_siphon_duration%秒受到吸魂巫术作用后会被恐惧%shard_fear_duration%秒。", "en": "Increases Spirit Siphon charges by %shard_bonus_charges% and causes enemies to be feared for %shard_fear_duration% seconds if they are siphoned for %shard_consecutive_siphon_duration% seconds consecutively."}}, "is_passive": false, "value_names": ["damage", "haunt_duration", "siphon_buffer", "shard_bonus_charges", "shard_fear_duration", "shard_consecutive_siphon_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"]}, {"subject": "death_prophet_witchcraft", "name_zh": "死亡先知·巫术精研", "name_en": "Witchcraft", "description_zh": "死亡先知的神秘学识随着经验积累而加深，获得移动速度和技能冷却时间减少。", "description_en": "Death Prophet's occult knowledge deepens with experience, gaining movement speed and spell cooldown reduction.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["movement_speed_pct", "cooldown_reduction_pct"]}, {"subject": "death_prophet_exorcism", "name_zh": "死亡先知·驱使恶灵", "name_en": "Exorcism", "description_zh": "释放恶灵偷走敌方单位和建筑的生命。恶灵需要回到她身上才能再次攻击。持续时间结束后，死亡先知根据造成的伤害量，获得一定比例的治疗。对建筑造成50%%伤害。持续%abilityduration%秒。", "description_en": "Unleashes evil spirits to drain the life of nearby enemy units and structures. Spirits need to return back to Death Prophet in order to attack again. At the end of the spell's duration, Death Prophet is healed in proportion to the damage dealt. Deals 50% damage to buildings. Lasts %abilityduration% seconds.", "notes_zh": ["作用范围代表死亡先知周围的恶灵寻找目标的范围。", "伤害格挡类技能不能减少恶灵伤害。"], "granted_by": "", "upgrades": {"scepter": {"zh": "敌人受到死亡先知的技能作用，或被死亡先知攻击时，会有一只恶灵飞出攻击敌人，造成高于平常的伤害，再返回使自身回复生命。", "en": "Whenever an enemy is affected by Death Prophet's spells or when she attacks an enemy, a ghost will fly out and hit the enemy for an increased bonus of its usual damage then return to her with life."}}, "is_passive": false, "value_names": ["radius", "spirits", "spirit_speed", "max_distance", "give_up_distance", "min_damage", "max_damage", "heal_percent", "average_damage", "ghost_spawn_rate", "scepter_spirit_life_duration", "scepter_spirit_bonus_damage", "duration_increase_per_kill", "AbilityDuration", "AbilityCastPoint"]}, {"subject": "phantom_assassin_stifling_dagger", "name_zh": "幻影刺客·窒碍短匕", "name_en": "Stifling Dagger", "description_zh": "对敌方单位掷出一把匕首，减缓其移动速度，并造成物理伤害，数值为%base_damage%+幻影刺客攻击伤害的%attack_factor_tooltip%%%，同时继承物品和技能的攻击效果。", "description_en": "Throws a dagger slowing the enemy unit's movement speed, dealing %base_damage%+%attack_factor_tooltip%%% of Phantom Assassin's attack damage as physical damage and applying attack effects from items and abilities.", "notes_zh": ["如果攻击效果为几率触发，匕首的触发几率与原几率相同。", "减益免疫下的敌人不会受到窒碍短匕的减速影响。", "窒碍短匕在行进途中和击中目标时都会提供附近的视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["move_slow", "dagger_speed", "duration", "base_damage", "attack_factor", "attack_factor_tooltip", "dagger_recast_time", "dagger_secondary_reduce", "extra_daggers", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "phantom_assassin_phantom_strike", "name_zh": "幻影刺客·幻影突袭", "name_en": "Phantom Strike", "description_zh": "传送到一个单位身旁，敌我皆可，如果目标是敌方单位将进行攻击并获得攻速加成。", "description_en": "Teleports to a unit, friendly or enemy, and grants bonus attack speed while attacking if it's an enemy unit.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_attack_speed", "duration", "creep_lifesteal_penalty", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "phantom_assassin_blur", "name_zh": "幻影刺客·魅影无形", "name_en": "Blur", "description_zh": "幻影刺客模糊自己的身形，躲避多种飞行过程中的攻击和技能弹道，提升她的移动速度，使她无法被看到，直到她靠近敌方英雄或防御塔。", "description_en": "Phantom Assassin blurs her body, disjointing incoming projectiles, increasing her movement speed, causing her to be impossible to see until she comes near enemy heroes or towers.", "notes_zh": ["通过普通攻击攻击肉山会驱散魅影无形。"], "granted_by": "", "upgrades": {"shard": {"zh": "冷却时间减少%bonus_AbilityCooldown%秒。只要幻影刺客击杀英雄，她的技能冷却时间都会加快%cooldown_refund_pct%%%最高冷却时间。", "en": "Decreases Cooldown by %bonus_AbilityCooldown%s. Any time Phantom Assassin gets a hero kill, her ability cooldowns advance %cooldown_refund_pct%%% of their max cooldown values."}}, "is_passive": false, "value_names": ["duration", "radius", "fade_duration", "active_movespeed_bonus", "immediate_cast", "purge_on_cast", "cooldown_refund_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "phantom_assassin_fan_of_knives", "name_zh": "幻影刺客·刀阵旋风", "name_en": "Fan of Knives", "description_zh": "幻影刺客对附近范围内敌人放出尖利的刀刃，击中时造成每名受害者最大生命值一定百分比的伤害并施加破坏效果。", "description_en": "Phantom Assassin releases sharp blades around her, dealing a percentage of each victim's max health on impact and applying Break.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["pct_health_damage_initial", "pct_health_damage", "degen", "duration", "radius", "projectile_speed", "max_damage_initial", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "phantom_assassin_immaterial", "name_zh": "幻影刺客·飘忽不定", "name_en": "Immaterial", "description_zh": "幻影刺客专注一心，闪避敌人攻击的技艺得到提升。\n\n与其他闪避效果为非线性叠加。", "description_en": "Phantom Assassin focuses inward, increasing her ability to evade enemy attacks.\n\nStacks diminishingly with other sources of Evasion.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["evasion"]}, {"subject": "phantom_assassin_coup_de_grace", "name_zh": "幻影刺客·恩赐解脱", "name_en": "Coup de Grace", "description_zh": "幻影刺客的战斗技能得到精进，每次攻击时有几率获得致命专注。攻击时若带有致命专注，幻影刺客会消耗该效果，并且必定产生一次致命一击。窒碍短匕拥有额外几率获得致命专注。", "description_en": "Phantom Assassin refines her combat abilities, acquiring a chance of gaining Deadly Focus with each attack. When attacking with Deadly Focus, Phantom Assassin will consume the buff and guarantee a critical hit. Stifling Dagger has a bonus chance to cause Deadly Focus.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["crit_chance", "dagger_crit_chance", "crit_bonus", "attacks_to_proc", "attacks_to_proc_creeps", "duration", "two_tooltip"]}, {"subject": "pugna_nether_blast", "name_zh": "帕格纳·幽冥爆轰", "name_en": "Nether Blast", "description_zh": "一个爆炸性脉冲，对敌方单位造成伤害。对建筑物造成%structure_damage_mod%%%伤害。", "description_en": "An exploding pulse deals damage to enemies and structures in the area.  Deals %structure_damage_mod%%% damage to structures.", "notes_zh": ["伤害生效延迟为%delay%秒。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["structure_damage_mod", "delay", "radius", "blast_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "pugna_decrepify", "name_zh": "帕格纳·衰老", "name_en": "Decrepify", "description_zh": "一个强大的驱逐咒语，能使一个单位进入虚无状态，无法攻击或受到攻击。受作用的友军提升了治疗效果，而受作用的敌军会被减速，并且承受额外魔法伤害。", "description_en": "A powerful banishing spell that slows a unit and renders it unable to attack or be attacked. Healing on affected allies is increased, while afflicted enemies take extra magic damage instead.", "notes_zh": ["只有魔法伤害和纯粹伤害可以作用于处于衰老状态的单位。", "不会对友方单位造成减速。", "可以对幽冥守卫施放。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_heal_amp_pct_allies", "bonus_movement_speed_allies", "bonus_spell_damage_pct", "bonus_movement_speed", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "pugna_nether_ward", "name_zh": "帕格纳·幽冥守卫", "name_en": "Nether Ward", "description_zh": "帕格纳在目标地点放置一个幽冥守卫。守卫将对任何施法的敌方英雄发射魔力闪光。幽冥守卫造成的伤害为基础伤害加上敌方英雄施法时消耗魔法值的数倍。", "description_en": "Pugna places a Nether Ward at the target location. The ward will fire at any enemy hero who casts a spell dealing base damage plus the damage multiplier of the mana spent by the enemy hero.", "notes_zh": ["技能施放后幽冥守卫先造成伤害，技能才会生效，所以如果施法者因此阵亡，施放的技能将没有效果。", "幽冥守卫可以受到衰老的作用。", "幻象和非英雄单位对幽冥守卫造成25%的伤害。"], "granted_by": "", "upgrades": {"shard": {"zh": "施法距离提升至%AbilityCastRange%。", "en": "Increases cast range to %AbilityCastRange%."}}, "is_passive": false, "value_names": ["radius", "base_damage", "mana_multiplier", "attacks_to_destroy", "nether_ward_gold_bounty", "self_restoration_range", "AbilityCastRange", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "pugna_oblivion_savant", "name_zh": "帕格纳·湮灭专家", "name_en": "Oblivion Savant", "description_zh": "帕格纳可以在持续施法期间施放技能和使用物品。\n\n每摧毁一座防御塔，帕格纳都会获得%tower_scale%%%技能增强。", "description_en": "Pugna can cast spells and use items while channeling.\n\nPugna receives %tower_scale%%% spell amplification per destroyed tower.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["tower_scale", "spell_amp_tooltip"]}, {"subject": "pugna_life_drain", "name_zh": "帕格纳·生命汲取", "name_en": "Life Drain", "description_zh": "持续施法 - 使用生命汲取时，帕格纳吸取目标敌方单位的生命值，并获得其视野。\n\n向队友施放可以将自己的生命值转移给队友。", "description_en": "CHANNELED - When cast on an enemy, Pugna drains health from the target enemy unit to heal himself and granting vision over the target.\n\nWhen cast on an ally, Pugna will drain his own health into his ally.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "冷却时间减少%abilitycooldown%秒。以敌方英雄为目标时，帕格纳每秒降低他们%spell_amp_drain_rate%%%技能伤害输出，最高可达到%spell_amp_drain_max%%%，并且自身的技能伤害输出提升，最高可达到%max_spell_amp_drain_pct%%%。魔晶升级下对幽冥守卫施放时降低和提升的速率为%spell_amp_drain_rate_ward%%%。负面效果持续%spell_amp_drain_duration%秒。", "en": "Reduces cooldown by %abilitycooldown%s. When targeting an enemy hero, Pugna reduces their outgoing spell damage by %spell_amp_drain_rate%%% per second up to a maximum of %spell_amp_drain_max%%% and increases his own, up to a maximum of %max_spell_amp_drain_pct%%%. When draining through a Nether Ward using Shard, the rate of increase/decrease is %spell_amp_drain_rate_ward%%% instead. Debuff lasts %spell_amp_drain_duration% seconds."}, "shard": {"zh": "生命汲取可以对幽冥守卫施放，使生命汲取可以折射至守卫附近%abilitycastrange%范围内所有敌方英雄，造成%shard_damage_pct_from_ward%%%效果。守卫被摧毁后效果将会中断。", "en": "Life Drain can target your Nether Ward, causing life drain to refract to all enemy heroes within %abilitycastrange% units of the ward for %shard_damage_pct_from_ward%%% of its normal value. The effect is interrupted if the ward is destroyed."}}, "is_passive": false, "value_names": ["health_drain", "ally_healing", "tick_rate", "drain_buffer", "shard_damage_pct_from_ward", "bonus_heal_pct", "spell_amp_drain_rate", "spell_amp_drain_max", "spell_amp_drain_rate_ward", "spell_amp_drain_duration", "max_spell_amp_drain_pct", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "templar_assassin_refraction", "name_zh": "圣堂刺客·折光", "name_en": "Refraction", "description_zh": "圣堂刺客变得高度难以捉摸，获得一个小型护盾，同时获得攻击力加成。攻击力加成和护盾效果相互独立，并且都是有限次数的效果。如果护盾被摧毁，只要还有能量点数就会再产生一个新的。如果单次伤害超过了剩余的护盾，该次的全部伤害都会被吸收。", "description_en": "Templar Assassin becomes highly elusive, gaining a small barrier and bonus to her damage.  The damage and avoidance effects are separate, and have a limited number of instances. If a barrier is consumed, a new one is created as long as there are charges left. If an instance of damage would deal more damage than the remaining barrier, all of the damage is absorbed.", "notes_zh": ["生命移除类伤害将无视折光（也不会减少折光次数）。"], "granted_by": "", "upgrades": {"shard": {"zh": "攻击力加成提升。被控制时可以施放折光。", "en": "Increases bonus damage. Refraction can be cast while disabled."}}, "is_passive": false, "value_names": ["instances", "shield_per_instance", "bonus_damage", "bonus_damage_per_instance_burn", "duration", "cast_while_disabled", "dispels", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "templar_assassin_meld", "name_zh": "圣堂刺客·隐匿", "name_en": "Meld", "description_zh": "圣堂刺客将自己隐藏起来，只要静止不动将一直处于隐身状态。只要在隐匿状态下攻击敌人打破隐身，拉娜娅的攻击将对敌人造成额外伤害，并降低其护甲，持续%debuff_duration%秒。额外伤害和隐匿的负面效果会施加给灵能之刃飞溅距离内所有敌人。", "description_en": "Templar Assassin conceals herself, becoming invisible as long as she remains still. If Meld's invisibility is broken by attacking an enemy, Lanaya's attack will deal bonus damage to the enemy and reduce their armor for %debuff_duration% seconds. Bonus damage and debuffs from Meld are applied to all enemies in the Psi Blades split range.", "notes_zh": ["除了停留在原地或持续施放灵能投射，其他任何动作都会打破隐匿效果。", "隐匿的护甲降低作用对防御塔无效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "bonus_armor", "bash_duration", "attack_range_bonus", "debuff_duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "templar_assassin_psi_blades", "name_zh": "圣堂刺客·灵能之刃", "name_en": "Psi Blades", "description_zh": "圣堂刺客锋利的灵能之刃可以穿透敌人，对其正后方的敌方单位造成伤害，并且攻击距离得到提升。每对一个单位造成伤害后，飞溅伤害都会减少一定百分比。", "description_en": "Templar Assassin's psi blades slice through the attacked unit, splitting and damaging enemy units directly behind it, while gaining bonus attack range. For each unit it damages, the split damage is reduced by a percentage.", "notes_zh": ["飞溅伤害可以伤害隐身单位。", "重击等攻击特效只对主目标有效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_attack_range", "attack_spill_range", "attack_spill_width", "attack_spill_pct", "meld_strike_spills"]}, {"subject": "templar_assassin_trap_teleport", "name_zh": "圣堂刺客·灵能投射", "name_en": "Psionic Projection", "description_zh": "持续施法 - 圣堂刺客经过%abilitychanneltime%秒持续施法后可以传送至任意灵能陷阱，到达时引爆灵能陷阱，陷阱总是最大效果，并且立刻造成%extra_damage%点额外伤害。灵能投射在持续施法时不会脱离隐匿效果。", "description_en": "CHANNELED - Allows Templar Assassin to teleport to any Psionic Trap after channeling for %abilitychanneltime% seconds, detonating it upon arrival as if it was fully charged and instantly dealing %extra_damage% bonus damage. Channeling Psionic Projection does not break Meld.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["extra_damage", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "templar_assassin_psionic_trap", "name_zh": "圣堂刺客·灵能陷阱", "name_en": "Psionic Trap", "description_zh": "圣堂刺客放下一个隐形的神秘陷阱监视敌人的动向。引爆后将减缓%trap_radius%范围内敌人的移动速度，陷阱放置时间越久，引爆后减速效果越强，最低为%movement_speed_min%%%，放置%trap_max_charge_duration%秒后引爆将达到最大减速效果，为%movement_speed_max%%%，并且还能造成额外伤害。", "description_en": "Templar Assassin places mystical traps that invisibly monitor enemy movement. When sprung at her command, they exert a slowing influence of %movement_speed_min%%% in a %trap_radius% radius. Trap movement slow charges up to %movement_speed_max%%% after %trap_max_charge_duration% seconds. Deals damage after %trap_max_charge_duration%s.", "notes_zh": ["陷阱没有时间限制。", "他们拥有隐形效果，渐隐时间为%trap_fade_time%秒，还拥有技能免疫状态。他们可以承受2次远程英雄的攻击，1次近战英雄的攻击，或4次非英雄单位的攻击。", "陷阱的视野是250/250，不能阻止中立生物刷新。"], "granted_by": "", "upgrades": {"scepter": {"zh": "现在陷阱引爆后还会沉默受到作用的敌人。", "en": "When activated, traps now silence affected enemies."}}, "is_passive": false, "value_names": ["trap_radius", "trap_duration", "max_traps", "trap_fade_time", "movement_speed_min", "movement_speed_max", "trap_bonus_damage", "extra_damage", "damage_tick_rate", "trap_max_charge_duration", "min_silence_duration", "max_silence_duration", "bonus_vision", "AbilityCastRange", "AbilityCastPoint"]}, {"subject": "templar_assassin_inner_peace", "name_zh": "圣堂刺客·心怀安宁", "name_en": "Inner Peace", "description_zh": "原地不动且未受到伤害超过%time_until_meditation%秒后，圣堂刺客开始冥想，获得生命恢复和魔法恢复加成，冥想%time_until_max_bonus%秒后达到最大加成。", "description_en": "When remaining stationary and not taking damage for %time_until_meditation%s, Templar Assassin begins meditating, gaining health and mana regeneration, reaching the maximum bonus after %time_until_max_bonus%s of meditating.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["max_hp_regen", "max_mana_regen", "time_until_meditation", "time_until_max_bonus"]}, {"subject": "viper_poison_attack", "name_zh": "冥界亚龙·毒性攻击", "name_en": "Poison Attack", "description_zh": "蝮蛇的毒液得到强化，使他的普通攻击附带效果，可以降低目标的移动速度和魔法抗性，并持续造成伤害。效果可以叠加，最多叠加%max_stacks%次。", "description_en": "Intensifies Viper's venom, adding an effect to his normal attack that applies a stacking movement speed slow and magic resistance deduction while dealing damage over time. Stacks up to %max_stacks% times.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升最大叠加次数，毒性攻击可以降低护甲，并且可以作用于建筑，造成的伤害有所降低。", "en": "Increases max stacks, and causes Poison Attack to lower armor per stack and to affect buildings for reduced damage."}}, "is_passive": false, "value_names": ["duration", "damage", "movement_speed", "magic_resistance", "max_stacks", "bonus_range", "shard_armor_reduction", "shard_building_dmg_pct", "AbilityCastRange", "AbilityManaCost"]}, {"subject": "viper_nethertoxin", "name_zh": "冥界亚龙·幽冥剧毒", "name_en": "Nethertoxin", "description_zh": "蝮蛇向目标区域释放幽冥剧毒。范围内的单位持续受到伤害，在区域内停留的时间越长，受到的伤害也越高。同时他们的攻击速度会被降低。", "description_en": "Viper releases a Nethertoxin at the targeted area. Units in that area take an increasing damage over time based on how long they remain in it. Units in it have their attack speed slowed.", "notes_zh": ["多个幽冥剧毒不会叠加。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["min_damage", "max_damage", "max_duration", "radius", "attack_slow", "duration", "projectile_speed", "radius_increase", "expand_interval", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "viper_corrosive_skin", "name_zh": "冥界亚龙·腐蚀皮肤", "name_en": "Corrosive Skin", "description_zh": "蝮蛇分泌出感染性的毒素，%max_range%范围内任何伤害它的敌人都将受到伤害，同时攻击速度也被降低。这种酸性分泌物还能提高蝮蛇的魔法抗性。", "description_en": "Viper exudes an infectious toxin that damages and slows the attack speed of any enemy that damages it in a %max_range% radius. The acid exudate also increases Viper's resistance to magic.", "notes_zh": ["与其他提升魔法抗性的物品和技能叠加。", "破坏会使腐蚀皮肤不再施加效果。极恶俯冲还是会施加腐蚀皮肤。", "这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "腐蚀皮肤会对距离冥界亚龙%effect_multiplier_distance%范围内的敌人施加%effect_multiplier%倍攻击速度降低效果。当冥界亚龙处于幽冥剧毒中，腐蚀皮肤的魔法抗性和每秒伤害会逐渐提升，在%nethertoxin_bonus_pct_max_duration_tooltip%秒后，达到最高的%nethertoxin_bonus_pct%%%提升。", "en": "Corrosive Skin applies %effect_multiplier%x the attack speed slow to enemies that are within %effect_multiplier_distance% distance of Viper.  Viper's Corrosive Skin Magic Resistance and Damage per Second are gradually increased while he is in Nethertoxin, up to %nethertoxin_bonus_pct%%% increased effect after %nethertoxin_bonus_pct_max_duration_tooltip%s."}}, "is_passive": true, "value_names": ["duration", "bonus_attack_speed", "bonus_magic_resistance", "damage", "max_range", "effect_multiplier_distance", "effect_multiplier", "nethertoxin_bonus_pct", "nethertoxin_bonus_pct_max_duration_tooltip"]}]
