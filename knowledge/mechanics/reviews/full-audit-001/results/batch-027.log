[{"subject": "dark_willow_shadow_realm", "name_zh": "邪影芳灵·暗影之境", "name_en": "Shadow Realm", "description_zh": "邪影芳灵遁入暗影之境，无法成为攻击或技能的目标。她的下次攻击具有%attack_range_bonus%额外攻击距离，并且造成额外魔法伤害，暗影之境技能也会随之结束。在暗影中时间越长，伤害越高。在暗影之境内的时间超过%max_damage_duration%秒将达到最高伤害。", "description_en": "Dark Willow recedes into the shadows, becoming untargetable.  Her next attack has %attack_range_bonus% bonus attack range and deals bonus magic damage, and will end Shadow Realm. Damage scales based on how long she remains under the effects of Shadow Realm, the maximum being reached after %max_damage_duration% seconds.", "notes_zh": ["施法时能躲避弹道。", "获得相位移动状态。", "需要视野的技能无法作用于暗影之境中的邪影芳灵。"], "granted_by": "", "upgrades": {"scepter": {"zh": "发动普通攻击不再使邪影芳灵脱离暗影之境。持续时间内每次攻击都带有额外伤害。", "en": "Attacking no longer takes Dark Willow out of Shadow Realm. Each attack still has bonus damage based on the duration of the buff."}}, "is_passive": false, "value_names": ["duration", "fade_time", "damage", "attack_range_bonus", "max_damage_duration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "dark_willow_cursed_crown", "name_zh": "邪影芳灵·诅咒王冠", "name_en": "Cursed Crown", "description_zh": "邪影芳灵授予敌人一顶被诅咒的古老仙灵王冠。经过一定延迟后，目标和周围的所有敌人都会被眩晕。", "description_en": "Dark Willow casts an ancient fae curse on the target. After a delay, the target and nearby enemies are stunned.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "诅咒王冠在倒计时结束时会围绕目标在%shard_spawn_radius%范围内产生%shard_bramble_amount%朵荆棘。即使效果被驱散也会触发。诅咒王冠的冷却时间减少1.5秒。", "en": "Cursed Crown creates %shard_bramble_amount% brambles in a %shard_spawn_radius% radius around the target after the counter ends. Triggers even upon dispel. Cursed Crown cooldown reduced by 1.5 seconds."}}, "is_passive": false, "value_names": ["delay", "stun_duration", "stun_radius", "shard_delay_reduction", "shard_bramble_amount", "shard_spawn_radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "dark_willow_bedlam", "name_zh": "邪影芳灵·作祟", "name_en": "Bedlam", "description_zh": "邪影芳灵放出她的精灵宠物在持续时间内围绕自身飞行，快速攻击周围敌人。恐吓生效期间不能使用作祟。", "description_en": "Dark Willow sends her pet wisp to roam around herself for the duration, rapidly attacking nearby enemies.  Bedlam cannot be used while Terrorize is active.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["attack_damage", "attack_interval", "attack_radius", "attack_targets", "roaming_radius", "roaming_seconds_per_rotation", "roaming_duration", "target_count", "travel_speed", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "dark_willow_pixie_dust", "name_zh": "邪影芳灵·仙灵粉尘", "name_en": "Pixie Dust", "description_zh": "邪影芳灵获得额外%hp_regen_amp%%%生命恢复和魔法恢复，而她无法作为目标或无敌时将提升至%hp_regen_amp_out_of_world%%%。", "description_en": "Dark Willow gains %hp_regen_amp%%% bonus Health and Mana Regeneration, increased to %hp_regen_amp_out_of_world%%% while she is untargetable or invulnerable.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["hp_regen_amp", "mana_regen_amp", "hp_regen_amp_out_of_world", "mana_regen_amp_out_of_world"]}, {"subject": "dark_willow_terrorize", "name_zh": "邪影芳灵·恐吓", "name_en": "Terrorize", "description_zh": "邪影芳灵放出她的精灵宠物恐吓她的敌人。经过一定延迟后，目标区域内所有敌人变得害怕，朝自己的泉水狂奔。作祟开启期间不能使用恐吓。", "description_en": "Dark Willow releases her pet wisp to terrorize her enemies. After a short delay, all enemies in the target area become fearful and run toward their home fountain. Terrorize cannot be used while Bedlam is active.", "notes_zh": ["恐吓提供受作用单位的视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["destination_travel_speed", "destination_radius", "destination_status_duration", "return_travel_speed", "starting_height", "impact_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "grimstroke_dark_artistry", "name_zh": "天涯墨客·绝笔", "name_en": "Stroke of Fate", "description_zh": "天涯墨客画出一道弯曲的墨迹，对敌人造成伤害和减速。墨迹每碰到一个敌人，造成的伤害都会增加。可以设为多样施法（右键点击技能栏图标），使墨迹为直线。", "description_en": "Grimstroke paints a curved path of ink with his brush, damaging and slowing enemies. The damage is increased with each enemy the ink hits. Can be put on alt-cast to have the path be straight.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["start_radius", "end_radius", "damage", "bonus_damage_per_hero", "bonus_damage_per_creep", "movement_slow_pct", "slow_duration", "vision_duration", "projectile_speed", "vector_min_cos_facing_angle", "vector_strength", "vector_max_travel_time_multiplier", "vector_acceptable_radian_to_snap_velocity", "vector_distance_to_start_force_turning", "vector_deg_turn_divisor"]}, {"subject": "grimstroke_ink_creature", "name_zh": "天涯墨客·戾影", "name_en": "Phantom's Embrace", "description_zh": "召唤一个快速向目标移动的幻影，到达时将其缠住。缠住后对其造成伤害和沉默。若她在纠缠期间存活，将会撕裂目标，造成大量伤害，并刷新戾影的冷却时间。\n\n英雄对幻影的单次攻击记为3次。", "description_en": "Summons a phantom that moves quickly towards the target, latching to it when she arrives. Once latched, the phantom damages and silences. If she survives the full latch duration she rends her victim for heavy damage and refreshes Phantom's Embrace's cooldown.\n\nHero attacks against the phantom count as 3 attacks each.", "notes_zh": ["幻影在目标隐身或进入减益免疫状态后掉下。", "目标在纠缠期间阵亡后幻影将会回归。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["speed", "latch_duration", "destroy_attacks", "hero_attack_multiplier", "damage_per_second", "enemy_vision_time", "tick_interval", "infection_search_radius", "pop_damage", "return_projectile_speed", "latched_unit_offset", "latched_unit_offset_short", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "grimstroke_spirit_walk", "name_zh": "天涯墨客·墨涌", "name_en": "Ink Swell", "description_zh": "天涯墨客将一个友方单位笼罩在一片墨汁中，目标的移动速度得到提升。友方单位附近的敌人会持续被墨须伤害。%buff_duration%秒后将根据墨须对英雄造成伤害的时间对区域内单位造成伤害和眩晕。", "description_en": "Grimstroke shrouds an allied unit in ink, increasing its movement speed. Enemies in range of the allied unit are damaged with inky tendrils over time. After %buff_duration% seconds it applies damage and stun in an area around the unit in proportion to how long ink tendril was near any hero.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "墨涌在施放时会驱散友方单位。墨涌造成的伤害增加%shard_bonus_damage_pct%%%，并且治疗目标，治疗量为墨涌造成伤害的%shard_heal_pct%%%。驱散类型：弱驱散", "en": "Ink Swell dispels the allied unit when cast. Causes Ink Swell to deal %shard_bonus_damage_pct%%% more damage and heal the target for %shard_heal_pct%%% of the damage Ink Swell deals.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["buff_duration", "movespeed_bonus_pct", "radius", "max_damage", "max_stun", "damage_per_tick", "tick_rate", "tick_dps_tooltip", "max_threshold_duration", "shard_bonus_damage_pct", "shard_heal_pct", "shard_creep_penalty", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "grimstroke_dark_portrait", "name_zh": "天涯墨客·暗绘", "name_en": "Dark Portrait", "description_zh": "制造目标敌方英雄的墨色幻象。幻象为减益免疫状态，拥有%immunity_resist%%%魔法抗性，移动速度和继承攻击力超过本体。", "description_en": "Creates an ink illusion of a target enemy hero. Illusion is debuff immune, has %immunity_resist%%% magic resistance, and has bonus movement speed and attack damage.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["illusion_duration", "images_do_damage_percent", "images_do_damage_percent_tooltip", "images_take_damage_percent", "images_take_damage_percent_tooltip", "images_movespeed_bonus", "immunity_resist", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "grimstroke_soul_chain", "name_zh": "天涯墨客·缚魂", "name_en": "Soulbind", "description_zh": "将一名敌方英雄与束缚作用范围内最接近的队友相连，阻止他们远离彼此。任何指向性技能击中任一英雄时，这两名敌方英雄都会受到作用。若连接在效果截止前断裂，初始目标将再次与其距离内最接近的队友相连。", "description_en": "Binds a targeted enemy hero to its nearest allied hero within the bind radius, preventing both from moving away from each other. Any unit-targeted ability that either bound hero receives also gets cast on the other hero. If the bind is broken before the duration expires, the initial target will be bound to its nearest allied hero in the radius.", "notes_zh": ["如果与另一个单位一起被束缚，作用下单位均被束缚，而且无法使用闪烁类技能。", "被束缚的单位都将提供视野。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["chain_duration", "chain_latch_radius", "chain_break_distance", "leash_limit_multiplier", "leash_radius_buffer", "creep_duration_pct", "bonus_reflected_spell_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "grimstroke_ink_trail", "name_zh": "天涯墨客·墨痕", "name_en": "Ink Trail", "description_zh": "天涯墨客的攻击和技能会使受作用的敌方英雄在身后留下一道墨痕，对天涯墨客造成的伤害减少，持续%debuff_duration%秒。", "description_en": "Grimstroke's attacks and spells cause affected enemy heroes to leave a trail of Ink behind them and deal less damage to Grimstroke for %debuff_duration%s.", "notes_zh": ["获得作用下英雄的视野。", "天涯墨客的幻象（包括暗绘）也拥有墨痕。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["debuff_duration", "damage_reduction"]}, {"subject": "mars_spear", "name_zh": "玛尔斯·战神迅矛", "name_en": "Spear of Mars", "description_zh": "玛尔斯以致命的精准掷出他强大的战矛，对击中的每个敌方单位造成伤害。击中的第一个敌方英雄将被战矛刺穿，并被击退。若战矛击中树木、建筑或悬崖，目标将会被钉在上面，并受到眩晕。", "description_en": "Mars throws his legendary Spear with deadly precision, damaging each enemy unit it strikes. The first enemy hero it hits is skewered on the spear, pushing it back. If a skewered hero hits a tree, building, or cliff, they will be impaled to it and stunned.", "notes_zh": ["战神迅矛可以击中隐身单位，造成眩晕还使其显形。", "战神迅矛只会将单位从低地钉在地势变高的地方，否则会将他们推下高地。"], "granted_by": "", "upgrades": {"shard": {"zh": "战神迅矛可以刺中最多%max_impale_targets%名英雄，并留下一道火焰路径，持续造成伤害并减缓移动速度。", "en": "Spear of Mars impales up to %max_impale_targets% heroes and leaves a fire trail behind that deals damage over time and slows movement speed."}}, "is_passive": false, "value_names": ["damage", "spear_speed", "spear_width", "spear_vision", "max_impale_targets", "spear_range", "activity_duration", "stun_duration", "knockback_duration", "knockback_distance", "shard_trail_duration", "shard_trail_radius", "shard_dps", "shard_move_slow_pct", "shard_debuff_linger_duration"]}, {"subject": "mars_gods_rebuke", "name_zh": "玛尔斯·神之谴戒", "name_en": "God's Rebuke", "description_zh": "玛尔斯举起他的战盾粉碎前方的敌人，将他们击退并且基于自身攻击力造成致命一击伤害。攻击英雄时攻击伤害提升。具有克敌机先效果。", "description_en": "Mars smashes enemies in front of him with his shield, knocking them back and damaging them with a critical hit based on his attack. Bonus damage is added when hitting heroes. Has True Strike.", "notes_zh": ["神之谴戒的攻击也有几率触发攻击特效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["crit_mult", "angle", "radius", "knockback_duration", "knockback_distance", "knockback_slow", "knockback_slow_duration", "activity_duration", "bonus_damage_vs_heroes", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "mars_bulwark", "name_zh": "玛尔斯·护身甲盾", "name_en": "Bulwark", "description_zh": "每当玛尔斯受到来自正面或侧面的攻击时，他就挥舞他那面巨大的战盾来格挡一定百分比的伤害。可以开启，开启后获得相位移动状态，但无法攻击，自身锁定为面朝的方向，并且移动速度降低，但飞向队友的攻击弹道中%redirect_chance%%%将改变方向朝他飞去。", "description_en": "Mars wields his massive shield to block a portion of each physical attack when hit from the front or sides. Can be toggled, granting phased movement, removing Mars's ability to attack, and locking the direction he is facing. When active, reduces movement speed and re-directs %redirect_chance%%% of the attack projectiles aimed at allies towards himself.", "notes_zh": ["改向只会在弹道目标位于玛尔斯身后锥形区域内或他身边100范围内才会生效。", "破坏会使正面和侧面减伤效果失效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["physical_damage_reduction", "forward_angle", "physical_damage_reduction_side", "side_angle", "redirect_chance", "redirect_range", "redirect_speed_penatly", "redirect_close_range", "forced_movement_immunity"]}, {"subject": "mars_dauntless", "name_zh": "玛尔斯·无畏", "name_en": "Dauntless", "description_zh": "%radius%范围内敌方英雄数量更多时，玛尔斯就会获得生命恢复，敌人数量越多，生命恢复也越高。", "description_en": "Mars gets more HP Regen the more he is outnumbered by enemy heroes in %radius% radius.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["health_regen_per_enemy", "radius"]}, {"subject": "mars_arena_of_blood", "name_zh": "玛尔斯·热血竞技场", "name_en": "Arena Of Blood", "description_zh": "经过短暂的列队时间，玛尔斯召唤出环绕着战士的竞技场，战士们将阻挡敌人的攻击和动向。竞技场内的敌方英雄靠近边缘时将被战矛攻击，受到伤害并被击退。", "description_en": "After a short formation time, Mars summons an arena lined with the undead warriors of the Ash Legion, who block enemy attacks and movement. Enemy heroes near the inside edge of the arena will be attacked by spears, dealing damage and knocking them back.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "冷却时间降低%bonus_AbilityCooldown%秒，持续时间提升。如果敌人在竞技场内阵亡，玛尔斯和竞技场内所有友军都会回复%arena_kill_buff_heal_pct%%%最大生命和魔法，并且获得%arena_kill_buff_damage_pct%%%攻击力加成，持续%arena_kill_buff_duration%秒。这个效果可以叠加。", "en": "Lowers cooldown by %bonus_AbilityCooldown%s and increases duration. If an enemy is killed in the Arena, Mars and all of his allies inside the Arena restore %arena_kill_buff_heal_pct%%  of their max health and mana and get a %arena_kill_buff_damage_pct%%  attack damage buff for %arena_kill_buff_duration%s. This effect stacks."}}, "is_passive": false, "value_names": ["duration", "radius", "width", "spear_damage", "formation_time", "spear_distance_from_wall", "spear_attack_interval", "warrior_count", "warrior_fade_min_dist", "warrior_fade_max_dist", "arena_kill_buff_duration", "arena_kill_buff_damage_pct", "arena_kill_buff_heal_pct", "allied_reduction_pct", "health_regen"]}, {"subject": "void_spirit_aether_remnant", "name_zh": "虚无之灵·残阴", "name_en": "Aether Remnant", "description_zh": "虚无之灵向目标地点派出一个残像。残像观察着一片区域，面朝矢量的方向。当有目标进入其视线，残像会拉扯，并造成伤害。", "description_en": "Void Spirit dispatches a remnant to the target location. The remnant stands watch over the region, facing the direction of his vector. When a unit crosses its gaze, the remnant pulls it in and damages it.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "额外产生一道观察路径，会围绕残阴旋转。残阴现在会提供真实视域，不再对非英雄单位触发，而是每秒在两道路径上造成%creep_damage_pct%%%伤害。不会使守卫显形。", "en": "Creates an additional watcher path that rotates around the remnant.  The remnant now provides True Sight, and no longer triggers on creeps, instead dealing %creep_damage_pct%%% damage to them every second in both paths. Does not reveal wards."}}, "is_passive": false, "value_names": ["start_radius", "end_radius", "radius", "projectile_speed", "remnant_watch_distance", "remnant_watch_radius", "watch_path_vision_radius", "activation_delay", "impact_damage", "pull_duration", "pull_destination", "duration", "think_interval", "pierces_creeps", "damage_tick_rate"]}, {"subject": "void_spirit_dissimilate", "name_zh": "虚无之灵·异化", "name_en": "Dissimilate", "description_zh": "虚无之灵暂时遁入太虚，创造数个灵扉。穿过灵扉他能重组自身。穿出灵扉后，他对区域内所有敌人造成伤害。", "description_en": "Void Spirit temporarily fades into the aether, creating a number of portals through which he can reassemble himself. Upon exiting a portal, he damages all enemies in the area.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["phase_duration", "destination_fx_radius", "portals_per_ring", "angle_per_ring_portal", "first_ring_distance_offset", "damage_radius", "has_outer_ring", "aether_remnant_count", "artifice_duration_override_tooltip", "artifice_pct_effectiveness_tooltip", "artifice_extra_offset", "root_duration", "AbilityDamage", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "void_spirit_resonant_pulse", "name_zh": "虚无之灵·共鸣脉冲", "name_en": "Resonant Pulse", "description_zh": "虚无之灵将自己包裹在保护性护盾之中，可以吸收物理伤害，并围绕自身发出一次伤害性脉冲。脉冲每击中一名敌方英雄，护盾的伤害吸收量都会提升。", "description_en": "Void Spirit wraps himself in a protective shield that absorbs physical damage and emits a single damaging pulse around him. The shield gains increased damage absorption for each enemy hero the pulse hits.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "共鸣脉冲可以沉默敌人，并获得%max_charges%点能量点数。", "en": "Causes Resonant Pulse to silence and gain %max_charges% charges."}}, "is_passive": false, "value_names": ["radius", "speed", "damage", "buff_duration", "base_absorb_amount", "absorb_per_hero_hit", "is_all_barrier", "return_projectile_speed", "max_charges", "charge_restore_time", "silence_duration_scepter", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "void_spirit_intrinsic_edge", "name_zh": "虚无之灵·内在优势", "name_en": "Intrinsic Edge", "description_zh": "虚无之灵从每点属性获得的攻击力提升%damage_stat_bonus_pct%%%，并且从力量中获得的生命恢复、敏捷中获得的攻击速度和智力中获得的魔法恢复提升%secondary_stat_bonus_pct%%%。", "description_en": "Void Spirit gains %damage_stat_bonus_pct%%% more attack damage per point of each attribute, and %secondary_stat_bonus_pct%%% more HP regen from Strength, attack speed from Agility, and mana regen from Intelligence.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["secondary_stat_bonus_pct", "damage_stat_bonus_pct", "attack_damage", "hp_regen", "armor", "mp_regen", "magic_resist", "attackspeed"]}, {"subject": "void_spirit_astral_step", "name_zh": "虚无之灵·太虚之径", "name_en": "Astral Step", "description_zh": "虚无之灵撕裂现实进入精神位面，再出现在目标地点，对沿途的所有敌人造成伤害。此次攻击将施加一个太虚印记，造成%pop_damage_delay%秒减速，然后引爆。", "description_en": "Void Spirit tears a rift through the astral plane to appear at the target location, attacking all enemies along the path. This attack inflicts a void mark that slows for %pop_damage_delay% seconds and then detonates.", "notes_zh": ["太虚之径的攻击不会分裂。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "min_travel_distance", "max_travel_distance", "pop_damage_delay", "pop_damage", "movement_slow_pct", "crit_damage", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost"]}, {"subject": "snapfire_scatterblast", "name_zh": "电炎绝手·电光石火", "name_en": "Scatterblast", "description_zh": "电炎绝手开枪产生大范围的爆炸，对锥形区域内的敌人造成伤害和减速。平射距离内的伤害提升%point_blank_dmg_bonus_pct%%%，移动速度减缓、攻击速度降低和减速持续时间额外提升%point_blank_debuff_duration_pct%%%。", "description_en": "Snapfire unloads with a wide blast that damages and slows enemies in a cone. Damage is increased by %point_blank_dmg_bonus_pct%%% and Movement Slow, Attack Slow and Slow Duration are increased by %point_blank_debuff_duration_pct%%% for enemies caught at point-blank range.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "blast_speed", "blast_width_initial", "blast_width_end", "debuff_duration", "movement_slow_pct", "attack_slow_pct", "point_blank_range", "point_blank_dmg_bonus_pct", "point_blank_debuff_duration_pct", "bonus_applies_at_long_range", "shard_knockback_distance", "shard_knockback_duration", "shard_stun_duration", "shard_bonus_point_blank_dmg_pct"]}, {"subject": "snapfire_firesnap_cookie", "name_zh": "电炎绝手·龙炎饼干", "name_en": "Firesnap Cookie", "description_zh": "电炎绝手将一块烈性饼干喂给小莫迪或一名队友，使他们短距离跳跃。跳跃的单位将在落地时对敌人造成眩晕和伤害。", "description_en": "Snapfire feeds a potent cookie to Mortimer or an ally, causing them to hop a short distance. The hopping unit stuns and damages enemies in the landing zone.", "notes_zh": ["饼干的弹道速度为%projectile_speed%。"], "granted_by": "", "upgrades": {"shard": {"zh": "龙炎饼干变得更具威力，治疗目标，并且朝着陆地点发射一个%shard_damage_multiplier_tooltip%%%冲击伤害的蜥蜴绝吻。", "en": "Firesnap cookies become even more potent, healing the target and launching a Mortimer Kiss that does %shard_damage_multiplier_tooltip%%% impact damage to the landing destination."}}, "is_passive": false, "value_names": ["projectile_speed", "jump_duration", "jump_height", "jump_horizontal_distance", "pre_land_anim_time", "landing_gesture_duration", "impact_radius", "impact_damage", "impact_stun_duration", "self_cast_delay", "target_heal", "shard_damage_multiplier_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges"]}, {"subject": "snapfire_lil_shredder", "name_zh": "电炎绝手·霹雳铁手", "name_en": "Lil' Shredder", "description_zh": "电炎绝手开动蜥蜴坐骑上的加农炮，快速发动%buffed_attacks%次固定伤害加上自身攻击伤害一定百分比的攻击。每次攻击都将削弱敌人的护甲。在持续时间内提供攻击距离加成。", "description_en": "Snapfire heats up her mounted turret to rapidly fire %buffed_attacks% attacks dealing fixed damage plus a percentage of her attack damage. Each attack reduces the enemy's armor. Provides bonus attack range for the duration.", "notes_zh": ["持续时间内基础攻击间隔变为%base_attack_time%。", "霹雳铁手的攻击也有几率触发攻击特效。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "buffed_attacks", "damage_pct", "attack_speed_bonus", "attack_range_bonus", "buff_duration_tooltip", "base_attack_time", "armor_reduction_per_attack", "armor_duration", "extra_targets", "AbilityCastRange", "AbilityDuration", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "snapfire_gobble_up", "name_zh": "电炎绝手·血盆大口", "name_en": "Gobble Up", "description_zh": "小莫迪吞下一个小兵或一名友方英雄，再朝敌人吐出。单位停留在他肚子里最多可达%max_time_in_belly%秒。", "description_en": "Mortimer gobbles up a creep or an allied hero, which he can then spit towards enemies. The unit stays in his belly up to %max_time_in_belly% seconds.", "notes_zh": ["电炎绝手在小兵被吐出并阵亡后获得相应的金钱。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["max_time_in_belly", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}]
