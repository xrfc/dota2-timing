[{"subject": "beastmaster_summon_raptor", "name_zh": "兽王·召唤猛禽", "name_en": "Summon Raptors", "description_zh": "兽王召唤%hawk_count%只战鹰环绕在他周围，战鹰以%hawk_base_attack_interval%秒的基础攻击间隔俯冲攻击敌人，造成伤害并缠绕。战鹰提升攻击速度后会提升攻击频率。以英雄优先。", "description_en": "Beastmaster summons %hawk_count% hawks that circle around Beastmaster and dive-bombs at enemies with a base attack rate of every %hawk_base_attack_interval%s, damaging and rooting them. Attack rate increases with the Hawk's attack speed. Prioritizes heroes.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "hawk_spawn_interval", "hawk_base_max_health", "hawk_base_gold_bounty", "hawk_base_vision_range", "hawk_base_xp_bounty", "hawk_base_magic_resist", "attack_radius", "hawk_count", "dive_damage", "dive_root_duration", "roaming_radius", "roaming_seconds_per_rotation", "hawk_base_attack_interval", "min_move_speed"]}, {"subject": "beastmaster_inner_beast", "name_zh": "兽王·野性之心", "name_en": "Inner Beast", "description_zh": "唤起兽王和他控制单位的内心狂怒，被动提高他们的攻击速度。", "description_en": "Untaps the inner fury of Beastmaster and units he controls, passively increasing their attack speed.", "notes_zh": ["破坏会使被动攻击速度加成失效。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "bonus_attack_speed", "bonus_damage"]}, {"subject": "beastmaster_drums_of_slom", "name_zh": "兽王·斯洛姆战鼓", "name_en": "Drums of Slom", "description_zh": "兽王或周围他控制的单位攻击敌人都会使他敲下战鼓，对附近单位造成伤害，并且治疗自身和他控制的单位，数值为造成伤害的一定百分比。每次攻击都会降低敲鼓的间隔，%max_stacks%次攻击后降低至最短%min_drum_hit_interval%秒敲击一次。如果没有发动攻击，敲鼓间隔会逐渐变长。使用原始咆哮时自动增加%primal_roar_stacks%层敲鼓叠加效果。", "description_en": "Attacks from Beastmaster or a nearby unit he controls will cause him bang his drum, dealing damage to nearby units and healing Beastmaster and units under his control for a portion of the damage dealt. Every attack decreases the interval between drum hits down to a minimum of %min_drum_hit_interval%s between hits after %max_stacks% attacks. If no attacks are made, the intervals gradually increase.Using Primal Roar counts as %primal_roar_stacks% attacks.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": true, "value_names": ["radius", "max_stacks", "stack_decay_time", "min_drum_hit_interval", "max_drum_hit_interval", "base_damage", "heal_pct", "creep_damage_pct", "creep_heal_pct", "aura_radius", "primal_roar_stacks"]}, {"subject": "beastmaster_primal_roar", "name_zh": "兽王·原始咆哮", "name_en": "Primal Roar", "description_zh": "兽王发出震耳欲聋的咆哮，使目标敌方单位受到伤害并眩晕，同时在兽王和他的猎物之间清出一条通道。通道上的所有单位都被震开，也受到伤害并被降低移动和攻击速度。另外，兽王和他的单位获得%movement_speed%%%移动速度提升，持续%movement_speed_duration%秒。", "description_en": "Beastmaster lets loose a deafening roar that stuns, and shoves open a path to its target. All units in the path of the roar are damaged, while units shoved aside by the roar have their movement and attack speed slowed. Additionally, Beastmaster and his units gain %movement_speed%%% movement speed for %movement_speed_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "damage", "side_damage", "damage_radius", "slow_movement_speed_pct", "slow_attack_speed_pct", "push_distance", "push_duration", "slow_duration", "movement_speed", "movement_speed_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "queenofpain_shadow_strike", "name_zh": "痛苦女王·暗影突袭", "name_en": "Shadow Strike", "description_zh": "投出一把淬毒匕首，造成大量初始伤害，并持续造成后续伤害。中毒的单位移动速度被减缓，持续%duration%秒。每%damage_interval%秒会再造成一次伤害。", "description_en": "Hurls a poisoned dagger which deals large initial damage, and then deals damage over time. The poisoned unit has its movement speed slowed for %duration% seconds.  An instance of damage is dealt every %damage_interval% seconds.", "notes_zh": ["受到作用的单位在持续时间内将逐秒缓慢地恢复至初始移动速度。", "受到暗影突袭作用的单位在生命值低于最大值25%时可以被队友反补。"], "granted_by": "", "upgrades": {"scepter": {"zh": "暗影突袭变为%aoe_radius%范围型技能。暗影突袭效果结束后或重新施加给敌方英雄时，目标将放出痛苦尖叫，伤害附近所有敌人。", "en": "Causes Shadow Strike to become a %aoe_radius% AoE Spell. When Shadow Strike ends or is re-applied to an enemy Hero, the target emits a Scream of Pain, hitting any nearby enemies."}}, "is_passive": false, "value_names": ["strike_damage", "duration_damage", "movement_slow", "projectile_speed", "attack_speed", "damage_interval", "generate_scream", "aoe_radius", "duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "queenofpain_blink", "name_zh": "痛苦女王·闪烁", "name_en": "Blink", "description_zh": "短距离传送，能让痛苦女王自由出入战场。", "description_en": "Short distance teleportation that allows Queen of Pain to move in and out of combat.", "notes_zh": ["闪烁可以躲避多种飞行过程中的攻击和技能弹道。"], "granted_by": "", "upgrades": {"shard": {"zh": "在痛苦女王的闪烁起点和落地点各释放一次音爆。在%shard_aoe%范围内造成%shard_damage%点伤害，并沉默%shard_duration%秒。", "en": "Releases a sonic boom when Queen of Pain blinks, at both her starting and ending locations. Deals %shard_damage% damage in a %shard_aoe% AoE and silences the target for %shard_duration% seconds."}}, "is_passive": false, "value_names": ["min_blink_range", "shard_damage", "shard_duration", "shard_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "queenofpain_scream_of_pain", "name_zh": "痛苦女王·痛苦尖叫", "name_en": "Scream Of Pain", "description_zh": "痛苦女王发出刺耳的尖叫，对周围敌人造成伤害。造成伤害的%damage_reflected_to_self%%%会反弹回她身上。", "description_en": "The Queen of Pain lets loose a piercing scream around her, damaging nearby enemies.%damage_reflected_to_self%%% of the damage dealt to heroes is reflected back to her.", "notes_zh": ["痛苦尖叫能作用隐身单位。", "痛苦尖叫无法被躲避。", "对幻象造成的伤害不会反弹。反弹的伤害为减免前的，而且不致死。", "反弹伤害不提供任何吸血，而且无法反弹。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["area_of_effect", "projectile_speed", "damage", "damage_reflected_to_self", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "queenofpain_succubus", "name_zh": "痛苦女王·魅魔", "name_en": "Succubus", "description_zh": "所有来源的技能吸血也对纯粹伤害生效。痛苦女王获得技能吸血，与敌人的距离越近效果越强。敌人距离她不到%close_radius%距离时达到最强效果，距离她超过%max_radius%距离时为最弱效果。", "description_en": "All sources of Spell Lifesteal also apply to Pure Damage. Queen of Pain gains Spell Lifesteal that increases with proximity to her enemies. Lifesteal is at its maximum when the enemy is %close_radius% units or closer to her and at its minimum when the enemy is %max_radius% units or further from her.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["spell_lifesteal", "close_radius", "max_radius", "spell_lifesteal_close"]}, {"subject": "queenofpain_sonic_wave", "name_zh": "痛苦女王·超声冲击波", "name_en": "Sonic Wave", "description_zh": "痛苦女王在她面前制造出强大的声波，对其轨迹上的所有敌人造成大量伤害，并将他们击退。", "description_en": "Creates a gigantic wave of sound in front of Queen of Pain, dealing heavy damage to all enemy units in its wake and pushing them back.", "notes_zh": ["超声冲击波最远能伤害1150距离外的单位。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["starting_aoe", "distance", "final_aoe", "speed", "damage", "tick_rate", "knockback_distance", "knockback_duration", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "venomancer_venomous_gale", "name_zh": "剧毒术士·瘴气", "name_en": "Venomous Gale", "description_zh": "沿直线射出一个毒液球，碰到的敌人受到初始伤害和持续伤害，并受到减速效果影响。瘴气在持续时间内每3秒造成一次持续伤害。", "description_en": "Launches a ball of venom in a line, poisoning enemy units so that they take both initial damage and damage over time, as well as suffering slowed movement.  Venomous Gale deals damage every 3 seconds over its duration.", "notes_zh": ["瘴气可以致死。", "技能持续时间内每%tick_interval%秒造成一次伤害。", "初始减速效果为%movement_slow%%%，减速效果将逐渐降低。"], "granted_by": "", "upgrades": {"shard": {"zh": "施法距离和弹道速度提升%shard_travel_tooltip%%%。瘴气只要击中每个敌方英雄就会在他们周围制造%num_created_wards_tooltip%个瘟疫守卫。", "en": "Increases cast range and projectile speed by %shard_travel_tooltip%%%. When Venomous Gale impacts enemy heroes, %num_created_wards_tooltip% Plague Wards are created around them."}}, "is_passive": false, "value_names": ["duration", "strike_damage", "tick_damage", "tick_interval", "movement_slow", "radius", "speed", "create_wards", "shard_travel_tooltip", "num_created_wards_tooltip", "ward_hp_dmg_pct", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "venomancer_snakebite", "name_zh": "剧毒术士·毒蛇撕咬", "name_en": "Snakebite", "description_zh": "剧毒术士召唤阿克特克的幼体，把它的毒牙刺入一个敌人，造成魔法伤害，并施加造成每秒伤害的剧毒。目标在感染时发动攻击，他就会再次受到初始伤害。", "description_en": "Venomancer summons a Spawn of Aktok to sink its fangs into a target, dealing magic damage and applying a toxin that does damage every second. When the target attacks while infected, they take the initial damage again.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["base_damage", "tick_damage", "duration", "damage_interval", "undispellable", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "venomancer_plague_ward", "name_zh": "剧毒术士·瘟疫守卫", "name_en": "Plague Ward", "description_zh": "召唤一个瘟疫守卫来攻击敌方单位和建筑。守卫对魔法免疫。守卫拥有毒刺攻击，效果与毒刺技能的当前等级相同，造成50%的原技能伤害。", "description_en": "Summons a plague ward to attack enemy units and structures. The ward is immune to magic. Wards gain the Poison Sting level from Venomancer, dealing 50% of the full damage.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["gold_bounty_pct", "duration", "ward_model_scale", "ward_base_damage", "ward_damage_spread", "ward_max_health", "ward_gold_bounty_min", "ward_gold_bounty_max", "magic_immune", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "venomancer_poison_sting", "name_zh": "剧毒术士·毒刺", "name_en": "Poison Sting", "description_zh": "剧毒的攻击会持续减速敌人并造成伤害。", "description_en": "Venomancer's attacks slow enemies and deal damage over time.", "notes_zh": ["毒刺的伤害可以致死。", "毒刺造成的持续性伤害不会打断物品的回复效果，也不能使闪烁匕首进行冷却状态。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["duration", "damage", "movement_speed", "hp_regen_reduction"]}, {"subject": "venomancer_noxious_plague", "name_zh": "剧毒术士·恶性瘟疫", "name_en": "Noxious Plague", "description_zh": "使一名敌人感染致命的瘟疫，施加时造成伤害，然后减速目标，并且基于目标的最大生命值造成持续伤害。不论负面状态以何种方式消失，瘟疫都会带着剧毒术士施加给初始目标的所有负面状态一起扩散到附近目标。第一次以外的额外扩散不会造成初始伤害。", "description_en": "Infects an enemy with a plague that does damage on application then slows the target and deals damage over time based on their maximum health. When the debuff ends for any reason, all debuffs from Venomancer on the initial target and the plague are spread to nearby targets. Additional spreads beyond the first do not deal impact damage.", "notes_zh": ["扩散的负面状态拥有固定的持续时间，不会受到状态抗性和负面状态增强的影响。"], "granted_by": "", "upgrades": {"scepter": {"zh": "冷却时间减少%bonus_AbilityCooldown%秒。感染的单位拥有的魔法抗性会降低。来自英雄目标的额外扩散会造成全额的击中伤害。", "en": "Decreases cooldown by %bonus_AbilityCooldown% seconds. Infected units have decreased magic resistance. Additional spreads from hero targets deal full impact damage."}}, "is_passive": false, "value_names": ["debuff_duration", "impact_damage", "damage_per_second", "damage_tick_rate", "debuff_time_transfer", "movement_slow", "debuff_radius", "spread_count", "mres_reduce", "impact_damage_reduce", "projectile_speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "faceless_void_time_walk", "name_zh": "虚空假面·时间漫游", "name_en": "Time Walk", "description_zh": "冲到目标位置，并取消最近%backtrack_duration%秒内受到的任何伤害。", "description_en": "Rushes to a target location while backtracking any damage taken the last %backtrack_duration% seconds.", "notes_zh": ["虚空假面在时间漫游过程中为无敌状态。"], "granted_by": "", "upgrades": {"scepter": {"zh": "在落地点对所有单位施加一次时间锁定。", "en": "Applies a Time Lock to all units at the landing destination."}}, "is_passive": false, "value_names": ["speed", "range", "backtrack_duration", "backtrack_time_walk_duration", "dodge_chance_pct", "radius", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "faceless_void_time_dilation", "name_zh": "虚空假面·时间膨胀", "name_en": "Time Dilation", "description_zh": "虚空假面将附近所有敌人困在一个时间膨胀场中，技能的冷却都会减慢。施加时每个受困的敌人都会获得一层时间膨胀的叠加效果，每有一个技能处于冷却就再获得一层。每层叠加效果造成每秒伤害，并降低移动速度和攻击速度降低。持续时间在时间结界作用下会暂停。", "description_en": "Faceless Void envelops nearby enemies with time dilating fields to slow cooldown progression of their abilities. Each enveloped enemy gains one Time Dilation stack when applied, and one stack per ability they have on cooldown. Each stack deals damage per second and slows movement and attack speed. The duration is paused while affected by Chronosphere.", "notes_zh": ["不会影响物品的冷却时间。", "效果期间叠加层数还会改变。施放技能后如果技能进入冷却就会提供一层叠加效果。如果技能冷却在时间膨胀期间完成，效果会被移除。"], "granted_by": "", "upgrades": {"shard": {"zh": "提升每层叠加的减速。向虚空假面提供叠加效果，可以提升他的攻击和移动速度。叠加层数等于施放时施加给敌人的时间膨胀叠加层数的总和，效果会在持续时间内线性衰减。", "en": "Increases slow per stack. Provides Faceless Void with stacks that increase his attack and movement speed. Amount of stacks is equal to the total amount of Time Dilation stacks applied to enemies at the moment of the cast and linearly fades out over the duration."}}, "is_passive": false, "value_names": ["radius", "duration", "slow", "attack_slow_tooltip_only", "cooldown_percentage", "damage_per_stack", "self_movespeed_tooltip", "self_attackspeed_tooltip", "self_buff", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "faceless_void_time_lock", "name_zh": "虚空假面·时间锁定", "name_en": "Time Lock", "description_zh": "攻击有一定概率将一个敌方目标锁定在时间中，再次发动攻击。", "description_en": "Adds the chance for an attack to lock an enemy unit in time while attacking it a second time.", "notes_zh": ["不与碎颅锤叠加。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["duration", "duration_creep", "chance_pct", "bonus_damage", "delay"]}, {"subject": "faceless_void_time_walk_reverse", "name_zh": "虚空假面·反时间漫游", "name_en": "Reverse Time Walk", "description_zh": "时间漫游落地后1.5秒内可使用。施放时，自身将逆转时间漫游，回到上一个施放地点。不会影响生命值或触发神杖效果。", "description_en": "Available for 1.5 seconds after landing Time Walk. If used in this period, you will reverse your time walk back to your previous cast location. Does not affect health or proc scepter hits.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["buff_duration", "speed", "AbilityCooldown"]}, {"subject": "faceless_void_distortion_field", "name_zh": "虚空假面·扭曲力场", "name_en": "Distortion Field", "description_zh": "虚空假面附近%friendly_hero_distance%范围内以他或友方英雄为目标的敌方攻击弹道在进入目标%slow_distance_max%范围后会被减速%attack_projectile_slow%%%。", "description_en": "Enemy Attack Projectiles targetting Faceless Void or allied heroes within a %friendly_hero_distance% radius of him get slowed by %attack_projectile_slow%%%, when they get  within %slow_distance_max% distance of their target.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["attack_projectile_slow", "slow_distance_max", "friendly_hero_distance"]}, {"subject": "faceless_void_chronosphere", "name_zh": "虚空假面·时间结界", "name_en": "Chronosphere", "description_zh": "在时空中创造一个泡状遮罩，将所有位于其中的单位定住，并使虚空假面在其内部来去自如。只有虚空假面和他控制的单位不受影响。在其中的隐形敌人会显形。", "description_en": "Creates a blister in spacetime, trapping all units caught in its sphere of influence and causes you to move very quickly inside it. Only Faceless Void and any units he controls are unaffected. Invisible enemies in the sphere will be revealed.", "notes_zh": ["能够定住所有单位和建筑，不论敌我。除了虚空假面控制的单位。", "虚空假面不受任何时间结界的影响。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "duration", "vision_radius", "bonus_attack_speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skeleton_king_hellfire_blast", "name_zh": "冥魂大帝·冥火爆击", "name_en": "Wraithfire Blast", "description_zh": "冥魂大帝向一个敌方单位发射冥魂火球，造成即时伤害和眩晕，并持续对目标造成伤害和减速。", "description_en": "Wraith King sears an enemy unit with spectral fire, dealing damage and stunning, then dealing damage over time and slowing the target.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["blast_speed", "blast_stun_duration", "blast_dot_duration", "blast_slow", "damage", "blast_dot_damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skeleton_king_bone_guard", "name_zh": "冥魂大帝·白骨护卫", "name_en": "Bone Guard", "description_zh": "击杀2个非英雄单位可获得1点能量，击杀1名英雄可获得2点能量。可以主动使用，消耗所有能量点数召唤可以复活一次的骷髅兵。骷髅兵享受吸血灵魂的吸血效果。", "description_en": "Gains a Charge for every 2 creeps killed and 2 charges per hero killed. Activate to spend all charges, summoning skeletons that respawn once when killed. Skeletons benefit from Vampiric Spirit's lifesteal.", "notes_zh": ["破坏会使技能无法获得新的叠加效果。", "对敌人施放冥火爆击会导致骷髅兵攻击该敌人。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["skeleton_duration", "max_skeleton_charges", "min_skeleton_spawn", "spawn_interval", "reincarnate_time", "gold_bounty", "xp_bounty", "skeleton_damage_tooltip", "talent_skeleton_damage", "skeleton_building_damage_reduction", "skeleton_bonus_hero_damage", "skeleton_charges_per_hero_multiplier", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "skeleton_king_mortal_strike", "name_zh": "冥魂大帝·本命一击", "name_en": "Mortal Strike", "description_zh": "冥魂大帝被动地在攻击时造成额外伤害，本技能具有冷却时间。", "description_en": "Wraith King passively deals bonus damage on an attack with a cooldown.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "本命一击会诅咒目标，使其在%curse_delay%秒延迟后再次受到%curse_damage_pct%%%原攻击伤害的纯粹伤害。吸血灵魂的吸血效果对诅咒伤害有效。", "en": "Mortal Strike hits curse their target, causing them to take %curse_damage_pct%%% of the initial attack damage again as Pure damage after a %curse_delay% second delay. Vampiric Spirit's lifesteal applies to the curse damage."}}, "is_passive": true, "value_names": ["crit_mult", "wraith_cd_mult", "curse_damage_pct", "curse_delay", "curse_cooldown", "AbilityCooldown"]}, {"subject": "skeleton_king_vampiric_spirit", "name_zh": "冥魂大帝·吸血灵魂", "name_en": "Vampiric Spirit", "description_zh": "冥魂大帝获得吸血效果。被击杀时冥魂大帝变为移动无视地形的冥魂，拥有额外攻击和移动速度，持续较短时间，自身死亡延后。冥魂大帝变为冥魂后无法重生。", "description_en": "Grants Wraith King Lifesteal. When slain Wraith King turns into a free pathing Wraith with Bonus Attack and Movement Speed for a short duration, delaying his death. Wraith King cannot reincarnate after being a Wraith.", "notes_zh": ["对于死亡被延缓的友军，其成为冥魂前所受的最后一击来源即为击杀者。", "触发绝冥再生时没有效果。", "破坏只会使被动吸血失效。", "复活时间会根据冥魂持续时间而减少。"], "granted_by": "", "upgrades": {"scepter": {"zh": "吸血灵魂变为光环，使友方英雄被击杀时也能变为冥魂。延长冥魂的持续时间。", "en": "Turns Vampiric Spirit into an aura, allowing allied heroes to turn into wraiths when slain. Extends wraith duration."}}, "is_passive": true, "value_names": ["vampiric_aura", "duration", "scepter_attack_speed", "scepter_move_speed_pct", "scepter_aura_radius"]}, {"subject": "skeleton_king_reincarnation", "name_zh": "冥魂大帝·绝冥再生", "name_en": "Reincarnation", "description_zh": "冥魂大帝倒下后，他飞散的冥魂会重组，使他复活。死亡时附近%slow_radius%范围内的敌人会被减速，会产生骷髅兵攻击附近每个敌方英雄。可以对自身施放，使冥魂大帝立刻阵亡。", "description_en": "Wraith King's form regroups after death, allowing him to resurrect when killed in battle.  Upon death, enemy units in a %slow_radius% radius are slowed. Skeletons spawn and attack each nearby enemy hero. Can be self-cast to kill Wraith King instantly.", "notes_zh": ["如果魔法不足冥魂大帝将不会重生。", "如果冥魂大帝拥有不朽之守护，同时绝冥再生不处于冷却状态，死亡后将首先触发绝冥再生。", "重生后生命值和魔法值全满。"], "granted_by": "", "upgrades": {"scepter": {"zh": "减少冷却时间。", "en": "Reduces cooldown."}}, "is_passive": false, "value_names": ["reincarnate_time", "slow_radius", "movespeed", "attackslow", "slow_duration", "clear_curse", "shard_skeleton_count", "trigger_wraithfire_blast", "AbilityManaCost", "AbilityCooldown"]}]
