bilityManaCost", "AbilityCooldown"]}, {"subject": "tidehunter_dead_in_the_water", "name_zh": "潮汐猎人·重如铁锚", "name_en": "Dead in the Water", "description_zh": "潮汐猎人将一只重锚栓到一名敌方英雄身上。被栓到锚上的英雄处于被束缚状态。尝试移动到距离巨锚%chain_length%距离外会导致英雄的移动速度降低至%max_movement_speed%，而且会一直拽着长锚。巨锚承受%attacks_to_destroy%次英雄攻击后会被摧毁。", "description_en": "Tidehunter attaches a heavy anchor to an enemy hero. The hero is leashed while attached to the anchor. Attempting to move more than %chain_length% units away from the anchor forces the hero to %max_movement_speed% move speed, dragging the anchor behind them. The anchor can be destroyed with %attacks_to_destroy% hero attacks.", "notes_zh": [], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["attacks_to_destroy", "max_movement_speed", "chain_length", "duration", "projectile_speed", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "riki_tricks_of_the_trade", "name_zh": "力丸·绝杀秘技", "name_en": "Tricks of the Trade", "description_zh": "持续施法 - 力丸转移出现实位面，每隔一段时间从背后随机攻击附近的%interval_targets%个随机敌方单位。期间他的攻击伤害为固定值。", "description_en": "CHANNELED - Riki phases out of the world and periodically strikes %interval_targets% random enemy units from behind in an area around him. He has fixed attack damage while phased out.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离至%AbilityCastRange%。可以对友方单位施放，持续时间内藏在他们体内。藏在友方单位体内时，他会拥有%scepter_movespeed%%%移动速度加成，同时绝杀秘技的持续时间提升%scepter_bonus_duration%秒，并且额外发动%scepter_bonus_attacks%次攻击。", "en": "Increases Cast Range to %AbilityCastRange%. Allows you to target an allied unit, hiding inside them for the duration. While hiding in an allied unit, they have %scepter_movespeed%%% bonus movement speed, and Tricks of the Trade lasts %scepter_bonus_duration%s longer and does an additional %scepter_bonus_attacks% attacks."}}, "is_passive": false, "value_names": ["radius", "attack_count", "speed_per_attack", "interval_targets", "attack_damage", "base_attack_damage_pct", "pocket_riki_enabled", "scepter_movespeed", "scepter_bonus_duration", "scepter_bonus_attacks", "creep_agility_multiplier", "cooldown_reduction_per_creep_kill", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint"]}, {"subject": "riki_backstab", "name_zh": "力丸·刀光谍影", "name_en": "Cloak and Dagger", "description_zh": "力丸遁入阴影，变为隐身状态，主动攻击敌人后力丸将会显形。击杀英雄和助攻会提供额外经验。", "description_en": "Riki fades into the shadows, becoming invisible until he attacks. Hero kills and assists grant additional experience.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["fade_delay", "invis_movespeed_bonus_percent", "bonus_xp_kill", "bonus_xp_assist"]}, {"subject": "enigma_demonic_conversion", "name_zh": "谜团·恶魔召唤", "name_en": "Demonic Summoning", "description_zh": "以生命为代价召唤三个谜团自身的碎片。虚灵的生命值会有所增加，数值为谜团当前生命值的%current_health_pct%%%。这些虚灵都由谜团控制，在反复经过几次成功的攻击后，虚灵会再次分裂，并完全回复生命值。", "description_en": "Summons three fragments of Enigma himself at the cost of health.  The eidolons health is increased by %current_health_pct%%% of Enigma's current health. These eidolons are all under Enigma's control, and repeated successful attacks cause them to multiply.  When this happens, the eidolons have their health restored.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["spawn_count", "split_attack_count", "eidelon_max_health", "life_extension", "eidelon_base_damage", "eidolon_damage_spread", "eidolon_bonus_damage", "eidolon_bonus_attack_speed", "eidelon_base_movespeed", "creep_max_level", "eidolon_magic_resist", "eidolon_attack_range", "allied_damage_pct", "self_modelscale", "spawn_offset"]}, {"subject": "enigma_event_horizon", "name_zh": "谜团·事件视界", "name_en": "Event Horizon", "description_zh": "%radius%范围内的单位远离谜团时会受到移速惩罚。", "description_en": "Units in a %radius% radius moving away from Enigma have a movespeed penalty.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "speed_bonus", "vision_cone"]}, {"subject": "necrolyte_ghost_shroud", "name_zh": "瘟疫法师·幽魂护罩", "name_en": "Ghost Shroud", "description_zh": "瘟疫法师步入将生者与死者相隔的领域。散发出一片灵气，减缓周围敌人的移动速度。在这个形态下，瘟疫法师为虚无状态，无法攻击或被攻击，受到的魔法伤害增加，但是生命/魔法恢复效果加强。", "description_en": "Necrophos slips into the realm that separates the living from the dead. Unable to attack or be attacked, he emits an aura that slows enemies around him. He takes additional magic damage in this form, but his restorative powers are amplified.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "heal_bonus", "movement_speed", "slow_aoe", "bonus_damage", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "warlock_shadow_word", "name_zh": "术士·暗言术", "name_en": "Shadow Word", "description_zh": "术士低声说出一个咒语，对一个单位施展法术，使周围的敌方单位受到伤害，周围的友方单位被治疗。目标单位也会被治疗或受到伤害，取决于他是友军还是敌人。", "description_en": "Warlock whispers an incantation, casting a spell on a unit that makes it deal damage to nearby enemy units and heal nearby ally units. Target Unit will also heal or be damaged depending on whether they are ally or enemy.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "duration", "tick_interval", "spell_aoe", "shard_movement_speed_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "warlock_rain_of_chaos", "name_zh": "术士·混乱之祭", "name_en": "Chaotic Offering", "description_zh": "从深渊召唤一个地狱火，眩晕敌人%stun_duration%秒。地狱火持续%golem_duration%秒，能够减免部分技能的伤害，具有较高的减速抗性，拥有永久献祭和烈焰之拳技能。", "description_en": "Summons a Golem from the depths, stunning enemies for %stun_duration% seconds. The Golem lives %golem_duration% seconds, takes reduced damage from spells, has increased Slow Resistance, has Permanent Immolation and Flaming Fists on attack.", "notes_zh": ["该技能将摧毁作用范围内的树木。"], "granted_by": "", "upgrades": {"scepter": {"zh": "召唤%number_of_golems_scepter%个地狱火。", "en": "Calls %number_of_golems_scepter% Golems."}}, "is_passive": false, "value_names": ["golem_duration", "stun_duration", "aoe", "golem_hp", "golem_dmg", "golem_armor", "golem_movement_speed", "golem_health_regen", "golem_gold_bounty", "stun_delay", "number_of_golems_scepter", "golem_hp_scepter", "golem_dmg_scepter", "golem_gold_bounty_scepter", "bonus_armor"]}, {"subject": "beastmaster_summon_razorback", "name_zh": "兽王·召唤刀背兽", "name_en": "Summon Razorback", "description_zh": "兽王召唤一头豪猪前来助阵。豪猪拥有被动的毒素攻击，可以减缓攻击和移动速度。", "description_en": "Beastmaster calls forth a Boar to aid in the battlefield. The Boar has a passive poison attack that slows attack and movement speeds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "boar_base_max_health", "boar_base_damage", "boar_total_damage_tooltip", "boar_bonus_damage", "boar_base_xp_bounty", "boar_base_movespeed", "boar_moveslow_tooltip", "boar_poison_duration_tooltip", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "beastmaster_summon_raptor", "name_zh": "兽王·召唤猛禽", "name_en": "Summon Raptors", "description_zh": "兽王召唤%hawk_count%只战鹰环绕在他周围，战鹰以%hawk_base_attack_interval%秒的基础攻击间隔俯冲攻击敌人，造成伤害并缠绕。战鹰提升攻击速度后会提升攻击频率。以英雄优先。", "description_en": "Beastmaster summons %hawk_count% hawks that circle around Beastmaster and dive-bombs at enemies with a base attack rate of every %hawk_base_attack_interval%s, damaging and rooting them. Attack rate increases with the Hawk's attack speed. Prioritizes heroes.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "hawk_spawn_interval", "hawk_base_max_health", "hawk_base_gold_bounty", "hawk_base_vision_range", "hawk_base_xp_bounty", "hawk_base_magic_resist", "attack_radius", "hawk_count", "dive_damage", "dive_root_duration", "roaming_radius", "roaming_seconds_per_rotation", "hawk_base_attack_interval", "min_move_speed"]}]
