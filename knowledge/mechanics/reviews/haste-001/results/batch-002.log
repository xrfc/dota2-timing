ect":"slardar_sprint","grants":"self","upgrade":"base","escape_main":"yes","quote":"移动速度得到显著提升，并且可以穿越单位","reason_zh":"基础主动给自身显著加速并允许穿越单位，主要用于跑或追。","uncertain":false},{"subject":"slardar_seaborn_sentinel","grants":"none","upgrade":"none","escape_main":"na","quote":"在水洼、水迹或河道中将获得移动速度、生命恢复、攻击力和护甲加成","reason_zh":"这是依赖水域地形的被动加成，按题目对被动地形效果的排除规则不计。","uncertain":false},{"subject":"tidehunter_gush","grants":"none","upgrade":"none","escape_main":"na","quote":"reducing their movement speed and armor","reason_zh":"只降低敌人的移动速度和护甲。","uncertain":false},{"subject":"tidehunter_kraken_shell","grants":"none","upgrade":"none","escape_main":"na","quote":"以%active_move_speed_penalty_pct%%%移动速度的代价使伤害格挡量加倍","reason_zh":"主动效果牺牲自身移速来提高格挡，没有移速提升。","uncertain":false},{"subject":"tidehunter_dead_in_the_water","grants":"none","upgrade":"none","escape_main":"na","quote":"英雄的移动速度降低至%max_movement_speed%","reason_zh":"魔晶技能只限制并降低敌方英雄移速。","uncertain":false},{"subject":"riki_tricks_of_the_trade","grants":"ally","upgrade":"scepter","escape_main":"yes","quote":"While hiding in an allied unit, they have %scepter_movespeed%%% bonus movement speed","reason_zh":"A杖升级使承载力丸的友方单位获得移速，帮助其在藏身持续期间跑或追。","uncertain":false},{"subject":"riki_backstab","grants":"unclear","upgrade":"none","escape_main":"na","quote":"变为隐身状态；\"invis_movespeed_bonus_percent\"","reason_zh":"正文没有描述隐身时加速，仅凭移速加成参数名无法确认实际效果。","uncertain":true},{"subject":"enigma_demonic_conversion","grants":"none","upgrade":"none","escape_main":"na","quote":"虚灵的生命值会有所增加；\"eidelon_base_movespeed\"","reason_zh":"召唤物的基础移速参数不代表获得移速提升，正文也没有加速效果。","uncertain":false},{"subject":"enigma_event_horizon","grants":"none","upgrade":"none","escape_main":"na","quote":"远离谜团时会受到移速惩罚","reason_zh":"只描述移动速度惩罚，没有移速增益。","uncertain":false},{"subject":"necrolyte_ghost_shroud","grants":"none","upgrade":"none","escape_main":"na","quote":"减缓周围敌人的移动速度","reason_zh":"虚无状态和恢复增强之外只描述敌方减速，没有自身加速。","uncertain":false},{"subject":"warlock_shadow_word","grants":"unclear","upgrade":"none","escape_main":"na","quote":"周围的友方单位被治疗；\"shard_movement_speed_pct\"","reason_zh":"正文只描述治疗和伤害，参数名不足以确认魔晶是否实际提供移速及作用对象。","uncertain":true},{"subject":"warlock_rain_of_chaos","grants":"none","upgrade":"none","escape_main":"na","quote":"具有较高的减速抗性","reason_zh":"减速抗性和召唤物基础移速不算移动速度提升。","uncertain":false},{"subject":"beastmaster_summon_razorback","grants":"none","upgrade":"none","escape_main":"na","quote":"毒素攻击，可以减缓攻击和移动速度","reason_zh":"豪猪只通过攻击降低敌方速度，没有自身或友方加速。","uncertain":false},{"subject":"beastmaster_summon_raptor","grants":"none","upgrade":"none","escape_main":"na","quote":"战鹰提升攻击速度后会提升攻击频率","reason_zh":"描述的是攻击速度影响攻击频率，未提供移动速度加成。","uncertain":false}]}
