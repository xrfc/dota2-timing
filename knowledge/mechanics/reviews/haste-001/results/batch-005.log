 {}, "is_passive": true, "value_names": ["tree_radius", "tree_regen", "dirt_move_speed", "water_move_slow", "water_slow_duration"]}, {"subject": "meepo_megameepo_fling", "name_zh": "米波·超大米波摔扔", "name_en": "MegaMeepo Fling", "description_zh": "在超大米波形态下，米波将最上端的米波向%AbilityCastRange%范围内目标扔出，造成伤害和减速。", "description_en": "In MegaMeepo form, Meepo flings the topmost meepo towards a target within a %AbilityCastRange% range, dealing damage and slowing their movement speed.", "notes_zh": ["不会触发法术反弹。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["fling_damage", "fling_radius", "fling_movespeed", "fling_slow_duration", "movement_slow", "AbilityCastRange", "AbilityCastPoint", "AbilityCooldown"]}, {"subject": "treant_natures_guise", "name_zh": "树精卫士·自然蔽护", "name_en": "Nature's Guise", "description_zh": "只要靠近树木就会获得移动速度加成。树精卫士在%cooldown_time%秒内不受到伤害就会额外获得树木穿行。树木穿行时，自然蔽护可以主动使用，使树精卫士获得隐身状态，直到他主动攻击，或不再靠近树木。", "description_en": "Grants bonus movement speed when near trees. Treant Protector additionally has Tree Walking if he has not taken damage for %cooldown_time% seconds. While Tree Walking, Nature's Guise can be activated to grant Treant invisibility until he attacks or is no longer near a tree.", "notes_zh": ["自然蔽护效果下树精卫士可以直接穿过树木。", "自然卷握的藤蔓在这个技能下被视为树木。", "树木穿行时，受到伤害并不会禁用主动效果或树木穿行。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["radius", "grace_time", "cooldown_time", "movement_bonus", "AbilityCooldown"]}, {"subject": "treant_overgrowth", "name_zh": "树精卫士·疯狂生长", "name_en": "Overgrowth", "description_zh": "在树精卫士周围召唤出疯狂生长的伤害性藤条和枝干，造成伤害并且阻止被缠绕的敌人移动、闪烁、进入隐身或攻击。", "description_en": "Summons an overgrowth of vines and branches around Treant that deal damage to afflicted enemies and prevent them from moving, blinking, going invisible, or attacking.", "notes_zh": ["效果无视减益免疫，但是在期间获得减益免疫状态将挣脱控制。"], "granted_by": "", "upgrades": {"scepter": {"zh": "冷却时间降低至%AbilityCooldown%秒。施放疯狂生长时，树精卫士从土壤中汲取力量，他的身体急剧增大，持续%bloom_duration%秒。变大后他会获得相位移动状态，移动速度为固定%movement_speed%，%strength_bonus%%%力量加成，并且拥有在%splash_radius%范围内造成%splash_pct%%%攻击伤害的溅射攻击。", "en": "Decreases Cooldown to %AbilityCooldown% seconds. When casting Overgrowth, Treant Protector draws power from the soil, greatly increasing his size for %bloom_duration% seconds. While enlarged, he gains phased movement with a fixed speed of %movement_speed%, %strength_bonus%%% bonus Strength, and a splashing attack that deals %splash_pct%%% of his attack damage in a %splash_radius% unit radius."}}, "is_passive": false, "value_names": ["duration", "radius", "damage", "bloom_duration", "strength_bonus", "splash_pct", "splash_radius", "movement_speed", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "ogre_magi_bloodlust", "name_zh": "食人魔魔法师·嗜血术", "name_en": "Bloodlust", "description_zh": "激起一个友方单位的狂暴，增加其移动和攻击速度。对食人魔魔法师自身施放时攻击速度加成更高。可以对防御塔施放。", "description_en": "Incites a frenzy in a friendly unit, increasing its movement speed and attack speed. Gives bonus attack speed if cast on Ogre himself. Can be cast on towers.", "notes_zh": ["触发多重施法时，%multicast_bloodlust_aoe%范围内的友方单位将随机获得嗜血术效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["modelscale", "bonus_movement_speed", "bonus_attack_speed", "self_bonus", "duration", "multicast_bloodlust_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "undying_tombstone", "name_zh": "不朽尸王·墓碑", "name_en": "Tombstone", "description_zh": "在目标位置召唤一座墓碑。墓碑会不断在其附近的每个敌方单位身边产生僵尸攻击他们。僵尸拥有死亡渴望技能，使他们的攻击带有减速效果，并且若目标的生命值低于一定百分比，僵尸的攻击和移动速度会提升。", "description_en": "Summons a tombstone at the target point.  Zombies will frequently spawn next to every enemy unit in the area around the Tombstone, and attack them.  Zombies have the Deathlust ability, which causes their attacks to slow the target, and if the target reaches below a certain amount of health, increases the attack and movement speed of the zombie.", "notes_zh": ["墓碑免疫技能，但是可以被噬魂治疗。", "僵尸和墓碑均免疫技能。", "如果初始目标死亡或丢失视野，僵尸将会死亡。"], "granted_by": "", "upgrades": {"shard": {"zh": "墓碑可以对友方英雄施放，让他们躲进墓碑。进入墓碑的英雄%tombstone_bunker_cd%秒内无法离开，离开后同样的时间内无法再次进入。如果英雄在内时墓碑被摧毁，该英雄会被眩晕%tombstone_stun_penalty%秒。", "en": "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."}}, "is_passive": false, "value_names": ["tombstone_health", "hits_to_destroy_tooltip", "duration", "radius", "health_threshold_pct_tooltip", "zombie_interval", "zombie_damage_tooltip", "zombie_bonus_damage", "zombie_health", "bunker_units", "tombstone_grab_radius", "tombstone_bunker_cd", "tombstone_stun_penalty", "AbilityCastRange", "AbilityCastPoint"]}, {"subject": "undying_flesh_golem", "name_zh": "不朽尸王·血肉傀儡", "name_en": "Flesh Golem", "description_zh": "不朽尸王变身为一具令人毛骨悚然的血肉傀儡。在这个状态下，他获得一定百分比的力量加成，移动速度加成，并且攻击附带减速和伤害加深效果，还会产生墓碑的僵尸。", "description_en": "Undying transforms into a horrifying flesh golem.  While in this state, he gains a percentage increase to strength, bonus movement speed, and causes attacks to slow, apply damage amplification, and spawn Tombstone zombies.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["slow", "damage_amp", "slow_duration", "str_percentage", "duration", "movement_bonus", "spawn_zombie_on_attack", "zombie_duration", "zombie_spawn_padding", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "nyx_assassin_vendetta", "name_zh": "司夜刺客·复仇", "name_en": "Vendetta", "description_zh": "司夜刺客进入隐身状态并获得移动速度加成。如果司夜刺客以攻击打破隐身，当次攻击将造成超高额外伤害，并对目标施加破坏效果。司夜刺客当次攻击具有%attack_range_bonus%额外攻击距离，并且攻击动作加快%attack_animation_bonus%%%。", "description_en": "Nyx Assassin becomes invisible and gains a speed bonus. If Nyx Assassin attacks to break the invisibility, massive bonus damage is dealt with the attack that applies a break to the target. Nyx Assassin has %attack_range_bonus% additional attack range and a %attack_animation_bonus%%% faster attack animation for this attack.", "notes_zh": ["如果在隐身期间使用了技能，或者隐身时间结束，额外伤害的效果将会消失。", "会在造成额外伤害前施加破坏效果。"], "granted_by": "", "upgrades": {"shard": {"zh": "冷却时间减少%bonus_AbilityCooldown%秒。在复仇的最初%free_pathing_duration%秒内，司夜刺客为极速状态，并且移动无视地形。", "en": "Decreases cooldown by %bonus_AbilityCooldown%s. For the first %free_pathing_duration%s of Vendetta, Nyx is hasted and has unobstructed pathing."}}, "is_passive": false, "value_names": ["duration", "movement_speed", "bonus_damage", "health_regen_rate_scepter", "mana_regen_rate_scepter", "break_duration", "free_pathing_duration", "free_pathing_movement_speed_bonus", "attack_animation_bonus", "attack_range_bonus", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_will_o_wisp", "name_zh": "光之守卫·灵光", "name_en": "Will-O-Wisp", "description_zh": "在目标区域召唤幻火。幻火交替闪亮和闪灭。闪亮时蛊惑敌人靠近，并造成伤害。", "description_en": "Summons Ignis Fatuus at the targeted area. Alternates on and off, drawing enemies closer with its mesmerising flicker.", "notes_zh": ["幻火会对作用范围内所有敌人施加朝其牵引的效果，该牵引效果不会打断。"], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["on_count", "radius", "hit_count", "wisp_damage", "off_duration", "on_duration", "off_duration_initial", "fixed_movement_speed", "wisp_duration_tooltip", "bounty", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_spirit_form", "name_zh": "光之守卫·灵魂形态", "name_en": "Spirit Form", "description_zh": "伊扎洛暂时使身体发光，获得施法距离加成，提升光明速度的移速加成，并且冲击波将由一个单独的灵魂施法，可以治疗友军。", "description_en": "Ezalor temporarily turns his body luminescent, gaining cast range, increasing the speed bonus from Bright Speed, and allows Illuminate to be channeled by a separate spirit and heal allies.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升冲击波的治疗效果。", "en": "Increases illuminate heal."}}, "is_passive": false, "value_names": ["duration", "movement_speed", "cast_range", "illuminate_heal", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "keeper_of_the_light_bright_speed", "name_zh": "光之守卫·光明速度", "name_en": "Bright Speed", "description_zh": "光之守卫每%intelligence_per_speed%点智力都会获得1移动速度。只要光之守卫移动%movement_per_vision%距离，他就会留下一道光，可以看到%vision_radius%范围，持续%vision_duration%秒。", "description_en": "Keeper of the Light gains 1 movement speed for every %intelligence_per_speed% Intelligence.Whenever Keeper of the Light moves %movement_per_vision% distance, he leaves behind light that allows him to see %vision_radius% range for %vision_duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["intelligence_per_speed", "movement_per_vision", "vision_radius", "vision_duration", "current_speed"]}, {"subject": "wisp_tether", "name_zh": "艾欧·羁绊", "name_en": "Tether", "description_zh": "将艾欧和一个友方单位连接在一起，提高双方的移动速度。当艾欧回复生命或魔法时，连在一起的友军将获得一部分回复效果。距离过远时连接将会断开，也可以主动断开连接。羁绊会减速触碰到的敌人。", "description_en": "Tethers Io to an allied unit, granting bonus movement speed to both. When Io restores health or mana, the tethered unit gains a portion of that amount. The tether breaks when the allied unit moves too far away, or Io cancels the tether. Tether slows enemies touching it.", "notes_zh": ["如果羁绊的目标距离艾欧700码以外，艾欧将链接目标并将自己向目标牵引（牵引后相距300码）。", "被羁绊连接的单位回复速度相比更快，艾欧满血时也能回复。", "艾欧的移动速度与羁绊目标一致。"], "granted_by": "", "upgrades": {"shard": {"zh": "羁绊会对触碰到的敌人造成伤害。艾欧会回复%damage_to_heal%%%造成伤害。", "en": "Tether damages enemies touching it. Io is healed for %damage_to_heal%%% of the damage done."}}, "is_passive": false, "value_names": ["radius", "movespeed", "latch_distance", "latch_speed", "tether_heal_amp", "tether_mana_amp", "slow", "slow_duration", "damage", "damage_to_heal", "tick_rate", "tether_attack_damage_pct", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_grave_chill", "name_zh": "维萨吉·黄泉颤抖", "name_en": "Grave Chill", "description_zh": "维萨吉吸取目标单位的移动和攻击速度，自身和附近的佣兽获得等量加成。", "description_en": "Visage drains the movement and attack speed of the targeted unit, gaining the drained speed for itself and nearby Familiars.", "notes_zh": ["两个状态效果是分开驱散的。", "速度加成和目标的速度减少相互独立。", "维萨吉周围%radius%内的佣兽也将获得黄泉颤抖的加成效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["chill_duration", "movespeed_bonus", "attackspeed_bonus", "radius", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_silent_as_the_grave", "name_zh": "维萨吉·静如古墓", "name_en": "Silent as the Grave", "description_zh": "维萨吉获得飞行移动状态和移动速度加成。攻击或施法后，将失去移速加成和飞行移动状态，同时维萨吉和他的佣兽在%bonus_duration%秒内拥有额外攻击力。", "description_en": "Visage gains flying movement and bonus movement speed.  Upon attacking or casting, the speed and flying movement are lost and Visage and his familiars deal additional attack damage for %bonus_duration%s.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "移动速度、额外攻击力和持续时间提升。维萨吉和佣兽在持续时间内为隐身状态，直到失去飞行移动状态。", "en": "Increases movement speed, damage, and duration. Turns Visage and familiars invisible for the duration until the flying movement is lost."}}, "is_passive": false, "value_names": ["flight_duration", "movespeed_bonus", "bonus_duration", "bonus_damage", "invis", "fly_timer", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "visage_summon_familiars", "name_zh": "维萨吉·召唤佣兽", "name_en": "Summon Familiars", "description_zh": "召唤%familiar_count%只盲眼的佣兽为维萨吉作战。佣兽拥有石像形态技能，可以化为石像，在落地时使敌人眩晕。在石像形态中的佣兽无敌，并且迅速回复生命值。佣兽被击杀时给予高额奖励。\n\n技能可以设为多样施法（右键点击技能栏图标），在%recall_duration%秒后召回维萨吉的佣兽，在此期间佣兽无法攻击或行动。", "description_en": "Conjures %familiar_count% blind Familiars to fight for Visage.  Familiars possess the Stone Form ability, that allows them to turn into stone, stunning enemies upon landing.  While in Stone Form, Familiars are invulnerable, and rapidly regenerate their health.  Familiars grant high bounty when killed.\n\nThe ability can be cast in the alt-cast state to recall Visages familiars after %recall_duration%s, during which they cannot attack or act.", "notes_zh": ["施放召唤佣兽后已有的佣兽将会死亡。", "佣兽在维萨吉周围时将获得当前陵卫斗篷的承伤降低效果和黄泉颤抖的加成效果。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["familiar_hp", "familiar_armor", "familiar_attack_range", "familiar_base_movespeed", "familiar_bounty", "familiar_attack_damage", "visage_base_damage", "bonus_damage", "familiar_count", "armor_reduction_per_hit", "armor_reduction_duration", "in_formation", "back_distance", "side_distance", "return_distance"]}, {"subject": "slark_shadow_dance", "name_zh": "斯拉克·暗影之舞", "name_en": "Shadow Dance", "description_zh": "当斯拉克不处于敌方视野内时，他会被动获得移动速度加成和生命恢复。如果受到来自中立单位的伤害，%neutral_disable%秒内会失去被动移速和生命恢复加成。主动开启后，斯拉克将自己藏进暗影之云，变成隐身状态，不会被反隐手段发现。攻击、施法、使用物品都不会使斯拉克显形，但是敌人可以看见暗影之云。", "description_en": "When not visible to the enemy team, Slark passively gains bonus movement speed and health regeneration.  If Slark is damaged by a neutral unit, the passive movement and health regeneration bonuses are lost for %neutral_disable% seconds.When activated, Slark hides himself in a cloud of shadows, becoming immune to detection. Attacking, casting spells, and using items will not reveal Slark, but enemies can see the cloud itself.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_movement_speed", "bonus_regen", "activation_delay", "neutral_disable", "duration", "attack_speed", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "troll_warlord_whirling_axes_ranged", "name_zh": "巨魔战将·旋风飞斧（远程）", "name_en": "Whirling Axes (Ranged)", "description_zh": "巨魔战将掷出手中的五把飞斧，减速并伤害前方%axe_range%范围锥形区域内的敌方单位。", "description_en": "Troll hurls a fistful of five axes in a cone shape over %axe_range% range, slowing and damaging enemy units.", "notes_zh": ["无法作用于肉山。", "不会触发法术抵抗或法术反弹。"], "granted_by": "", "upgrades": {"scepter": {"zh": "旋风飞斧（远程）可以驱散敌人。降低冷却时间和魔法消耗。驱散类型：弱驱散", "en": "Causes Whirling Axes (Ranged) to dispel enemies. Reduces cooldown and mana cost.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["axe_width", "axe_speed", "axe_range", "axe_damage", "axe_slow_duration", "movement_speed", "axe_spread", "axe_count", "pierces_magic_immunity", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "troll_warlord_whirling_axes_melee", "name_zh": "巨魔战将·旋风飞斧（近战）", "name_en": "Whirling Axes (Melee)", "description_zh": "巨魔战将掷出两把飞斧环绕在他周围，使敌方单位受到伤害，并且部分普通攻击将不能命中。", "description_en": "Troll hurls two axes around him in a close range area of effect, damaging enemy units and causing them to miss some attacks.", "notes_zh": ["无法作用于肉山。"], "granted_by": "", "upgrades": {"scepter": {"zh": "旋风飞斧（近战）可以驱散自己。降低冷却时间和魔法消耗。驱散类型：弱驱散", "en": "Causes Whirling Axes (Melee) to dispel Troll Warlord. Reduces cooldown and mana cost.DISPEL TYPE: Basic Dispel"}}, "is_passive": false, "value_names": ["damage", "hit_radius", "max_range", "axe_movement_speed", "blind_duration", "blind_pct", "whirl_duration", "pierces_magic_immunity", "AbilityManaCost", "AbilityCooldown"]}]
