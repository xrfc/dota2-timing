      "reason_zh": "明确向前跳跃。",
      "uncertain": false
    },
    {
      "subject": "riki_blink_strike",
      "kinds": ["teleport"],
      "quote": "传送到目标背后",
      "reason_zh": "明确传送到目标背后。",
      "uncertain": false
    },
    {
      "subject": "sniper_concussive_grenade",
