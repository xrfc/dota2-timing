tes_zh": ["行进过程中可以使用技能和物品。", "该技能可以摧毁树木。", "风暴之灵在球状闪电期间是无敌状态。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["ball_lightning_initial_mana_percentage", "ball_lightning_initial_mana_base", "ball_lightning_move_speed", "ball_lightning_aoe", "ball_lightning_travel_cost_base", "ball_lightning_travel_cost_percent", "ball_lightning_vision_radius", "blocker_duration", "scepter_remnant_interval", "auto_remnant_interval", "AbilityDamage", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "sven_storm_bolt", "name_zh": "斯温·风暴之拳", "name_en": "Storm Hammer", "description_zh": "斯温用他充满魔力的手套对目标周围内所有敌人造成伤害和眩晕。", "description_en": "Sven unleashes his magical gauntlet that deals damage and stuns enemy units in a small area around the target.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离，并且对目标施加弱驱散效果。可以影响无敌目标。设为多样施法（右键点击技能栏图标）后，额外造成%scepter_bonus_damage%点伤害并且斯温会跟随风暴之拳行进。", "en": "Increases cast range and applies a basic dispel on the target. Affects invulnerable units. If alt-cast, it deals an additional %scepter_bonus_damage% damage and Sven travels with the Storm Hammer."}}, "is_passive": false, "value_names": ["bolt_speed", "bolt_stun_duration", "bolt_aoe", "vision_radius", "scepter_bonus_damage", "bonus_damage_pct", "AbilityDamage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "vengefulspirit_nether_swap", "name_zh": "复仇之魂·移形换位", "name_en": "Nether Swap", "description_zh": "与一个目标英雄瞬间交换位置，不论敌我。移形换位会打断目标的持续施法。敌方英雄被交换后受到伤害。复仇之魂和被交换的友方英雄都会获得等同于造成伤害的护盾。", "description_en": "Instantaneously swaps positions with a target Hero, friend or enemy. Nether Swap interrupts channeling abilities on the target. Enemy Swapped units take damage. Vengeful Spirit and allied swapped units gain a barrier equal to the damage dealt.", "notes_zh": ["对减益免疫单位有效。", "技能施放后复仇之魂和目标附近的树木将会被摧毁。", "移形换位能够打断持续施法。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage_reduction_duration", "damage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "zuus_heavenly_jump", "name_zh": "宙斯·神圣一跳", "name_en": "Heavenly Jump", "description_zh": "宙斯作出神圣一跳，向前跳跃并震击最近的可见敌人（以英雄优先），造成伤害，并减缓其移动速度、攻击速度。宙斯获得附近%vision_radius%范围的顺畅视野，持续3秒。", "description_en": "Zeus performs a Heavenly Jump, leaping forward and shocking the closest visible nearby enemy (prioritizing heroes), dealing damage as well as reducing their movement and attack speed. Zeus gets %vision_radius% unobstructed vision around him for 3 seconds.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["damage", "hop_distance", "hop_duration", "hop_height", "range", "vision_radius", "vision_duration", "duration", "move_slow", "aspd_slow", "targets", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "riki_blink_strike", "name_zh": "力丸·闪烁突袭", "name_en": "Blink Strike", "description_zh": "传送到目标背后，如果是敌人对其造成%slow_pct_tooltip%%%短暂减速，并发动一次拥有额外伤害的攻击。", "description_en": "Teleports behind the target unit, momentarily slowing them by %slow_pct_tooltip%%% and attacking them with bonus damage if it is an enemy.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_damage", "slow", "slow_pct_tooltip", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "sniper_concussive_grenade", "name_zh": "狙击手·震荡手雷", "name_en": "Concussive Grenade", "description_zh": "向目标区域扔出一枚手雷，对敌人造成伤害并将他们和狙击手一同击退。受到作用的敌人被击退后还会被缴械和减速。", "description_en": "Launches a grenade at the target area, dealing damage to enemies and knocking them and Sniper back. Enemies affected are disarmed and have their movement slowed after the knockback.", "notes_zh": [], "granted_by": "shard", "upgrades": {"shard": {"zh": "降低冷却时间，提升伤害并允许技能也能击退狙击手。", "en": "Reduces cooldown, increases damage, and allows the knockback to affect Sniper as well."}}, "is_passive": false, "value_names": ["damage", "radius", "slow", "debuff_duration", "knockback_height", "knockback_distance", "knockback_duration", "self_push", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "necrolyte_death_seeker", "name_zh": "瘟疫法师·死亡搜寻", "name_en": "Death Seeker", "description_zh": "瘟疫法师变成一个大死亡脉冲，向目标单位的地点移动。到达该地点后，死亡脉冲会扩散至附近敌人和友军。", "description_en": "Necrophos turns into a large Death Pulse towards the target unit's position. Once it arrives to the location, the Death Pulse spreads towards nearby enemies and allies.", "notes_zh": ["不会触发法术反弹。"], "granted_by": "shard", "upgrades": {}, "is_passive": false, "value_names": ["projectile_multiplier", "ethereal_duration", "magic_resistance_reduction", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "queenofpain_blink", "name_zh": "痛苦女王·闪烁", "name_en": "Blink", "description_zh": "短距离传送，能让痛苦女王自由出入战场。", "description_en": "Short distance teleportation that allows Queen of Pain to move in and out of combat.", "notes_zh": ["闪烁可以躲避多种飞行过程中的攻击和技能弹道。"], "granted_by": "", "upgrades": {"shard": {"zh": "在痛苦女王的闪烁起点和落地点各释放一次音爆。在%shard_aoe%范围内造成%shard_damage%点伤害，并沉默%shard_duration%秒。", "en": "Releases a sonic boom when Queen of Pain blinks, at both her starting and ending locations. Deals %shard_damage% damage in a %shard_aoe% AoE and silences the target for %shard_duration% seconds."}}, "is_passive": false, "value_names": ["min_blink_range", "shard_damage", "shard_duration", "shard_aoe", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "faceless_void_time_walk", "name_zh": "虚空假面·时间漫游", "name_en": "Time Walk", "description_zh": "冲到目标位置，并取消最近%backtrack_duration%秒内受到的任何伤害。", "description_en": "Rushes to a target location while backtracking any damage taken the last %backtrack_duration% seconds.", "notes_zh": ["虚空假面在时间漫游过程中为无敌状态。"], "granted_by": "", "upgrades": {"scepter": {"zh": "在落地点对所有单位施加一次时间锁定。", "en": "Applies a Time Lock to all units at the landing destination."}}, "is_passive": false, "value_names": ["speed", "range", "backtrack_duration", "backtrack_time_walk_duration", "dodge_chance_pct", "radius", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "faceless_void_time_walk_reverse", "name_zh": "虚空假面·反时间漫游", "name_en": "Reverse Time Walk", "description_zh": "时间漫游落地后1.5秒内可使用。施放时，自身将逆转时间漫游，回到上一个施放地点。不会影响生命值或触发神杖效果。", "description_en": "Available for 1.5 seconds after landing Time Walk. If used in this period, you will reverse your time walk back to your previous cast location. Does not affect health or proc scepter hits.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["buff_duration", "speed", "AbilityCooldown"]}, {"subject": "phantom_assassin_phantom_strike", "name_zh": "幻影刺客·幻影突袭", "name_en": "Phantom Strike", "description_zh": "传送到一个单位身旁，敌我皆可，如果目标是敌方单位将进行攻击并获得攻速加成。", "description_en": "Teleports to a unit, friendly or enemy, and grants bonus attack speed while attacking if it's an enemy unit.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["bonus_attack_speed", "duration", "creep_lifesteal_penalty", "AbilityCastRange", "AbilityCastPoint", "AbilityCharges", "AbilityChargeRestoreTime", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "templar_assassin_trap_teleport", "name_zh": "圣堂刺客·灵能投射", "name_en": "Psionic Projection", "description_zh": "持续施法 - 圣堂刺客经过%abilitychanneltime%秒持续施法后可以传送至任意灵能陷阱，到达时引爆灵能陷阱，陷阱总是最大效果，并且立刻造成%extra_damage%点额外伤害。灵能投射在持续施法时不会脱离隐匿效果。", "description_en": "CHANNELED - Allows Templar Assassin to teleport to any Psionic Trap after channeling for %abilitychanneltime% seconds, detonating it upon arrival as if it was fully charged and instantly dealing %extra_damage% bonus damage. Channeling Psionic Projection does not break Meld.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["extra_damage", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}]
