      "kinds": ["teleport"],
      "quote": "与一个目标英雄瞬间交换位置，不论敌我。",
      "reason_zh": "瞬间交换位置属于传送。",
      "uncertain": false
    },
    {
      "subject": "zuus_heavenly_jump",
      "kinds": ["jump_dash"],
