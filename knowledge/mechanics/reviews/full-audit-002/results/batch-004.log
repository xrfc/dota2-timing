ivation_charges", "shard_activation_duration", "shard_manacost", "shard_cooldown", "shard_attack_speed_bonus", "overload_bounces", "overload_damage_pct", "AbilityDuration"]}, {"subject": "storm_spirit_ball_lightning", "name_zh": "风暴之灵·球状闪电", "name_en": "Ball Lightning", "description_zh": "风暴之灵变成不稳定的电流在战场上横冲直撞，直到他的魔法耗尽或到达目标才停下。施法消耗为%ball_lightning_initial_mana_base%+总魔法量的%ball_lightning_initial_mana_percentage%%%，每移动100距离消耗%ball_lightning_travel_cost_base%+总魔法量的%ball_lightning_travel_cost_percent%%%，本技能造成的伤害每飞行100距离就会递增。", "description_en": "Storm Spirit becomes volatile electricity, charging across the battlefield until he depletes his mana or reaches his target. The activation mana cost is %ball_lightning_initial_mana_base%+%ball_lightning_initial_mana_percentage%%% of his total mana pool, and the cost per 100 units traveled is %ball_lightning_travel_cost_base%+%ball_lightning_travel_cost_percent%%% of his total mana pool.  Damage is expressed in damage per 100 units traveled.", "notes_zh": ["行进过程中可以使用技能和物品。", "该技能可以摧毁树木。", "风暴之灵在球状闪电期间是无敌状态。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["ball_lightning_initial_mana_percentage", "ball_lightning_initial_mana_base", "ball_lightning_move_speed", "ball_lightning_aoe", "ball_lightning_travel_cost_base", "ball_lightning_travel_cost_percent", "ball_lightning_vision_radius", "blocker_duration", "scepter_remnant_interval", "auto_remnant_interval", "AbilityDamage", "AbilityCastPoint", "AbilityManaCost"]}, {"subject": "storm_spirit_galvanized", "name_zh": "风暴之灵·通电", "name_en": "Galvanized", "description_zh": "风暴之灵每次击杀都会获得一点提供%mp_per_kill%点/秒魔法恢复的能量，每%level_divisor%级也会获得一点能量。每次阵亡会损失%charges_per_death%点能量。另外每次获得一点能量时他还会永久获得%perma_mp_per_kill%点/秒魔法恢复。", "description_en": "Storm Spirit gains a charge of %mp_per_kill% mana regeneration per kill, and a charge every %level_divisor% levels. Loses %charges_per_death% charges per death. Additionally every time he gains a charge he also gains %perma_mp_per_kill% Mana Regen permanently.", "notes_zh": ["破坏会使技能无法通过击杀获得新的叠加效果。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["perma_mp_per_kill", "mp_per_kill", "aoe", "charges_per_death", "level_divisor"]}, {"subject": "sven_storm_bolt", "name_zh": "斯温·风暴之拳", "name_en": "Storm Hammer", "description_zh": "斯温用他充满魔力的手套对目标周围内所有敌人造成伤害和眩晕。", "description_en": "Sven unleashes his magical gauntlet that deals damage and stuns enemy units in a small area around the target.", "notes_zh": [], "granted_by": "", "upgrades": {"scepter": {"zh": "提升施法距离，并且对目标施加弱驱散效果。可以影响无敌目标。设为多样施法（右键点击技能栏图标）后，额外造成%scepter_bonus_damage%点伤害并且斯温会跟随风暴之拳行进。", "en": "Increases cast range and applies a basic dispel on the target. Affects invulnerable units. If alt-cast, it deals an additional %scepter_bonus_damage% damage and Sven travels with the Storm Hammer."}}, "is_passive": false, "value_names": ["bolt_speed", "bolt_stun_duration", "bolt_aoe", "vision_radius", "scepter_bonus_damage", "bonus_damage_pct", "AbilityDamage", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "sven_great_cleave", "name_zh": "斯温·巨力挥舞", "name_en": "Great Cleave", "description_zh": "斯温以巨力攻击，并对所有附近的敌方单位造成分裂攻击伤害。", "description_en": "Sven strikes with great force, cleaving all nearby enemy units with his attack.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["cleave_starting_width", "cleave_ending_width", "cleave_distance", "great_cleave_damage"]}, {"subject": "sven_warcry", "name_zh": "斯温·战吼", "name_en": "Warcry", "description_zh": "斯温的战吼激励着同伴作战，提升他们的护甲和移动速度。持续%duration%秒。", "description_en": "Sven's Warcry heartens his allied heroes for battle, increasing their armor and movement speed. Lasts %duration% seconds.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "提升作用范围和移动速度加成。现在战吼不可驱散，并提供%base_barrier_amount%点物理伤害护盾。", "en": "Increases radius and bonus movement speed. Warcry is now undispellable and provides a %base_barrier_amount% physical damage barrier."}}, "is_passive": false, "value_names": ["movespeed", "bonus_armor", "radius", "duration", "shard_passive_armor", "shard_passive_movespeed", "undispellable", "shard_radius", "base_barrier_amount", "barrier_per_strength", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "sven_gods_strength", "name_zh": "斯温·神之力量", "name_en": "God's Strength", "description_zh": "斯温爆发出他流浪剑客的力量，获得攻击力加成和减速抗性，持续%abilityduration%秒。", "description_en": "Sven channels his rogue strength, granting bonus damage and slow resistance for %abilityduration% seconds.", "notes_zh": ["额外攻击力是基于斯温的基础攻击力和主属性数值。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["gods_strength_damage", "bonus_slow_resistance", "AbilityDuration", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "sven_wrath_of_god", "name_zh": "斯温·神之愤怒", "name_en": "Wrath of God", "description_zh": "斯温从力量中获得额外攻击力。", "description_en": "Sven gains additional attack damage from Strength.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["bonus_damage_per_str", "current_bonus_damage_tooltip"]}, {"subject": "tiny_avalanche", "name_zh": "小小·山崩", "name_en": "Avalanche", "description_zh": "用岩石轰炸一块区域，对敌方单位造成短间隔的伤害并眩晕。", "description_en": "Bombards an area with rocks, continously doing small intervals of damage and stun to enemy units.", "notes_zh": [], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["radius", "tick_interval", "total_duration", "tick_count", "stun_duration", "projectile_speed", "avalanche_damage", "AbilityCastRange", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tiny_toss", "name_zh": "小小·投掷", "name_en": "Toss", "description_zh": "抓起小小身旁%grab_radius%范围内最近的单位，不论敌友，扔向目标单位或神符，落地时将造成伤害。", "description_en": "Grabs the nearest unit in a %grab_radius% radius around Tiny, ally or enemy, and launches it at the target unit or rune to deal damage where they land.", "notes_zh": ["你可以投掷队友，但他们不会受到伤害。", "投掷对建筑物造成33%的伤害。", "可以对减益免疫单位施放，但是不能将他们扔起，或对他们造成伤害。", "飞行时间是%duration%秒。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["duration", "grab_radius", "radius", "toss_damage", "toss_land_damage_pct", "AbilityCastRange", "AbilityCharges", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tiny_tree_grab", "name_zh": "小小·抓树", "name_en": "Tree Grab", "description_zh": "抓起一棵树，使小小在有限次数的攻击里获得攻击距离加成、攻击力加成和溅射攻击。可以将树木扔出，对远距离的敌人造成攻击伤害。", "description_en": "Grabs a tree and causes Tiny to have bonus range, damage, and a splashing attack for a limited number of attacks.  The tree can be thrown, to deal your attack to a unit at a distance.", "notes_zh": ["树木扔出后技能进入冷却。"], "granted_by": "", "upgrades": {}, "is_passive": false, "value_names": ["attack_count", "bonus_damage", "bonus_damage_buildings", "attack_range", "splash_width", "splash_range", "splash_pct", "AbilityCastRange", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tiny_tree_channel", "name_zh": "小小·树木连掷", "name_en": "Tree Volley", "description_zh": "持续施法 - 小小进行持续施法，随机将自身周围的树木扔向目标范围。每棵树对该区域内敌人造成的伤害为小小的攻击伤害加上扔树的额外伤害。", "description_en": "CHANNELED - Tiny channels to throw random trees within range towards the targeted area. Deals Tiny's attack with Tree Throw bonuses.", "notes_zh": [], "granted_by": "scepter", "upgrades": {}, "is_passive": false, "value_names": ["speed", "range", "splash_radius", "tree_grab_radius", "interval", "AbilityCastRange", "AbilityChannelTime", "AbilityCastPoint", "AbilityManaCost", "AbilityCooldown"]}, {"subject": "tiny_insurmountable", "name_zh": "小小·不可逾越", "name_en": "Insurmountable", "description_zh": "小小从力量中获得状态和减速抗性。减速抗性还会降低攻击速度减少的影响。", "description_en": "Tiny gains Status and Slow Resistance from Strength. Slow Resistance also reduces the impact of Attack Speed slows.", "notes_zh": ["不可逾越不会减少长大的攻击速度降低效果。"], "granted_by": "", "upgrades": {}, "is_passive": true, "value_names": ["str_to_slow_resist_pct", "str_to_status_resist_pct"]}, {"subject": "tiny_grow", "name_zh": "小小·长大", "name_en": "Grow", "description_zh": "小小崎岖的身体不断成长，提升了攻击力、移动速度、护甲和投掷的威力，但攻击速度降低。", "description_en": "Tiny gains craggy mass, increasing his attack damage, movement speed and armor, and toss power while slowing his attack speed.", "notes_zh": [], "granted_by": "", "upgrades": {"shard": {"zh": "现在投掷扔出的单位，扔树和树木连掷扔出的树木都会在落地点的更大范围内造成额外伤害和减速效果。", "en": "Units tossed by Toss or trees tossed by Tree Throw or Tree Volley now deal additional damage and slow in a larger area of effect at their landing location."}}, "is_passive": true, "value_names": ["bonus_armor", "bonus_damage", "attack_speed_reduction", "toss_bonus_damage", "move_speed", "land_movement_slow", "land_attack_slow", "land_debuff_duration", "land_radius_tooltip", "land_toss_damage_tooltip", "land_tree_damage_tooltip"]}]
